    "Could not find still image in Live Photo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not find still image in Live Photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo में स्थिर छवि नहीं मिली."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo-তে স্থির ছবি পাওয়া যায়নি."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo-இல் நிலைப் படம் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photoలో స్థిర చిత్రం కనుగొనలేకపోయాం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo मध्ये स्थिर प्रतिमा आढळली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo માં સ્થિર ઇમેજ મળી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo ನಲ್ಲಿ ಸ್ಟಿಲ್ ಚಿತ್ರ ಕಂಡುಬಂದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo-ൽ സ്റ്റിൽ ഇമേജ് കണ്ടെത്താനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo ਵਿੱਚ ਸਥਿਰ ਤਸਵੀਰ ਨਹੀਂ ਮਿਲੀ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la foto fija en la Live Photo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver la photo fixe dans la Live Photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Live Photo wurde kein Standbild gefunden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar a foto estática na Live Photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare la foto statica nella Live Photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo内に静止画が見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo에서 정지 이미지를 찾지 못했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在 Live Photo 中找到静帧图像。"
          }
        },
        "ru": {
          "stringUnit": {
