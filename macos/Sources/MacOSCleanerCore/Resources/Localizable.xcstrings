    "A lens smudge may have reduced image clarity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lens smudge may have reduced image clarity."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेंस पर लगे धब्बे से छवि की स्पष्टता कम हो सकती है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেন্সের দাগ ছবির স্পষ্টতা কমিয়ে থাকতে পারে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "லென்ஸில் உள்ள கறையால் படத்தின் தெளிவு குறைந்திருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లెన్స్ మరక చిత్ర స్పష్టతను తగ్గించి ఉండవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन्सवरील डागामुळे प्रतिमेची स्पष्टता कमी झाली असू शकते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લેન્સ પરના ડાઘને કારણે છબીની સ્પષ્ટતા ઘટી હોઈ શકે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೆನ್ಸ್ ಕಲೆ ಚಿತ್ರದ ಸ್ಪಷ್ಟತೆಯನ್ನು ಕಡಿಮೆ ಮಾಡಿರಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലെൻസിലെ പാട് ചിത്രത്തിന്റെ വ്യക്തത കുറച്ചിരിക്കാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੈਂਸ ਉੱਤੇ ਧੱਬੇ ਕਾਰਨ ਤਸਵੀਰ ਦੀ ਸਪਸ਼ਟਤਾ ਘੱਟ ਹੋ ਸਕਦੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que una mancha en la lente haya reducido la nitidez de la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une trace sur l'objectif a peut-être réduit la netteté de l'image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine verschmutzte Linse kann die Bildschärfe beeinträchtigt haben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mancha na lente pode ter reduzido a nitidez da imagem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'impronta sull'obiettivo potrebbe aver ridotto la nitidezza dell'immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズの汚れにより、画像の鮮明さが低下している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌즈 얼룩으로 이미지 선명도가 낮아졌을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜头污渍可能降低了图像的清晰度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрязнение объектива могло снизить четкость изображения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يكون اتساخ العدسة قد قلّل وضوح الصورة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שלכלוך על העדשה הפחית את חדות התמונה."
          }
        }
      }
    },
