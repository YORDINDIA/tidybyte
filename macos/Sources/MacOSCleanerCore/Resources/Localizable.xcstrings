    "Always consider %@ for %@ in this scope after review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always consider %@ for %@ in this scope after review."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा के बाद इस दायरे में %2$@ के लिए हमेशा %1$@ का सुझाव दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্যালোচনার পর এই পরিসরে %2$@-এর জন্য সর্বদা %1$@ বিবেচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மதிப்பாய்வுக்குப் பிறகு இந்த வரம்பில் %2$@ க்கு எப்போதும் %1$@ ஐப் பரிசீலிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్ష తర్వాత ఈ పరిధిలో %2$@ కోసం ఎల్లప్పుడూ %1$@ ను పరిగణించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरावलोकनानंतर या कार्यक्षेत्रात %2$@ साठी नेहमी %1$@ विचारात घ्या."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમીક્ષા પછી આ વિસ્તારમાં %2$@ માટે હંમેશા %1$@ ધ્યાનમાં લો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿಶೀಲನೆಯ ನಂತರ ಈ ವ್ಯಾಪ್ತಿಯಲ್ಲಿ %2$@ ಗಾಗಿ ಯಾವಾಗಲೂ %1$@ ಅನ್ನು ಪರಿಗಣಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവലോകനത്തിന് ശേഷം ഈ പരിധിയിൽ %2$@-നായി എപ്പോഴും %1$@ പരിഗണിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੀਖਿਆ ਤੋਂ ਬਾਅਦ ਇਸ ਦਾਇਰੇ ਵਿੱਚ %2$@ ਲਈ ਹਮੇਸ਼ਾ %1$@ 'ਤੇ ਵਿਚਾਰ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Considerar siempre %@ para %@ en este ámbito tras la revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours proposer %@ pour %@ dans ce périmètre après examen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ in diesem Bereich nach Prüfung immer %@ vorschlagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre considerar %@ para %@ neste escopo após revisão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Considera sempre %@ per %@ in quest'area dopo la revisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後、この範囲内の %2$@ に対して常に %1$@ を候補にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토 후 이 범위의 %2$@에 대해 항상 %1$@을(를) 고려합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审阅后在此范围内始终为 %2$@ 考虑 %1$@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда предлагать %@ для %@ в этой области после проверки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقترح دائمًا %@ لـ %@ في هذا النطاق بعد المراجعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמיד לשקול %@ עבור %@ בהיקף זה לאחר בדיקה."
          }
        }
      }
    },
