    "Named after the app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Named after the app"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप के नाम पर आधारित"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপের নামে নামকরণকৃত"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலியின் பெயரால் பெயரிடப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ పేరు మీద పెట్టబడింది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅपच्या नावावरून नाव दिलेले"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપના નામ પરથી રાખેલું"
          }
        },
        "kn": {
