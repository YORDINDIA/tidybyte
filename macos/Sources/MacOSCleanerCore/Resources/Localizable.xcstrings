    "Export verification failed. The Photos original was kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export verification failed. The Photos original was kept."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात सत्यापन विफल रहा। फ़ोटो का मूल आइटम सुरक्षित रखा गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট যাচাই ব্যর্থ হয়েছে। ফটোর মূল আইটেমটি রাখা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்றுமதி சரிபார்ப்பு தோல்வியடைந்தது. அசல் புகைப்படம் வைக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎగుమతి ధృవీకరణ విఫలమైంది. అసలు ఫోటో ఉంచబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात पडताळणी अयशस्वी झाली. मूळ फोटो ठेवला आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિકાસ ચકાસણી નિષ્ફળ ગઈ. મૂળ ફોટો રાખવામાં આવ્યો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಫ್ತು ದೃಢೀಕರಣ ವಿಫಲವಾಗಿದೆ. ಮೂಲ ಫೋಟೋವನ್ನು ಇರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എക്സ്പോർട്ട് സ്ഥിരീകരണം പരാജയപ്പെട്ടു. യഥാർത്ഥ ഫോട്ടോ നിലനിർത്തി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿਰਯਾਤ ਪੁਸ਼ਟੀ ਅਸਫਲ ਰਹੀ। ਫੋਟੋ ਦਾ ਮੂਲ ਰੱਖਿਆ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la verificación de la exportación. Se conservó el original en Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de l'export a échoué. L'original dans Photos a été conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportprüfung fehlgeschlagen. Das Original in Fotos wurde behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação da exportação falhou. O original do Fotos foi mantido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica dell'esportazione non riuscita. L'originale in Foto è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しの検証に失敗しました。「写真」の元の項目を保持しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기 검증에 실패하여 사진 원본을 유지했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出验证失败。已保留“照片”中的原件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка экспорта не пройдена. Оригинал в «Фото» сохранен."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل التحقق من التصدير. تم الاحتفاظ بالأصل في الصور."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימות הייצוא נכשל. המקור בתמונות נשמר."
          }
        }
      }
    },
