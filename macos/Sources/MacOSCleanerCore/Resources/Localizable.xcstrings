        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश में %@ पर मौजूद आइटम की पहचान सत्यापित नहीं हो सकी, इसलिए इसे पुनर्स्थापित नहीं किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাশে %@-এ থাকা আইটেমের পরিচয় যাচাই করা যায়নি, তাই এটি পুনরুদ্ধার করা হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குப்பைத் தொட்டியில் %@ இல் உள்ள உருப்படியின் அடையாளத்தைச் சரிபார்க்க முடியவில்லை, எனவே மீட்டெடுக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాష్‌లో %@ వద్ద ఉన్న అంశం గుర్తింపును ధృవీకరించలేకపోయాము, కాబట్టి అది పునరుద్ధరించబడలేదు."
          }
