    "Action %@ was already executed and cannot run again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Action %@ was already executed and cannot run again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रिया %@ पहले ही चलाई जा चुकी है और इसे फिर से नहीं चलाया जा सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ কাজটি ইতিমধ্যেই চালানো হয়েছে এবং পুনরায় চালানো যাবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ செயல் ஏற்கனவே இயக்கப்பட்டுவிட்டது, மீண்டும் இயக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చర్య %@ ఇప్పటికే అమలు చేయబడింది మరియు మళ్లీ అమలు చేయలేరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रिया %@ आधीच चालवली गेली आहे आणि पुन्हा चालवता येत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્રિયા %@ પહેલેથી ચલાવવામાં આવી છે અને ફરીથી ચલાવી શકાતી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ರಿಯೆ %@ ಅನ್ನು ಈಗಾಗಲೇ ಚಲಾಯಿಸಲಾಗಿದೆ ಮತ್ತು ಮತ್ತೆ ಚಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ എന്ന പ്രവൃത്തി ഇതിനകം നടപ്പിലാക്കിയിട്ടുണ്ട്, വീണ്ടും പ്രവർത്തിപ്പിക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਾਰਵਾਈ %@ ਪਹਿਲਾਂ ਹੀ ਚਲਾਈ ਜਾ ਚੁੱਕੀ ਹੈ ਅਤੇ ਦੁਬਾਰਾ ਨਹੀਂ ਚਲਾਈ ਜਾ ਸਕਦੀ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción %@ ya se ejecutó y no puede volver a ejecutarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'action %@ a déjà été exécutée et ne peut pas être relancée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktion %@ wurde bereits ausgeführt und kann nicht erneut gestartet werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação %@ já foi executada e não pode ser executada novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'azione %@ è già stata eseguita e non può essere ripetuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクション %@ はすでに実行済みのため再実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 %@은(는) 이미 실행되어 다시 실행할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作 %@ 已经执行过，不能重复运行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие %@ уже выполнено и не может быть запущено повторно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تنفيذ الإجراء %@ بالفعل ولا يمكن تشغيله مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה %@ כבר בוצעה ולא ניתן להריצה שוב."
          }
        }
      }
    },
