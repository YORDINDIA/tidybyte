    "pip cache at %@%@ can be purged safely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pip cache at %@%@ can be purged safely."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ पर मौजूद pip कैश को सुरक्षित रूप से साफ़ किया जा सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@-এ থাকা pip ক্যাশ নিরাপদে পরিষ্কার করা যাবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ இல் உள்ள pip கேச்சைப் பாதுகாப்பாக நீக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ వద్ద ఉన్న pip క్యాష్‌ను సురక్షితంగా తొలగించవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ येथील pip कॅशे सुरक्षितपणे साफ करता येतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ પરનું pip કૅશ સુરક્ષિત રીતે સાફ કરી શકાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ ನಲ್ಲಿರುವ pip ಕ್ಯಾಶ್ ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ತೆರವುಗೊಳಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@-ലുള്ള pip ക്യാഷ് സുരക്ഷിതമായി നീക്കം ചെയ്യാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ 'ਤੇ pip ਕੈਸ਼ ਨੂੰ ਸੁਰੱਖਿਅਤ ਸਾਫ਼ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caché de pip en %@%@ se puede vaciar de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache pip dans %@%@ peut être purgé en toute sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "pip-Cache unter %@%@ kann sicher geleert werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cache do pip em %@%@ pode ser limpo com segurança."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cache pip in %@%@ può essere svuotata in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ にある pip キャッシュは安全に消去できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@에 있는 pip 캐시는 안전하게 비울 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %@%@ 的 pip 缓存可以安全清除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэш pip в %@%@ можно безопасно очистить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن مسح ذاكرة تخزين pip في %@%@ بأمان."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לרוקן בבטחה את מטמון pip ב-%@%@."
          }
        }
      }
    },
    "pnpm store at %@ can drop packages no project uses.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pnpm store at %@ can drop packages no project uses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर मौजूद pnpm स्टोर उन पैकेजों को हटा सकता है जिनका उपयोग कोई प्रोजेक्ट नहीं करता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ থাকা pnpm স্টোর কোনো প্রজেক্টের ব্যবহৃত নয় এমন প্যাকেজ বাদ দিতে পারে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல் உள்ள pnpm கடை எந்தத் திட்டமும் பயன்படுத்தாத தொகுப்புகளை நீக்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వద్ద ఉన్న pnpm స్టోర్ ఏ ప్రాజెక్ట్ ఉపయోగించని ప్యాకేజీలను తొలగించగలదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ येथील pnpm स्टोअर कोणताही प्रोजेक्ट वापरत नसलेली पॅकेजेस काढू शकतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ પરનો pnpm સ્ટોર કોઈ પ્રોજેક્ટ ન વાપરતું હોય તેવા પૅકેજીસ દૂર કરી શકે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ನಲ್ಲಿರುವ pnpm ಸ್ಟೋರ್ ಯಾವುದೇ ಪ್ರಾಜೆಕ್ಟ್ ಬಳಸದ ಪ್ಯಾಕೇಜ್‌ಗಳನ್ನು ಬಿಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ലുള്ള pnpm സ്റ്റോറിന് ഒരു പ്രോജക്റ്റും ഉപയോഗിക്കാത്ത പാക്കേജുകൾ നീക്കം ചെയ്യാനാകും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 'ਤੇ pnpm ਸਟੋਰ ਉਹ ਪੈਕੇਜ ਹਟਾ ਸਕਦਾ ਹੈ ਜੋ ਕੋਈ ਪ੍ਰੋਜੈਕਟ ਨਹੀਂ ਵਰਤਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacén de pnpm en %@ puede eliminar paquetes que ningún proyecto usa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt pnpm dans %@ peut supprimer les paquets inutilisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "pnpm-Store unter %@ kann ungenutzte Pakete entfernen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do pnpm em %@ pode descartar pacotes que nenhum projeto usa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archivio pnpm in %@ può rimuovere i pacchetti non usati da alcun progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の pnpm ストアからどのプロジェクトも使っていないパッケージを削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 pnpm 저장소에서 어떤 프로젝트도 사용하지 않는 패키지를 삭제할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %@ 的 pnpm 存储可以移除没有任何项目在使用的包。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище pnpm в %@ позволяет удалить пакеты, не используемые проектами."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لمخزن pnpm في %@ حذف الحزم التي لا يستخدمها أي مشروع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאגר pnpm ב-%@ יכול להסיר חבילות שאף פרויקט אינו משתמש בהן."
          }
        }
      }
    },
