    "Loose file organization candidate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loose file organization candidate."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिखरी फ़ाइल व्यवस्थित करने का विकल्प।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অগোছালো ফাইল বিন্যাসের উপযুক্ত।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒழுங்கமைக்கப்படாத கோப்பைச் சீரமைக்கத் தகுந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చెల్లాచెదురు ఫైల్ నిర్వహణకు అర్హమైనది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विखुरलेली फाइल व्यवस्थित करण्याचा पर्याय."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિખરાયેલી ફાઇલ ગોઠવવા માટેનો વિકલ્પ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚದುರಿದ ಫೈಲ್ ವ್ಯವಸ್ಥೆಗೊಳಿಸಲು ಯೋಗ್ಯವಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചിതറിക്കിടക്കുന്ന ഫയൽ ക്രമീകരിക്കാൻ യോഗ്യമായത്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖਿੱਲਰੀ ਫਾਈਲ ਪ੍ਰਬੰਧਿਤ ਕਰਨ ਲਈ ਯੋਗ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidato a organización de archivos sueltos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier isolé candidat à l'organisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandidat zur Ordnung loser Dateien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidato à organização de arquivos soltos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File sparso candidato all'organizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未整理ファイルの整理候補。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "흩어진 파일 정리 후보."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "零散文件整理候选项。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кандидат для упорядочивания разрозненных файлов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف متفرّق مرشح للتنظيم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ פזור המועמד לסידור."
          }
        }
      }
    },
    "Lower confidence for similar cleanup suggestions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower confidence for similar cleanup suggestions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समान क्लीनअप सुझावों का विश्वास स्तर कम करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একই ধরনের ক্লিনআপ পরামর্শের নির্ভরযোগ্যতা কমান।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒத்த சுத்திகரிப்புப் பரிந்துரைகளுக்கான நம்பகத்தன்மையைக் குறைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇలాంటి శుభ్రత సూచనలకు విశ్వసనీయతను తగ్గించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समान क्लीनअप सूचनांचा विश्वासार्हता स्तर कमी करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમાન ક્લીનઅપ સૂચનોનો વિશ્વસનીયતા સ્તર ઘટાડો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೋಲುವ ಸ್ವಚ್ಛತಾ ಸಲಹೆಗಳ ವಿಶ್ವಾಸಾರ್ಹತೆಯನ್ನು ಕಡಿಮೆ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സമാന വൃത്തിയാക്കൽ നിർദ്ദേശങ്ങൾക്കുള്ള വിശ്വാസ്യത കുറയ്ക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਲਦੇ-ਜੁਲਦੇ ਸਫਾਈ ਸੁਝਾਵਾਂ ਲਈ ਭਰੋਸੇਯੋਗਤਾ ਘਟਾਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir la confianza para sugerencias de limpieza similares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire la confiance pour des suggestions de nettoyage similaires."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrauen für ähnliche Bereinigungsvorschläge verringern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzir confiança para sugestões de limpeza semelhantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci l'affidabilità per suggerimenti di pulizia simili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "類似のクリーンアップ提案の信頼度を下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유사한 정리 제안의 신뢰도를 낮춥니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降低同类清理建议的置信度。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Понизить достоверность для похожих предложений очистки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خفض درجة الثقة لاقتراحات التنظيف المشابهة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפחת מהימנות עבור הצעות ניקוי דומות."
          }
        }
      }
    },
    "Manual review is still required before executing %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual review is still required before executing %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को निष्पादित करने से पहले अभी भी मैन्युअल समीक्षा आवश्यक है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ কার্যকর করার আগে এখনও ম্যানুয়াল পর্যালোচনা প্রয়োজন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐ இயக்குவதற்கு முன் கைமுறை மதிப்பாய்வு இன்னும் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ను అమలు చేసే ముందు మాన్యువల్ సమీక్ష ఇంకా అవసరం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ चालवण्यापूर्वी मॅन्युअल पुनरावलोकन अजूनही आवश्यक आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ચલાવતાં પહેલાં હજી પણ જાતે સમીક્ષા જરૂરી છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಅನ್ನು ಕಾರ್ಯಗತಗೊಳಿಸುವ ಮೊದಲು ಕೈಯಾರೆ ಪರಿಶೀಲನೆ ಇನ್ನೂ ಅಗತ್ಯವಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ പ്രവർത്തിപ്പിക്കുന്നതിന് മുമ്പ് സ്വയം അവലോകനം ഇപ്പോഴും ആവശ്യമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਚਲਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਅਜੇ ਵੀ ਖੁਦ ਸਮੀਖਿਆ ਜ਼ਰੂਰੀ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue siendo necesaria una revisión manual antes de ejecutar %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un examen manuel reste nécessaire avant d'exécuter %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Ausführung von %@ ist weiterhin eine manuelle Prüfung erforderlich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisão manual ainda é necessária antes de executar %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È comunque necessaria una revisione manuale prima di eseguire %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を実行する前に手動での確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 실행하기 전에 수동 검토가 여전히 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在执行 %@ 前仍需手动审阅。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед выполнением %@ все равно требуется ручная проверка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المراجعة اليدوية لا تزال مطلوبة قبل تنفيذ %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין נדרשת בדיקה ידנית לפני ביצוע %@."
          }
        }
      }
    },
