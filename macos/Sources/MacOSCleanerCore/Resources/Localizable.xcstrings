    "The item at %@ is not the artifact this undo record created, so it was not deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item at %@ is not the artifact this undo record created, so it was not deleted."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर मौजूद आइटम वह आर्टिफैक्ट नहीं है जिसे इस पूर्ववत रिकॉर्ड ने बनाया था, इसलिए इसे नहीं हटाया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ থাকা আইটেমটি এই পূর্বাবস্থার রেকর্ডের তৈরি আর্টিফ্যাক্ট নয়, তাই এটি মোছা হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல் உள்ள உருப்படி இந்தச் செயல்தவிர் பதிவு உருவாக்கிய உருவாக்கம் அல்ல, எனவே நீக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వద్ద ఉన్న అంశం ఈ రద్దు రికార్డు సృష్టించిన ఆర్టిఫ్యాక్ట్ కాదు, కాబట్టి అది తొలగించబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ येथील आयटम या पूर्ववत नोंदीने तयार केलेले आर्टिफॅक्ट नाही, म्हणून तो हटवला गेला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ પરની આઇટમ આ પૂર્વવત નોંધે બનાવેલ આર્ટિફૅક્ટ નથી, તેથી તેને કાઢી નાખવામાં આવી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ನಲ್ಲಿರುವ ಐಟಂ ಈ ರದ್ದು ದಾಖಲೆ ರಚಿಸಿದ ಆರ್ಟಿಫ್ಯಾಕ್ಟ್ ಅಲ್ಲ, ಆದ್ದರಿಂದ ಅದನ್ನು ಅಳಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ലുള്ള ഇനം ഈ പഴയപടിയാക്കൽ രേഖ സൃഷ്ടിച്ച ആർട്ടിഫാക്റ്റ് അല്ല, അതിനാൽ അത് ഇല്ലാതാക്കിയില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 'ਤੇ ਆਈਟਮ ਉਹ ਆਰਟੀਫੈਕਟ ਨਹੀਂ ਹੈ ਜੋ ਇਸ ਵਾਪਸੀ ਰਿਕਾਰਡ ਨੇ ਬਣਾਇਆ ਸੀ, ਇਸ ਲਈ ਇਸਨੂੰ ਮਿਟਾਇਆ ਨਹੀਂ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento en %@ no es el artefacto que creó este registro de deshacer, así que no se eliminó."
          }
