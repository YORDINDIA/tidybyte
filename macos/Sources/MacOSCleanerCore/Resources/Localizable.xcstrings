    "Refusing to stage an uninstall of the running app (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusing to stage an uninstall of the running app (%@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहे ऐप (%@) का अनइंस्टॉल तैयार करने से इनकार किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চলমান অ্যাপ (%@)-এর আনইনস্টল প্রস্তুত করতে অস্বীকার করা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயங்கும் செயலியின் (%@) நிறுவல் நீக்கத்தைத் தயார்நிலையில் வைக்க மறுக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నడుస్తున్న యాప్ (%@) యొక్క అన్‌ఇన్‌స్టాల్‌ను సిద్ధం చేయడానికి నిరాకరించబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्या सुरू असलेल्या अ‍ॅप (%@) चे अनइन्स्टॉल तयार करण्यास नकार दिला."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચાલતી ઍપ (%@) નું અનઇન્સ્ટૉલ તૈયાર કરવાનો ઇનકાર કર્યો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಾಲನೆಯಲ್ಲಿರುವ ಆ್ಯಪ್ (%@) ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಸಿದ್ಧಪಡಿಸಲು ನಿರಾಕರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രവർത്തിക്കുന്ന ആപ്പിന്റെ (%@) അൺഇൻസ്റ്റാൾ സജ്ജമാക്കുന്നത് നിരസിച്ചു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੱਲ ਰਹੇ ਐਪ (%@) ਦਾ ਅਨਇੰਸਟਾਲ ਤਿਆਰ ਕਰਨ ਤੋਂ ਇਨਕਾਰ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó preparar la desinstalación de la app en ejecución (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refus de préparer la désinstallation de l'app en cours d'exécution (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vormerkung zur Deinstallation der laufenden App (%@) verweigert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recusado preparar a desinstalação do app em execução (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifiutata la preparazione alla disinstallazione dell'app in esecuzione (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のアプリ (%@) のアンインストール追加を拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 앱(%@)의 제거 대기는 허용되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝将正在运行的应用 (%@) 加入卸载队列。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонена подготовка удаления работающего приложения (%@)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض تجهيز إلغاء تثبيت التطبيق قيد التشغيل (%@)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדחתה הכנה להסרת האפליקציה הפעילה כעת (%@)."
          }
        }
      }
    },
    "Remove to Trash or Recently Deleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove to Trash or Recently Deleted"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश या हाल ही में हटाए गए में भेजें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাশ বা সম্প্রতি মোছা-তে সরান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குப்பைத் தொட்டி அல்லது சமீபத்தில் நீக்கியவைக்கு நகர்த்து"
