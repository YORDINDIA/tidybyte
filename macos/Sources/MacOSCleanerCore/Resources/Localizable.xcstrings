          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തകർന്ന സിംബോളിക് ലിങ്ക്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟੁੱਟਿਆ ਸਿਮਬੌਲਿਕ ਲਿੰਕ।"
