        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাধাপ্রাপ্ত কাজ খারিজ করা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடைநிறுத்தப்பட்ட செயல் மூடப்பட்டது."
