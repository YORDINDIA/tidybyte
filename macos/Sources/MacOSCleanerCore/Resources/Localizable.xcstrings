    "Automatic maintenance is not enabled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic maintenance is not enabled."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित रखरखाव सक्षम नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয় রক্ষণাবেক্ষণ সক্রিয় নয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கி பராமரிப்பு இயக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వయంచాలక నిర్వహణ ప్రారంభించబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वयंचलित देखभाल सक्षम नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આપોઆપ જાળવણી સક્ષમ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಯಂಚಾಲಿತ ನಿರ್ವಹಣೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയമേവയുള്ള പരിപാലനം പ്രവർത്തനക്ഷമമാക്കിയിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਆਪ ਸਾਂਭ-ਸੰਭਾਲ ਸਮਰੱਥ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mantenimiento automático no está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La maintenance automatique n'est pas activée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatische Wartung ist nicht aktiviert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A manutenção automática não está ativada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La manutenzione automatica non è abilitata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動メンテナンスは有効になっていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 유지 관리가 활성화되어 있지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未启用自动维护。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическое обслуживание не включено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصيانة التلقائية غير مفعّلة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תחזוקה אוטומטית אינה מופעלת."
          }
        }
      }
    },
    "Automatic maintenance needs the app installed in /Applications (found %@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic maintenance needs the app installed in /Applications (found %@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित रखरखाव के लिए ऐप का /Applications में इंस्टॉल होना आवश्यक है (%@ पर मिला)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয় রক্ষণাবেক্ষণের জন্য অ্যাপটি /Applications-এ ইনস্টল থাকতে হবে (%@-এ পাওয়া গেছে)।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கி பராமரிப்பிற்கு /Applications இல் செயலி நிறுவப்பட்டிருக்க வேண்டும் (%@ இல் கண்டறியப்பட்டது)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వయంచాలక నిర్వహణ కోసం యాప్ /Applications లో ఇన్‌స్టాల్ చేయబడాలి (%@ లో కనుగొనబడింది)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वयंचलित देखभालीसाठी अ‍ॅप /Applications मध्ये इन्स्टॉल असणे आवश्यक आहे (%@ येथे आढळले)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આપોઆપ જાળવણી માટે ઍપ /Applications માં ઇન્સ્ટૉલ હોવી જરૂરી છે (%@ પર મળી)."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಯಂಚಾಲಿತ ನಿರ್ವಹಣೆಗಾಗಿ ಆ್ಯಪ್ /Applications ನಲ್ಲಿ ಸ್ಥಾಪಿತವಾಗಿರಬೇಕು (%@ ನಲ್ಲಿ ಕಂಡುಬಂದಿದೆ)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയമേവയുള്ള പരിപാലനത്തിന് ആപ്പ് /Applications-ൽ ഇൻസ്റ്റാൾ ചെയ്തിരിക്കണം (%@-ൽ കണ്ടെത്തി)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਆਪ ਸਾਂਭ-ਸੰਭਾਲ ਲਈ ਐਪ ਦਾ /Applications ਵਿੱਚ ਇੰਸਟਾਲ ਹੋਣਾ ਜ਼ਰੂਰੀ ਹੈ (%@ ਵਿੱਚ ਮਿਲਿਆ)।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mantenimiento automático requiere tener la app instalada en /Applications (encontrada en %@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La maintenance automatique exige que l'app soit installée dans /Applications (trouvée dans %@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die automatische Wartung muss die App in /Applications installiert sein (gefunden: %@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A manutenção automática exige o app instalado em /Applications (encontrado em %@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La manutenzione automatica richiede l'app installata in /Applications (trovata in %@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動メンテナンスを使用するには、アプリを /Applications にインストールする必要があります（現在地: %@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 유지 관리를 사용하려면 앱이 /Applications에 설치되어 있어야 합니다(현재 위치: %@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动维护要求将应用安装在 /Applications 中（当前位于 %@）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для автоматического обслуживания приложение должно находиться в /Applications (сейчас в %@)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب الصيانة التلقائية تثبيت التطبيق في /Applications (الموجود: %@)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תחזוקה אוטומטית דורשת שהאפליקציה תהיה מותקנת ב-/Applications (נמצאה ב-%@)."
          }
        }
      }
    },
