    "Cannot save the verified output. The original was kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot save the verified output. The original was kept."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्यापित आउटपुट सहेजा नहीं जा सका। मूल फ़ाइल सुरक्षित रखी गई।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাচাইকৃত আউটপুট সংরক্ষণ করা যায়নি। মূল ফাইলটি রাখা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்க்கப்பட்ட வெளியீட்டைச் சேமிக்க முடியவில்லை. அசல் கோப்பு வைக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ధృవీకరించబడిన అవుట్‌పుట్ సేవ్ చేయలేకపోయాము. అసలు ఫైల్ ఉంచబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पडताळलेले आउटपुट जतन करता आले नाही. मूळ फाइल ठेवली आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચકાસાયેલ આઉટપુટ સાચવી શકાયું નહીં. મૂળ ફાઇલ રાખવામાં આવી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೃಢೀಕರಿಸಿದ ಔಟ್‌ಪುಟ್ ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಮೂಲ ಫೈಲ್ ಇರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിശോധിച്ച ഔട്ട്പുട്ട് സംരക്ഷിക്കാനായില്ല. യഥാർത്ഥ ഫയൽ നിലനിർത്തി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਮਾਣਿਤ ਆਉਟਪੁੱਟ ਸੰਭਾਲਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ। ਮੂਲ ਫਾਈਲ ਰੱਖੀ ਗਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la salida verificada. Se conservó el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer la sortie vérifiée. L'original a été conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüfte Ausgabe konnte nicht gesichert werden. Das Original wurde behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a saída verificada. O original foi mantido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l'output verificato. L'originale è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みの出力を保存できませんでした。元のファイルを保持しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증된 출력 파일을 저장할 수 없습니다. 원본을 유지했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存经验证的输出文件。已保留原文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить проверенный файл. Оригинал оставлен."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ المخرجات التي تم التحقق منها. تم الاحتفاظ بالأصل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשמור את הפלט המאומת. המקור נשמר."
          }
        }
      }
    },
    "Cannot verify the new Photos asset. The original was kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
