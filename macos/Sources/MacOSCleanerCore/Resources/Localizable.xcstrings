        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಾಪಿಸಲಾದ ಇನ್ನೊಂದು ಆ್ಯಪ್‌ನಿಂದಲೂ ಬಳಸಲಾಗುತ್ತಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇൻസ്റ്റാൾ ചെയ്ത മറ്റൊരു ആപ്പും ഉപയോഗിക്കുന്നു"
          }
