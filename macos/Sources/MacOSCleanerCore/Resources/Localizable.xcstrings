        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפענח את התמונה לצורך כיווץ."
          }
        }
      }
    },
    "Cannot fold %@ onto a keeper on a different volume.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot fold %@ onto a keeper on a different volume."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी अन्य वॉल्यूम पर रखी मूल फ़ाइल के साथ %@ को समेकित नहीं किया जा सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য ভলিউমে থাকা মূল ফাইলের সাথে %@ একত্রিত করা যায় না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறு தொகுதியில் உள்ள முதன்மைக் கோப்புடன் %@ ஐ மடிக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేరే వాల్యూమ్‌లోని ఉంచే ఫైల్‌పై %@ ను ఫోల్డ్ చేయలేరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेगळ्या व्हॉल्यूमवरील मूळ फाइलवर %@ एकत्रित करता येत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અલગ વૉલ્યૂમ પરની મૂળ ફાઇલ પર %@ ને એકત્રિત કરી શકાતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೇರೆ ವಾಲ್ಯೂಮ್‌ನಲ್ಲಿರುವ ಮೂಲ ಫೈಲ್‌ಗೆ %@ ಅನ್ನು ಫೋಲ್ಡ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു വോളിയത്തിലെ പ്രധാന ഫയലിലേക്ക് %@ ഫോൾഡ് ചെയ്യാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਖਰੇ ਵਾਲੀਅਮ 'ਤੇ ਰੱਖੀ ਮੂਲ ਫਾਈਲ ਉੱਤੇ %@ ਨੂੰ ਫੋਲਡ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede plegar %@ sobre un archivo conservado en otro volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de regrouper %@ avec un original conservé sur un autre volume."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nicht mit einer Originaldatei auf einem anderen Volume zusammengeführt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível unificar %@ em um arquivo mantido em outro volume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile unire %@ su un file conservato in un altro volume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別ボリューム上の保持ファイルに対して %@ を統合できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 볼륨에 있는 유지 파일로 %@을(를) 통합할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将 %@ 折叠至位于其他宗卷上的保留文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно объединить %@ с сохраняемым файлом на другом томе."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن طيّ %@ على ملف محفوظ في وحدة تخزين أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקפל את %@ לקובץ שמור באמצעי אחסון אחר."
          }
        }
      }
    },
    "Cannot reach the target file size. The original was kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot reach the target file size. The original was kept."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य फ़ाइल आकार तक पहुँचना संभव नहीं हुआ। मूल फ़ाइल सुरक्षित रखी गई।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক্ষ্য ফাইলের আকারে পৌঁছানো যায়নি। মূল ফাইলটি রাখা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இலக்கு கோப்பு அளவை அடைய முடியவில்லை. அசல் கோப்பு வைக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లక్ష్య ఫైల్ పరిమాణాన్ని చేరుకోలేకపోయాము. అసలు ఫైల్ ఉంచబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य फाइल आकारापर्यंत पोहोचता आले नाही. मूळ फाइल ठेवली आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લક્ષ્ય ફાઇલ કદ સુધી પહોંચી શકાયું નહીં. મૂળ ફાઇલ રાખવામાં આવી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುರಿ ಫೈಲ್ ಗಾತ್ರವನ್ನು ತಲುಪಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಮೂಲ ಫೈಲ್ ಇರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലക്ഷ്യ ഫയൽ വലുപ്പത്തിൽ എത്താനായില്ല. യഥാർത്ഥ ഫയൽ നിലനിർത്തി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟੀਚੇ ਦੇ ਫਾਈਲ ਆਕਾਰ ਤੱਕ ਨਹੀਂ ਪਹੁੰਚ ਸਕਿਆ। ਮੂਲ ਫਾਈਲ ਰੱਖੀ ਗਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo alcanzar el tamaño objetivo. Se conservó el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'atteindre la taille cible. L'original a été conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieldateigröße nicht erreichbar. Das Original wurde behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atingir o tamanho de arquivo desejado. O original foi mantido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere la dimensione desiderata. L'originale è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標ファイルサイズに到達できませんでした。元のファイルを保持しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 파일 크기에 도달하지 못했습니다. 원본을 유지했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法达到目标文件大小。已保留原文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось достичь целевого размера файла. Оригинал сохранен."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الحجم المستهدف للملف. تم الاحتفاظ بالأصل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להגיע לגודל הקובץ הרצוי. המקור נשמר."
          }
        }
      }
    },
    "Cannot read %@. Choose the folder again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read %@. Choose the folder again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पढ़ा नहीं जा सका। फ़ोल्डर फिर से चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ পড়া যাচ্ছে না। ফোল্ডারটি আবার বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐப் படிக்க முடியவில்லை. கோப்புறையை மீண்டும் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ చదవలేకపోతోంది. ఫోల్డర్‌ను మళ్లీ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ वाचता येत नाही. फोल्डर पुन्हा निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ વાંચી શકાતું નથી. ફોલ્ડર ફરી પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಓದಲಾಗುತ್ತಿಲ್ಲ. ಫೋಲ್ಡರ್ ಅನ್ನು ಮತ್ತೆ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വായിക്കാനാകുന്നില്ല. ഫോൾഡർ വീണ്ടും തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਪੜ੍ਹਿਆ ਨਹੀਂ ਜਾ ਰਿਹਾ। ਫੋਲਡਰ ਦੁਬਾਰਾ ਚੁਣੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer %@. Vuelve a elegir la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire %@. Choisissez le dossier à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht gelesen werden. Ordner erneut auswählen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler %@. Escolha a pasta novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere %@. Seleziona di nuovo la cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を読み取れません。フォルダをもう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 읽을 수 없습니다. 폴더를 다시 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %@。请重新选择该文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удается прочитать %@. Выберите папку снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة %@. اختر المجلد مرة أخرى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את %@. בחרו את התיקייה שוב."
          }
        }
      }
    },
    "Cannot read the compressed image size.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot read the compressed image size."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस की गई छवि का आकार पढ़ा नहीं जा सका।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপ্রেস করা ছবির আকার পড়া যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கப்பட்ட படத்தின் அளவைப் படிக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదించిన చిత్ర పరిమాణాన్ని చదవలేకపోయాము."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस केलेल्या प्रतिमेचा आकार वाचता आला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેસ કરેલી છબીનું કદ વાંચી શકાયું નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚಿತ ಚಿತ್ರದ ಗಾತ್ರವನ್ನು ಓದಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രസ് ചെയ്ത ചിത്രത്തിന്റെ വലുപ്പം വായിക്കാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪ੍ਰੈਸ ਕੀਤੀ ਤਸਵੀਰ ਦਾ ਆਕਾਰ ਪੜ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el tamaño de la imagen comprimida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la taille de l'image compressée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe des komprimierten Bildes konnte nicht gelesen werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o tamanho da imagem comprimida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la dimensione dell'immagine compressa."
          }
        },
        "ja": {
          "stringUnit": {
