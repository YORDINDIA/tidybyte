          }
        }
      }
    },
    "These files have the same size and full content hash. Keep the newest copy and move duplicate copies to Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files have the same size and full content hash. Keep the newest copy and move duplicate copies to Trash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन फ़ाइलों का आकार और पूर्ण सामग्री हैश एक जैसा है। सबसे नई प्रति रखें और डुप्लिकेट प्रतियों को ट्रैश में भेजें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইলগুলোর আকার এবং সম্পূর্ণ হ্যাশ একই। সবচেয়ে নতুন কপি রাখুন এবং ডুপ্লিকেট কপি ট্র্যাশে পাঠান।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்புகள் ஒரே அளவும் முழு உள்ளடக்க ஹாஷும் கொண்டுள்ளன. மிகப் புதிய நகலை வைத்துக்கொண்டு நகல் கோப்புகளை குப்பைத் தொட்டிக்கு நகர்த்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫైళ్లకు ఒకే పరిమాణం మరియు పూర్తి కంటెంట్ హ్యాష్ ఉన్నాయి. అత్యంత కొత్త ప్రతిని ఉంచి, నకిలీ ప్రతులను ట్రాష్‌లోకి తరలించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फाइल्सचा आकार आणि पूर्ण सामग्री हॅश एकसारखा आहे. सर्वात नवीन प्रत ठेवा आणि डुप्लिकेट प्रती ट्रॅशमध्ये हलवा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફાઇલોનું કદ અને સંપૂર્ણ સામગ્રી હૅશ સમાન છે. સૌથી નવી નકલ રાખો અને ડુપ્લિકેટ નકલો ટ્રૅશમાં ખસેડો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೈಲ್‌ಗಳು ಒಂದೇ ಗಾತ್ರ ಮತ್ತು ಪೂರ್ಣ ವಿಷಯ ಹ್ಯಾಶ್ ಹೊಂದಿವೆ. ಅತ್ಯಂತ ಹೊಸ ಪ್ರತಿಯನ್ನು ಇರಿಸಿ ನಕಲಿ ಪ್ರತಿಗಳನ್ನು ಟ್ರ್ಯಾಶ್‌ಗೆ ಸರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫയലുകൾക്ക് ഒരേ വലുപ്പവും പൂർണ്ണ ഉള്ളടക്ക ഹാഷുമാണുള്ളത്. ഏറ്റവും പുതിയ പകർപ്പ് നിലനിർത്തി ഡ്യൂപ്ലിക്കേറ്റ് പകർപ്പുകൾ ട്രാഷിലേക്ക് മാറ്റുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹਨਾਂ ਫਾਈਲਾਂ ਦਾ ਆਕਾਰ ਅਤੇ ਪੂਰਾ ਸਮੱਗਰੀ ਹੈਸ਼ ਇੱਕੋ ਜਿਹਾ ਹੈ। ਸਭ ਤੋਂ ਨਵੀਂ ਕਾਪੀ ਰੱਖੋ ਅਤੇ ਡੁਪਲੀਕੇਟ ਕਾਪੀਆਂ ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos archivos tienen el mismo tamaño y hash de contenido completo. Conserva la copia más reciente y mueve los duplicados al Basurero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fichiers ont la même taille et la même empreinte complète de contenu. Conservez la copie la plus récente et placez les doublons dans la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien haben die gleiche Größe und denselben vollständigen Inhalts-Hash. Behalte die neueste Kopie und bewege Duplikate in den Papierkorb."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses arquivos têm o mesmo tamanho e hash completo de conteúdo. Mantenha a cópia mais recente e mova as duplicatas para o Lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi file hanno la stessa dimensione e lo stesso hash completo del contenuto. Conserva la copia più recente e sposta i duplicati nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズと完全なハッシュが一致するファイルです。最新のコピーを残し、重複ファイルをゴミ箱に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기와 전체 콘텐츠 해시가 동일한 파일입니다. 최신 사본을 유지하고 중복 파일은 휴지통으로 이동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件大小和完整内容哈希完全一致。将保留最新副本并将重复文件移至废纸篓。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этих файлов совпадают размер и полный хеш содержимого. Сохраните новейшую копию и переместите дубликаты в Корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه الملفات لها نفس الحجم وبصمة المحتوى الكاملة. أبقِ أحدث نسخة وانقل النسخ المكررة إلى سلة المهملات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לקבצים אלה גודל וגיבוב תוכן זהה לחלוטין. שמרו את העותק החדש ביותר והעבירו עותקים כפולים לפח."
          }
        }
      }
    },
    "These images look very similar but are not byte-identical. Verify before trashing; keep the newest.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These images look very similar but are not byte-identical. Verify before trashing; keep the newest."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये इमेज बहुत समान दिखती हैं लेकिन बाइट-दर-बाइट एक जैसी नहीं हैं। ट्रैश में भेजने से पहले जाँच लें; सबसे नई प्रति रखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ছবিগুলো দেখতে খুব কাছাকাছি কিন্তু বাইট-অনুযায়ী এক নয়। ট্র্যাশে পাঠানোর আগে যাচাই করুন; সবচেয়ে নতুনটি রাখুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்படங்கள் பார்ப்பதற்கு ஒரே மாதிரியாக இருந்தாலும் பைட் அளவில் ஒன்றல்ல. குப்பைத் தொட்டிக்கு அனுப்பும் முன் சரிபார்க்கவும்; மிகப் புதியதை வைத்திருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ చిత్రాలు చూడటానికి చాలా ఒకేలా ఉన్నాయి కానీ బైట్-ప్రకారం ఒకేలా లేవు. ట్రాష్‌లో వేసే ముందు ధృవీకరించండి; అత్యంత కొత్తది ఉంచండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या प्रतिमा दिसायला खूप सारख्या आहेत परंतु बाइट-निहाय एकसारख्या नाहीत. ट्रॅशमध्ये हलवण्यापूर्वी तपासा; सर्वात नवीन ठेवा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ છબીઓ દેખાવમાં ઘણી સમાન છે પણ બાઇટ-દર-બાઇટ સમાન નથી. ટ્રૅશમાં મોકલતાં પહેલાં ચકાસો; સૌથી નવી રાખો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಚಿತ್ರಗಳು ನೋಡಲು ಬಹಳ ಹೋಲುತ್ತವೆ ಆದರೆ ಬೈಟ್-ಪ್ರಕಾರ ಒಂದೇ ಅಲ್ಲ. ಟ್ರ್ಯಾಶ್ ಮಾಡುವ ಮೊದಲು ದೃಢೀಕರಿಸಿ; ಅತ್ಯಂತ ಹೊಸದನ್ನು ಇರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ചിത്രങ്ങൾ കാഴ്ചയിൽ വളരെ സാമ്യമുള്ളവയാണ്, പക്ഷേ ബൈറ്റ്-പ്രകാരം ഒരേപോലെയല്ല. ട്രാഷിലേക്ക് മാറ്റുന്നതിന് മുമ്പ് പരിശോധിക്കുക; ഏറ്റവും പുതിയത് നിലനിർത്തുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਤਸਵੀਰਾਂ ਬਹੁਤ ਮਿਲਦੀਆਂ-ਜੁਲਦੀਆਂ ਹਨ ਪਰ ਬਾਈਟ-ਦਰ-ਬਾਈਟ ਇੱਕੋ ਜਿਹੀਆਂ ਨਹੀਂ। ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜਣ ਤੋਂ ਪਹਿਲਾਂ ਜਾਂਚੋ; ਸਭ ਤੋਂ ਨਵੀਂ ਰੱਖੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas imágenes se parecen mucho, pero no son idénticas byte a byte. Verifícalas antes de moverlas al Basurero; conserva la más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces images se ressemblent beaucoup mais ne sont pas identiques octet par octet. Vérifiez avant de mettre à la Corbeille ; conservez la plus récente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bilder sehen sich sehr ähnlich, sind aber nicht byte-identisch. Vor dem Verschieben in den Papierkorb prüfen; das neueste behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas imagens são muito parecidas, mas não idênticas byte a byte. Verifique antes de mover para o Lixo; mantenha a mais recente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste immagini sono molto simili, ma non identiche byte per byte. Verifica prima di spostare nel Cestino; conserva la più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非常に似ていますがバイト単位で同一ではありません。最新の 1 枚を残し、ゴミ箱へ移動する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매우 비슷해 보이지만 바이트 단위로 동일하지는 않습니다. 휴지통으로 이동하기 전에 확인하고 가장 최신 이미지를 유지하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些图像外观极为相似但字节并不完全相同。移至废纸篓前请核实；默认保留最新的一张。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти изображения очень похожи, но не совпадают побайтово. Проверьте перед удалением; сохраните новейшее."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدو هذه الصور متشابهة جدًا لكنها ليست متطابقة بالبايت. تحقق منها قبل النقل إلى سلة المهملات؛ أبقِ الأحدث."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות אלה נראות דומות מאוד אך אינן זהות ברמת הבית. ודאו לפני העברה לפח; החדשה ביותר נשמרת."
          }
        }
      }
    },
    "These items match only by developer team or need administrator rights. Check them in Finder before you remove them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items match only by developer team or need administrator rights. Check them in Finder before you remove them."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये आइटम केवल डेवलपर टीम से मेल खाते हैं या इन्हें हटाने के लिए व्यवस्थापक अधिकार आवश्यक हैं। हटाने से पहले Finder में इनकी जाँच करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আইটেমগুলো কেবল ডেভেলপার টিমের মাধ্যমে মিলেছে বা সরানোর জন্য অ্যাডমিনিস্ট্রেটর অধিকার প্রয়োজন। সরানোর আগে Finder-এ পরীক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இவ்வுருப்படிகள் டெவலப்பர் குழுவால் மட்டுமே பொருந்துகின்றன அல்லது நிர்வாகி உரிமைகள் தேவை. அகற்றுவதற்கு முன் Finder இல் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అంశాలు డెవలపర్ బృందం ద్వారా మాత్రమే సరిపోతాయి లేదా తొలగించడానికి అడ్మినిస్ట్రేటర్ హక్కులు అవసరం. తీసివేసే ముందు Finder లో తనిఖీ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे आयटम केवळ डेव्हलपर टीमशी जुळतात किंवा काढण्यासाठी प्रशासक अधिकार लागतात. काढण्यापूर्वी Finder मध्ये तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ આઇટમ્સ માત્ર ડેવલપર ટીમથી મેળ ખાય છે અથવા દૂર કરવા એડમિનિસ્ટ્રેટર અધિકાર જરૂરી છે. દૂર કરતાં પહેલાં Finder માં તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಐಟಂಗಳು ಡೆವಲಪರ್ ತಂಡದಿಂದ ಮಾತ್ರ ಹೊಂದಾಣಿಕೆಯಾಗುತ್ತವೆ ಅಥವಾ ತೆಗೆಯಲು ನಿರ್ವಾಹಕ ಹಕ್ಕುಗಳು ಬೇಕು. ತೆಗೆದುಹಾಕುವ ಮೊದಲು Finder ನಲ್ಲಿ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഇനങ്ങൾ ഡെവലപ്പർ ടീം പ്രകാരം മാത്രമേ പൊരുത്തപ്പെടുന്നുള്ളൂ അല്ലെങ്കിൽ നീക്കം ചെയ്യാൻ അഡ്മിനിസ്ട്രേറ്റർ അവകാശങ്ങൾ ആവശ്യമാണ്. നീക്കം ചെയ്യുന്നതിന് മുമ്പ് Finder-ൽ പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਆਈਟਮਾਂ ਕੇਵਲ ਡਿਵੈਲਪਰ ਟੀਮ ਨਾਲ ਮੇਲ ਖਾਂਦੀਆਂ ਹਨ ਜਾਂ ਹਟਾਉਣ ਲਈ ਪ੍ਰਸ਼ਾਸਕ ਅਧਿਕਾਰ ਚਾਹੀਦੇ ਹਨ। ਹਟਾਉਣ ਤੋਂ ਪਹਿਲਾਂ Finder ਵਿੱਚ ਜਾਂਚੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos elementos coinciden solo por equipo de desarrollo o requieren permisos de administrador. Revísalos en Finder antes de eliminarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments ne correspondent que par équipe de développement ou exigent des droits d'administrateur. Vérifiez-les dans le Finder avant de les supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Objekte stimmen nur über das Entwicklerteam überein oder erfordern Administratorrechte. Prüfe sie im Finder, bevor du sie entfernst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses itens coincidem apenas por equipe de desenvolvimento ou exigem privilégios de administrador. Verifique no Finder antes de remover."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi elementi corrispondono solo per team di sviluppo o richiedono privilegi da amministratore. Controllali nel Finder prima di rimuoverli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発チームのみで一致したか、削除に管理者権限が必要な項目です。削除前に Finder で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자 팀만 일치하거나 관리자 권한이 필요한 항목입니다. 제거하기 전에 Finder에서 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些项目仅通过开发团队匹配或需要管理员权限。移除前请在 Finder 中确认。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти объекты совпадают только по команде разработчиков или требуют прав администратора. Проверьте их в Finder перед удалением."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطابق هذه العناصر فقط عبر فريق التطوير أو تحتاج لصلاحيات المسؤول. تحقق منها في Finder قبل إزالتها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריטים אלה מתאימים רק לפי צוות פיתוח או דורשים הרשאות מנהל. בדקו ב-Finder לפני ההסרה."
          }
        }
      }
    },
    "This Application Support folder does not clearly match an installed app. Review carefully before moving it to Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Application Support folder does not clearly match an installed app. Review carefully before moving it to Trash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Application Support फ़ोल्डर किसी इंस्टॉल किए गए ऐप से स्पष्ट रूप से मेल नहीं खाता। ट्रैश में भेजने से पहले सावधानी से समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Application Support ফোল্ডারটি কোনো ইনস্টল করা অ্যাপের সাথে স্পষ্টভাবে মেলে না। ট্র্যাশে পাঠানোর আগে সাবধানে পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Application Support கோப்புறை நிறுவப்பட்ட செயலியுடன் தெளிவாகப் பொருந்தவில்லை. குப்பைத் தொட்டிக்கு நகர்த்தும் முன் கவனமாக மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Application Support ఫోల్డర్ ఇన్‌స్టాల్ చేసిన యాప్‌తో స్పష్టంగా సరిపోలడం లేదు. ట్రాష్‌లోకి తరలించే ముందు జాగ్రత్తగా సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे Application Support फोल्डर इन्स्टॉल केलेल्या अ‍ॅपशी स्पष्टपणे जुळत नाही. ट्रॅशमध्ये हलवण्यापूर्वी काळजीपूर्वक पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Application Support ફોલ્ડર કોઈ ઇન્સ્ટૉલ કરેલી ઍપ સાથે સ્પષ્ટ મેળ ખાતું નથી. ટ્રૅશમાં ખસેડતાં પહેલાં કાળજીપૂર્વક સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Application Support ಫೋಲ್ಡರ್ ಸ್ಥಾಪಿಸಲಾದ ಆ್ಯಪ್‌ಗೆ ಸ್ಪಷ್ಟವಾಗಿ ಹೊಂದಿಕೆಯಾಗುತ್ತಿಲ್ಲ. ಟ್ರ್ಯಾಶ್‌ಗೆ ಸರಿಸುವ ಮೊದಲು ಎಚ್ಚರಿಕೆಯಿಂದ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Application Support ഫോൾഡർ ഇൻസ്റ്റാൾ ചെയ്ത ആപ്പുമായി വ്യക്തമായി പൊരുത്തപ്പെടുന്നില്ല. ട്രാഷിലേക്ക് മാറ്റുന്നതിന് മുമ്പ് ശ്രദ്ധാപൂർവ്വം അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ Application Support ਫੋਲਡਰ ਕਿਸੇ ਇੰਸਟਾਲ ਐਪ ਨਾਲ ਸਪਸ਼ਟ ਮੇਲ ਨਹੀਂ ਖਾਂਦਾ। ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜਣ ਤੋਂ ਪਹਿਲਾਂ ਧਿਆਨ ਨਾਲ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta de Application Support no coincide claramente con ninguna app instalada. Revísala con cuidado antes de moverla al Basurero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier Application Support ne correspond pas clairement à une app installée. Vérifiez soigneusement avant de le placer dans la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Application-Support-Ordner gehört nicht eindeutig zu einer installierten App. Vor dem Verschieben in den Papierkorb sorgfältig prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta Application Support não corresponde claramente a nenhum app instalado. Revise com cuidado antes de mover para o Lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella Application Support non corrisponde chiaramente a un'app installata. Controllala bene prima di spostarla nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Application Support フォルダはインストール済みアプリとの明確な一致がありません。ゴミ箱に移動する前に慎重に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Application Support 폴더는 설치된 앱과 명확히 일치하지 않습니다. 휴지통으로 이동하기 전에 주의 깊게 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Application Support 文件夹未明确匹配任何已安装应用。移至废纸篓前请仔细检查。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка Application Support не соотносится явно ни с одним установленным приложением. Тщательно проверьте перед перемещением в Корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يطابق مجلد Application Support هذا بوضوح أي تطبيق مثبّت. راجعه بعناية قبل نقله إلى سلة المهملات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקיית Application Support זו אינה תואמת בבירור לאפליקציה מותקנת. בדקו היטב לפני ההעברה לפח."
          }
        }
      }
    },
    "This Photos item is not available for changes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Photos item is not available for changes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोटो आइटम बदलावों के लिए उपलब्ध नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটো আইটেমটি পরিবর্তনের জন্য উপলব্ধ নয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்பட உருப்படி மாற்றங்களுக்குக் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటో అంశం మార్పులకు అందుబాటులో లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो आयटम बदलांसाठी उपलब्ध नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો આઇટમ ફેરફારો માટે ઉપલબ્ધ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋ ಐಟಂ ಬದಲಾವಣೆಗಳಿಗೆ ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ ഇനം മാറ്റങ്ങൾക്ക് ലഭ്യമല്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫੋਟੋ ਆਈਟਮ ਬਦਲਾਵਾਂ ਲਈ ਉਪਲਬਧ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento de Fotos no está disponible para cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément Photos ne peut pas être modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Fotos-Objekt steht für Änderungen nicht zur Verfügung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item do Fotos não está disponível para alterações."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento di Foto non è modificabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この「写真」項目は変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진 항목은 변경할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改此“照片”项目。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот объект «Фото» недоступен для изменений."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنصر الصور هذا غير متاح للتعديل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריט תמונות זה אינו זמין לשינויים."
          }
        }
      }
    },
    "This action type is not supported by the executor: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action type is not supported by the executor: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निष्पादक द्वारा यह क्रिया प्रकार समर्थित नहीं है: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাহক দ্বারা এই কাজের ধরন সমর্থিত নয়: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் செயல் வகை செயல்படுத்தியால் ஆதரிக்கப்படவில்லை: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ చర్య రకం ఎగ్జిక్యూటర్ ద్వారా మద్దతు ఇవ్వబడదు: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा क्रिया प्रकार अंमलबजावणीकर्त्याद्वारे समर्थित नाही: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ક્રિયા પ્રકાર એક્ઝિક્યુટર દ્વારા સમર્થિત નથી: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಕ್ರಿಯೆಯ ಪ್ರಕಾರವು ಕಾರ್ಯಗತಗೊಳಿಸುವವರಿಂದ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്രവൃത്തി തരം എക്സിക്യൂട്ടർ പിന്തുണയ്ക്കുന്നില്ല: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਕਾਰਵਾਈ ਕਿਸਮ ਐਗਜ਼ੀਕਿਊਟਰ ਦੁਆਰਾ ਸਮਰਥਿਤ ਨਹੀਂ ਹੈ: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tipo de acción no es compatible con el ejecutor: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce type d'action n'est pas pris en charge par l'exécuteur : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Aktionstyp wird von der Ausführung nicht unterstützt: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tipo de ação não é suportado pelo executor: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo tipo di azione non è supportato dall'esecutore: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクション種別はエグゼキュータでサポートされていません: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행기가 이 작업 유형을 지원하지 않습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行器不支持此操作类型：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот тип действия не поддерживается исполнителем: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نوع الإجراء هذا غير مدعوم من المنفّذ: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוג פעולה זה אינו נתמך על ידי המבצע: %@"
          }
        }
      }
    },
    "This asset is not downloaded. Download it in Photos first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This asset is not downloaded. Download it in Photos first."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आइटम डाउनलोड नहीं है। पहले इसे फ़ोटो ऐप में डाउनलोड करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আইটেমটি ডাউনলোড করা নেই। প্রথমে ফটো অ্যাপে এটি ডাউনলোড করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உருப்படி பதிவிறக்கப்படவில்லை. முதலில் புகைப்படங்களில் பதிவிறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అంశం డౌన్‌లోడ్ చేయబడలేదు. ముందుగా ఫోటోలలో డౌన్‌లోడ్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा आयटम डाउनलोड केलेला नाही. प्रथम फोटोमध्ये तो डाउनलोड करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ આઇટમ ડાઉનલોડ થયેલ નથી. પહેલાં ફોટોમાં ડાઉનલોડ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಐಟಂ ಡೌನ್‌ಲೋಡ್ ಆಗಿಲ್ಲ. ಮೊದಲು ಫೋಟೋಗಳಲ್ಲಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഇനം ഡൗൺലോഡ് ചെയ്തിട്ടില്ല. ആദ്യം ഫോട്ടോസിൽ ഡൗൺലോഡ് ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਆਈਟਮ ਡਾਊਨਲੋਡ ਨਹੀਂ ਹੋਈ। ਪਹਿਲਾਂ ਫੋਟੋ ਵਿੱਚ ਡਾਊਨਲੋਡ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recurso no está descargado. Descárgalo primero en Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément n'est pas téléchargé. Téléchargez-le d'abord dans Photos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt ist nicht geladen. Lade es zuerst in Fotos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item não está baixado. Baixe-o primeiro no Fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento non è scaricato. Scaricalo prima in Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はダウンロードされていません。先に「写真」アプリでダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목이 다운로드되지 않았습니다. 먼저 사진 앱에서 다운로드하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目尚未下载。请先在“照片”中下载。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот объект не загружен. Сначала загрузите его в приложении «Фото»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنزّل هذا العنصر. نزّله في تطبيق الصور أولًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריט זה לא הורד. הורידו אותו תחילה באפליקציית תמונות."
          }
        }
      }
    },
    "This file does not support compression.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file does not support compression."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल संपीड़न का समर्थन नहीं करती।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফাইল কমপ্রেশন সমর্থন করে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்பு சுருக்கத்தை ஆதரிக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫైల్ కుదింపుకు మద్దతు ఇవ్వదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही फाइल कंप्रेशनला समर्थन देत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફાઇલ કોમ્પ્રેશનને સમર્થન આપતી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೈಲ್ ಸಂಕುಚನೆಯನ್ನು ಬೆಂಬಲಿಸುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫയൽ കംപ്രഷനെ പിന്തുണയ്ക്കുന്നില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫਾਈਲ ਕੰਪ੍ਰੈਸ਼ਨ ਦਾ ਸਮਰਥਨ ਨਹੀਂ ਕਰਦੀ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no admite compresión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne prend pas en charge la compression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei unterstützt keine Komprimierung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não suporta compressão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non supporta la compressione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは圧縮に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 압축을 지원하지 않습니다."
