    "The export changed aspect ratio or increased dimensions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export changed aspect ratio or increased dimensions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात से आस्पेक्ट रेशियो बदल गया या आयाम बढ़ गए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্টে অনুপাত পরিবর্তিত হয়েছে বা মাত্রা বেড়ে গেছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்றுமதி தோற்ற விகிதத்தை மாற்றியது அல்லது அளவுகளை அதிகரித்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎగుమతి కారక నిష్పత్తిని మార్చింది లేదా కొలతలను పెంచింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यातीमुळे गुणोत्तर बदलले किंवा आकारमान वाढले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિકાસમાં આસ્પેક્ટ રેશિયો બદલાયો અથવા પરિમાણ વધી ગયા."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಫ್ತು ಆಕಾರ ಅನುಪಾತವನ್ನು ಬದಲಾಯಿಸಿದೆ ಅಥವಾ ಆಯಾಮಗಳನ್ನು ಹೆಚ್ಚಿಸಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എക്സ്പോർട്ട് ആസ്പെക്റ്റ് റേഷ്യോ മാറ്റി അല്ലെങ്കിൽ അളവുകൾ വർദ്ധിപ്പിച്ചു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿਰਯਾਤ ਨੇ ਅਨੁਪਾਤ ਬਦਲਿਆ ਜਾਂ ਆਯਾਮ ਵਧਾ ਦਿੱਤੇ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación cambió la relación de aspecto o aumentó las dimensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'export a modifié les proportions ou augmenté les dimensions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Export hat das Seitenverhältnis geändert oder die Abmessungen vergrößert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação alterou a proporção ou aumentou as dimensões."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esportazione ha modificato le proporzioni o aumentato le dimensioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しによって縦横比が変化したか、サイズが大きくなりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기 결과 화면 비율이 달라졌거나 크기가 커졌습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出改变了宽高比或增大了尺寸。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При экспорте изменились пропорции или увеличилось разрешение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر التصدير نسبة العرض إلى الارتفاع أو زاد الأبعاد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא שינה את יחס הגובה-רוחב או הגדיל את הממדים."
          }
        }
      }
    },
    "The exported audio could not be decoded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exported audio could not be decoded."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यातित ऑडियो डीकोड नहीं हो सका।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট করা অডিও ডিকোড করা যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்றுமதி செய்யப்பட்ட ஒலியை டிகோட் செய்ய முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎగుమతి చేసిన ఆడియో డీకోడ్ చేయలేకపోయాము."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात केलेला ऑडिओ डीकोड करता आला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિકાસ કરેલ ઑડિયો ડીકોડ કરી શકાયો નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಫ್ತು ಮಾಡಿದ ಆಡಿಯೋ ಡಿಕೋಡ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എക്സ്പോർട്ട് ചെയ്ത ഓഡിയോ ഡീകോഡ് ചെയ്യാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿਰਯਾਤ ਕੀਤਾ ਆਡੀਓ ਡੀਕੋਡ ਨਹੀਂ ਹੋ ਸਕਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo decodificar el audio exportado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio exporté n'a pas pu être décodé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das exportierte Audio konnte nicht dekodiert werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio exportado não pôde ser decodificado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile decodificare l'audio esportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したオーディオをデコードできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 오디오를 디코딩할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解码导出的音频。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось декодировать экспортированное аудио."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فك ترميز الصوت المصدّر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לפענח את השמע שיוצא."
          }
        }
      }
    },
