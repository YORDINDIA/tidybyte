        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम अब ट्रैश में नहीं है और इसे पुनर्स्थापित नहीं किया जा सकता: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইটেমটি আর ট্র্যাশে নেই এবং পুনরুদ্ধার করা যাবে না: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உருப்படி இப்போது குப்பைத் தொட்டியில் இல்லை, மீட்டெடுக்க முடியாது: %@"
