    "Never repeat similar cleanup without manual review. Regret reason: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never repeat similar cleanup without manual review. Regret reason: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैन्युअल समीक्षा के बिना समान क्लीनअप दोबारा न दोहराएँ। कारण: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যানুয়াল পর্যালোচনা ছাড়া একই ধরনের ক্লিনআপ পুনরায় করবেন না। কারণ: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைமுறை மதிப்பாய்வின்றி இதே போன்ற சுத்திகரிப்பை மீண்டும் செய்யாதே. காரணம்: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాన్యువల్ సమీక్ష లేకుండా ఇలాంటి శుభ్రతను మళ్లీ చేయవద్దు. కారణం: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मॅन्युअल पुनरावलोकनाशिवाय असाच क्लीनअप पुन्हा करू नका. कारण: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જાતે સમીક્ષા કર્યા વિના આવા ક્લીનઅપનું પુનરાવર્તન ન કરો. કારણ: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೈಯಾರೆ ಪರಿಶೀಲನೆಯಿಲ್ಲದೆ ಇಂತಹ ಸ್ವಚ್ಛತೆಯನ್ನು ಪುನರಾವರ್ತಿಸಬೇಡಿ. ಕಾರಣ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയം അവലോകനം ചെയ്യാതെ സമാന വൃത്തിയാക്കൽ ആവർത്തിക്കരുത്. കാരണം: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖੁਦ ਸਮੀਖਿਆ ਕੀਤੇ ਬਿਨਾਂ ਅਜਿਹੀ ਸਫਾਈ ਦੁਬਾਰਾ ਨਾ ਕਰੋ। ਕਾਰਨ: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No repetir una limpieza similar sin revisión manual. Motivo del cambio: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais répéter un nettoyage similaire sans examen manuel. Motif : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Bereinigung nie ohne manuelle Prüfung wiederholen. Grund: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca repetir limpeza semelhante sem revisão manual. Motivo: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ripetere pulizie simili senza revisione manuale. Motivo: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動確認なしに同様のクリーンアップを繰り返しません。理由: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 검토 없이 유사한 정리를 반복하지 않습니다. 사유: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经手动审阅不再重复类似清理。撤回原因：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не повторять подобную очистку без ручной проверки. Причина: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تكرر تنظيفًا مشابهًا دون مراجعة يدوية. السبب: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעולם לא לחזור על ניקוי דומה ללא בדיקה ידנית. סיבה: %@"
          }
        }
      }
    },
    "Never suggest %@ in %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never suggest %@ in %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ में कभी भी %1$@ का सुझाव न दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এ কখনো %1$@ প্রস্তাব করবেন না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ இல் %1$@ ஐ ஒருபோதும் பரிந்துரைக்காதே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ లో %1$@ ను ఎప్పుడూ సూచించవద్దు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ मध्ये कधीही %1$@ सुचवू नका."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ માં ક્યારેય %1$@ સૂચવશો નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ನಲ್ಲಿ %1$@ ಅನ್ನು ಎಂದಿಗೂ ಸೂಚಿಸಬೇಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-ൽ ഒരിക്കലും %1$@ നിർദ്ദേശിക്കരുത്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ਵਿੱਚ ਕਦੇ ਵੀ %1$@ ਦਾ ਸੁਝਾਅ ਨਾ ਦਿਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No volver a sugerir %@ en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais proposer %@ dans %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in %@ nie mehr vorschlagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca sugerir %@ em %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non suggerire mai %@ in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ では %1$@ を今後提案しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에서 %1$@을(를) 다시 제안하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再在 %2$@ 中建议 %1$@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не предлагать %@ в %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تقترح %@ في %@ أبدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעולם לא להציע %@ ב-%@."
          }
        }
      }
    },
