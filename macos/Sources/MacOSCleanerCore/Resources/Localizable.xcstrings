    "The AI endpoint must use HTTPS (or HTTP on localhost): %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI endpoint must use HTTPS (or HTTP on localhost): %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI एंडपॉइंट को HTTPS (या localhost पर HTTP) का उपयोग करना आवश्यक है: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AI এন্ডপয়েন্ট অবশ্যই HTTPS (অথবা localhost-এ HTTP) ব্যবহার করবে: %@"
