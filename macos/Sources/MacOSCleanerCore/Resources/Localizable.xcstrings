    "%@ was skipped: it is a protected or system location, so it was not scanned.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was skipped: it is a protected or system location, so it was not scanned."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को छोड़ दिया गया: यह एक सुरक्षित या सिस्टम स्थान है, इसलिए इसे स्कैन नहीं किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ বাদ দেওয়া হয়েছে: এটি একটি সুরক্ষিত বা সিস্টেম স্থান, তাই স্ক্যান করা হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ தவிர்க்கப்பட்டது: இது பாதுகாக்கப்பட்ட அல்லது கணினி இடமாகும், எனவே ஸ்கேன் செய்யப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ దాటవేయబడింది: ఇది రక్షిత లేదా సిస్టమ్ స్థానం కనుక స్కాన్ చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ वगळले गेले: हे सुरक्षित किंवा सिस्टम ठिकाण असल्याने स्कॅन केले गेले नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ છોડી દીધું: તે સુરક્ષિત અથવા સિસ્ટમ સ્થાન હોવાથી સ્કૅન થયું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ: ಇದು ರಕ್ಷಿತ ಅಥವಾ ಸಿಸ್ಟಮ್ ಸ್ಥಳವಾಗಿರುವುದರಿಂದ ಸ್ಕ್ಯಾನ್ ಮಾಡಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഒഴിവാക്കി: ഇതൊരു സംരക്ഷിത അല്ലെങ്കിൽ സിസ്റ്റം സ്ഥലമായതിനാൽ സ്കാൻ ചെയ്തില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਛੱਡਿਆ ਗਿਆ: ਇਹ ਸੁਰੱਖਿਅਤ ਜਾਂ ਸਿਸਟਮ ਟਿਕਾਣਾ ਹੈ, ਇਸ ਲਈ ਸਕੈਨ ਨਹੀਂ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitió %@: es una ubicación protegida o del sistema, por lo que no se analizó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été ignoré : il s'agit d'un emplacement protégé ou système, il n'a donc pas été analysé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde übersprungen: Es handelt sich um einen geschützten oder Systemordner."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi ignorado: é um local protegido ou do sistema, portanto não foi analisado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ignorato: è una posizione protetta o di sistema, quindi non è stata analizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はスキップされました: 保護された場所またはシステムの場所であるためスキャンされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 건너뜀: 보호된 위치이거나 시스템 위치이므로 스캔하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过 %@：这是受保护位置或系统位置，因此未进行扫描。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ пропущено: это защищенное или системное расположение, поэтому сканирование не выполнялось."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي %@: إنه موقع محمي أو موقع نظام، لذا لم يُفحص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ דולג: זהו מיקום מוגן או מיקום מערכת, ולכן לא נסרק."
          }
        }
      }
    },
