        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنصر في %@ ليس الأثر الذي أنشأه سجل التراجع هذا، لذا لم يُحذف."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריט ב-%@ אינו התוצר שיצרה רשומת ביטול זו, ולכן לא נמחק."
          }
        }
      }
    },
    "The item in Trash at %@ is not the file this undo record trashed, so it was not restored.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item in Trash at %@ is not the file this undo record trashed, so it was not restored."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश में %@ पर मौजूद आइटम वह फ़ाइल नहीं है जिसे इस पूर्ववत रिकॉर्ड ने ट्रैश किया था, इसलिए इसे पुनर्स्थापित नहीं किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাশে %@-এ থাকা আইটেমটি এই পূর্বাবস্থার রেকর্ডে মোছা ফাইল নয়, তাই এটি পুনরুদ্ধার করা হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குப்பைத் தொட்டியில் %@ இல் உள்ள உருப்படி இந்தச் செயல்தவிர் பதிவு நீக்கிய கோப்பு அல்ல, எனவே மீட்டெடுக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాష్‌లో %@ వద్ద ఉన్న అంశం ఈ రద్దు రికార్డు ట్రాష్ చేసిన ఫైల్ కాదు, కాబట్టి అది పునరుద్ధరించబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रॅशमधील %@ येथील आयटम या पूर्ववत नोंदीने ट्रॅश केलेली फाइल नाही, म्हणून ती पुनर्संचयित केली गेली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રૅશમાં %@ પરની આઇટમ આ પૂર્વવત નોંધે ટ્રૅશ કરેલી ફાઇલ નથી, તેથી તેને પુનઃસ્થાપિત કરવામાં આવી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರ್ಯಾಶ್‌ನಲ್ಲಿ %@ ನಲ್ಲಿರುವ ಐಟಂ ಈ ರದ್ದು ದಾಖಲೆ ಟ್ರ್ಯಾಶ್ ಮಾಡಿದ ಫೈಲ್ ಅಲ್ಲ, ಆದ್ದರಿಂದ ಅದನ್ನು ಮರುಸ್ಥಾಪಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രാഷിൽ %@-ലുള്ള ഇനം ഈ പഴയപടിയാക്കൽ രേഖ ട്രാഷ് ചെയ്ത ഫയലല്ല, അതിനാൽ അത് പുനഃസ്ഥാപിച്ചില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਰੈਸ਼ ਵਿੱਚ %@ 'ਤੇ ਆਈਟਮ ਉਹ ਫਾਈਲ ਨਹੀਂ ਹੈ ਜੋ ਇਸ ਵਾਪਸੀ ਰਿਕਾਰਡ ਨੇ ਟਰੈਸ਼ ਕੀਤੀ ਸੀ, ਇਸ ਲਈ ਇਸਨੂੰ ਬਹਾਲ ਨਹੀਂ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento en el Basurero en %@ no es el archivo que movió este registro de deshacer, así que no se restauró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément dans la Corbeille à %@ n'est pas le fichier supprimé par cet enregistrement ; il n'a donc pas été restauré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objekt im Papierkorb unter %@ ist nicht die durch diesen Eintrag gelöschte Datei und wurde nicht wiederhergestellt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item no Lixo em %@ não é o arquivo movido por este registro, portanto não foi restaurado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elemento nel Cestino in %@ non è il file spostato da questo record, quindi non è stato ripristinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱内 %@ の項目は、この取り消し記録で削除されたファイルではないため復元されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통의 %@ 항목은 이 실행 취소 기록이 삭제한 파일이 아니므로 복원되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓中 %@ 处的项目并非该撤销记录移入废纸篓的文件，因此未执行还原。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объект в Корзине %@ не является файлом, удаленным этой записью, поэтому восстановление отменено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنصر في سلة المهملات عند %@ ليس الملف الذي نقله سجل التراجع هذا، لذا لم يُستعد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריט בפח ב-%@ אינו הקובץ שהועבר על ידי רשומת ביטול זו, ולכן לא שוחזר."
          }
        }
      }
    },
    "The item is a symbolic link and was not tagged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item is a symbolic link and was not tagged."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आइटम एक सिम्बॉलिक लिंक है और इसे टैग नहीं किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইটেমটি একটি সিম্বলিক লিংক এবং ট্যাগ করা হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உருப்படி குறியீட்டு இணைப்பாகும், குறிச்சொல் இடப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అంశం సింబాలిక్ లింక్ మరియు ట్యాగ్ చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा आयटम सिम्बॉलिक लिंक आहे आणि टॅग केला गेला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ આઇટમ સિમ્બૉલિક લિંક છે અને તેને ટૅગ કરવામાં આવી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಐಟಂ ಸಿಂಬಾಲಿಕ್ ಲಿಂಕ್ ಆಗಿದೆ ಮತ್ತು ಟ್ಯಾಗ್ ಮಾಡಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഇനം ഒരു സിംബോളിക് ലിങ്കാണ്, ടാഗ് ചെയ്തിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਆਈਟਮ ਸਿਮਬੌਲਿਕ ਲਿੰਕ ਹੈ ਅਤੇ ਇਸਨੂੰ ਟੈਗ ਨਹੀਂ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento es un enlace simbólico y no se etiquetó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément est un lien symbolique et n'a pas été tagué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objekt ist ein symbolischer Link und wurde nicht getaggt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item é um link simbólico e não foi etiquetado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elemento è un collegamento simbolico e non è stato etichettato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はシンボリックリンクのためタグ付けされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 심볼릭 링크이므로 태그가 지정되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该项目为符号链接，未添加标签。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объект является символьной ссылкой и не был помечен тегом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العنصر رابط رمزي ولم يُوسَم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריט הוא קישור סימבולי ולכן לא תויג."
          }
        }
      }
    },
    "The item is no longer in Trash and cannot be restored: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item is no longer in Trash and cannot be restored: %@"
