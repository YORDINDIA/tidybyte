    "This symbolic link points to %@, which does not exist. Inspect before removing manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This symbolic link points to %@, which does not exist. Inspect before removing manually."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सिम्बॉलिक लिंक %@ की ओर इशारा करता है, जो मौजूद नहीं है। मैन्युअल रूप से हटाने से पहले इसकी जाँच करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সিম্বলিক লিংকটি %@-এর দিকে নির্দেশ করে, যা বিদ্যমান নেই। ম্যানুয়ালি সরানোর আগে পরীক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் குறியீட்டு இணைப்பு %@ ஐச் சுட்டுகிறது, அது இப்போது இல்லை. கைமுறையாக அகற்றும் முன் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ సింబాలిక్ లింక్ %@ ను సూచిస్తుంది, అది ఉనికిలో లేదు. మాన్యువల్‌గా తీసివేసే ముందు పరిశీలించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही सिम्बॉलिक लिंक %@ कडे निर्देश करते, जे अस्तित्वात नाही. मॅन्युअली काढण्यापूर्वी तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સિમ્બૉલિક લિંક %@ તરફ નિર્દેશ કરે છે, જે અસ્તિત્વમાં નથી. જાતે દૂર કરતાં પહેલાં તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಿಂಬಾಲಿಕ್ ಲಿಂಕ್ %@ ಅನ್ನು ಸೂಚಿಸುತ್ತದೆ, ಅದು ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲ. ಕೈಯಾರೆ ತೆಗೆದುಹಾಕುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സിംബോളിക് ലിങ്ക് %@-ലേക്ക് ചൂണ്ടുന്നു, അത് നിലവിലില്ല. സ്വയം നീക്കം ചെയ്യുന്നതിന് മുമ്പ് പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸਿਮਬੌਲਿਕ ਲਿੰਕ %@ ਵੱਲ ਇਸ਼ਾਰਾ ਕਰਦਾ ਹੈ, ਜੋ ਮੌਜੂਦ ਨਹੀਂ ਹੈ। ਖੁਦ ਹਟਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਜਾਂਚੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace simbólico apunta a %@, que no existe. Inspecciónalo antes de borrarlo manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien symbolique pointe vers %@, qui n'existe pas. Inspectez-le avant de le supprimer manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser symbolische Link verweist auf %@, das nicht existiert. Vor dem manuellen Entfernen prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link simbólico aponta para %@, que não existe. Inspecione antes de remover manualmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo collegamento simbolico punta a %@, che non esiste. Ispezionalo prima di rimuoverlo manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシンボリックリンクの参照先 %@ は存在しません。手動で削除する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 심볼릭 링크는 존재하지 않는 %@을(를) 가리킵니다. 수동으로 제거하기 전에 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此符号链接指向的 %@ 已不存在。手动移除前请先检查。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта символьная ссылка ведет на несуществующий путь %@. Проверьте перед ручным удалением."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير هذا الرابط الرمزي إلى %@ غير الموجود. افحصه قبل الإزالة اليدوية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קישור סימבולי זה מצביע אל %@, שאינו קיים. בדקו לפני הסרה ידנית."
          }
        }
      }
    },
