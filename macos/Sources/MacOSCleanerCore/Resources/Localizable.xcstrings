    "Database export could not be finalized.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Database export could not be finalized."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटाबेस निर्यात पूरा नहीं हो सका।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেটাবেস এক্সপোর্ট চূড়ান্ত করা যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தரவுத்தள ஏற்றுமதியை இறுதி செய்ய முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డేటాబేస్ ఎగుమతిని పూర్తి చేయలేకపోయాము."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटाबेस निर्यात अंतिम करता आली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડેટાબેઝ નિકાસ પૂર્ણ કરી શકાઈ નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡೇಟಾಬೇಸ್ ರಫ್ತು ಅಂತಿಮಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡാറ്റാബേസ് എക്സ്പോർട്ട് പൂർത്തിയാക്കാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡੇਟਾਬੇਸ ਨਿਰਯਾਤ ਅੰਤਿਮ ਰੂਪ ਵਿੱਚ ਪੂਰਾ ਨਹੀਂ ਹੋ ਸਕਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo finalizar la exportación de la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'export de la base de données n'a pas pu être finalisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenbankexport konnte nicht abgeschlossen werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a exportação do banco de dados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile finalizzare l'esportazione del database."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースの書き出しを完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스 내보내기를 완료할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成数据库导出。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить экспорт базы данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إتمام تصدير قاعدة البيانات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להשלים את ייצוא מסד הנתונים."
          }
        }
      }
    },
