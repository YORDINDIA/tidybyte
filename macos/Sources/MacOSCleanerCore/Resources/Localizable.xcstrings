    },
    "This video format cannot be exported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video format cannot be exported."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वीडियो फ़ॉर्मेट निर्यात नहीं किया जा सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিও ফরম্যাট এক্সপোর্ট করা যাচ্ছে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த வீடியோ வடிவத்தை ஏற்றுமதி செய்ய முடியாது."
