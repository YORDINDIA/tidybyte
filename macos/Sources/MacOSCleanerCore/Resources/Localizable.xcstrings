    "This video's track layout is not supported for compression.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This video's track layout is not supported for compression."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वीडियो का ट्रैक लेआउट संपीड़न के लिए समर्थित नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপ্রেশনের জন্য এই ভিডিওর ট্র্যাক লেআউট সমর্থিত নয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கத்திற்கு இந்த வீடியோவின் தட அமைப்பு ஆதரிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదింపు కోసం ఈ వీడియో ట్రాక్ లేఅవుట్ మద్దతు ఇవ్వబడదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेशनसाठी या व्हिडिओचा ट्रॅक लेआउट समर्थित नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેશન માટે આ વિડિયોનો ટ્રૅક લેઆઉટ સમર્થિત નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚನೆಗಾಗಿ ಈ ವೀಡಿಯೊದ ಟ್ರ್ಯಾಕ್ ವಿನ್ಯಾಸ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രഷനായി ഈ വീഡിയോയുടെ ട്രാക്ക് ലേഔട്ട് പിന്തുണയ്ക്കുന്നില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪ੍ਰੈਸ਼ਨ ਲਈ ਇਸ ਵੀਡੀਓ ਦਾ ਟਰੈਕ ਲੇਆਉਟ ਸਮਰਥਿਤ ਨਹੀਂ ਹੈ।"
          }
        },
