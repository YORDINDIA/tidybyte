    "Review cleanup suggestions for %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review cleanup suggestions for %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए क्लीनअप सुझावों की समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর জন্য ক্লিনআপ পরামর্শ পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கான சுத்திகரிப்புப் பரிந்துரைகளை மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కోసం శుభ్రత సూచనలను సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ साठी क्लीनअप सूचनांचे पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ માટે ક્લીનઅપ સૂચનોની સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಗಾಗಿ ಸ್ವಚ್ಛತಾ ಸಲಹೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-നുള്ള വൃത്തിയാക്കൽ നിർദ്ദേശങ്ങൾ അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਲਈ ਸਫਾਈ ਸੁਝਾਵਾਂ ਦੀ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa las sugerencias de limpieza para %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez les suggestions de nettoyage pour %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigungsvorschläge für %@ prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise as sugestões de limpeza para %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamina i suggerimenti di pulizia per %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のクリーンアップ提案を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대한 정리 제안을 검토합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审阅针对 %@ 的清理建议。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте предложения очистки для %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع اقتراحات التنظيف لـ %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו הצעות ניקוי עבור %@."
          }
        }
      }
    },
    "Review only: %@ may hold data you still need, such as dSYMs for shipped builds or a global package store. Remove it yourself if you no longer need it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review only: %@ may hold data you still need, such as dSYMs for shipped builds or a global package store. Remove it yourself if you no longer need it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल समीक्षा: %@ में ऐसा डेटा हो सकता है जिसकी आपको अभी भी आवश्यकता हो, जैसे भेजे गए बिल्ड के लिए dSYMs या ग्लोबल पैकेज स्टोर। यदि आवश्यकता न हो, तो इसे स्वयं हटाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধুমাত্র পর্যালোচনা: %@-এ আপনার এখনও প্রয়োজনীয় ডেটা থাকতে পারে, যেমন প্রকাশিত বিল্ডের dSYMs বা গ্লোবাল প্যাকেজ স্টোর। প্রয়োজন না থাকলে নিজেই এটি সরিয়ে ফেলুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மதிப்பாய்வு மட்டும்: %@ இல் வெளியிடப்பட்ட உருவாக்கங்களுக்கான dSYMs அல்லது உலகளாவிய தொகுப்புக் கடை போன்ற உங்களுக்குத் தேவையான தரவு இருக்கலாம். தேவையில்லாதபோது நீங்களே அகற்றவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్ష మాత్రమే: %@ లో మీకు ఇంకా అవసరమైన డేటా ఉండవచ్చు, ఉదాహరణకు పంపిన బిల్డ్‌ల కోసం dSYMs లేదా గ్లోబల్ ప్యాకేజీ స్టోర్. అవసరం లేనప్పుడు మీరే తీసివేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "केवळ पुनरावलोकन: %@ मध्ये तुम्हाला अजूनही आवश्यक असलेला डेटा असू शकतो, जसे की पाठवलेल्या बिल्ड्ससाठी dSYMs किंवा ग्लोबल पॅकेज स्टोअर. गरज नसल्यास ते स्वतः काढा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માત્ર સમીક્ષા: %@ માં તમને હજી પણ જરૂરી હોય તેવો ડેટા હોઈ શકે છે, જેમ કે વિતરિત બિલ્ડ્સ માટે dSYMs અથવા ગ્લોબલ પૅકેજ સ્ટોર. જરૂર ન હોય તો જાતે દૂર કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿಶೀಲನೆ ಮಾತ್ರ: %@ ನಲ್ಲಿ ನಿಮಗೆ ಇನ್ನೂ ಅಗತ್ಯವಿರುವ ಡೇಟಾ ಇರಬಹುದು, ಉದಾಹರಣೆಗೆ ಶಿಪ್ ಮಾಡಿದ ಬಿಲ್ಡ್‌ಗಳಿಗಾಗಿ dSYMs ಅಥವಾ ಗ್ಲೋಬಲ್ ಪ್ಯಾಕೇಜ್ ಸ್ಟೋರ್. ಅಗತ್ಯವಿಲ್ಲದಿದ್ದಾಗ ನೀವೇ ತೆಗೆದುಹಾಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവലോകനം മാത്രം: %@-ൽ നിങ്ങൾക്ക് ഇപ്പോഴും ആവശ്യമുള്ള ഡാറ്റ ഉണ്ടാകാം, ഉദാഹരണത്തിന് വിതരണം ചെയ്ത ബിൽഡുകൾക്കുള്ള dSYMs അല്ലെങ്കിൽ ഗ്ലോബൽ പാക്കേജ് സ്റ്റോർ. ആവശ്യമില്ലാത്തപ്പോൾ സ്വയം നീക്കം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੇਵਲ ਸਮੀਖਿਆ: %@ ਵਿੱਚ ਅਜੇ ਵੀ ਲੋੜੀਂਦਾ ਡੇਟਾ ਹੋ ਸਕਦਾ ਹੈ, ਜਿਵੇਂ ਭੇਜੇ ਬਿਲਡਾਂ ਲਈ dSYMs ਜਾਂ ਗਲੋਬਲ ਪੈਕੇਜ ਸਟੋਰ। ਲੋੜ ਨਾ ਹੋਣ 'ਤੇ ਖੁਦ ਹਟਾਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para revisar: %@ puede contener datos que aún necesites, como dSYM de versiones publicadas o un almacén global de paquetes. Elimínalo tú mismo si ya no lo necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examen uniquement : %@ peut contenir des données dont vous avez encore besoin, comme des dSYM de versions publiées ou un dépôt global de paquets. Supprimez-le vous-même si vous n'en avez plus l'utilité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur zur Prüfung: %@ enthält möglicherweise noch benötigte Daten wie dSYMs für ausgelieferte Builds oder einen globalen Paketspeicher. Entferne es selbst, wenn du es nicht mehr brauchst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente revisão: %@ pode conter dados ainda necessários, como dSYMs de compilações lançadas ou um repositório global de pacotes. Remova você mesmo se não precisar mais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo revisione: %@ può contenere dati ancora utili, come i file dSYM delle build distribuite o una cache globale di pacchetti. Rimuovilo manualmente se non ti serve più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のみ: %@ には配信済みビルドの dSYM やグローバルパッケージストアなど、まだ必要なデータが含まれている場合があります。不要な場合のみ手動で削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토 전용: %@에는 배포한 빌드의 dSYM이나 전역 패키지 저장소 등 계속 필요한 데이터가 포함되어 있을 수 있습니다. 더 이상 필요하지 않을 때만 직접 제거하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅审阅：%@ 可能保存着您仍需要的数据，例如已发布版本的 dSYM 符号文件或全局包仓库。若确定不再需要，请自行手动删除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только проверка: %@ может содержать нужные данные, например dSYM для выпущенных сборок или глобальное хранилище пакетов. Удалите вручную, если это больше не нужно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للمراجعة فقط: قد يحتوي %@ على بيانات ما زلت تحتاجها مثل رموز dSYM للإصدارات المنشورة أو مخزن حزم عام. أزله بنفسك إذا لم تعد بحاجة إليه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבדיקה בלבד: %@ עשוי להכיל נתונים שעדיין דרושים לכם, כמו קבצי dSYM לבניות שפורסמו או מאגר חבילות כללי. הסירו ידנית אם אין בכך צורך."
          }
        }
      }
    },
