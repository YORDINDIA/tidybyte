        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરિણામોનું વિશ્લેષણ થઈ રહ્યું છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫಲಿತಾಂಶಗಳನ್ನು ವಿಶ್ಲೇಷಿಸುತ್ತಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണ്ടെത്തലുകൾ വിശകലനം ചെയ്യുന്നു"
          }
        },
        "pa": {
