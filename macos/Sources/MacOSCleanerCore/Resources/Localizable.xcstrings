    "%@ at %@ is high-risk or cloud-managed. Review manually before removing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ at %@ is high-risk or cloud-managed. Review manually before removing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ पर स्थित %1$@ उच्च-जोखिम वाला या क्लाउड-प्रबंधित है। हटाने से पहले मैन्युअल रूप से समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এ অবস্থিত %1$@ উচ্চ-ঝুঁকিপূর্ণ বা ক্লাউড-পরিচালিত। সরানোর আগে ম্যানুয়ালি পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ இல் உள்ள %1$@ அதிக ஆபத்து கொண்டது அல்லது கிளவுட்-நிர்வகிக்கப்பட்டது. அகற்றுவதற்கு முன் கைமுறையாக மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ వద్ద ఉన్న %1$@ అధిక-ప్రమాదకరమైనది లేదా క్లౌడ్-నిర్వహించబడేది. తొలగించే ముందు మాన్యువల్‌గా సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ येथील %1$@ हे उच्च-जोखमीचे किंवा क्लाउड-व्यवस्थापित आहे. काढण्यापूर्वी मॅन्युअली पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ પરનું %1$@ ઉચ્ચ-જોખમી અથવા ક્લાઉડ-સંચાલિત છે. દૂર કરતાં પહેલાં જાતે સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ನಲ್ಲಿರುವ %1$@ ಹೆಚ್ಚು ಅಪಾಯಕಾರಿ ಅಥವಾ ಕ್ಲೌಡ್-ನಿರ್ವಹಿತವಾಗಿದೆ. ತೆಗೆಯುವ ಮೊದಲು ಕೈಯಾರೆ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-ലുള്ള %1$@ ഉയർന്ന അപകടസാധ്യതയുള്ളതോ ക്ലൗഡ്-നിയന്ത്രിതമോ ആണ്. നീക്കം ചെയ്യുന്നതിന് മുമ്പ് സ്വയം അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 'ਤੇ %1$@ ਉੱਚ-ਜੋਖਮ ਜਾਂ ਕਲਾਊਡ-ਪ੍ਰਬੰਧਿਤ ਹੈ। ਹਟਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਖੁਦ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en %@ es de alto riesgo o está gestionado en la nube. Revísalo manualmente antes de eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dans %@ présente un risque élevé ou est géré dans le nuage. Vérifiez-le manuellement avant de supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unter %@ ist risikoreich oder cloudverwaltet. Vor dem Entfernen manuell prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ em %@ tem alto risco ou é gerenciado na nuvem. Revise manualmente antes de remover."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in %@ è ad alto rischio o gestito su cloud. Esaminalo manualmente prima di rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 内の %1$@ は高リスクまたはクラウド管理対象です。削除前に手動で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에 있는 %1$@은(는) 위험도가 높거나 클라우드에서 관리됩니다. 제거하기 전에 직접 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %2$@ 的 %1$@ 属于高风险或由云端管理。移除前请手动检查。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ по пути %@ имеет высокий риск или управляется через облако. Проверьте вручную перед удалением."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ في %@ عالي الخطورة أو مُدار عبر السحابة. راجعه يدويًا قبل الإزالة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ בנתיב %@ הוא בסיכון גבוה או מנוהל בענן. בדקו ידנית לפני ההסרה."
          }
        }
      }
    },
