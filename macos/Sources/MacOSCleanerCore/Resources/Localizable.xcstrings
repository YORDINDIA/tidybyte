        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐಟಂ ಈಗ ಟ್ರ್ಯಾಶ್‌ನಲ್ಲಿಲ್ಲ ಮತ್ತು ಮರುಸ್ಥಾಪಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനം ഇപ്പോൾ ട്രാഷിലില്ല, പുനഃസ്ഥാപിക്കാനാകില്ല: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਈਟਮ ਹੁਣ ਟਰੈਸ਼ ਵਿੱਚ ਨਹੀਂ ਹੈ ਅਤੇ ਬਹਾਲ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ: %@"
          }
        },
        "es": {
