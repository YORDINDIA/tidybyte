        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोल्डर में अद्वितीय आउटपुट फ़ाइल नहीं बन सकी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোল্ডারে অনন্য আউটপুট তৈরি করা যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்புறையில் தனித்துவமான வெளியீட்டை உருவாக்க முடியவில்லை."
