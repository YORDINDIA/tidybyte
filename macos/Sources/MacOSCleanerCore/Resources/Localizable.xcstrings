    "Another cleanup batch is already running. Wait for it to finish before starting a new one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another cleanup batch is already running. Wait for it to finish before starting a new one."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अन्य सफ़ाई बैच पहले से चल रहा है। नया बैच शुरू करने से पहले इसके समाप्त होने की प्रतीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরেকটি ক্লিনআপ ব্যাচ ইতিমধ্যেই চলছে। নতুনটি শুরু করার আগে এটি শেষ হওয়া পর্যন্ত অপেক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்றொரு சுத்திகரிப்புத் தொகுதி ஏற்கனவே இயங்குகிறது. புதியதைத் தொடங்கும் முன் அது முடியும் வரை காத்திருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మరొక శుభ్రత బ్యాచ్ ఇప్పటికే నడుస్తోంది. కొత్తది ప్రారంభించే ముందు అది ముగిసే వరకు వేచి ఉండండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आणखी एक क्लीनअप बॅच आधीच सुरू आहे. नवीन सुरू करण्यापूर्वी तो पूर्ण होईपर्यंत प्रतीक्षा करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બીજું ક્લીનઅપ બૅચ પહેલેથી ચાલી રહ્યું છે. નવું શરૂ કરતાં પહેલાં તે પૂર્ણ થાય ત્યાં સુધી રાહ જુઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮತ್ತೊಂದು ಸ್ವಚ್ಛತಾ ಬ್ಯಾಚ್ ಈಗಾಗಲೇ ನಡೆಯುತ್ತಿದೆ. ಹೊಸದನ್ನು ಪ್ರಾರಂಭಿಸುವ ಮೊದಲು ಅದು ಮುಗಿಯುವವರೆಗೆ ಕಾಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു വൃത്തിയാക്കൽ ബാച്ച് ഇതിനകം പ്രവർത്തിക്കുന്നുണ്ട്. പുതിയത് തുടങ്ങുന്നതിന് മുമ്പ് അത് തീരുന്നതുവരെ കാത്തിരിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਹੋਰ ਸਫਾਈ ਬੈਚ ਪਹਿਲਾਂ ਹੀ ਚੱਲ ਰਿਹਾ ਹੈ। ਨਵਾਂ ਸ਼ੁਰੂ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਇਸਦੇ ਖਤਮ ਹੋਣ ਦੀ ਉਡੀਕ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay otro lote de limpieza en ejecución. Espera a que termine antes de iniciar uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre lot de nettoyage est déjà en cours. Attendez la fin avant d'en lancer un nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Bereinigungslauf wird bereits ausgeführt. Warte, bis er beendet ist, bevor du einen neuen startest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro lote de limpeza já está em execução. Aguarde a conclusão antes de iniciar um novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro blocco di pulizia è già in corso. Attendi che termini prima di avviarne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のクリーンアップバッチがすでに実行中です。完了するまで待ってから新しく開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 정리 일괄 작업이 이미 실행 중입니다. 완료될 때까지 기다린 후 새로 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一批清理操作正在运行。请等待其完成后再开始新批次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой пакет очистки уже выполняется. Дождитесь завершения, прежде чем запускать новый."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل دفعة تنظيف أخرى بالفعل. انتظر حتى تنتهي قبل بدء دفعة جديدة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אצוות ניקוי אחרת כבר פועלת. המתינו לסיומה לפני התחלת אצווה חדשה."
          }
        }
      }
    },
