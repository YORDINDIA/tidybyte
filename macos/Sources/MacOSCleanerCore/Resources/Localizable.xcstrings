          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ਨੂੰ ਟਰੈਸ਼ ਵਿੱਚੋਂ ਹਟਾਇਆ ਨਹੀਂ ਜਾ ਸਕਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo quitar «%@» del Basurero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de retirer « %@ » de la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
