    "Visual near-match. Check before removing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visual near-match. Check before removing"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिखने में लगभग समान। हटाने से पहले जाँच लें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দৃশ্যমানভাবে প্রায় এক। সরানোর আগে যাচাই করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பார்வையில் கிட்டத்தட்ட ஒத்தது. அகற்றும் முன் சரிபார்க்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దృశ్యమానంగా దాదాపు ఒకేలా ఉంది. తీసివేసే ముందు తనిఖీ చేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दिसायला जवळजवळ सारखे. काढण्यापूर्वी तपासा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દેખાવમાં લગભગ સમાન. દૂર કરતાં પહેલાં તપાસો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೃಷ್ಟಿಯಲ್ಲಿ ಬಹುತೇಕ ಹೋಲುತ್ತದೆ. ತೆಗೆಯುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാഴ്ചയിൽ ഏകദേശം സമാനമാണ്. നീക്കം ചെയ്യുന്നതിന് മുമ്പ് പരിശോധിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
