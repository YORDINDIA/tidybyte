    "Planned action references a missing target: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planned action references a missing target: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजनाबद्ध क्रिया एक अनुपस्थित लक्ष्य का संदर्भ देती है: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিকল্পিত কাজটি একটি অনুপস্থিত লক্ষ্য নির্দেশ করে: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டமிடப்பட்ட செயல் இல்லாத இலக்கைக் குறிப்பிடுகிறது: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రణాళిక చేసిన చర్య లోపించిన లక్ష్యాన్ని సూచిస్తుంది: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नियोजित क्रिया एका गहाळ लक्ष्याचा संदर्भ देते: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આયોજિત ક્રિયા ખૂટતા લક્ષ્યનો સંદર્ભ આપે છે: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯೋಜಿತ ಕ್ರಿಯೆಯು ಕಾಣೆಯಾದ ಗುರಿಯನ್ನು ಉಲ್ಲೇಖಿಸುತ್ತದೆ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആസൂത്രണം ചെയ്ത പ്രവൃത്തി കാണാതായ ലക്ഷ്യത്തെ സൂചിപ്പിക്കുന്നു: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਯੋਜਨਾਬੱਧ ਕਾਰਵਾਈ ਇੱਕ ਗੁੰਮ ਟੀਚੇ ਦਾ ਹਵਾਲਾ ਦਿੰਦੀ ਹੈ: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción planificada hace referencia a un destino faltante: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'action planifiée fait référence à une cible manquante : %@"
          }
        },
        "de": {
          "stringUnit": {
