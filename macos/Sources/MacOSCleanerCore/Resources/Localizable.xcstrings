    "Keeps the newest version per platform. Xcode copies symbols again when a device with an older system connects.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the newest version per platform. Xcode copies symbols again when a device with an older system connects."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति प्लेटफ़ॉर्म केवल नवीनतम संस्करण रखता है। पुराने सिस्टम वाला डिवाइस कनेक्ट होने पर Xcode सिंबल फिर से कॉपी कर लेता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি প্ল্যাটফর্মের শুধুমাত্র নতুন সংস্করণটি রাখে। পুরনো সিস্টেমের কোনো ডিভাইস যুক্ত হলে Xcode পুনরায় সিম্বল কপি করে নেয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு தளத்திற்கும் மிகப் புதிய பதிப்பை மட்டுமே வைத்திருக்கும். பழைய கணினி கொண்ட சாதனம் இணைக்கப்படும்போது Xcode சின்னங்களை மீண்டும் நகலெடுக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి ప్లాట్‌ఫారమ్‌కు తాజా వెర్షన్‌ను మాత్రమే ఉంచుతుంది. పాత సిస్టమ్ ఉన్న పరికరం కనెక్ట్ అయినప్పుడు Xcode మళ్లీ చిహ్నాలను కాపీ చేస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति प्लॅटफॉर्म सर्वात नवीन आवृत्ती ठेवतो. जुनी सिस्टम असलेले डिव्हाइस कनेक्ट केल्यास Xcode पुन्हा सिम्बॉल्स कॉपी करतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક પ્લૅટફૉર્મનું માત્ર સૌથી નવું સંસ્કરણ રાખે છે. જૂની સિસ્ટમવાળું ડિવાઇસ કનેક્ટ થાય ત્યારે Xcode ફરી સિમ્બૉલ્સ કૉપિ કરી લે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಪ್ಲಾಟ್‌ಫಾರ್ಮ್‌ಗೆ ಅತ್ಯಂತ ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಮಾತ್ರ ಇರಿಸುತ್ತದೆ. ಹಳೆಯ ಸಿಸ್ಟಮ್ ಹೊಂದಿರುವ ಸಾಧನ ಸಂಪರ್ಕವಾದಾಗ Xcode ಚಿಹ್ನೆಗಳನ್ನು ಮತ್ತೆ ನಕಲಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ പ്ലാറ്റ്ഫോമിലെയും ഏറ്റവും പുതിയ പതിപ്പ് മാത്രം സൂക്ഷിക്കുന്നു. പഴയ സിസ്റ്റമുള്ള ഉപകരണം ബന്ധിപ്പിക്കുമ്പോൾ Xcode വീണ്ടും സിംബലുകൾ പകർത്തും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਪਲੇਟਫਾਰਮ ਦਾ ਕੇਵਲ ਸਭ ਤੋਂ ਨਵਾਂ ਸੰਸਕਰਨ ਰੱਖਦਾ ਹੈ। ਪੁਰਾਣੇ ਸਿਸਟਮ ਵਾਲਾ ਡਿਵਾਈਸ ਕਨੈਕਟ ਹੋਣ 'ਤੇ Xcode ਸਿੰਬਲ ਦੁਬਾਰਾ ਕਾਪੀ ਕਰ ਲੈਂਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la versión más reciente por plataforma. Xcode volverá a copiar los símbolos cuando conectes un dispositivo con un sistema anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve la version la plus récente par plateforme. Xcode recopie les symboles lorsqu'un appareil doté d'un système plus ancien se connecte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die neueste Version pro Plattform. Xcode kopiert Symbole bei Bedarf erneut, wenn ein Gerät mit älterem System verbunden wird."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a versão mais recente por plataforma. O Xcode copia os símbolos novamente quando um dispositivo com sistema antigo é conectado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la versione più recente per piattaforma. Xcode copia nuovamente i simboli quando colleghi un dispositivo con un sistema precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラットフォームごとに最新バージョンのみを保持します。古い OS のデバイスを接続すると Xcode がシンボルを再度コピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랫폼별로 최신 버전만 유지합니다. 구형 시스템 기기를 연결하면 Xcode가 기호를 다시 복사합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个平台仅保留最新版本。当连接搭载旧系统的设备时，Xcode 会重新拷贝符号。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет новейшую версию для каждой платформы. Xcode заново скопирует символы при подключении устройства со старой ОС."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي أحدث إصدار لكل منصة. يعيد Xcode نسخ الرموز عند توصيل جهاز بنظام أقدم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר את הגרסה החדשה ביותר לכל פלטפורמה. Xcode יעתיק סמלים שוב כשיחובר מכשיר עם מערכת ישנה יותר."
          }
        }
      }
    },
    "Keychain operation failed with status %d.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain operation failed with status %d."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कीचेन संचालन स्थिति %d के साथ विफल रहा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কীচেইন কাজটি %d স্থিতিসহ ব্যর্থ হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கீசெயின் செயல் நிலை %d உடன் தோல்வியடைந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కీచెయిన్ చర్య స్థితి %d తో విఫలమైంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कीचेन क्रिया स्थिती %d सह अयशस्वी झाली."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કીચેન ક્રિયા સ્થિતિ %d સાથે નિષ્ફળ ગઈ."
          }
        },
        "kn": {
          "stringUnit": {
