        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ನಲ್ಲಿರುವ ಐಟಂ ಗುರುತನ್ನು ದೃಢೀಕರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಆದ್ದರಿಂದ ಅದನ್ನು ಅಳಿಸಲಾಗಿಲ್ಲ."
