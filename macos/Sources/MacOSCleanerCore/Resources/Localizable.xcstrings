    "This item uses %@; review whether you need it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item uses %@; review whether you need it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आइटम %@ लेता है; देखें कि क्या आपको इसकी ज़रूरत है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আইটেমটি %@ নেয়; দেখে নিন এটি আপনার দরকার কি না."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உருப்படி %@ பயன்படுத்துகிறது; உங்களுக்கு இது தேவையா எனப் பாருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అంశం %@ వాడుతుంది; ఇది మీకు అవసరమో లేదో సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा आयटम %@ वापरतो; त्याची गरज आहे का ते तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ આઇટમ %@ વાપરે છે; તેની જરૂર છે કે નહીં તે તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಐಟಂ %@ ಬಳಸುತ್ತದೆ; ಅದು ನಿಮಗೆ ಬೇಕೇ ಎಂದು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഇനം %@ ഉപയോഗിക്കുന്നു; അത് നിങ്ങൾക്ക് വേണോ എന്ന് പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਆਈਟਮ %@ ਵਰਤਦੀ ਹੈ; ਇਸਦੀ ਲੋੜ ਹੈ ਕਿ ਨਹੀਂ, ਵੇਖੋ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento ocupa %@; revisa si lo necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément occupe %@ ; vérifiez si vous en avez besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt belegt %@; prüfe, ob du es brauchst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item ocupa %@; veja se você precisa dele."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento occupa %@; verifica se ti serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は%@を使用しています；必要かどうかを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 %@을(를) 사용합니다; 필요한지 검토하세요."
