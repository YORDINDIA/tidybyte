    "Tag this loose file for review instead of moving it automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag this loose file for review instead of moving it automatically."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बिखरी फ़ाइल को स्वतः स्थानांतरित करने के बजाय समीक्षा के लिए टैग करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয়ভাবে না সরিয়ে পর্যালোচনার জন্য এই অগোছালো ফাইলটি ট্যাগ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானாக நகர்த்துவதற்குப் பதிலாக இந்தத் தனி கோப்பை மதிப்பாய்வுக்காகக் குறிச்சொல்லிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వయంచాలకంగా తరలించడానికి బదులుగా సమీక్ష కోసం ఈ చెల్లాచెదురు ఫైల్‌ను ట్యాగ్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वयंचलितपणे हलवण्याऐवजी ही विखुरलेली फाइल पुनरावलोकनासाठी टॅग करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આપોઆપ ખસેડવાને બદલે આ છૂટી ફાઇલને સમીક્ષા માટે ટૅગ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸರಿಸುವ ಬದಲು ಪರಿಶೀಲನೆಗಾಗಿ ಈ ಚದುರಿದ ಫೈಲ್ ಅನ್ನು ಟ್ಯಾಗ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയമേവ മാറ്റുന്നതിന് പകരം അവലോകനത്തിനായി ഈ ചിതറിക്കിടക്കുന്ന ഫയൽ ടാഗ് ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਆਪ ਭੇਜਣ ਦੀ ਬਜਾਏ ਇਸ ਖਿੱਲਰੀ ਫਾਈਲ ਨੂੰ ਸਮੀਖਿਆ ਲਈ ਟੈਗ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiquetar este archivo suelto para revisión en lugar de moverlo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taguer ce fichier isolé pour examen au lieu de le déplacer automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese lose Datei zur Prüfung taggen, statt sie automatisch zu verschieben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiquetar este arquivo solto para revisão em vez de movê-lo automaticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Etichetta questo file sparso per revisione anziché spostarlo automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動移動せずに確認用タグを付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 자동으로 이동하지 않고 검토용 태그를 지정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此零散文件添加标签以便审阅，而不自动移动。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить этот файл тегом для проверки вместо автоматического перемещения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وسم هذا الملف المتفرّق للمراجعة بدلًا من نقله تلقائيًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיוג קובץ פזור זה לבדיקה במקום העברה אוטומטית."
          }
        }
      }
    },
    "Tag this older download for review instead of moving it automatically.": {
      "localizations": {
