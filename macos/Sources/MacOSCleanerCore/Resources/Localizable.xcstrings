    "The exported video did not pass verification.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exported video did not pass verification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यातित वीडियो सत्यापन में सफल नहीं हुआ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট করা ভিডিও যাচাইয়ে উত্তীর্ণ হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்றுமதி செய்யப்பட்ட வீடியோ சரிபார்ப்பில் தேர்ச்சி பெறவில்லை."
