          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया फ़ोटो आइटम सत्यापित नहीं हो सका। मूल आइटम सुरक्षित रखा गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন ফটো আইটেম যাচাই করা যায়নি। মূল আইটেমটি রাখা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய புகைப்பட உருப்படியைச் சரிபார்க்க முடியவில்லை. அசல் வைக்கப்பட்டது."
