    "Possible app support leftover for an app that is not currently installed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible app support leftover for an app that is not currently installed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी ऐसे ऐप का संभावित Application Support अवशेष जो अभी इंस्टॉल नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমানে ইনস্টল করা নেই এমন একটি অ্যাপের সম্ভাব্য Application Support অবশিষ্টাংশ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போது நிறுவப்படாத செயலிக்கான சாத்தியமான Application Support எஞ்சிய தரவு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం ఇన్‌స్టాల్ చేయని యాప్ కోసం సంభావ్య Application Support అవశేషం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्या इन्स्टॉल नसलेल्या अ‍ॅपचा संभाव्य Application Support अवशेष."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાલમાં ઇન્સ્ટૉલ ન હોય તેવી ઍપનો સંભવિત Application Support અવશેષ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಸ್ತುತ ಸ್ಥಾಪಿತವಾಗದ ಆ್ಯಪ್‌ಗಾಗಿ ಸಂಭಾವ್ಯ Application Support ಉಳಿಕೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിലവിൽ ഇൻസ്റ്റാൾ ചെയ്തിട്ടില്ലാത്ത ഒരു ആപ്പിന്റെ സാധ്യമായ Application Support അവശിഷ്ടം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਅਜਿਹੇ ਐਪ ਦੀ ਸੰਭਾਵੀ Application Support ਬਚੀ ਸਮੱਗਰੀ ਜੋ ਇਸ ਵੇਲੇ ਇੰਸਟਾਲ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Posibles restos de Application Support de una app que ya no está instalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible résidu Application Support d'une app qui n'est actuellement pas installée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicher Application-Support-Rest einer derzeit nicht installierten App."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Possível sobra do Application Support de um app não instalado atualmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possibile residuo Application Support di un'app non attualmente installata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在インストールされていないアプリの Application Support 残存データの可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 설치되지 않은 앱의 Application Support 잔여 데이터일 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能是当前未安装应用的 Application Support 残留数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможный остаток Application Support от приложения, которое сейчас не установлено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بقايا محتملة في Application Support لتطبيق غير مثبت حاليًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שארית אפשרית ב-Application Support של אפליקציה שאינה מותקנת כעת."
          }
        }
      }
    },
