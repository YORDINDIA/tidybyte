    "Analyzing findings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyzing findings"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निष्कर्षों का विश्लेषण जारी"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলাফল বিশ্লেষণ করা হচ্ছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கண்டறிதல்களைப் பகுப்பாய்வு செய்கிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫలితాలను విశ్లేషిస్తోంది"
