    "Application or package cache.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application or package cache."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप या पैकेज कैश।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ্লিকেশন বা প্যাকেজ ক্যাশ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலி அல்லது தொகுப்பு கேச்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అప్లికేషన్ లేదా ప్యాకేజీ క్యాష్."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅप्लिकेशन किंवा पॅकेज कॅशे."
