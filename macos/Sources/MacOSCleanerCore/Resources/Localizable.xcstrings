    "No API key is stored for the configured provider.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No API key is stored for the configured provider."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िगर किए गए प्रदाता के लिए कोई API कुंजी सहेजी नहीं गई है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্ধারিত প্রদানকারীর জন্য কোনো API কী সংরক্ষিত নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அமைக்கப்பட்ட வழங்குநருக்கு API விசை எதுவும் சேமிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాన్ఫిగర్ చేసిన ప్రొవైడర్ కోసం API కీ సేవ్ చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फिगर केलेल्या प्रदात्यासाठी कोणतीही API की जतन केलेली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૉન્ફિગર કરેલ પ્રદાતા માટે કોઈ API કી સાચવેલી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ ಪೂರೈಕೆದಾರರಿಗೆ ಯಾವುದೇ API ಕೀ ಉಳಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്രമീകരിച്ച ദാതാവിനായി API കീ ഒന്നും സംരക്ഷിച്ചിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੈੱਟ ਕੀਤੇ ਪ੍ਰਦਾਤਾ ਲਈ ਕੋਈ API ਕੁੰਜੀ ਸੰਭਾਲੀ ਨਹੀਂ ਗਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave de API guardada para el proveedor configurado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé API n'est enregistrée pour le fournisseur configuré."
          }
        },
        "de": {
