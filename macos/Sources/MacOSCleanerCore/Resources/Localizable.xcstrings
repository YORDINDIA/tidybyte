    "Undo is not available for this operation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo is not available for this operation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस क्रिया के लिए पूर्ववत उपलब्ध नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কাজের জন্য পূর্বাবস্থায় ফেরানো উপলব্ধ নয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் செயலுக்குச் செயல்தவிர் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ చర్యకు రద్దు అందుబాటులో లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या क्रियेसाठी पूर्ववत उपलब्ध नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ક્રિયા માટે પૂર્વવત ઉપલબ્ધ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಕ್ರಿಯೆಗೆ ರದ್ದು ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്രവൃത്തിക്ക് പഴയപടിയാക്കൽ ലഭ്യമല്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਕਾਰਵਾਈ ਲਈ ਵਾਪਸੀ ਉਪਲਬਧ ਨਹੀਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es posible deshacer esta operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'annulation n'est pas disponible pour cette opération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung ist für diesen Vorgang nicht verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfazer não está disponível para esta operação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'annullamento non è disponibile per questa operazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업에는 실행 취소를 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不支持撤销。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена недоступна для этой операции."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التراجع غير متاح لهذه العملية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול אינו זמין עבור פעולה זו."
          }
        }
      }
    },
    "Undo records may not persist across app restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo records may not persist across app restart."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को पुनः आरंभ करने पर पूर्ववत रिकॉर्ड सुरक्षित नहीं रह सकते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ পুনরায় চালু করলে পূর্বাবস্থার রেকর্ড নাও থাকতে পারে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலியை மறுதொடக்கம் செய்யும்போது செயல்தவிர் பதிவுகள் நிலைக்காமல் போகலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్ పునఃప్రారంభించిన తర్వాత రద్దు రికార్డులు ఉండకపోవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अ‍ॅप पुन्हा सुरू केल्यानंतर पूर्ववत नोंदी टिकून राहणार नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍપ ફરી શરૂ કર્યા પછી પૂર્વવત નોંધો જળવાઈ ન પણ રહે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ಮರುಪ್ರಾರಂಭಿಸಿದ ನಂತರ ರದ್ದು ದಾಖಲೆಗಳು ಉಳಿಯದಿರಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പ് വീണ്ടും തുറക്കുമ്പോൾ പഴയപടിയാക്കൽ രേഖകൾ നിലനിന്നില്ലെന്ന് വരാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪ ਮੁੜ ਚਾਲੂ ਕਰਨ 'ਤੇ ਵਾਪਸੀ ਰਿਕਾਰਡ ਬਰਕਰਾਰ ਨਾ ਰਹਿ ਸਕਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que los registros para deshacer no persistan tras reiniciar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux d'annulation peuvent ne pas être conservés après redémarrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungseinträge bleiben nach einem App-Neustart möglicherweise nicht erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registros para desfazer podem não persistir após reiniciar o app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I record di annullamento potrebbero non persistere dopo il riavvio dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを再起動すると取り消し記録が失われる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 재시작하면 실행 취소 기록이 유지되지 않을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启应用后，撤销记录可能无法保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи отмены могут не сохраниться после перезапуска программы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا تبقى سجلات التراجع بعد إعادة تشغيل التطبيق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשומות ביטול עלולות שלא להישמר לאחר הפעלה מחדש של האפליקציה."
          }
        }
      }
    },
    "Uninstalled App Data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalled App Data"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनइंस्टॉल किए गए ऐप का डेटा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনইনস্টল করা অ্যাপের ডেটা"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிறுவல் நீக்கப்பட்ட செயலி தரவு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్‌ఇన్‌స్టాల్ చేసిన యాప్ డేటా"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अनइन्स्टॉल केलेल्या अ‍ॅपचा डेटा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અનઇન્સ્ટૉલ કરેલી ઍપનો ડેટા"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದ ಆ್ಯಪ್ ಡೇಟಾ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അൺഇൻസ്റ്റാൾ ചെയ്ത ആപ്പ് ഡാറ്റ"
