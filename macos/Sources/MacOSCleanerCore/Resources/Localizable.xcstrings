        "kn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld ಐಟಂ macOS ಅಥವಾ ಇತರ ಬಳಕೆದಾರರೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಲಾದ ಸಿಸ್ಟಮ್-ವ್ಯಾಪಿ ಸ್ಥಳದಲ್ಲಿದೆ. ಆ ಮಾರ್ಗಗಳನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ಪರಿಶೀಲಿಸಿ."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld ಐಟಂಗಳು macOS ಅಥವಾ ಇತರ ಬಳಕೆದಾರರೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಲಾದ ಸಿಸ್ಟಮ್-ವ್ಯಾಪಿ ಸ್ಥಳಗಳಲ್ಲಿವೆ. ಆ ಮಾರ್ಗಗಳನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ಪರಿಶೀಲಿಸಿ."
