    "Scan stopped early: %@. These results cover only the locations scanned before the stop.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan stopped early: %@. These results cover only the locations scanned before the stop."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन समय से पहले रुका: %@। ये परिणाम रुकने से पहले स्कैन किए गए स्थानों को ही दर्शाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান আগেভাগে থেমে গেছে: %@। এই ফলাফলগুলোতে কেবল থামার আগে স্ক্যান করা স্থানগুলো অন্তর্ভুক্ত রয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் முன்பே நின்றது: %@. இந்த முடிவுகள் நிறுத்தத்திற்கு முன் ஸ்கேன் செய்த இடங்களை மட்டுமே காட்டுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ ముందే ఆగింది: %@. ఈ ఫలితాలు ఆగే ముందు స్కాన్ చేసిన స్థానాలను మాత్రమే చూపుతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन लवकर थांबला: %@. हे निकाल थांबण्यापूर्वी स्कॅन केलेल्या ठिकाणांपुरतेच आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન વહેલો અટક્યો: %@. આ પરિણામો અટક્યા પહેલાં સ્કૅન થયેલા સ્થાનોને જ દર્શાવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಮುಂಚಿತವಾಗಿಯೇ ನಿಂತಿದೆ: %@. ಈ ಫಲಿತಾಂಶಗಳು ನಿಲ್ಲುವ ಮೊದಲು ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಸ್ಥಳಗಳನ್ನು ಮಾತ್ರ ತೋರಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ നേരത്തെ നിന്നു: %@. നിർത്തുന്നതിന് മുമ്പ് സ്കാൻ ചെയ്ത സ്ഥലങ്ങൾ മാത്രമേ ഈ ഫലങ്ങളിൽ ഉള്ളൂ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਸਮੇਂ ਤੋਂ ਪਹਿਲਾਂ ਰੁਕਿਆ: %@। ਇਹ ਨਤੀਜੇ ਰੁਕਣ ਤੋਂ ਪਹਿਲਾਂ ਸਕੈਨ ਕੀਤੇ ਟਿਕਾਣਿਆਂ ਨੂੰ ਹੀ ਦਰਸਾਉਂਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis detenido antes: %@. Estos resultados cubren solo las ubicaciones analizadas hasta detenerse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse arrêtée prématurément : %@. Ces résultats ne couvrent que les emplacements analysés avant l'arrêt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan vorzeitig gestoppt: %@. Diese Ergebnisse decken nur die bis zum Stopp gescannten Orte ab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Análise interrompida: %@. Estes resultados cobrem apenas os locais analisados antes da parada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansione interrotta in anticipo: %@. Questi risultati coprono solo le posizioni analizzate prima dell'arresto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンが途中で停止しました: %@。これらの結果は停止前にスキャンされた場所のみを対象としています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔이 일찍 중지되었습니다: %@. 이 결과는 중지 전까지 스캔한 위치만 포함합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描提前停止：%@。以下结果仅涵盖停止前扫描到的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование остановлено досрочно: %@. Эти результаты охватывают только места, проверенные до остановки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف الفحص مبكرًا: %@. تغطي هذه النتائج المواقع المفحوصة قبل التوقف فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסריקה נעצרה מוקדם: %@. תוצאות אלה מכסות רק מיקומים שנסרקו לפני העצירה."
          }
        }
      }
    },
    "Scan was stopped early before finishing. Results show only the items scanned so far.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan was stopped early before finishing. Results show only the items scanned so far."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा होने से पहले स्कैन रुक गया था। परिणाम केवल अब तक स्कैन किए गए आइटम दिखाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ হওয়ার আগেই স্ক্যান থেমে গিয়েছিল। ফলাফলে কেবল এ পর্যন্ত স্ক্যান হওয়া আইটেম দেখানো হচ্ছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவதற்கு முன்பே ஸ்கேன் நின்றது. இதுவரை ஸ்கேன் செய்த உருப்படிகளை மட்டுமே முடிவுகள் காட்டுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తి కాకముందే స్కాన్ ఆగింది. ఫలితాలు ఇప్పటివరకు స్కాన్ చేసిన అంశాలను మాత్రమే చూపుతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण होण्यापूर्वी स्कॅन थांबला होता. निकाल केवळ आतापर्यंत स्कॅन केलेले आयटम दाखवतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્ણ થાય તે પહેલાં સ્કૅન અટકી ગયો હતો. પરિણામો માત્ર અત્યાર સુધી સ્કૅન થયેલી આઇટમ્સ બતાવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಗಿಯುವ ಮೊದಲೇ ಸ್ಕ್ಯಾನ್ ನಿಂತಿತ್ತು. ಫಲಿತಾಂಶಗಳು ಇದುವರೆಗೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಐಟಂಗಳನ್ನು ಮಾತ್ರ ತೋರಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൂർത്തിയാകും മുമ്പേ സ്കാൻ നിന്നു. ഇതുവരെ സ്കാൻ ചെയ്ത ഇനങ്ങൾ മാത്രമേ ഫലങ്ങളിൽ കാണിക്കുന്നുള്ളൂ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੂਰਾ ਹੋਣ ਤੋਂ ਪਹਿਲਾਂ ਸਕੈਨ ਰੁਕ ਗਿਆ ਸੀ। ਨਤੀਜੇ ਕੇਵਲ ਹੁਣ ਤੱਕ ਸਕੈਨ ਕੀਤੀਆਂ ਆਈਟਮਾਂ ਦਿਖਾਉਂਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se detuvo antes de terminar. Los resultados muestran solo los elementos analizados hasta ese momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse a été interrompue avant la fin. Les résultats n'affichent que les éléments déjà analysés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan wurde vorzeitig gestoppt. Ergebnisse zeigen nur die bisher gescannten Objekte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise foi interrompida antes de concluir. Os resultados mostram apenas os itens analisados até o momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione è stata interrotta prima del termine. I risultati mostrano solo gli elementi analizzati finora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンが完了前に停止しました。これまでスキャンされた項目のみを表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되기 전에 스캔이 중지되었습니다. 결과에는 지금까지 스캔한 항목만 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描在完成前被停止。结果仅显示目前已扫描的项目。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование было остановлено до завершения. Показаны только уже проверенные объекты."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُوقف الفحص قبل اكتماله. تعرض النتائج العناصر المفحوصة حتى تلك اللحظة فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסריקה נעצרה לפני סיומה. התוצאות מציגות רק פריטים שנסרקו עד כה."
          }
        }
      }
    },
