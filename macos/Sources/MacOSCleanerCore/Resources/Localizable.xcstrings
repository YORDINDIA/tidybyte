    "Restored all original actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored all original actions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी मूल क्रियाएँ पुनर्स्थापित कर दी गईं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব মূল কাজ পুনরুদ্ধার করা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து அசல் செயல்களும் மீட்டெடுக்கப்பட்டன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని అసలు చర్యలు పునరుద్ధరించబడ్డాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व मूळ क्रिया पुनर्संचयित केल्या."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધી મૂળ ક્રિયાઓ પુનઃસ્થાપિત કરી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಮೂಲ ಕ್ರಿಯೆಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ യഥാർത്ഥ പ്രവൃത്തികളും പുനഃസ്ഥാപിച്ചു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੀਆਂ ਮੂਲ ਕਾਰਵਾਈਆਂ ਬਹਾਲ ਕੀਤੀਆਂ ਗਈਆਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restauraron todas las acciones originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les actions d'origine ont été restaurées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ursprünglichen Aktionen wiederhergestellt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as ações originais foram restauradas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le azioni originali ripristinate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のアクションをすべて復元しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 작업을 모두 복원했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已还原所有原始操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все исходные действия восстановлены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت استعادة جميع الإجراءات الأصلية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הפעולות המקוריות שוחזרו."
          }
        }
      }
    },
    "Review Later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review Later"
          }
        },
        "hi": {
          "stringUnit": {
