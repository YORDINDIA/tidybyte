            "value": "“%@” ट्रॅशमधून काढता आले नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ને ટ્રૅશમાંથી દૂર કરી શકાયું નહીં."
          }
        },
        "kn": {
          "stringUnit": {
