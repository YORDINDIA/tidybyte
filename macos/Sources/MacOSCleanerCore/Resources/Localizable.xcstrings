    "No cleanup actions are currently recommended.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cleanup actions are currently recommended."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िलहाल किसी क्लीनअप क्रिया की अनुशंसा नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমানে কোনো ক্লিনআপ কাজের সুপারিশ নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போது சுத்திகரிப்பு செயல்கள் எதுவும் பரிந்துரைக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం ఏ శుభ్రత చర్యలు సిఫార్సు చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्या कोणत्याही क्लीनअप क्रियेची शिफारस केलेली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હાલમાં કોઈ ક્લીનઅપ ક્રિયાની ભલામણ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಸ್ತುತ ಯಾವುದೇ ಸ್ವಚ್ಛತಾ ಕ್ರಿಯೆಗಳನ್ನು ಶಿಫಾರಸು ಮಾಡಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിലവിൽ വൃത്തിയാക്കൽ പ്രവൃത്തികളൊന്നും ശുപാർശ ചെയ്യുന്നില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵੇਲੇ ਕਿਸੇ ਸਫਾਈ ਕਾਰਵਾਈ ਦੀ ਸਿਫ਼ਾਰਸ਼ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se recomiendan acciones de limpieza en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune action de nettoyage n'est recommandée pour le moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit werden keine Bereinigungsaktionen empfohlen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ação de limpeza é recomendada no momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non sono consigliate azioni di pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在推奨されるクリーンアップアクションはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 권장되는 정리 작업이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前暂无推荐的清理操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас действия по очистке не рекомендуются."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إجراءات تنظيف موصى بها حاليًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין כרגע פעולות ניקוי מומלצות."
          }
        }
      }
    },
    "No installed app uses %@, and none of its data changed in 30 days.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No installed app uses %@, and none of its data changed in 30 days."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी इंस्टॉल किया हुआ ऐप %@ का उपयोग नहीं करता, और पिछले 30 दिनों में इसका कोई डेटा नहीं बदला।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ইনস্টল করা অ্যাপ %@ ব্যবহার করে না, এবং 30 দিনে এর কোনো ডেটা পরিবর্তিত হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிறுவப்பட்ட எந்தச் செயலியும் %@ ஐப் பயன்படுத்தவில்லை, மேலும் 30 நாட்களில் இதன் தரவு எதுவும் மாறவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇన్‌స్టాల్ చేసిన ఏ యాప్ %@ ను ఉపయోగించదు మరియు 30 రోజుల్లో దీని డేటా ఏదీ మారలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणतेही इन्स्टॉल केलेले अ‍ॅप %@ वापरत नाही, आणि 30 दिवसांत त्याचा कोणताही डेटा बदलला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ ઇન્સ્ટૉલ કરેલી ઍપ %@ વાપરતી નથી, અને 30 દિવસોમાં તેનો કોઈ ડેટા બદલાયો નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಾಪಿಸಲಾದ ಯಾವುದೇ ಆ್ಯಪ್ %@ ಅನ್ನು ಬಳಸುವುದಿಲ್ಲ, ಮತ್ತು 30 ದಿನಗಳಲ್ಲಿ ಅದರ ಯಾವುದೇ ಡೇಟಾ ಬದಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇൻസ്റ്റാൾ ചെയ്ത ഒരു ആപ്പും %@ ഉപയോഗിക്കുന്നില്ല, 30 ദിവസത്തിനുള്ളിൽ ഇതിന്റെ ഡാറ്റയൊന്നും മാറിയിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਇੰਸਟਾਲ ਐਪ %@ ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕਰਦਾ, ਅਤੇ 30 ਦਿਨਾਂ ਵਿੱਚ ਇਸਦਾ ਕੋਈ ਡੇਟਾ ਨਹੀਂ ਬਦਲਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna app instalada usa %@ y ninguno de sus datos cambió en 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app installée n'utilise %@, et aucune de ses données n'a changé depuis 30 jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine installierte App nutzt %@, und keine der Daten hat sich in 30 Tagen geändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app instalado usa %@ e nenhum de seus dados mudou em 30 dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna app installata usa %@ e nessuno dei suoi dati è cambiato in 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのアプリで %@ を使用しているものはなく、関連データも 30 日間変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 앱 중 %@을(를) 사용하는 앱이 없으며, 지난 30일간 데이터 변경도 없었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已安装应用使用 %@，且其数据在 30 天内均未更改。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одно установленное приложение не использует %@, и данные не менялись уже 30 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستخدم أي تطبيق مثبّت %@، ولم تتغير أي من بياناته خلال 30 يومًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף אפליקציה מותקנת אינה משתמשת ב-%@, ואף נתון שלה לא השתנה ב-30 יום."
          }
        }
      }
    },
