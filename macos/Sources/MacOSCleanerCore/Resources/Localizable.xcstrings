        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ರದ್ದು ದಾಖಲೆ %@ ರಂದು ಅವಧಿ ಮೀರಿದೆ ಮತ್ತು ಇನ್ನು ಮುಂದೆ ಮರುಸ್ಥಾಪಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പഴയപടിയാക്കൽ രേഖ %@-ന് കാലഹരണപ്പെട്ടു, ഇനി പുനഃസ്ഥാപിക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਵਾਪਸੀ ਰਿਕਾਰਡ %@ ਨੂੰ ਮਿਆਦ ਪੁੱਗ ਗਿਆ ਅਤੇ ਹੁਣ ਬਹਾਲ ਨਹੀਂ ਹੋ ਸਕਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
