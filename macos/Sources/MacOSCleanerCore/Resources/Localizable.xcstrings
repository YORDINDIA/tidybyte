    "Homebrew autoremove dry-run found unused dependencies.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew autoremove dry-run found unused dependencies."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew autoremove ड्राई-रन में अप्रयुक्त निर्भरताएँ मिलीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew autoremove ড্রাই-রানে অব্যবহৃত নির্ভরতা পাওয়া গেছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew autoremove சோதனை இயக்கத்தில் பயன்படுத்தப்படாத சார்புகள் கண்டறியப்பட்டன."
