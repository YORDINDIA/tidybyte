    "Compression does not support this image's format or animation data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compression does not support this image's format or animation data."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेशन इस छवि के फ़ॉर्मैट या एनीमेशन डेटा का समर्थन नहीं करता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপ্রেশন এই ছবির ফরম্যাট বা অ্যানিমেশন ডেটা সমর্থন করে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கம் இந்தப் படத்தின் வடிவம் அல்லது அனிமேஷன் தரவை ஆதரிக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదింపు ఈ చిత్రం ఫార్మాట్ లేదా యానిమేషన్ డేటాకు మద్దతు ఇవ్వదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेशन या प्रतिमेचे स्वरूप किंवा अ‍ॅनिमेशन डेटा समर्थित करत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેશન આ છબીના ફોર્મેટ અથવા ઍનિમેશન ડેટાને સમર્થન આપતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚನೆಯು ಈ ಚಿತ್ರದ ಸ್ವರೂಪ ಅಥವಾ ಅನಿಮೇಷನ್ ಡೇಟಾವನ್ನು ಬೆಂಬಲಿಸುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ചിത്രത്തിന്റെ ഫോർമാറ്റോ ആനിമേഷൻ ഡാറ്റയോ കംപ്രഷൻ പിന്തുണയ്ക്കുന്നില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪ੍ਰੈਸ਼ਨ ਇਸ ਤਸਵੀਰ ਦੇ ਫਾਰਮੈਟ ਜਾਂ ਐਨੀਮੇਸ਼ਨ ਡੇਟਾ ਦਾ ਸਮਰਥਨ ਨਹੀਂ ਕਰਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compresión no admite el formato ni los datos de animación de esta imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compression ne prend pas en charge le format ou les données d'animation de cette image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Komprimierung unterstützt das Format oder die Animationsdaten dieses Bildes nicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compressão não oferece suporte ao formato ou aos dados de animação desta imagem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La compressione non supporta il formato o i dati di animazione di questa immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像の形式またはアニメーションデータは圧縮に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지의 형식이나 애니메이션 데이터는 압축을 지원하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩功能不支持该图像的格式或动画数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сжатие не поддерживает формат или данные анимации этого изображения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدعم الضغط تنسيق هذه الصورة أو بيانات الحركة الخاصة بها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכיווץ אינו תומך בפורמט או בנתוני ההנפשה של תמונה זו."
          }
        }
      }
    },
    "Container metadata names this app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Container metadata names this app"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंटेनर मेटाडेटा इस ऐप का नाम बताता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কন্টেইনার মেটাডেটা এই অ্যাপের নাম নির্দেশ করে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கொள்கலன் மெட்டாடேட்டா இந்தச் செயலியைக் குறிப்பிடுகிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కంటైనర్ మెటాడేటా ఈ యాప్ పేరును సూచిస్తుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंटेनर मेटाडेटा या अ‍ॅपचे नाव दर्शवतो"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કન્ટેનર મેટાડેટા આ ઍપનું નામ દર્શાવે છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಂಟೇನರ್ ಮೆಟಾಡೇಟಾ ಈ ಆ್ಯಪ್ ಹೆಸರನ್ನು ಸೂಚಿಸುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണ്ടെയ്നർ മെറ്റാഡാറ്റ ഈ ആപ്പിന്റെ പേര് സൂചിപ്പിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਟੇਨਰ ਮੈਟਾਡੇਟਾ ਇਸ ਐਪ ਦਾ ਨਾਮ ਦੱਸਦਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los metadatos del contenedor nombran esta app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les métadonnées du conteneur désignent cette app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Container-Metadaten nennen diese App"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os metadados do contêiner indicam este app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I metadati del container indicano questa app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテナメタデータにこのアプリ名が記載"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨테이너 메타데이터에 이 앱 이름이 있음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "容器元数据指向此应用"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метаданные контейнера указывают на это приложение"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكر البيانات الوصفية للحاوية هذا التطبيق"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מטא-נתוני המכולה מציינים אפליקציה זו"
          }
        }
      }
    },
