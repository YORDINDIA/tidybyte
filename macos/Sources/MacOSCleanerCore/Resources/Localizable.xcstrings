          "stringUnit": {
            "state": "translated",
            "value": "AI 공급자가 잘못된 형식의 응답을 반환했습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 提供方返回了格式错误的响应：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик ИИ вернул некорректный ответ: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرجع مزوّد الذكاء الاصطناعي استجابة غير صالحة: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספק הבינה המלאכותית החזיר תגובה פגומה: %@"
          }
        }
      }
    },
    "AI request failed after multiple attempts. Last error: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI request failed after multiple attempts. Last error: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई प्रयासों के बाद AI अनुरोध विफल रहा। अंतिम त्रुटि: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একাধিক চেষ্টার পর AI অনুরোধ ব্যর্থ হয়েছে। শেষ ত্রুটি: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பல முயற்சிகளுக்குப் பிறகு AI கோரிக்கை தோல்வியடைந்தது. கடைசி பிழை: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అనేక ప్రయత్నాల తర్వాత AI అభ్యర్థన విఫలమైంది. చివరి లోపం: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अनेक प्रयत्नांनंतर AI विनंती अयशस्वी झाली. शेवटची त्रुटी: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઘણા પ્રયાસો પછી AI વિનંતી નિષ્ફળ ગઈ. છેલ્લી ભૂલ: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಲವು ಪ್ರಯತ್ನಗಳ ನಂತರ AI ವಿನಂತಿ ವಿಫಲವಾಗಿದೆ. ಕೊನೆಯ ದೋಷ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പല ശ്രമങ്ങൾക്ക് ശേഷം AI അഭ്യർത്ഥന പരാജയപ്പെട്ടു. അവസാന പിശക്: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਈ ਕੋਸ਼ਿਸ਼ਾਂ ਤੋਂ ਬਾਅਦ AI ਬੇਨਤੀ ਅਸਫਲ ਰਹੀ। ਆਖਰੀ ਗਲਤੀ: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud de IA falló tras varios intentos. Último error: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête IA a échoué après plusieurs tentatives. Dernière erreur : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Anfrage ist nach mehreren Versuchen fehlgeschlagen. Letzter Fehler: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação de IA falhou após várias tentativas. Último erro: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiesta IA non riuscita dopo più tentativi. Ultimo errore: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数回試行しましたが AI リクエストに失敗しました。最後のエラー: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 번 시도했지만 AI 요청에 실패했습니다. 마지막 오류: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多次尝试后 AI 请求失败。最后错误：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос к ИИ завершился ошибкой после нескольких попыток. Последняя ошибка: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل طلب الذكاء الاصطناعي بعد عدة محاولات. آخر خطأ: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשת הבינה המלאכותית נכשלה לאחר מספר ניסיונות. שגיאה אחרונה: %@"
          }
        }
      }
    },
