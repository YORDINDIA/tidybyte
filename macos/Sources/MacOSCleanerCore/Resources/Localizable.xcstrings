            "state": "translated",
            "value": "בחרו ב-%@ כדי להעניק גישה לתיקייה."
          }
        }
      }
    },
    "Choose a different file. The export would overwrite the live database.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a different file. The export would overwrite the live database."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरी फ़ाइल चुनें। निर्यात से सक्रिय डेटाबेस ओवरराइट हो जाएगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভিন্ন একটি ফাইল বেছে নিন। এক্সপোর্ট করলে সক্রিয় ডেটাবেস ওভাররাইট হবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வேறு கோப்பைத் தேர்ந்தெடுக்கவும். ஏற்றுமதி நேரடி தரவுத்தளத்தை மேலெழுதிவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేరే ఫైల్ ఎంచుకోండి. ఎగుమతి ప్రత్యక్ష డేటాబేస్‌ను ఓవర్‌రైట్ చేస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेगळी फाइल निवडा. निर्यात केल्यास थेट डेटाबेसवर अधिलिखित केले जाईल."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અલગ ફાઇલ પસંદ કરો. નિકાસ સક્રિય ડેટાબેઝને ઓવરરાઇટ કરશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೇರೆ ಫೈಲ್ ಆಯ್ಕೆಮಾಡಿ. ರಫ್ತು ಲೈವ್ ಡೇಟಾಬೇಸ್ ಅನ್ನು ತಿದ್ದಿಬರೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു ഫയൽ തിരഞ്ഞെടുക്കുക. എക്സ്പോർട്ട് തത്സമയ ഡാറ്റാബേസിനെ തിരുത്തിയെഴുതും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਖਰੀ ਫਾਈਲ ਚੁਣੋ। ਨਿਰਯਾਤ ਮੌਜੂਦਾ ਡੇਟਾਬੇਸ ਨੂੰ ਓਵਰਰਾਈਟ ਕਰ ਦੇਵੇਗਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige otro archivo. La exportación sobrescribiría la base de datos activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un autre fichier. L'export écraserait la base de données active."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine andere Datei. Der Export würde die aktive Datenbank überschreiben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha outro arquivo. A exportação substituiria o banco de dados em uso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un altro file. L'esportazione sovrascriverebbe il database in uso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のファイルを選択してください。書き出すと使用中のデータベースが上書きされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 파일을 선택하세요. 내보내면 사용 중인 데이터베이스를 덮어쓰게 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择其他文件。导出会覆盖当前正在使用的数据库。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите другой файл. Экспорт перезаписал бы активную базу данных."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملفًا آخر. سيؤدي التصدير إلى استبدال قاعدة البيانات النشطة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו קובץ אחר. הייצוא ידרוס את מסד הנתונים הפעיל."
          }
        }
      }
    },
    "Choose a local folder outside protected and cloud locations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a local folder outside protected and cloud locations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित और क्लाउड स्थानों के बाहर कोई स्थानीय फ़ोल्डर चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সুরক্ষিত ও ক্লাউড স্থানের বাইরে একটি স্থানীয় ফোল্ডার বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதுகாக்கப்பட்ட மற்றும் கிளவுட் இடங்களுக்கு வெளியே உள்ள உள்ளூர் கோப்புறையைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రక్షిత మరియు క్లౌడ్ స్థానాల వెలుపల ఉన్న స్థానిక ఫోల్డర్ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित आणि क्लाउड ठिकाणांच्या बाहेर स्थानिक फोल्डर निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સુરક્ષિત અને ક્લાઉડ સ્થાનોની બહારનું સ્થાનિક ફોલ્ડર પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಕ್ಷಿತ ಮತ್ತು ಕ್ಲೌಡ್ ಸ್ಥಳಗಳ ಹೊರಗಿರುವ ಸ್ಥಳೀಯ ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സംരക്ഷിതവും ക്ലൗഡ് സ്ഥലങ്ങൾക്കും പുറത്തുള്ള ഒരു പ്രാദേശിക ഫോൾഡർ തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੁਰੱਖਿਅਤ ਅਤੇ ਕਲਾਊਡ ਟਿਕਾਣਿਆਂ ਤੋਂ ਬਾਹਰ ਸਥਾਨਕ ਫੋਲਡਰ ਚੁਣੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta local fuera de ubicaciones protegidas o en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier local hors des emplacements protégés et dans le nuage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen lokalen Ordner außerhalb geschützter und Cloud-Speicherorte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta local fora de locais protegidos e da nuvem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella locale al di fuori di posizioni protette o nel cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護された場所やクラウド以外のローカルフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호되거나 클라우드에 동기화된 위치 밖의 로컬 폴더를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择位于受保护位置和云端路径之外的本地文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите локальную папку вне защищенных и облачных расположений."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدًا محليًا خارج المواقع المحمية والسحابية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו תיקייה מקומית מחוץ למיקומים מוגנים או בענן."
          }
        }
      }
    },
    "Choose an export destination.": {
      "localizations": {
