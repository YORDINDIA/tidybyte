    "Not enough free disk space to compress safely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free disk space to compress safely."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित रूप से कंप्रेस करने के लिए पर्याप्त खाली डिस्क स्पेस नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিরাপদে কমপ্রেস করার জন্য পর্যাপ্ত খালি ডিস্ক জায়গা নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதுகாப்பாக சுருக்க போதுமான காலி வட்டு இடம் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సురక్షితంగా కుదించడానికి తగినంత ఖాళీ డిస్క్ స్థలం లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षितपणे कंप्रेस करण्यासाठी पुरेशी मोकळी डिस्क जागा नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સુરક્ષિત રીતે કોમ્પ્રેસ કરવા માટે પૂરતી ખાલી ડિસ્ક જગ્યા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸುರಕ್ಷಿತವಾಗಿ ಸಂಕುಚಿಸಲು ಸಾಕಷ್ಟು ಖಾಲಿ ಡಿಸ್ಕ್ ಸ್ಥಳವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സുരക്ഷിതമായി കംപ്രസ് ചെയ്യാൻ ആവശ്യത്തിന് ഒഴിഞ്ഞ ഡിസ്ക് ഇടമില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੁਰੱਖਿਅਤ ਢੰਗ ਨਾਲ ਕੰਪ੍ਰੈਸ ਕਰਨ ਲਈ ਲੋੜੀਂਦੀ ਖਾਲੀ ਡਿਸਕ ਥਾਂ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre en disco para comprimir de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace disque libre insuffisant pour compresser en toute sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genügend freier Speicherplatz für eine sichere Komprimierung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço livre insuficiente no disco para comprimir com segurança."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio libero insufficiente su disco per comprimere in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に圧縮するための十分な空きディスク容量がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 압축할 수 있는 디스크 여유 공간이 부족합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘可用空间不足，无法安全进行压缩。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно свободного места на диске для безопасного сжатия."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة حرة كافية على القرص للضغط بأمان."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מספיק שטח פנוי בדיסק לכיווץ בטוח."
          }
        }
      }
    },
    "Not trashed: %@ holds protected or unreadable content (%@).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not trashed: %@ holds protected or unreadable content (%@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश में नहीं भेजा गया: %@ में सुरक्षित या अपठनीय सामग्री (%@) है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাশে পাঠানো হয়নি: %@-এ সুরক্ষিত বা অপঠনযোগ্য বিষয়বস্তু (%@) রয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குப்பைத் தொட்டிக்கு நகர்த்தப்படவில்லை: %@ பாதுகாக்கப்பட்ட அல்லது படிக்க முடியாத உள்ளடக்கத்தை (%@) கொண்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాష్‌లోకి పంపలేదు: %@ లో రక్షిత లేదా చదవలేని కంటెంట్ (%@) ఉంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रॅशमध्ये हलवले नाही: %@ मध्ये सुरक्षित किंवा वाचता न येणारी सामग्री (%@) आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રૅશમાં મોકલ્યું નથી: %@ માં સુરક્ષિત અથવા વાંચી ન શકાય તેવી સામગ્રી (%@) છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರ್ಯಾಶ್‌ಗೆ ಕಳುಹಿಸಲಾಗಿಲ್ಲ: %@ ರಕ್ಷಿತ ಅಥವಾ ಓದಲಾಗದ ವಿಷಯವನ್ನು (%@) ಹೊಂದಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രാഷിലേക്ക് മാറ്റിയില്ല: %@-ൽ സംരക്ഷിതമോ വായിക്കാനാകാത്തതോ ആയ ഉള്ളടക്കം (%@) ഉണ്ട്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਰੈਸ਼ ਵਿੱਚ ਨਹੀਂ ਭੇਜਿਆ ਗਿਆ: %@ ਵਿੱਚ ਸੁਰੱਖਿਅਤ ਜਾਂ ਨਾ-ਪੜ੍ਹਨਯੋਗ ਸਮੱਗਰੀ (%@) ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se movió al Basurero: %@ contiene datos protegidos o ilegibles (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non placé dans la Corbeille : %@ contient des éléments protégés ou illisibles (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht in den Papierkorb verschoben: %@ enthält geschützte oder unlesbare Inhalte (%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não movido para o Lixo: %@ contém conteúdo protegido ou ilegível (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non spostato nel Cestino: %@ contiene elementi protetti o illeggibili (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に移動されませんでした: %@ には保護された、または読み取れない内容が含まれています (%@)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동되지 않음: %@에 보호되었거나 읽을 수 없는 콘텐츠가 있습니다 (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未移至废纸篓：%@ 包含受保护或无法读取的内容 (%@)。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не перемещено в Корзину: %@ содержит защищенные или нечитаемые данные (%@)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُنقل إلى سلة المهملات: يحتوي %@ على محتوى محمي أو غير قابل للقراءة (%@)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הועבר לפח: %@ מכיל תוכן מוגן או שאינו ניתן לקריאה (%@)."
          }
        }
      }
    },
