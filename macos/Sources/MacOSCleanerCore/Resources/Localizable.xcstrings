          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান করার আগে অন্তত একটি ফোল্ডার নির্বাচন করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் செய்வதற்கு முன் குறைந்தது ஒரு கோப்புறையையாவது தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ చేసే ముందు కనీసం ఒక ఫోల్డర్ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन करण्यापूर्वी किमान एक फोल्डर निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન કરતાં પહેલાં ઓછામાં ઓછું એક ફોલ્ડર પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಮಾಡುವ ಮೊದಲು ಕನಿಷ್ಠ ಒಂದು ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ ചെയ്യുന്നതിന് മുമ്പ് കുറഞ്ഞത് ഒരു ഫോൾഡറെങ്കിലും തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਘੱਟੋ-ਘੱਟ ਇੱਕ ਫੋਲਡਰ ਚੁਣੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona al menos una carpeta antes de analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez au moins un dossier avant d'analyser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle vor dem Scannen mindestens einen Ordner aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione ao menos uma pasta antes de analisar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona almeno una cartella prima di avviare la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン前に少なくとも 1 つのフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔하기 전에 폴더를 하나 이상 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描前请至少选择一个文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед сканированием выберите хотя бы одну папку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد مجلدًا واحدًا على الأقل قبل الفحص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו תיקייה אחת לפחות לפני הסריקה."
          }
        }
      }
    },
    "Select two different snapshots to compare.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select two different snapshots to compare."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुलना के लिए दो अलग-अलग स्नैपशॉट चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুলনা করতে দুটি ভিন্ন স্ন্যাপশট নির্বাচন করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒப்பிட இரு வெவ்வேறு ஸ்னாப்ஷாட்களைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సరిపోల్చడానికి రెండు వేర్వేరు స్నాప్‌షాట్లను ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुलना करण्यासाठी दोन वेगळे स्नॅपशॉट निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરખામણી કરવા બે અલગ સ્નૅપશૉટ પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೋಲಿಸಲು ಎರಡು ವಿಭಿನ್ನ ಸ್ನ್ಯಾಪ್‌ಶಾಟ್‌ಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "താരതമ്യം ചെയ്യാൻ രണ്ട് വ്യത്യസ്ത സ്നാപ്പ്ഷോട്ടുകൾ തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਲਨਾ ਕਰਨ ਲਈ ਦੋ ਵੱਖਰੇ ਸਨੈਪਸ਼ਾਟ ਚੁਣੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona dos instantáneas distintas para comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
