    "%@ cache/log at %@ is rebuildable. Review before moving to Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cache/log at %@ is rebuildable. Review before moving to Trash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ पर %1$@ का कैश/लॉग फिर से बनाया जा सकता है। ट्रैश में ले जाने से पहले समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-এ %1$@-এর ক্যাশ/লগ পুনরায় তৈরিযোগ্য। ট্র্যাশে পাঠানোর আগে পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ இல் உள்ள %1$@ கேச்/பதிவு மீண்டும் உருவாக்கக்கூடியது. குப்பைத் தொட்டிக்கு நகர்த்தும் முன் மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ వద్ద %1$@ క్యాష్/లాగ్ మళ్లీ నిర్మించదగినది. ట్రాష్‌లోకి తరలించే ముందు సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ येथील %1$@ चे कॅशे/लॉग पुन्हा तयार करता येतात. ट्रॅशमध्ये हलवण्यापूर्वी पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ પર %1$@ નું કૅશ/લૉગ ફરી બનાવી શકાય છે. ટ્રૅશમાં ખસેડતાં પહેલાં સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ನಲ್ಲಿರುವ %1$@ ಕ್ಯಾಶ್/ಲಾಗ್ ಅನ್ನು ಮರುನಿರ್ಮಿಸಬಹುದು. ಟ್ರ್ಯಾಶ್‌ಗೆ ಸರಿಸುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@-ലുള്ള %1$@ ക്യാഷ്/ലോഗ് വീണ്ടും നിർമ്മിക്കാവുന്നതാണ്. ട്രാഷിലേക്ക് മാറ്റുന്നതിന് മുമ്പ് അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 'ਤੇ %1$@ ਦਾ ਕੈਸ਼/ਲੌਗ ਮੁੜ-ਬਣਾਉਣ ਯੋਗ ਹੈ। ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜਣ ਤੋਂ ਪਹਿਲਾਂ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caché/registro de %@ en %@ es reconstruible. Revísalo antes de moverlo al Basurero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache/journal de %@ dans %@ est reconstructible. Vérifiez avant de placer dans la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache/Protokoll für %@ unter %@ ist neu erstellbar. Vor dem Verschieben in den Papierkorb prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cache/registro de %@ em %@ é recriável. Revise antes de mover para o Lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cache o il log di %@ in %@ è ricreabile. Esaminalo prima di spostarlo nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ にある %1$@ のキャッシュ／ログは再生成可能です。ゴミ箱に移動する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에 있는 %1$@ 캐시/로그는 다시 생성할 수 있습니다. 휴지통으로 이동하기 전에 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %2$@ 的 %1$@ 缓存/日志可重建。移至废纸篓前请先检查。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэш/журнал %@ в %@ можно пересоздать. Проверьте перед перемещением в Корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرة التخزين المؤقت/السجل لـ %@ في %@ قابلة لإعادة الإنشاء. راجعها قبل النقل إلى سلة المهملات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המטמון/היומן של %@ בנתיב %@ ניתן ליצירה מחדש. בדקו לפני ההעברה לפח."
          }
        }
