    "Package Manager Cleanup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Package Manager Cleanup"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैकेज मैनेजर क्लीनअप"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাকেজ ম্যানেজার ক্লিনআপ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொகுப்பு மேலாளர் சுத்திகரிப்பு"
