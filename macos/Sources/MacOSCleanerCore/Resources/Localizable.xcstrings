        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objekt unter %@ ist nicht das Artefakt dieses Wiederherstellungseintrags und wurde nicht gelöscht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item em %@ não é o artefato criado por este registro de desfazer, portanto não foi apagado."
          }
