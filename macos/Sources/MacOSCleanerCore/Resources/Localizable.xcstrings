    "metadata could not be kept exactly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "metadata could not be kept exactly"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेटाडेटा ठीक उसी रूप में नहीं रखा जा सका"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেটাডেটা হুবহু রাখা যায়নি"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மெட்டாடேட்டாவை அதேபோல் வைத்திருக்க முடியவில்லை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మెటాడేటాను ఖచ్చితంగా అలాగే ఉంచలేకపోయాము"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मेटाडेटा तंतोतंत ठेवता आला नाही"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મેટાડેટા બરાબર તે જ રીતે રાખી શકાયો નહીં"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆಟಾಡೇಟಾವನ್ನು ನಿಖರವಾಗಿ ಇರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മെറ്റാഡാറ്റ കൃത്യമായി സൂക്ഷിക്കാനായില്ല"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੈਟਾਡੇਟਾ ਬਿਲਕੁਲ ਉਸੇ ਤਰ੍ਹਾਂ ਨਹੀਂ ਰੱਖਿਆ ਜਾ ਸਕਿਆ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no se pudieron conservar exactamente los metadatos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les métadonnées n'ont pas pu être conservées à l'identique"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metadaten konnten nicht exakt beibehalten werden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "os metadados não puderam ser mantidos exatamente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "impossibile conservare esattamente i metadati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メタデータを完全には維持できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메타데이터를 정확히 유지할 수 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法精确保留元数据"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "метаданные не удалось сохранить точно"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ البيانات الوصفية بدقة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשמור מטא-נתונים במדויק"
          }
        }
      }
