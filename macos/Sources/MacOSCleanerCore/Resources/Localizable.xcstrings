    "The stopped scan could not analyze its files, so its findings are incomplete.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stopped scan could not analyze its files, so its findings are incomplete."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोका गया स्कैन अपनी फ़ाइलों का विश्लेषण नहीं कर सका, इसलिए इसके परिणाम अधूरे हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "থামানো স্ক্যানটি ফাইল বিশ্লেষণ করতে পারেনি, তাই এর ফলাফল অসম্পূর্ণ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிறுத்தப்பட்ட ஸ்கேன் தன் கோப்புகளைப் பகுப்பாய்வு செய்ய முடியவில்லை, எனவே முடிவுகள் முழுமையற்றவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆపిన స్కాన్ దాని ఫైళ్లను విశ్లేషించలేకపోయింది, కాబట్టి దాని ఫలితాలు అసంపూర్ణంగా ఉన్నాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "थांबवलेला स्कॅन त्याच्या फाइल्सचे विश्लेषण करू शकला नाही, त्यामुळे त्याचे निष्कर्ष अपूर्ण आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અટકાવેલ સ્કૅન તેની ફાઇલોનું વિશ્લેષણ કરી શક્યો નહીં, તેથી તેના પરિણામો અધૂરા છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಲ್ಲಿಸಿದ ಸ್ಕ್ಯಾನ್ ತನ್ನ ಫೈಲ್‌ಗಳನ್ನು ವಿಶ್ಲೇಷಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಆದ್ದರಿಂದ ಫಲಿತಾಂಶಗಳು ಅಪೂರ್ಣವಾಗಿವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിർത്തിയ സ്കാനിന് അതിന്റെ ഫയലുകൾ വിശകലനം ചെയ്യാനായില്ല, അതിനാൽ കണ്ടെത്തലുകൾ അപൂർണ്ണമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੋਕਿਆ ਗਿਆ ਸਕੈਨ ਆਪਣੀਆਂ ਫਾਈਲਾਂ ਦਾ ਵਿਸ਼ਲੇਸ਼ਣ ਨਹੀਂ ਕਰ ਸਕਿਆ, ਇਸ ਲਈ ਨਤੀਜੇ ਅਧੂਰੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis detenido no pudo analizar sus archivos, por lo que sus hallazgos están incompletos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse arrêtée n'a pas pu analyser ses fichiers ; ses résultats sont donc incomplets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gestoppte Scan konnte seine Dateien nicht analysieren, daher sind die Ergebnisse unvollständig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise interrompida não pôde analisar os arquivos; portanto, os resultados estão incompletos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione interrotta non ha potuto analizzare i file, quindi i risultati sono incompleti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止されたスキャンではファイルを分析できなかったため、結果は不完全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지된 스캔은 파일을 분석하지 못했으므로 결과가 불완전합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被停止的扫描未能完成文件分析，因此结果不完整。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановленное сканирование не успело проанализировать файлы, поэтому результаты неполны."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن الفحص المتوقف من تحليل ملفاته، لذا فنتائجه غير مكتملة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסריקה שנעצרה לא הספיקה לנתח את הקבצים, ולכן ממצאיה חלקיים."
          }
        }
      }
    },
    "The tool %@ is not available.": {
