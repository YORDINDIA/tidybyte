        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎగుమతి చేసిన వీడియో ధృవీకరణలో ఉత్తీర్ణత సాధించలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात केलेला व्हिडिओ पडताळणीत उत्तीर्ण झाला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિકાસ કરેલ વિડિયો ચકાસણીમાં પાસ થયો નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಫ್ತು ಮಾಡಿದ ವೀಡಿಯೊ ದೃಢೀಕರಣದಲ್ಲಿ ಉತ್ತೀರ್ಣವಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എക്സ്പോർട്ട് ചെയ്ത വീഡിയോ സ്ഥിരീകരണത്തിൽ വിജയിച്ചില്ല."
