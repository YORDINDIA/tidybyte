    "Destructive actions against symlinks are rejected: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destructive actions against symlinks are rejected: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंबॉलिक लिंक पर विनाशकारी क्रियाएं अस्वीकार की जाती हैं: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিম্বলিক লিংকের বিরুদ্ধে ধ্বংসাত্মক কাজ প্রত্যাখ্যাত হয়: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறியீட்டு இணைப்புகளுக்கு எதிரான அழிக்கும் செயல்கள் நிராகரிக்கப்படுகின்றன: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సింబాలిక్ లింక్‌లపై విధ్వంసక చర్యలు తిరస్కరించబడతాయి: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिम्बॉलिक लिंक्सवरील विनाशकारी क्रिया नाकारल्या जातात: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિમ્બૉલિક લિંક્સ પર વિનાશક ક્રિયાઓ નકારવામાં આવે છે: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಂಬಾಲಿಕ್ ಲಿಂಕ್‌ಗಳ ಮೇಲಿನ ವಿನಾಶಕಾರಿ ಕ್ರಿಯೆಗಳನ್ನು ತಿರಸ್ಕರಿಸಲಾಗುತ್ತದೆ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിംബോളിക് ലിങ്കുകളിലെ വിനാശകരമായ പ്രവൃത്തികൾ നിരസിക്കപ്പെടുന്നു: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
