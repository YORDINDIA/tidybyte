    "Cache entry at %@ is rebuildable. Review before moving to Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache entry at %@ is rebuildable. Review before moving to Trash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर स्थित कैश प्रविष्टि फिर से बनाई जा सकती है। ट्रैश में ले जाने से पहले समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ থাকা ক্যাশ আইটেম পুনরায় তৈরিযোগ্য। ট্র্যাশে পাঠানোর আগে পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல் உள்ள கேச் உள்ளீடு மீண்டும் உருவாக்கக்கூடியது. குப்பைத் தொட்டிக்கு நகர்த்தும் முன் மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వద్ద ఉన్న క్యాష్ అంశం మళ్లీ నిర్మించదగినది. ట్రాష్‌లోకి తరలించే ముందు సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ येथील कॅशे नोंद पुन्हा तयार करता येते. ट्रॅशमध्ये हलवण्यापूर्वी पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ પરની કૅશ નોંધ ફરી બનાવી શકાય છે. ટ્રૅશમાં ખસેડતાં પહેલાં સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ನಲ್ಲಿರುವ ಕ್ಯಾಶ್ ನಮೂದು ಮರುನಿರ್ಮಿಸಬಹುದಾಗಿದೆ. ಟ್ರ್ಯಾಶ್‌ಗೆ ಸರಿಸುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ലുള്ള ക്യാഷ് എൻട്രി വീണ്ടും നിർമ്മിക്കാവുന്നതാണ്. ട്രാഷിലേക്ക് മാറ്റുന്നതിന് മുമ്പ് അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 'ਤੇ ਕੈਸ਼ ਇੰਦਰਾਜ਼ ਮੁੜ-ਬਣਾਉਣ ਯੋਗ ਹੈ। ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜਣ ਤੋਂ ਪਹਿਲਾਂ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada de caché en %@ es reconstruible. Revísala antes de moverla al Basurero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entrée de cache à %@ est reconstructible. Vérifiez avant de placer dans la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache-Eintrag unter %@ ist neu erstellbar. Vor dem Verschieben in den Papierkorb prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrada de cache em %@ é recriável. Revise antes de mover para o Lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce di cache in %@ è ricreabile. Controllala prima di spostarla nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にあるキャッシュ項目は再生成可能です。ゴミ箱へ移動する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 캐시 항목은 다시 생성할 수 있습니다. 휴지통으로 이동하기 전에 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %@ 的缓存项可重建。移至废纸篓前请先检查。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент кэша по адресу %@ можно пересоздать. Проверьте перед перемещением в Корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنصر التخزين المؤقت في %@ قابل لإعادة الإنشاء. راجعه قبل النقل إلى سلة المهملات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריט המטמון ב-%@ ניתן ליצירה מחדש. בדקו לפני ההעברה לפח."
          }
        }
      }
    },
    "Cache entry under the system-wide caches root at %@. This location may be shared by the OS or other apps, review carefully before removing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache entry under the system-wide caches root at %@. This location may be shared by the OS or other apps, review carefully before removing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर सिस्टम-व्यापी कैश रूट के अंतर्गत प्रविष्टि। यह स्थान OS या अन्य ऐप्स द्वारा साझा हो सकता है; हटाने से पहले सावधानीपूर्वक जांचें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ সিস্টেম-ব্যাপী ক্যাশ রুটের অধীনে থাকা আইটেম। এই স্থানটি OS বা অন্যান্য অ্যাপের সাথে শেয়ার হতে পারে; অপসারণের আগে সাবধানে পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல் கணினி-அளவிலான கேச் மூலத்தின் கீழுள்ள உள்ளீடு. இந்த இடம் OS அல்லது பிற செயலிகளுடன் பகிரப்படலாம்; அகற்றுவதற்கு முன் கவனமாக மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ వద్ద సిస్టమ్-వ్యాప్త క్యాష్ రూట్ క్రింద ఉన్న అంశం. ఈ స్థానం OS లేదా ఇతర యాప్‌లతో భాగస్వామ్యం చేయబడవచ్చు; తొలగించే ముందు జాగ్రత్తగా సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ येथे सिस्टम-व्यापी कॅशे रूट अंतर्गत नोंद. हे ठिकाण OS किंवा इतर अ‍ॅप्ससोबत शेअर केलेले असू शकते; काढण्यापूर्वी काळजीपूर्वक तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ પર સિસ્ટમ-વ્યાપી કૅશ રૂટ હેઠળની નોંધ. આ સ્થાન OS અથવા અન્ય ઍપ્સ સાથે શેર કરેલું હોઈ શકે છે; દૂર કરતાં પહેલાં કાળજીપૂર્વક સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ನಲ್ಲಿ ಸಿಸ್ಟಮ್-ವ್ಯಾಪಿ ಕ್ಯಾಶ್ ರೂಟ್ ಅಡಿಯ ನಮೂದು. ಈ ಸ್ಥಳವನ್ನು OS ಅಥವಾ ಇತರ ಆ್ಯಪ್‌ಗಳೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಬಹುದು; ತೆಗೆಯುವ ಮೊದಲು ಎಚ್ಚರಿಕೆಯಿಂದ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ൽ സിസ്റ്റം-വ്യാപക ക്യാഷ് റൂട്ടിന് കീഴിലുള്ള എൻട്രി. ഈ സ്ഥലം OS അല്ലെങ്കിൽ മറ്റ് ആപ്പുകളുമായി പങ്കിട്ടിരിക്കാം; നീക്കം ചെയ്യുന്നതിന് മുമ്പ് ശ്രദ്ധയോടെ അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 'ਤੇ ਸਿਸਟਮ-ਵਿਆਪੀ ਕੈਸ਼ ਰੂਟ ਅਧੀਨ ਇੰਦਰਾਜ਼। ਇਹ ਟਿਕਾਣਾ OS ਜਾਂ ਹੋਰ ਐਪਸ ਨਾਲ ਸਾਂਝਾ ਹੋ ਸਕਦਾ ਹੈ; ਹਟਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਧਿਆਨ ਨਾਲ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada de caché en la raíz de cachés del sistema en %@. Esta ubicación puede compartirse con macOS u otras apps; revísala bien antes de eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrée de cache sous la racine des caches système à %@. Cet emplacement peut être partagé avec macOS ou d'autres apps ; vérifiez soigneusement avant de supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache-Eintrag im systemweiten Cache-Stamm unter %@. Dieser Ort wird möglicherweise vom System oder anderen Apps geteilt – vor dem Entfernen sorgfältig prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrada de cache na raiz de caches do sistema em %@. Este local pode ser compartilhado pelo sistema ou outros apps; revise com cuidado antes de remover."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voce di cache sotto la radice cache di sistema in %@. Questa posizione può essere condivisa con macOS o altre app; controlla con attenzione prima di rimuovere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のシステム全体キャッシュ内の項目です。OS やほかのアプリと共有されている可能性があるため、削除前に慎重に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 시스템 전체 캐시 루트에 있는 항목입니다. OS나 다른 앱과 공유될 수 있으므로 제거 전 주의 깊게 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于系统级缓存根目录 %@ 下的缓存项。该位置可能由系统或其他应用共享，移除前请务必仔细核实。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент кэша в системном корне %@. Это расположение может использоваться ОС или другими приложениями — внимательно проверьте перед удалением."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنصر تخزين مؤقت ضمن جذر النظام في %@. قد يشارك النظام أو تطبيقات أخرى هذا الموقع، راجعه بعناية قبل الإزالة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריט מטמון תחת שורש מטמוני המערכת ב-%@. מיקום זה עשוי להיות משותף למערכת ההפעלה או לאפליקציות אחרות — בדקו בזהירות לפני ההסרה."
          }
        }
      }
    },
