    "Size measurement is supported for images only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size measurement is supported for images only."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आकार मापना केवल इमेज के लिए समर्थित है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আকার পরিমাপ শুধুমাত্র ছবির জন্য সমর্থিত।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அளவு அளவீடு படங்களுக்கு மட்டுமே ஆதரிக்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరిమాణం కొలత చిత్రాలకు మాత్రమే మద్దతు ఇస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आकार मोजमाप केवळ प्रतिमांसाठी समर्थित आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કદ માપવું માત્ર છબીઓ માટે જ સમર્થિત છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗಾತ್ರ ಅಳತೆಯು ಚಿತ್ರಗಳಿಗೆ ಮಾತ್ರ ಬೆಂಬಲಿತವಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വലുപ്പം അളക്കൽ ചിത്രങ്ങൾക്ക് മാത്രമേ പിന്തുണയുള്ളൂ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਕਾਰ ਮਾਪਣਾ ਕੇਵਲ ਤਸਵੀਰਾਂ ਲਈ ਸਮਰਥਿਤ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La medición de tamaño solo se admite para imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mesure de taille n'est prise en charge que pour les images."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größenmessung wird nur für Bilder unterstützt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A medição de tamanho é suportada apenas para imagens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La misurazione della dimensione è supportata solo per le immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズ計測は画像のみ対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 측정은 이미지만 지원됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持针对图像测量压缩大小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измерение размера поддерживается только для изображений."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قياس الحجم مدعوم للصور فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדידת גודל נתמכת לתמונות בלבד."
          }
        }
      }
    },
