                  "state": "translated",
                  "value": " %lld items live in system-wide locations shared with the OS or other users. Review those paths carefully."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld आइटम ऐसे सिस्टम-व्यापी स्थान पर है जो macOS या अन्य उपयोगकर्ताओं के साथ साझा किया जाता है। इन पथों की ध्यान से समीक्षा करें।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld आइटम ऐसे सिस्टम-व्यापी स्थानों पर हैं जो macOS या अन्य उपयोगकर्ताओं के साथ साझा किए जाते हैं। इन पथों की ध्यान से समीक्षा करें।"
                }
              }
            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lldটি আইটেম সিস্টেম-ব্যাপী স্থানে রয়েছে যা macOS বা অন্যান্য ব্যবহারকারীদের সাথে শেয়ার করা হয়। এই পথগুলো সাবধানে পর্যালোচনা করুন।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lldটি আইটেম সিস্টেম-ব্যাপী স্থানে রয়েছে যা macOS বা অন্যান্য ব্যবহারকারীদের সাথে শেয়ার করা হয়। এই পথগুলো সাবধানে পর্যালোচনা করুন।"
                }
              }
            }
          }
        },
        "ta": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld உருப்படி macOS அல்லது பிற பயனர்களுடன் பகிரப்படும் கணினி-அளவிலான இடத்தில் உள்ளது. இந்தப் பாதைகளைக் கவனமாக மதிப்பாய்வு செய்யவும்."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld உருப்படிகள் macOS அல்லது பிற பயனர்களுடன் பகிரப்படும் கணினி-அளவிலான இடங்களில் உள்ளன. இந்தப் பாதைகளைக் கவனமாக மதிப்பாய்வு செய்யவும்."
                }
              }
            }
          }
        },
        "te": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld అంశం macOS లేదా ఇతర వినియోగదారులతో భాగస్వామ్యం చేయబడిన సిస్టమ్-వ్యాప్త స్థానంలో ఉంది. ఆ మార్గాలను జాగ్రత్తగా సమీక్షించండి."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld అంశాలు macOS లేదా ఇతర వినియోగదారులతో భాగస్వామ్యం చేయబడిన సిస్టమ్-వ్యాప్త స్థానాలలో ఉన్నాయి. ఆ మార్గాలను జాగ్రత్తగా సమీక్షించండి."
                }
              }
            }
          }
        },
        "mr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld आयटम सिस्टम-व्यापी ठिकाणी आहे जो macOS किंवा इतर वापरकर्त्यांसोबत शेअर केला जातो. या मार्गांचे काळजीपूर्वक पुनरावलोकन करा."
