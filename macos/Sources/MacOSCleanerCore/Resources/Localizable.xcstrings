          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ಗೆ ಯಾವುದೇ ಅನುಮೋದಿತ ಫೋಲ್ಡರ್ ಇಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലിന് അംഗീകരിച്ച ഫോൾഡറില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਾਈਲ ਦਾ ਕੋਈ ਮਨਜ਼ੂਰ ਫੋਲਡਰ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no tiene ninguna carpeta aprobada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas de dossier approuvé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat keinen genehmigten Ordner."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não tem pasta aprovada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non ha alcuna cartella approvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに承認済みのフォルダがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 승인된 폴더가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件没有已批准的文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У файла нет одобренной папки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يملك الملف مجلدًا معتمدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לקובץ אין תיקייה מאושרת."
          }
        }
      }
    },
    "The file is an old downloaded archive or installer. Review before moving it to Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is an old downloaded archive or installer. Review before moving it to Trash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल एक पुराना डाउनलोड आर्काइव या इंस्टॉलर है। ट्रैश में भेजने से पहले समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলটি একটি পুরনো ডাউনলোড আর্কাইভ বা ইনস্টলার। ট্র্যাশে পাঠানোর আগে পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்பு பழைய பதிவிறக்க காப்பகம் அல்லது நிறுவி ஆகும். குப்பைத் தொட்டிக்கு நகர்த்தும் முன் மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫైల్ పాత డౌన్‌లోడ్ ఆర్కైవ్ లేదా ఇన్‌స్టాలర్. ట్రాష్‌లోకి తరలించే ముందు సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही फाइल जुना डाउनलोड संग्रह किंवा इन्स्टॉलर आहे. ट्रॅशमध्ये हलवण्यापूर्वी पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફાઇલ જૂનું ડાઉનલોડ આર્કાઇવ અથવા ઇન્સ્ટૉલર છે. ટ્રૅશમાં ખસેડતાં પહેલાં સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೈಲ್ ಹಳೆಯ ಡೌನ್‌ಲೋಡ್ ಆರ್ಕೈವ್ ಅಥವಾ ಇನ್‌ಸ್ಟಾಲರ್ ಆಗಿದೆ. ಟ್ರ್ಯಾಶ್‌ಗೆ ಸರಿಸುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫയൽ പഴയ ഡൗൺലോഡ് ആർക്കൈവോ ഇൻസ്റ്റാളറോ ആണ്. ട്രാഷിലേക്ക് മാറ്റുന്നതിന് മുമ്പ് അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫਾਈਲ ਪੁਰਾਣਾ ਡਾਊਨਲੋਡ ਆਰਕਾਈਵ ਜਾਂ ਇੰਸਟਾਲਰ ਹੈ। ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜਣ ਤੋਂ ਪਹਿਲਾਂ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es una descarga antigua comprimida o un instalador. Revísalo antes de moverlo al Basurero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est une ancienne archive téléchargée ou un installateur. Examinez-le avant de le placer dans la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist ein altes heruntergeladenes Archiv oder Installationsprogramm. Vor dem Verschieben in den Papierkorb prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo é um pacote baixado antigo ou instalador. Revise antes de mover para o Lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è un vecchio archivio scaricato o installer. Esaminalo prima di spostarlo nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは古いダウンロードアーカイブまたはインストーラです。ゴミ箱に移動する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 오래된 다운로드 아카이브 또는 설치 프로그램입니다. 휴지통으로 이동하기 전에 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件是旧的下载压缩包或安装器。移至废纸篓前请先审阅。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл — старый загруженный архив или установщик. Проверьте перед перемещением в Корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف أرشيف تنزيل قديم أو برنامج تثبيت. راجعه قبل نقله إلى سلة المهملات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ זה הוא ארכיון הורדה ישן או קובץ התקנה. בדקו לפני ההעברה לפח."
          }
        }
      }
    },
