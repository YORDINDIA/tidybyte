    "This photo has very high brightness.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo has very high brightness."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो की चमक बहुत ज़्यादा है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোর উজ্জ্বলতা খুব বেশি."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்தின் ஒளிர்வு மிக அதிகம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటో చాలా ఎక్కువ వెలుతురు కలిగి ఉంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फोटोची चमक खूप जास्त आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટાની ચમક બહુ વધારે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋ ಬಹಳ ಹೆಚ್ಚು ಪ್ರಕಾಶಮಾನತೆ ಹೊಂದಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോയിൽ വളരെ കൂടിയ പ്രകാശമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਟੋ ਦੀ ਚਮਕ ਬਹੁਤ ਵੱਧ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tiene una luminosidad muy alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo a une luminosité très élevée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto ist sehr hell."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tem brilho muito alto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto ha una luminosità molto alta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は明るさが非常に高いです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 밝기가 매우 높습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片的亮度非常高。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого фото очень высокая яркость."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سطوع هذه الصورة مرتفع جدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבהירות של התמונה הזו גבוהה מאוד."
          }
        }
      }
    },
    "This photo has very low brightness.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo has very low brightness."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो की चमक बहुत कम है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোর উজ্জ্বলতা খুব কম."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்தின் ஒளிர்வு மிகக் குறைவு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటో చాలా తక్కువ వెలుతురు కలిగి ఉంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फोटोची चमक खूप कमी आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટાની ચમક બહુ ઓછી છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋ ಬಹಳ ಕಡಿಮೆ ಪ್ರಕಾಶಮಾನತೆ ಹೊಂದಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോയിൽ വളരെ കുറഞ്ഞ പ്രകാശമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਟੋ ਦੀ ਚਮਕ ਬਹੁਤ ਘੱਟ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tiene una luminosidad muy baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo a une luminosité très faible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto ist sehr dunkel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto tem brilho muito baixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto ha una luminosità molto bassa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真は明るさが非常に低いです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 밝기가 매우 낮습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片的亮度非常低。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого фото очень низкая яркость."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سطوع هذه الصورة منخفض جدًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבהירות של התמונה הזו נמוכה מאוד."
          }
        }
      }
    },
    "This photo may be out of focus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo may be out of focus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोटो फ़ोकस से बाहर हो सकती है."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি ফোকাসের বাইরে থাকতে পারে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படம் கவனம் விலகி இருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటో ఫోకస్ లేకుండా ఉండవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा फोटो फोकसबाहेर असू शकतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટો ફોકસ બહાર હોઈ શકે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋ ಫೋಕಸ್ನಲ್ಲಿಲ್ಲದಿರಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോ ഫോക്കസിലല്ലായിരിക്കാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫ਼ੋਟੋ ਫੋਕਸ ਤੋਂ ਬਾਹਰ ਹੋ ਸਕਦੀ ਹੈ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que esta foto esté desenfocada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo est peut-être floue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto ist möglicherweise unscharf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto pode estar fora de foco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto potrebbe essere fuori fuoco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真はピントが合っていない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진은 초점이 맞지 않았을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张照片可能未对焦。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это фото может быть не в фокусе."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تكون هذه الصورة غير واضحة التركيز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שהתמונה הזו לא מפוקסת."
          }
        }
      }
    },
    "This photo received a low visual-quality score.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo received a low visual-quality score."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोटो को दृश्य गुणवत्ता में कम स्कोर मिला."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফটোটি দৃশ্যমান গুণমানের কম স্কোর পেয়েছে."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் புகைப்படத்திற்குக் காட்சித் தர மதிப்பெண் குறைவாக இருந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోటోకు తక్కువ దృశ్య నాణ్యత స్కోరు లభించింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या फोटोला दृश्य-गुणवत्तेचा कमी गुण मिळाला."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોટાને દૃશ્ય-ગુણવત્તાનો ઓછો સ્કોર મળ્યો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಟೋಗೆ ಕಡಿಮೆ ದೃಶ್ಯ-ಗುಣಮಟ್ಟದ ಸ್ಕೋರ್ ಸಿಕ್ಕಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോട്ടോയ്ക്ക് കുറഞ്ഞ ദൃശ്യ-ഗുണനിലവാര സ്കോർ ലഭിച്ചു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਫ਼ੋਟੋ ਨੂੰ ਦਿੱਖ-ਗੁਣਵੱਤਾ ਦਾ ਘੱਟ ਸਕੋਰ ਮਿਲਿਆ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto recibió una puntuación baja de calidad visual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo a reçu un faible score de qualité visuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildqualität dieses Fotos wurde niedrig bewertet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta foto recebeu uma pontuação baixa de qualidade visual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto ha ricevuto un punteggio basso di qualità visiva."
          }
        },
        "ja": {
