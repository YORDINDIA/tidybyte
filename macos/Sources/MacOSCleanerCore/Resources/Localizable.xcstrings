    "Local LLM weights are large and slow to re-download. Inspect with `ollama rm` before removing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local LLM weights are large and slow to re-download. Inspect with `ollama rm` before removing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल LLM मॉडल बहुत बड़े होते हैं और दोबारा डाउनलोड करने में समय लगता है। हटाने से पहले `ollama rm` से जाँच लें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় LLM মডেলের ওজন বড় এবং পুনরায় ডাউনলোডে সময় লাগে। সরানোর আগে `ollama rm` দিয়ে পরীক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் LLM மாதிரிகள் பெரியவை மற்றும் மீண்டும் பதிவிறக்க நேரமாகும். அகற்றுவதற்கு முன் `ollama rm` மூலம் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థానిక LLM మోడల్ బరువులు పెద్దవిగా ఉంటాయి మరియు మళ్లీ డౌన్‌లోడ్ చేయడానికి సమయం పడుతుంది. తొలగించే ముందు `ollama rm` తో తనిఖీ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानिक LLM मॉडेल वेट्स मोठे असतात आणि पुन्हा डाउनलोड होण्यास वेळ लागतो. काढण्यापूर्वी `ollama rm` ने तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થાનિક LLM મૉડેલ વજન મોટા હોય છે અને ફરી ડાઉનલોડ કરવામાં સમય લાગે છે. દૂર કરતાં પહેલાં `ollama rm` વડે તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳೀಯ LLM ಮಾದರಿ ತೂಕಗಳು ದೊಡ್ಡದಾಗಿರುತ್ತವೆ ಮತ್ತು ಮರು-ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಸಮಯ ತೆಗೆದುಕೊಳ್ಳುತ್ತವೆ. ತೆಗೆಯುವ ಮೊದಲು `ollama rm` ನಿಂದ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രാദേശിക LLM മോഡൽ ഭാരങ്ങൾ വലുതും വീണ്ടും ഡൗൺലോഡ് ചെയ്യാൻ സാവധാനത്തിലുള്ളതുമാണ്. നീക്കം ചെയ്യുന്നതിന് മുമ്പ് `ollama rm` ഉപയോഗിച്ച് പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਥਾਨਕ LLM ਮਾਡਲ ਭਾਰ ਵੱਡੇ ਹੁੰਦੇ ਹਨ ਅਤੇ ਮੁੜ ਡਾਊਨਲੋਡ ਵਿੱਚ ਸਮਾਂ ਲੱਗਦਾ ਹੈ। ਹਟਾਉਣ ਤੋਂ ਪਹਿਲਾਂ `ollama rm` ਨਾਲ ਜਾਂਚੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pesos locales de LLM ocupan mucho y tardan en volver a descargarse. Revísalos con `ollama rm` antes de eliminarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les poids de LLM locaux sont volumineux et longs à retélécharger. Vérifiez avec `ollama rm` avant de supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale LLM-Gewichte sind groß und langsam erneut zu laden. Vor dem Entfernen mit `ollama rm` prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesos locais de LLM são grandes e demoram para baixar novamente. Verifique com `ollama rm` antes de remover."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pesi LLM locali sono grandi e lenti da riscaricare. Verifica con `ollama rm` prima di rimuovere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル LLM のモデルデータは容量が大きく、再ダウンロードに時間がかかります。削除前に `ollama rm` で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 LLM 가중치는 크기가 크고 다시 다운로드하는 데 오래 걸립니다. 제거하기 전에 `ollama rm`으로 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地大模型权重体积庞大且重新下载较慢。移除前请用 `ollama rm` 检查。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные веса LLM занимают много места и долго загружаются. Проверьте их с помощью `ollama rm` перед удалением."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوزان نماذج LLM المحلية كبيرة وبطيئة في إعادة التنزيل. افحصها بـ `ollama rm` قبل الإزالة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משקלי LLM מקומיים גדולים ואיטיים להורדה מחדש. בדקו עם `ollama rm` לפני הסרה."
          }
        }
      }
    },
    "Local Photos preview unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Photos preview unavailable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकल फ़ोटो पूर्वावलोकन उपलब्ध नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় ফটো প্রিভিউ উপলব্ধ নয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் புகைப்பட முன்னோட்டம் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థానిక ఫోటో ప్రివ్యూ అందుబాటులో లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानिक फोटो पूर्वावलोकन उपलब्ध नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થાનિક ફોટો પૂર્વાવલોકન ઉપલબ્ધ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳೀಯ ಫೋಟೋ ಪೂರ್ವವೀಕ್ಷಣೆ ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രാദേശിക ഫോട്ടോ പ്രിവ്യൂ ലഭ്യമല്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਥਾਨਕ ਫੋਟੋ ਪ੍ਰੀਵਿਊ ਉਪਲਬਧ ਨਹੀਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa local de Fotos no disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu local de Photos indisponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Fotos-Vorschau nicht verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização local do Fotos indisponível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima locale di Foto non disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの写真プレビューを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 사진 미리보기를 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地照片预览不可用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный предпросмотр в «Фото» недоступен."
          }
        },
