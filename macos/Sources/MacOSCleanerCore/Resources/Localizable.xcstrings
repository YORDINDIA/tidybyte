    "%@ appears to be a rebuildable developer artifact.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appears to be a rebuildable developer artifact."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ एक पुनर्निर्माण योग्य डेवलपर आर्टिफैक्ट प्रतीत होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ একটি পুনর্নির্মাণযোগ্য ডেভেলপার আর্টিফ্যাক্ট বলে মনে হচ্ছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ மீண்டும் உருவாக்கக்கூடிய டெவலப்பர் உருவாக்கமாகத் தெரிகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ మళ్లీ నిర్మించగల డెవలపర్ ఆర్టిఫ్యాక్ట్‌లా కనిపిస్తోంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ हे पुन्हा तयार करता येण्याजोगे डेव्हलपर आर्टिफॅक्ट असल्याचे दिसते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ફરી બનાવી શકાય તેવું ડેવલપર આર્ટિફૅક્ટ લાગે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಮರುನಿರ್ಮಿಸಬಹುದಾದ ಡೆವಲಪರ್ ಆರ್ಟಿಫ್ಯಾಕ್ಟ್‌ನಂತೆ ಕಾಣುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ വീണ്ടും നിർമ്മിക്കാവുന്ന ഒരു ഡെവലപ്പർ ആർട്ടിഫാക്റ്റ് ആണെന്ന് തോന്നുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਮੁੜ-ਬਣਾਉਣ ਯੋਗ ਡਿਵੈਲਪਰ ਆਰਟੀਫੈਕਟ ਜਾਪਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parece ser un artefacto de desarrollo reconstruible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ semble être un artefact de développement reconstructible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ scheint ein wiederherstellbares Entwickler-Artefakt zu sein."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parece ser um artefato de desenvolvimento recriável."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sembra un artefatto di sviluppo ricreabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は再生成可能な開発成果物と思われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 다시 생성할 수 있는 개발 아티팩트인 것 같습니다."
          }
        },
        "zh-Hans": {
