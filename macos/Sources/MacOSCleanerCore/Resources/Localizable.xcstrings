    "npm cache clean will delete the entire npm cache at %@. Packages will be re-downloaded on next install.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean will delete the entire npm cache at %@. Packages will be re-downloaded on next install."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean से %@ पर मौजूद पूरा npm कैश हट जाएगा। अगले इंस्टॉल पर पैकेज फिर से डाउनलोड होंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean চালালে %@-এ থাকা সম্পূর্ণ npm ক্যাশ মুছে যাবে। পরবর্তী ইনস্টলে প্যাকেজগুলো পুনরায় ডাউনলোড হবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean இயக்குவது %@ இல் உள்ள முழு npm கேச்சையும் நீக்கும். அடுத்த நிறுவலில் தொகுப்புகள் மீண்டும் பதிவிறக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean అమలు చేస్తే %@ వద్ద ఉన్న మొత్తం npm క్యాష్ తొలగించబడుతుంది. తదుపరి ఇన్‌స్టాల్‌లో ప్యాకేజీలు మళ్లీ డౌన్‌లోడ్ అవుతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean चालवल्याने %@ येथील संपूर्ण npm कॅशे हटवला जाईल. पुढील इन्स्टॉलवर पॅकेजेस पुन्हा डाउनलोड होतील."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean થી %@ પરનું સંપૂર્ણ npm કૅશ કાઢી નખાશે. આગલા ઇન્સ્ટૉલ પર પૅકેજીસ ફરી ડાઉનલોડ થશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean ನಡೆಸಿದರೆ %@ ನಲ್ಲಿರುವ ಸಂಪೂರ್ಣ npm ಕ್ಯಾಶ್ ಅಳಿಸಲ್ಪಡುತ್ತದೆ. ಮುಂದಿನ ಇನ್‌ಸ್ಟಾಲ್‌ನಲ್ಲಿ ಪ್ಯಾಕೇಜ್‌ಗಳು ಮರು-ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean പ്രവർത്തിപ്പിച്ചാൽ %@-ലുള്ള മുഴുവൻ npm ക്യാഷും ഇല്ലാതാകും. അടുത്ത ഇൻസ്റ്റാളിൽ പാക്കേജുകൾ വീണ്ടും ഡൗൺലോഡ് ചെയ്യും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean ਨਾਲ %@ 'ਤੇ ਸਾਰਾ npm ਕੈਸ਼ ਮਿਟ ਜਾਵੇਗਾ। ਅਗਲੇ ਇੰਸਟਾਲ 'ਤੇ ਪੈਕੇਜ ਦੁਬਾਰਾ ਡਾਊਨਲੋਡ ਹੋਣਗੇ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean eliminará toda la caché de npm en %@. Los paquetes volverán a descargarse en la siguiente instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean supprimera tout le cache npm dans %@. Les paquets seront retéléchargés lors de la prochaine installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean löscht den gesamten npm-Cache unter %@. Pakete werden bei der nächsten Installation neu geladen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean apagará todo o cache do npm em %@. Os pacotes serão baixados novamente na próxima instalação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean eliminerà l'intera cache npm in %@. I pacchetti verranno riscaricati alla prossima installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean を実行すると %@ の npm キャッシュ全体が削除されます。パッケージは次回インストール時に再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean을 실행하면 %@의 전체 npm 캐시가 삭제됩니다. 다음 설치 시 패키지를 다시 다운로드합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean 将删除 %@ 中的全部 npm 缓存。下次安装软件包时将重新下载。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean удалит весь кэш npm в %@. Пакеты будут загружены заново при следующей установке."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحذف npm cache clean ذاكرة تخزين npm بالكامل في %@. ستُنزّل الحزم مجددًا عند التثبيت التالي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache clean ימחק את כל מטמון npm ב-%@. חבילות יורדו מחדש בהתקנה הבאה."
          }
        }
      }
    },
    "npm cache is visible at %@. Review before cleaning.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "npm cache is visible at %@. Review before cleaning."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "npm कैश %@ पर दिख रहा है। साफ़ करने से पहले समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "npm ক্যাশ %@-এ দৃশ্যমান। পরিষ্কার করার আগে পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "npm கேச் %@ இல் தெரிகிறது. சுத்தம் செய்யும் முன் மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "npm క్యాష్ %@ వద్ద కనిపిస్తోంది. శుభ్రం చేసే ముందు సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "npm कॅशे %@ येथे दिसत आहे. साफ करण्यापूर्वी पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "npm કૅશ %@ પર દેખાય છે. સાફ કરતાં પહેલાં સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "npm ಕ್ಯಾಶ್ %@ ನಲ್ಲಿ ಗೋಚರಿಸುತ್ತದೆ. ಸ್ವಚ್ಛಗೊಳಿಸುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "npm ക്യാഷ് %@-ൽ കാണാം. വൃത്തിയാക്കുന്നതിന് മുമ്പ് അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "npm ਕੈਸ਼ %@ 'ਤੇ ਦਿਖਾਈ ਦੇ ਰਿਹਾ ਹੈ। ਸਾਫ਼ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caché de npm es visible en %@. Revísala antes de limpiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache npm est visible dans %@. Vérifiez avant de nettoyer."
          }
        },
        "de": {
