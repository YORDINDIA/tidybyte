    "Docker safe cleanup can prune %@ of stopped containers, dangling images, and build cache.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker safe cleanup can prune %@ of stopped containers, dangling images, and build cache."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित Docker सफ़ाई रुके हुए कंटेनर, अनाथ इमेज और बिल्ड कैश का %@ साफ़ कर सकती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিরাপদ Docker ক্লিনআপ থামানো কন্টেইনার, অনাথ ইমেজ ও বিল্ড ক্যাশের %@ পরিষ্কার করতে পারে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதுகாப்பான Docker சுத்திகரிப்பு நின்ற கொள்கலன்கள், தொங்கும் படங்கள் மற்றும் உருவாக்க கேச்சிலிருந்து %@ ஐ அழிக்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సురక్షిత Docker శుభ్రత ఆగిన కంటైనర్లు, వదులైన చిత్రాలు మరియు బిల్డ్ క్యాష్ నుండి %@ ను క్లియర్ చేయగలదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित Docker क्लीनअप थांबलेले कंटेनर्स, मोकळ्या प्रतिमा आणि बिल्ड कॅशेमधील %@ साफ करू शकते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સુરક્ષિત Docker ક્લીનઅપ બંધ કન્ટેનર્સ, છૂટી છબીઓ અને બિલ્ડ કૅશમાંથી %@ સાફ કરી શકે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸುರಕ್ಷಿತ Docker ಸ್ವಚ್ಛತೆಯು ನಿಂತ ಕಂಟೇನರ್‌ಗಳು, ಅನಾಥ ಚಿತ್ರಗಳು ಮತ್ತು ಬಿಲ್ಡ್ ಕ್ಯಾಶ್‌ನ %@ ಅನ್ನು ತೆರವುಗೊಳಿಸಬಲ್ಲದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സുരക്ഷിത Docker വൃത്തിയാക്കലിന് നിർത്തിയ കണ്ടെയ്നറുകൾ, ഒറ്റപ്പെട്ട ഇമേജുകൾ, ബിൽഡ് ക്യാഷ് എന്നിവയുടെ %@ വൃത്തിയാക്കാനാകും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੁਰੱਖਿਅਤ Docker ਸਫਾਈ ਰੁਕੇ ਕੰਟੇਨਰਾਂ, ਲਟਕਦੀਆਂ ਤਸਵੀਰਾਂ ਅਤੇ ਬਿਲਡ ਕੈਸ਼ ਦਾ %@ ਸਾਫ਼ ਕਰ ਸਕਦੀ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza segura de Docker puede eliminar %@ de contenedores detenidos, imágenes huérfanas y caché de compilación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage Docker sûr peut purger %@ de conteneurs arrêtés, d'images orphelines et de cache de compilation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Docker-Bereinigung kann %@ an gestoppten Containern, verwaisten Images und Build-Cache entfernen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza segura do Docker pode remover %@ de contêineres parados, imagens órfãs e cache de compilação."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia sicura Docker può rimuovere %@ di container fermi, immagini orfane e cache di build."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker の安全クリーンアップにより、停止中のコンテナ、未参照イメージ、ビルドキャッシュ %@ を整理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 Docker 정리로 중지된 컨테이너, 고아 이미지 및 빌드 캐시 %@을(를) 정리할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 安全清理可回收 %@ 的已停止容器、悬空镜像和构建缓存。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безопасная очистка Docker может удалить %@ остановленных контейнеров, неиспользуемых образов и кэша сборки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للتنظيف الآمن لـ Docker إزالة %@ من الحاويات المتوقفة والصور العالقة وذاكرة تخزين البناء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוי Docker בטוח יכול להסיר %@ של מכולות כבויות, תמונות יתומות ומטמון בנייה."
          }
        }
      }
    },
