    "Package cleanup command is not on the approved allowlist: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Package cleanup command is not on the approved allowlist: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैकेज क्लीनअप कमांड स्वीकृत अनुमति-सूची में नहीं है: %@।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাকেজ ক্লিনআপ কমান্ডটি অনুমোদিত তালিকায় নেই: %@।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொகுப்பு சுத்திகரிப்புக் கட்டளை அங்கீகரிக்கப்பட்ட அனுமதிப் பட்டியலில் இல்லை: %@."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్యాకేజీ శుభ్రత కమాండ్ ఆమోదించిన అనుమతి జాబితాలో లేదు: %@."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पॅकेज क्लीनअप कमांड मंजूर अनुमती यादीत नाही: %@."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૅકેજ ક્લીનઅપ કમાન્ડ મંજૂર સૂચિમાં નથી: %@."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ಯಾಕೇಜ್ ಸ್ವಚ್ಛತಾ ಆಜ್ಞೆಯು ಅನುಮೋದಿತ ಪಟ್ಟಿಯಲ್ಲಿಲ್ಲ: %@."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാക്കേജ് വൃത്തിയാക്കൽ കമാൻഡ് അംഗീകരിച്ച പട്ടികയിലില്ല: %@."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੈਕੇਜ ਸਫਾਈ ਕਮਾਂਡ ਮਨਜ਼ੂਰ ਸੂਚੀ ਵਿੱਚ ਨਹੀਂ ਹੈ: %@।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comando de limpieza del paquete no está en la lista permitida: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande de nettoyage du paquet ne figure pas sur la liste autorisée : %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketbereinigungsbefehl steht nicht auf der freigegebenen Liste: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando de limpeza de pacotes não está na lista de permissão aprovada: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando di pulizia del pacchetto non è nella lista consentita approvata: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージクリーンアップコマンドは承認済みの許可リストに含まれていません: %@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지 정리 명령이 승인된 허용 목록에 없습니다: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包清理命令不在已批准的允许列表中：%@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда очистки пакета отсутствует в списке разрешенных: %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمر تنظيف الحزم ليس ضمن القائمة المسموح بها المعتمدة: %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פקודת ניקוי החבילה אינה ברשימה המאושרת: %@."
          }
        }
      }
    },
    "Package manager caches are rebuildable. Review before moving to Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Package manager caches are rebuildable. Review before moving to Trash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैकेज मैनेजर कैश दोबारा बनाए जा सकते हैं। ट्रैश में भेजने से पहले समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাকেজ ম্যানেজার ক্যাশ পুনরায় তৈরি করা যায়। ট্র্যাশে পাঠানোর আগে পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொகுப்பு மேலாளர் கேஸ்களை மீண்டும் உருவாக்கலாம். குப்பைத் தொட்டிக்கு நகர்த்தும் முன் மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్యాకేజీ మేనేజర్ క్యాష్‌లను మళ్లీ నిర్మించవచ్చు. ట్రాష్‌లోకి తరలించే ముందు సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पॅकेज मॅनेजर कॅशे पुन्हा तयार करता येतात. ट्रॅशमध्ये हलवण्यापूर्वी पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૅકેજ મૅનેજર કૅશ ફરી બનાવી શકાય છે. ટ્રૅશમાં ખસેડતાં પહેલાં સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ಯಾಕೇಜ್ ಮ್ಯಾನೇಜರ್ ಕ್ಯಾಶ್‌ಗಳನ್ನು ಮರುನಿರ್ಮಿಸಬಹುದು. ಟ್ರ್ಯಾಶ್‌ಗೆ ಸರಿಸುವ ಮೊದಲು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാക്കേജ് മാനേജർ ക്യാഷുകൾ വീണ്ടും നിർമ്മിക്കാവുന്നതാണ്. ട്രാഷിലേക്ക് മാറ്റുന്നതിന് മുമ്പ് അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੈਕੇਜ ਮੈਨੇਜਰ ਕੈਸ਼ ਮੁੜ ਬਣਾਏ ਜਾ ਸਕਦੇ ਹਨ। ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜਣ ਤੋਂ ਪਹਿਲਾਂ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cachés de gestores de paquetes son reconstruibles. Revísalas antes de moverlas al Basurero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les caches de gestionnaires de paquets sont reconstructibles. Vérifiez avant de placer dans la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketmanager-Caches sind neu erstellbar. Vor dem Verschieben in den Papierkorb prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches de gerenciadores de pacotes são recriáveis. Revise antes de mover para o Lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache dei gestori pacchetti sono ricreabili. Controllale prima di spostarle nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージマネージャのキャッシュは再生成可能です。ゴミ箱へ移動する前に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지 관리자 캐시는 다시 생성할 수 있습니다. 휴지통으로 이동하기 전에 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理器缓存可重建。移至废纸篓前请先检查。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэши пакетных менеджеров можно пересоздать. Проверьте перед перемещением в Корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذاكرات التخزين المؤقت لمديري الحزم قابلة لإعادة الإنشاء. راجعها قبل النقل إلى سلة المهملات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מטמוני מנהלי חבילות ניתנים ליצירה מחדש. בדקו לפני ההעברה לפח."
          }
        }
      }
    },
    "Package-manager cleanup uses the provider CLI and is not fully undoable; explicit user approval serves as the required review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Package-manager cleanup uses the provider CLI and is not fully undoable; explicit user approval serves as the required review."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैकेज-मैनेजर क्लीनअप प्रदाता के CLI का उपयोग करता है और पूरी तरह पूर्ववत नहीं हो सकता; आपकी स्पष्ट स्वीकृति आवश्यक समीक्षा मानी जाती है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাকেজ-ম্যানেজার ক্লিনআপ প্রদানকারীর CLI ব্যবহার করে এবং সম্পূর্ণভাবে পূর্বাবস্থায় ফেরানো যায় না; আপনার স্পষ্ট অনুমোদনই প্রয়োজনীয় পর্যালোচনা হিসেবে গণ্য হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொகுப்பு-மேலாளர் சுத்திகரிப்பு வழங்குநரின் CLI ஐப் பயன்படுத்துகிறது, முழுமையாக செயல்தவிர்க்க இயலாது; உங்கள் வெளிப்படையான அங்கீகாரம் தேவையான மதிப்பாய்வாகக் கருதப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్యాకేజీ-మేనేజర్ శుభ్రత ప్రొవైడర్ CLI ని ఉపయోగిస్తుంది మరియు పూర్తిగా రద్దు చేయలేరు; మీ స్పష్టమైన ఆమోదం అవసరమైన సమీక్షగా పరిగణించబడుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पॅकेज-मॅनेजर क्लीनअप प्रदात्याचे CLI वापरते आणि पूर्णपणे पूर्ववत करता येत नाही; तुमची स्पष्ट मंजुरी आवश्यक पुनरावलोकन म्हणून ग्राह्य धरली जाते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૅકેજ-મૅનેજર ક્લીનઅપ પ્રદાતાના CLI નો ઉપયોગ કરે છે અને સંપૂર્ણ પૂર્વવત કરી શકાતું નથી; તમારી સ્પષ્ટ મંજૂરી જરૂરી સમીક્ષા ગણાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ಯಾಕೇಜ್-ಮ್ಯಾನೇಜರ್ ಸ್ವಚ್ಛತೆಯು ಪೂರೈಕೆದಾರರ CLI ಅನ್ನು ಬಳಸುತ್ತದೆ ಮತ್ತು ಸಂಪೂರ್ಣವಾಗಿ ರದ್ದುಮಾಡಲಾಗುವುದಿಲ್ಲ; ನಿಮ್ಮ ಸ್ಪಷ್ಟ ಅನುಮೋದನೆಯು ಅಗತ್ಯ ಪರಿಶೀಲನೆಯಾಗಿರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാക്കേജ്-മാനേജർ വൃത്തിയാക്കൽ ദാതാവിന്റെ CLI ഉപയോഗിക്കുന്നതിനാൽ പൂർണ്ണമായി പഴയപടിയാക്കാനാകില്ല; നിങ്ങളുടെ വ്യക്തമായ അംഗീകാരം ആവശ്യമായ അവലോകനമായി കണക്കാക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੈਕੇਜ-ਮੈਨੇਜਰ ਸਫਾਈ ਪ੍ਰਦਾਤਾ ਦੇ CLI ਦੀ ਵਰਤੋਂ ਕਰਦੀ ਹੈ ਅਤੇ ਪੂਰੀ ਤਰ੍ਹਾਂ ਵਾਪਸ ਨਹੀਂ ਹੋ ਸਕਦੀ; ਤੁਹਾਡੀ ਸਪਸ਼ਟ ਮਨਜ਼ੂਰੀ ਲੋੜੀਂਦੀ ਸਮੀਖਿਆ ਮੰਨੀ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza con el gestor de paquetes usa la CLI del proveedor y no es totalmente reversible; tu aprobación explícita actúa como revisión obligatoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage par gestionnaire de paquets utilise l'outil CLI du fournisseur et n'est pas entièrement annulable ; votre approbation explicite vaut validation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Paketmanager-Bereinigung verwendet die Anbieter-CLI und ist nicht vollständig widerrufbar; deine ausdrückliche Genehmigung dient als erforderliche Prüfung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza por gerenciador de pacotes usa a CLI do provedor e não é totalmente reversível; sua aprovação explícita serve como revisão obrigatória."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia con gestore pacchetti usa la CLI del provider e non è completamente annullabile; la tua approvazione esplicita funge da revisione obbligatoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージマネージャのクリーンアップは各ツールの CLI を使用するため完全には取り消せません。ユーザーによる明示的な承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지 관리자 정리는 해당 도구의 CLI를 사용하므로 완전히 실행 취소할 수 없으며, 사용자의 명시적인 승인이 필수 검토 역할을 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理器清理使用对应工具的命令行，无法完全撤销；需要您明确批准确认。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистка использует CLI инструмента и не является полностью обратимой; ваше явное одобрение служит подтверждением."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم التنظيف واجهة سطر الأوامر الخاصة بالأداة ولا يمكن التراجع عنه بالكامل؛ تعد موافقتك الصريحة هي المراجعة المطلوبة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הניקוי משתמש בממשק הפקודה של הכלי ואינו ניתן לביטול מלא; אישור מפורש שלך משמש כבדיקה הנדרשת."
          }
        }
      }
    },
    "Paired formats. Removing a component loses its editing or motion data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired formats. Removing a component loses its editing or motion data"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "युग्मित फ़ॉर्मेट। किसी एक घटक को हटाने से उसका संपादन या गति डेटा नष्ट हो जाएगा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জোড়া ফরম্যাট। একটি উপাদান সরালে এর সম্পাদনা বা মোশন ডেটা হারিয়ে যাবে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைக்கப்பட்ட வடிவங்கள். ஒரு கூறினை அகற்றினால் அதன் திருத்த அல்லது இயக்கத் தரவு இழக்கப்படும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జత ఫార్మాట్లు. ఒక భాగాన్ని తీసివేస్తే దాని ఎడిటింగ్ లేదా మోషన్ డేటా కోల్పోతారు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जोडलेले स्वरूप. एक घटक काढल्यास त्याचा संपादन किंवा मोशन डेटा गमावला जाईल"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જોડાયેલા ફોર્મેટ્સ. એક ઘટક દૂર કરવાથી તેનો સંપાદન અથવા મોશન ડેટા ગુમાવશો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜೋಡಿಸಿದ ಸ್ವರೂಪಗಳು. ಒಂದು ಘಟಕವನ್ನು ತೆಗೆದುಹಾಕಿದರೆ ಅದರ ಸಂಪಾದನೆ ಅಥವಾ ಚಲನೆಯ ಡೇಟಾ ಕಳೆದುಹೋಗುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ജോടിയാക്കിയ ഫോർമാറ്റുകൾ. ഒരു ഘടകം നീക്കം ചെയ്താൽ അതിന്റെ എഡിറ്റിംഗ് അല്ലെങ്കിൽ മോഷൻ ഡാറ്റ നഷ്ടമാകും"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੋੜੇ ਹੋਏ ਫਾਰਮੈਟ। ਇੱਕ ਹਿੱਸਾ ਹਟਾਉਣ ਨਾਲ ਇਸਦਾ ਸੰਪਾਦਨ ਜਾਂ ਮੋਸ਼ਨ ਡੇਟਾ ਗੁੰਮ ਹੋ ਜਾਵੇਗਾ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatos emparejados. Quitar un componente elimina sus datos de edición o movimiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Formats jumelés. Supprimer un composant fait perdre ses données de retouche ou de mouvement"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelte Formate. Beim Entfernen einer Komponente gehen Bearbeitungs- oder Bewegungsdaten verloren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formatos emparelhados. Remover um componente perde seus dados de edição ou movimento"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formati abbinati. Rimuovendo un componente perdi i suoi dati di modifica o movimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペア形式です。一部を削除すると編集データまたはモーションデータが失われます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짝을 이루는 형식입니다. 구성 요소를 제거하면 편집 또는 모션 데이터가 손실됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对格式文件。移除任一组件将丢失其编辑或动态数据"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Парные форматы. Удаление компонента уничтожит данные правок или движения"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صيغ مقترنة. إزالة أحد المكوّنات تفقد بيانات التعديل أو الحركة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פורמטים מצומדים. הסרת רכיב מוחקת את נתוני העריכה או התנועה"
          }
        }
      }
    },
