          "stringUnit": {
            "state": "translated",
            "value": "कोडिंग-एजेंट लॉग/कैश आर्टिफैक्ट। कॉन्फ़िगरेशन और मेमोरी पथ सुरक्षित रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোডিং-এজেন্ট লগ/ক্যাশ আর্টিফ্যাক্ট। কনফিগ ও মেমরি পথ সুরক্ষিত থাকে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறியீட்டு-முகவர் பதிவு/கேச் உருவாக்கம். அமைப்பு மற்றும் நினைவகப் பாதைகள் பாதுகாக்கப்பட்டிருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కోడింగ్-ఏజెంట్ లాగ్/క్యాష్ ఆర్టిఫ్యాక్ట్. కాన్ఫిగ్ మరియు మెమరీ మార్గాలు రక్షితంగా ఉంటాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोडिंग-एजंट लॉग/कॅशे आर्टिफॅक्ट. कॉन्फिग आणि मेमरी मार्ग सुरक्षित राहतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોડિંગ-એજન્ટ લૉગ/કૅશ આર્ટિફૅક્ટ. કૉન્ફિગ અને મેમરી માર્ગો સુરક્ષિત રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೋಡಿಂಗ್-ಏಜೆಂಟ್ ಲಾಗ್/ಕ್ಯಾಶ್ ಆರ್ಟಿಫ್ಯಾಕ್ಟ್. ಕಾನ್ಫಿಗ್ ಮತ್ತು ಮೆಮೊರಿ ಮಾರ್ಗಗಳು ರಕ್ಷಿತವಾಗಿರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കോഡിംഗ്-ഏജന്റ് ലോഗ്/ക്യാഷ് ആർട്ടിഫാക്റ്റ്. കോൺഫിഗ്, മെമ്മറി പാതകൾ സംരക്ഷിക്കപ്പെട്ടിരിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਡਿੰਗ-ਏਜੰਟ ਲੌਗ/ਕੈਸ਼ ਆਰਟੀਫੈਕਟ। ਕੌਨਫਿਗ ਅਤੇ ਮੈਮੋਰੀ ਮਾਰਗ ਸੁਰੱਖਿਅਤ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefacto de registro/caché de agente de código. Las rutas de configuración y memoria siguen protegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefact journal/cache d'agent de code. Les chemins de configuration et de mémoire restent protégés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokoll-/Cache-Artefakt eines Coding-Agenten. Konfigurations- und Speicherpfade bleiben geschützt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefato de registro/cache de agente de código. Caminhos de configuração e memória continuam protegidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Artefatto log/cache di agente di codice. I percorsi di configurazione e memoria restano protetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングエージェントのログ／キャッシュ成果物。設定パスとメモリパスは保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트 로그/캐시 아티팩트입니다. 설정 및 메모리 경로는 계속 보호됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编程代理的日志/缓存产物。配置和记忆路径仍受保护。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журналы/кэш агента кода. Пути к настройкам и памяти защищены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجلات/تخزين مؤقت لوكيل البرمجة. تظل مسارات الإعدادات والذاكرة محمية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוצר יומן/מטמון של סוכן קוד. נתיבי ההגדרות והזיכרון נותרים מוגנים."
          }
        }
      }
    },
