    "Live Photo pair. Removing a component loses motion or still data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo pair. Removing a component loses motion or still data"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo जोड़ी। किसी एक घटक को हटाने से गति या स्थिर फ़ोटो डेटा खो जाएगा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo জোড়া। একটি উপাদান সরালে মোশন বা স্থির ছবির ডেটা হারিয়ে যাবে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo இணை. ஒரு கூறினை அகற்றினால் இயக்கம் அல்லது நிலைப் படத் தரவு இழக்கப்படும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo జత. ఒక భాగాన్ని తీసివేస్తే మోషన్ లేదా స్థిర ఫోటో డేటా కోల్పోతారు"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo जोडी. एक घटक काढल्यास मोशन किंवा स्थिर फोटो डेटा गमावला जाईल"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo જોડી. એક ઘટક દૂર કરવાથી મોશન અથવા સ્થિર ફોટો ડેટા ગુમાવશો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo ಜೋಡಿ. ಒಂದು ಘಟಕವನ್ನು ತೆಗೆದುಹಾಕಿದರೆ ಚಲನೆ ಅಥವಾ ಸ್ಥಿರ ಫೋಟೋ ಡೇಟಾ ಕಳೆದುಹೋಗುತ್ತದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo ജോഡി. ഒരു ഘടകം നീക്കം ചെയ്താൽ മോഷൻ അല്ലെങ്കിൽ നിശ്ചല ഫോട്ടോ ഡാറ്റ നഷ്ടമാകും"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo ਜੋੜਾ। ਇੱਕ ਹਿੱਸਾ ਹਟਾਉਣ ਨਾਲ ਮੋਸ਼ਨ ਜਾਂ ਸਥਿਰ ਫੋਟੋ ਡੇਟਾ ਗੁੰਮ ਹੋ ਜਾਵੇਗਾ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Par de Live Photo. Quitar un componente elimina los datos de movimiento o de imagen fija"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paire Live Photo. Supprimer un composant fait perdre la vidéo ou l'image fixe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo-Paar. Durch das Entfernen einer Komponente gehen Bewegungs- oder Bilddaten verloren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Par de Live Photo. Remover um componente perde os dados de movimento ou da imagem estática"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coppia Live Photo. Rimuovendo un componente perdi i dati video o dell'immagine fissa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo のペアです。一方を削除すると動画または静止画データが失われます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo 쌍입니다. 한쪽을 제거하면 모션 또는 스틸 데이터가 손실됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo 配对组件。移除任一部分都会丢失动态视频或静态图像数据"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пара Live Photo. Удаление одного компонента сотрет видео или статичное фото"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زوج Live Photo. تؤدي إزالة أحد المكوّنين إلى فقدان الحركة أو الصورة الثابتة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זוג Live Photo. הסרת רכיב מוחקת את נתוני התנועה או הסטילס"
          }
        }
      }
    },
