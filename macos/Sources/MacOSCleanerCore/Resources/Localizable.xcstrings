    "One of the selected snapshots no longer exists.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the selected snapshots no longer exists."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित स्नैपशॉट में से एक अब मौजूद नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত স্ন্যাপশটগুলোর একটি আর বিদ্যমান নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த ஸ்னாப்ஷாட்களில் ஒன்று இப்போது இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న స్నాప్‌షాట్లలో ఒకటి ఇప్పుడు ఉనికిలో లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या स्नॅपशॉट्सपैकी एक आता अस्तित्वात नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલ સ્નૅપશૉટ્સમાંથી એક હવે અસ્તિત્વમાં નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಸ್ನ್ಯಾಪ್‌ಶಾಟ್‌ಗಳಲ್ಲಿ ಒಂದು ಈಗ ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത സ്നാപ്പ്ഷോട്ടുകളിൽ ഒന്ന് ഇപ്പോൾ നിലവിലില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੇ ਸਨੈਪਸ਼ਾਟਾਂ ਵਿੱਚੋਂ ਇੱਕ ਹੁਣ ਮੌਜੂਦ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una de las instantáneas seleccionadas ya no existe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'un des instantanés sélectionnés n'existe plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einer der ausgewählten Schnappschüsse existiert nicht mehr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma das capturas selecionadas não existe mais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una delle istantanee selezionate non esiste più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたスナップショットの 1 つはすでに存在しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 스냅샷 중 하나가 더 이상 존재하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选快照之一已不存在。"
          }
