    "The compressed copy is not smaller. The original was kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compressed copy is not smaller. The original was kept."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपीड़ित प्रति छोटी नहीं बनी। मूल फ़ाइल सुरक्षित रखी गई।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপ্রেস করা কপিটি ছোট হয়নি। মূল ফাইল রাখা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கப்பட்ட நகல் சிறியதாக இல்லை. அசல் வைக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదించిన ప్రతి చిన్నదిగా లేదు. అసలు ఫైల్ ఉంచబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस केलेली प्रत लहान झाली नाही. मूळ फाइल ठेवली आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેસ કરેલી નકલ નાની નથી બની. મૂળ ફાઇલ રાખવામાં આવી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚಿತ ಪ್ರತಿಯು ಚಿಕ್ಕದಾಗಿಲ್ಲ. ಮೂಲ ಫೈಲ್ ಇರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രസ് ചെയ്ത പകർപ്പ് ചെറുതല്ല. യഥാർത്ഥ ഫയൽ നിലനിർത്തി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪ੍ਰੈਸ ਕੀਤੀ ਕਾਪੀ ਛੋਟੀ ਨਹੀਂ ਬਣੀ। ਮੂਲ ਫਾਈਲ ਰੱਖੀ ਗਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia comprimida no es más pequeña. Se conservó el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie compressée n'est pas plus petite. L'original a été conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die komprimierte Kopie ist nicht kleiner. Das Original wurde behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia comprimida não é menor. O original foi mantido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia compressa non è più piccola. L'originale è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮後のコピーが元より小さくならなかったため、元のファイルを保持しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축된 사본이 더 작지 않아 원본을 유지했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩后的副本并未更小。已保留原文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сжатая копия не меньше оригинала. Сохранен оригинал."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النسخة المضغوطة ليست أصغر حجمًا. تم الاحتفاظ بالأصل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותק המכווץ אינו קטן יותר. המקור נשמר."
          }
        }
      }
    },
    "The compressed image did not pass verification.": {
