    "Photos cannot add items to this album.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos cannot add items to this album."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो इस एल्बम में आइटम नहीं जोड़ सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো এই অ্যালবামে আইটেম যোগ করতে পারছে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்கள் இந்த ஆல்பத்தில் உருப்படிகளைச் சேர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలు ఈ ఆల్బమ్‌కు అంశాలను జోడించలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो या अल्बममध्ये आयटम्स जोडू शकत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા આ આલ્બમમાં આઇટમ્સ ઉમેરી શકતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳು ಈ ಆಲ್ಬಮ್‌ಗೆ ಐಟಂಗಳನ್ನು ಸೇರಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോസിന് ഈ ആൽബത്തിലേക്ക് ഇനങ്ങൾ ചേർക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫੋਟੋ ਇਸ ਐਲਬਮ ਵਿੱਚ ਆਈਟਮਾਂ ਸ਼ਾਮਲ ਨਹੀਂ ਕਰ ਸਕਦੀ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos no puede añadir elementos a este álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos ne peut pas ajouter d'éléments à cet album."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos kann diesem Album keine Objekte hinzufügen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fotos não pode adicionar itens a este álbum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto non può aggiungere elementi a questo album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」はこのアルバムに項目を追加できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱이 이 앨범에 항목을 추가할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“照片”无法将项目添加到此相簿。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Фото» не может добавить объекты в этот альбом."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لتطبيق الصور إضافة عناصر إلى هذا الألبوم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציית התמונות אינה יכולה להוסיף פריטים לאלבום זה."
          }
        }
      }
    },
    "Picked in burst": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picked in burst"
          }
        },
        "hi": {
          "stringUnit": {
