    "This item cannot be restored here. Check Trash or Recently Deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item cannot be restored here. Check Trash or Recently Deleted."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आइटम को यहाँ पुनर्स्थापित नहीं किया जा सकता। ट्रैश या हाल ही में हटाए गए जाँचें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আইটেমটি এখান থেকে পুনরুদ্ধার করা যাবে না। ট্র্যাশ বা সম্প্রতি মোছা পরীক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உருப்படியை இங்கிருந்து மீட்டெடுக்க முடியாது. குப்பைத் தொட்டி அல்லது சமீபத்தில் நீக்கியவையைப் பார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అంశాన్ని ఇక్కడి నుండి పునరుద్ధరించలేరు. ట్రాష్ లేదా ఇటీవల తొలగించినవి తనిఖీ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा आयटम येथून पुनर्संचयित करता येत नाही. ट्रॅश किंवा अलीकडे हटवलेले तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ આઇટમ અહીંથી પુનઃસ્થાપિત કરી શકાતી નથી. ટ્રૅશ અથવા તાજેતરમાં કાઢી નાખેલા તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಐಟಂ ಅನ್ನು ಇಲ್ಲಿಂದ ಮರುಸ್ಥಾಪಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಟ್ರ್ಯಾಶ್ ಅಥವಾ ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഇനം ഇവിടെ നിന്ന് പുനഃസ്ഥാപിക്കാനാകില്ല. ട്രാഷോ അടുത്തിടെ ഇല്ലാതാക്കിയവയോ പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਆਈਟਮ ਇੱਥੋਂ ਬਹਾਲ ਨਹੀਂ ਹੋ ਸਕਦੀ। ਟਰੈਸ਼ ਜਾਂ ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਜਾਂਚੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento no puede restaurarse aquí. Revisa el Basurero o Recientemente eliminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément ne peut pas être restauré ici. Vérifiez la Corbeille ou Récemment supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Objekt kann hier nicht wiederhergestellt werden. Prüfe den Papierkorb oder Zuletzt gelöscht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item não pode ser restaurado aqui. Verifique o Lixo ou Excluídos recentemente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento non può essere ripristinato qui. Controlla il Cestino o Eliminati di recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はここから復元できません。ゴミ箱または「最近削除した項目」を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 여기에서 복원할 수 없습니다. 휴지통 또는 최근 삭제된 항목을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此处还原此项目。请检查废纸篓或“最近删除”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот объект нельзя восстановить здесь. Проверьте Корзину или «Недавно удаленные»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استعادة هذا العنصر هنا. تحقق من سلة المهملات أو المحذوفة مؤخرًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשחזר פריט זה כאן. בדקו בפח או בנמחקו לאחרונה."
          }
        }
      }
