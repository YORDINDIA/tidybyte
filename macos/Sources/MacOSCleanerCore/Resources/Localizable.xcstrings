    "Target no longer exists on disk: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target no longer exists on disk: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्ष्य अब डिस्क पर मौजूद नहीं है: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক্ষ্য আর ডিস্কে বিদ্যমান নেই: %@"
