        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೊಸ ಫೋಟೋ ಐಟಂ ಅನ್ನು ದೃಢೀಕರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಮೂಲ ಐಟಂ ಇರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ ഫോട്ടോ ഇനം സ്ഥിരീകരിക്കാനായില്ല. യഥാർത്ഥ ഇനം നിലനിർത്തി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਵੀਂ ਫੋਟੋ ਆਈਟਮ ਦੀ ਪੁਸ਼ਟੀ ਨਹੀਂ ਹੋ ਸਕੀ। ਮੂਲ ਆਈਟਮ ਰੱਖੀ ਗਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el nuevo recurso de Fotos. Se conservó el original."
          }
        },
        "fr": {
