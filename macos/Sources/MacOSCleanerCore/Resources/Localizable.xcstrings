    "Interrupted operation dismissed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupted operation dismissed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाधित प्रक्रिया खारिज कर दी गई।"
