            "state": "translated",
            "value": "L'azione pianificata fa riferimento a una destinazione mancante: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定されたアクションが存在しない対象を参照しています: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획된 작업이 없는 대상을 참조합니다: %@"
          }
        },
        "zh-Hans": {
