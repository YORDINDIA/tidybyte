    "Filtered plan excluding selected items.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtered plan excluding selected items."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित आइटम छोड़कर फ़िल्टर की गई योजना।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত আইটেম বাদ দিয়ে ফিল্টার করা পরিকল্পনা।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த உருப்படிகள் தவிர்த்து வடிகட்டிய திட்டம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న అంశాలను మినహాయించి ఫిల్టర్ చేసిన ప్రణాళిక."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेले आयटम वगळून फिल्टर केलेली योजना."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલી આઇટમ્સ સિવાયની ફિલ્ટર કરેલી યોજના."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಐಟಂಗಳನ್ನು ಹೊರತುಪಡಿಸಿ ಫಿಲ್ಟರ್ ಮಾಡಿದ ಯೋಜನೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത ഇനങ്ങൾ ഒഴിവാക്കിയ ഫിൽട്ടർ ചെയ്ത പ്ലാൻ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੀਆਂ ਆਈਟਮਾਂ ਨੂੰ ਛੱਡ ਕੇ ਫਿਲਟਰ ਕੀਤੀ ਯੋਜਨਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan filtrado que excluye los elementos seleccionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan filtré excluant les éléments sélectionnés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefilterter Plan ohne ausgewählte Objekte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Plano filtrado excluindo os itens selecionados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piano filtrato escludendo gli elementi selezionati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択項目を除外したフィルタ済みプラン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목을 제외한 필터링된 계획입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排除所选项目的筛选后计划。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отфильтрованный план без выбранных объектов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطة مصفّاة تستثني العناصر المحددة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוכנית מסוננת ללא הפריטים שנבחרו."
          }
        }
      }
    },
    "Filtered to safe-only (low risk) actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtered to safe-only (low risk) actions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल सुरक्षित (कम जोखिम) क्रियाओं पर फ़िल्टर किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধুমাত্র নিরাপদ (কম ঝুঁকি) কাজে ফিল্টার করা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதுகாப்பான (குறைந்த ஆபத்து) செயல்களுக்கு மட்டும் வடிகட்டப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సురక్షితమైన (తక్కువ ప్రమాదం) చర్యలకు మాత్రమే ఫిల్టర్ చేయబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "केवळ सुरक्षित (कमी जोखीम) क्रियांसाठी फिल्टर केले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માત્ર સુરક્ષિત (ઓછું જોખમ) ક્રિયાઓ માટે ફિલ્ટર કરેલ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸುರಕ್ಷಿತ (ಕಡಿಮೆ ಅಪಾಯ) ಕ್ರಿಯೆಗಳಿಗೆ ಮಾತ್ರ ಫಿಲ್ಟರ್ ಮಾಡಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സുരക്ഷിതമായ (കുറഞ്ഞ അപകടസാധ്യത) പ്രവൃത്തികളിലേക്ക് മാത്രം ഫിൽട്ടർ ചെയ്തു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੇਵਲ ਸੁਰੱਖਿਅਤ (ਘੱਟ ਜੋਖਮ) ਕਾਰਵਾਈਆਂ ਤੱਕ ਫਿਲਟਰ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrado solo a acciones seguras (riesgo bajo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtré uniquement sur les actions sûres (risque faible)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf sichere Aktionen (geringes Risiko) gefiltert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrado apenas para ações seguras (baixo risco)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrato solo alle azioni sicure (rischio basso)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なアクション（低リスク）のみに絞り込み済み。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 작업(낮은 위험)만 표시하도록 필터링됨."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已筛选为仅显示安全操作（低风险）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отфильтровано только до безопасных действий (низкий риск)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت التصفية إلى الإجراءات الآمنة فقط (منخفضة الخطورة)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסונן לפעולות בטוחות בלבד (סיכון נמוך)."
          }
        }
      }
    },
