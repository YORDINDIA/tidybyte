        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объект больше не находится в Корзине и не может быть восстановлен: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد العنصر في سلة المهملات ولا يمكن استعادته: %@"
