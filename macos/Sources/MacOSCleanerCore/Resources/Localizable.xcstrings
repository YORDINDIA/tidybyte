          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La cible n'existe plus sur le disque : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziel existiert nicht mehr auf dem Laufwerk: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O destino não existe mais no disco: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La destinazione non esiste più su disco: %@"
          }
        },
        "ja": {
