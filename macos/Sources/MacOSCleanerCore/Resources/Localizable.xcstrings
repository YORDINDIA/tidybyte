            "state": "translated",
            "value": "중단된 작업을 닫았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已忽略中断的操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прерванная операция скрыта."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تجاهل العملية المتوقفة."
          }
        },
        "he": {
