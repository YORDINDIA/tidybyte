        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI वर्गीकरण छोड़ दिया गया (%@); परिणाम केवल स्थानीय नियमों पर आधारित हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "AI শ্রেণিবিন্যাস বাদ দেওয়া হয়েছে (%@); ফলাফল শুধুমাত্র স্থানীয় নিয়মের ওপর ভিত্তি করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI வகைப்பாடு தவிர்க்கப்பட்டது (%@); முடிவுகள் உள்ளூர் விதிகளின் அடிப்படையில் மட்டுமே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "AI వర్గీకరణ దాటవేయబడింది (%@); ఫలితాలు స్థానిక నియమాల నుండి మాత్రమే వచ్చాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI वर्गीकरण वगळले गेले (%@); निकाल केवळ स्थानिक नियमांवर आधारित आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "AI વર્ગીકરણ છોડી દેવામાં આવ્યું (%@); પરિણામો માત્ર સ્થાનિક નિયમો પરથી છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ವರ್ಗೀಕರಣವನ್ನು ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ (%@); ಫಲಿತಾಂಶಗಳು ಸ್ಥಳೀಯ ನಿಯಮಗಳಿಂದ ಮಾತ್ರ ಬಂದಿವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "AI വർഗ്ഗീകരണം ഒഴിവാക്കി (%@); ഫലങ്ങൾ പ്രാദേശിക നിയമങ്ങളിൽ നിന്ന് മാത്രമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ਵਰਗੀਕਰਨ ਛੱਡਿਆ ਗਿਆ (%@); ਨਤੀਜੇ ਕੇਵਲ ਸਥਾਨਕ ਨਿਯਮਾਂ 'ਤੇ ਆਧਾਰਿਤ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitió la clasificación con IA (%@); los resultados provienen solo de reglas locales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La classification par IA a été ignorée (%@) ; les résultats proviennent uniquement des règles locales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Klassifizierung übersprungen (%@); Ergebnisse basieren nur auf lokalen Regeln."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A classificação por IA foi ignorada (%@); os resultados vêm apenas de regras locais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Classificazione IA ignorata (%@); i risultati si basano solo su regole locali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 分類はスキップされました (%@)。結果はローカルルールのみに基づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 분류를 건너뛰었습니다(%@). 로컬 규칙 결과만 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过 AI 分类 (%@)；当前结果仅基于本地规则。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Классификация ИИ пропущена (%@); результаты получены только по локальным правилам."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي تصنيف الذكاء الاصطناعي (%@)؛ النتائج من القواعد المحلية فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיווג בינה מלאכותית דולג (%@); התוצאות מבוססות על כללים מקומיים בלבד."
          }
        }
      }
    },
    "AI is disabled in local-only privacy mode.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is disabled in local-only privacy mode."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल स्थानीय गोपनीयता मोड में AI अक्षम है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধুমাত্র স্থানীয় গোপনীয়তা মোডে AI অক্ষম রয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர்-மட்டும் தனியுரிமை பயன்முறையில் AI முடக்கப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థానిక-మాత్రమే గోప్యత మోడ్‌లో AI నిలిపివేయబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "केवळ स्थानिक गोपनीयता मोडमध्ये AI अक्षम आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "માત્ર-સ્થાનિક ગોપનીયતા મોડમાં AI અક્ષમ છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳೀಯ-ಮಾತ್ರ ಗೌಪ್ಯತೆ ಮೋಡ್‌ನಲ್ಲಿ AI ನಿಷ್ಕ್ರಿಯವಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രാദേശിക-മാത്രം സ്വകാര്യതാ മോഡിൽ AI പ്രവർത്തനരഹിതമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੇਵਲ-ਸਥਾਨਕ ਗੋਪਨੀਯਤਾ ਮੋਡ ਵਿੱਚ AI ਅਸਮਰੱਥ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA está desactivada en el modo de privacidad Solo local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA est désactivée en mode de confidentialité Local uniquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI ist im Datenschutzmodus „Nur lokal“ deaktiviert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA está desativada no modo de privacidade Somente local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA è disattivata nella modalità privacy Solo locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ローカルのみ」プライバシーモードでは AI が無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 전용 개인정보 보호 모드에서는 AI가 비활성화되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“仅本地”隐私模式下已禁用 AI。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ отключен в режиме конфиденциальности «Только локально»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء الاصطناعي معطّل في وضع الخصوصية المحلي فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בינה מלאכותית מושבתת במצב פרטיות מקומי בלבד."
          }
        }
      }
    },
