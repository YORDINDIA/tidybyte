    "Homebrew cleanup dry-run has stale downloads or old versions to review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew cleanup dry-run has stale downloads or old versions to review."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew क्लीनअप ड्राई-रन में समीक्षा के लिए पुराने डाउनलोड या पुराने संस्करण मिले हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ক্লিনআপ ড্রাই-রানে পর্যালোচনার জন্য পুরনো ডাউনলোড বা পুরনো সংস্করণ রয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew சுத்திகரிப்பு சோதனை இயக்கத்தில் மதிப்பாய்வுக்கான பழைய பதிவிறக்கங்கள் அல்லது பழைய பதிப்புகள் உள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew శుభ్రత డ్రై-రన్‌లో సమీక్షించడానికి పాత డౌన్‌లోడ్‌లు లేదా పాత వెర్షన్లు ఉన్నాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew क्लीनअप ड्राय-रनमध्ये पुनरावलोकनासाठी जुने डाउनलोड्स किंवा जुन्या आवृत्त्या आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ક્લીનઅપ ડ્રાય-રનમાં સમીક્ષા માટે જૂના ડાઉનલોડ્સ અથવા જૂના સંસ્કરણો છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ಸ್ವಚ್ಛತೆ ಡ್ರೈ-ರನ್‌ನಲ್ಲಿ ಪರಿಶೀಲಿಸಲು ಹಳೆಯ ಡೌನ್‌ಲೋಡ್‌ಗಳು ಅಥವಾ ಹಳೆಯ ಆವೃತ್ತಿಗಳಿವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew വൃത്തിയാക്കൽ ഡ്രൈ-റണ്ണിൽ അവലോകനം ചെയ്യാൻ പഴയ ഡൗൺലോഡുകളോ പഴയ പതിപ്പുകളോ ഉണ്ട്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ਸਫਾਈ ਡਰਾਈ-ਰਨ ਵਿੱਚ ਸਮੀਖਿਆ ਲਈ ਪੁਰਾਣੇ ਡਾਊਨਲੋਡਸ ਜਾਂ ਪੁਰਾਣੇ ਸੰਸਕਰਨ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El simulacro de limpieza de Homebrew tiene descargas obsoletas o versiones antiguas para revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La simulation de nettoyage Homebrew contient d'anciens téléchargements ou d'anciennes versions à examiner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew-Bereinigungs-Testlauf enthält alte Downloads oder ältere Versionen zur Prüfung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A simulação de limpeza do Homebrew tem downloads antigos ou versões antigas para revisar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La simulazione di pulizia Homebrew ha download obsoleti o vecchie versioni da esaminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew クリーンアップのドライランに、確認対象の古いダウンロードや旧バージョンがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 정리 시뮬레이션에 검토할 오래된 다운로드나 구버전이 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 清理试运行发现有待审阅的过期下载或旧版本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В пробной очистке Homebrew есть устаревшие загрузки или старые версии для проверки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الفحص التجريبي لتنظيف Homebrew على تنزيلات قديمة أو إصدارات سابقة للمراجعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בהרצת הבדיקה של Homebrew יש הורדות ישנות או גרסאות קודמות לבדיקה."
          }
        }
      }
    },
    "Hugging Face model cache.": {
      "localizations": {
