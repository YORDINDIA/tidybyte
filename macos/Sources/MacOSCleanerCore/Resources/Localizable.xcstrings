    "Photos access was not granted. You can still scan folders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos access was not granted. You can still scan folders."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो एक्सेस नहीं दिया गया। आप फिर भी फ़ोल्डर स्कैन कर सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো অ্যাক্সেস দেওয়া হয়নি। আপনি এখনও ফোল্ডার স্ক্যান করতে পারবেন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்பட அணுகல் வழங்கப்படவில்லை. நீங்கள் கோப்புறைகளை இன்னும் ஸ்கேன் செய்யலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోల యాక్సెస్ ఇవ్వబడలేదు. మీరు ఇంకా ఫోల్డర్లను స్కాన్ చేయవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो प्रवेश दिला गेला नाही. तुम्ही तरीही फोल्डर्स स्कॅन करू शकता."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો ઍક્સેસ આપવામાં આવ્યો નથી. તમે હજી પણ ફોલ્ડર્સ સ્કૅન કરી શકો છો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳ ಪ್ರವೇಶವನ್ನು ನೀಡಲಾಗಿಲ್ಲ. ನೀವು ಇನ್ನೂ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോസ് ആക്സസ് നൽകിയിട്ടില്ല. നിങ്ങൾക്ക് ഇപ്പോഴും ഫോൾഡറുകൾ സ്കാൻ ചെയ്യാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫੋਟੋ ਪਹੁੰਚ ਨਹੀਂ ਦਿੱਤੀ ਗਈ। ਤੁਸੀਂ ਅਜੇ ਵੀ ਫੋਲਡਰ ਸਕੈਨ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se concedió acceso a Fotos. Aún puedes analizar carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à Photos n'a pas été accordé. Vous pouvez tout de même analyser des dossiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fotos-Zugriff wurde nicht gewährt. Du kannst dennoch Ordner scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao Fotos não foi concedido. Você ainda pode analisar pastas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso a Foto non concesso. Puoi comunque analizzare le cartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」へのアクセスが許可されていません。フォルダのスキャンは引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근 권한이 부여되지 않았습니다. 폴더는 계속 스캔할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予“照片”访问权限。您仍可继续扫描文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к «Фото» не предоставлен. Вы все равно можете сканировать папки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُمنح إذن الوصول إلى الصور. لا يزال بإمكانك فحص المجلدات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתנה גישה לתמונות. עדיין ניתן לסרוק תיקיות."
          }
        }
      }
    },
