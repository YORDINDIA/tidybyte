    "Could not give %@ its own storage again (not enough free space, file in use, or a filesystem error). Try again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not give %@ its own storage again (not enough free space, file in use, or a filesystem error). Try again later."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को फिर से अपना अलग स्टोरेज नहीं दिया जा सका (पर्याप्त खाली स्थान नहीं, फ़ाइल उपयोग में है या फ़ाइल सिस्टम त्रुटि)। बाद में प्रयास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে পুনরায় নিজস্ব স্টোরেজ দেওয়া যায়নি (পর্যাপ্ত খালি জায়গা নেই, ফাইল ব্যবহৃত হচ্ছে বা ফাইলসিস্টেম ত্রুটি)। পরে আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கு மீண்டும் அதன் சொந்த சேமிப்பகத்தை வழங்க முடியவில்லை (போதுமான காலி இடமில்லை, கோப்பு பயன்பாட்டில் உள்ளது அல்லது கோப்புமுறைமை பிழை). பின்னர் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కు మళ్లీ దాని స్వంత నిల్వను ఇవ్వలేకపోయాము (తగినంత ఖాళీ స్థలం లేదు, ఫైల్ ఉపయోగంలో ఉంది లేదా ఫైల్‌సిస్టమ్ లోపం). తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ला पुन्हा स्वतःचे स्वतंत्र स्टोरेज देता आले नाही (पुरेशी मोकळी जागा नाही, फाइल वापरात आहे किंवा फाइलसिस्टम त्रुटी). नंतर पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ને ફરી પોતાનું અલગ સ્ટોરેજ આપી શકાયું નહીં (પૂરતી ખાલી જગ્યા નથી, ફાઇલ ઉપયોગમાં છે અથવા ફાઇલસિસ્ટમ ભૂલ). પછી ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಗೆ ಮತ್ತೆ ಅದರ ಸ್ವಂತ ಸಂಗ್ರಹಣೆಯನ್ನು ನೀಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ (ಸಾಕಷ್ಟು ಖಾಲಿ ಸ್ಥಳವಿಲ್ಲ, ಫೈಲ್ ಬಳಕೆಯಲ್ಲಿದೆ ಅಥವಾ ಫೈಲ್‌ಸಿಸ್ಟಮ್ ದೋಷ). ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ന് വീണ്ടും സ്വന്തം സ്റ്റോറേജ് നൽകാനായില്ല (ആവശ്യത്തിന് ഒഴിഞ്ഞ ഇടമില്ല, ഫയൽ ഉപയോഗത്തിലാണ് അല്ലെങ്കിൽ ഫയൽസിസ്റ്റം പിശക്). പിന്നീട് ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਨੂੰ ਦੁਬਾਰਾ ਆਪਣੀ ਵੱਖਰੀ ਸਟੋਰੇਜ ਨਹੀਂ ਦਿੱਤੀ ਜਾ ਸਕੀ (ਕਾਫ਼ੀ ਖਾਲੀ ਥਾਂ ਨਹੀਂ, ਫਾਈਲ ਵਰਤੋਂ ਵਿੱਚ ਹੈ ਜਾਂ ਫਾਈਲ-ਸਿਸਟਮ ਗਲਤੀ)। ਬਾਅਦ ਵਿੱਚ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo devolver almacenamiento propio a %@ (espacio libre insuficiente, archivo en uso o error del sistema de archivos). Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de redonner son propre stockage à %@ (espace libre insuffisant, fichier utilisé ou erreur système). Réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte keinen eigenen Speicher mehr erhalten (zu wenig freier Platz, Datei in Verwendung oder Dateisystemfehler). Später erneut versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível devolver armazenamento próprio a %@ (espaço livre insuficiente, arquivo em uso ou erro do sistema de arquivos). Tente novamente mais tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile restituire spazio proprio a %@ (spazio libero insufficiente, file in uso o errore del file system). Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に独立した領域を再割り当てできませんでした（空き容量不足、使用中、またはファイルシステムエラー）。あとでお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 별도 저장 공간을 다시 할당할 수 없습니다(여유 공간 부족, 파일 사용 중 또는 파일 시스템 오류). 나중에 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新为 %@ 分配独立存储空间（可用空间不足、文件正在使用或文件系统错误）。请稍后重试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось вернуть %@ отдельное место на диске (недостаточно свободного места, файл занят или ошибка файловой системы). Повторите позже."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر منح %@ مساحة تخزين مستقلة مجددًا (المساحة الحرة غير كافية، أو الملف قيد الاستخدام، أو خطأ في نظام الملفات). حاول لاحقًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להעניק ל-%@ אחסון עצמאי מחדש (אין מספיק שטח פנוי, קובץ בשימוש או שגיאת מערכת קבצים). נסו שוב מאוחר יותר."
          }
        }
      }
    },
    "Could not record the undo trail (%@); the action was not performed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not record the undo trail (%@); the action was not performed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ववत रिकॉर्ड दर्ज नहीं हो सका (%@); क्रिया नहीं की गई।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্বাবস্থার রেকর্ড সংরক্ষণ করা যায়নি (%@); কাজটি সম্পন্ন করা হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்தவிர் பதிவைப் பதிவுசெய்ய முடியவில்லை (%@); செயல் செய்யப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రద్దు రికార్డును నమోదు చేయలేకపోయాము (%@); చర్య చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ववत नोंद जतन करता आली नाही (%@); क्रिया केली गेली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્વવત નોંધ સાચવી શકાઈ નહીં (%@); ક્રિયા કરવામાં આવી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರದ್ದು ದಾಖಲೆಯನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ (%@); ಕ್ರಿಯೆಯನ್ನು ಮಾಡಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പഴയപടിയാക്കൽ രേഖ സംരക്ഷിക്കാനായില്ല (%@); പ്രവൃത്തി ചെയ്തില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਾਪਸੀ ਰਿਕਾਰਡ ਦਰਜ ਨਹੀਂ ਹੋ ਸਕਿਆ (%@); ਕਾਰਵਾਈ ਨਹੀਂ ਕੀਤੀ ਗਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo registrar el historial de deshacer (%@); no se realizó la acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer le journal d'annulation (%@) ; l'action n'a pas été exécutée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsspur konnte nicht aufgezeichnet werden (%@); die Aktion wurde nicht ausgeführt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registrar o histórico de desfazer (%@); a ação não foi executada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare la cronologia di annullamento (%@); azione non eseguita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消し履歴を記録できませんでした (%@)。アクションは実行されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 취소 기록을 남길 수 없어(%@) 작업을 수행하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法记录撤销轨迹 (%@)；操作未执行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось записать журнал отмены (%@); действие не выполнено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تسجيل سجل التراجع (%@)؛ لم يُنفَّذ الإجراء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לתעד את מסלול הביטול (%@); הפעולה לא בוצעה."
          }
        }
      }
    },
    "Could not remove “%@” from the Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not remove “%@” from the Trash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” को ट्रैश से नहीं हटाया जा सका।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”-কে ট্র্যাশ থেকে সরানো যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ஐ குப்பைத் தொட்டியிலிருந்து அகற்ற முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ను ట్రాష్ నుండి తొలగించలేకపోయాము."
          }
        },
        "mr": {
