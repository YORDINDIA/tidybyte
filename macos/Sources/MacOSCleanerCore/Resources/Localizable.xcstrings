    "The file changed or is outside the approved scope. Scan again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed or is outside the approved scope. Scan again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल बदल गई है या स्वीकृत दायरे से बाहर है। फिर से स्कैन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল পরিবর্তিত হয়েছে বা অনুমোদিত পরিসরের বাইরে রয়েছে। আবার স্ক্যান করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்பு மாறிவிட்டது அல்லது அங்கீகரிக்கப்பட்ட வரம்பிற்கு வெளியே உள்ளது. மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైల్ మారింది లేదా ఆమోదించిన పరిధి వెలుపల ఉంది. మళ్లీ స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल बदलली आहे किंवा मंजूर कार्यक्षेत्राबाहेर आहे. पुन्हा स्कॅन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલ બદલાઈ છે અથવા મંજૂર વિસ્તારની બહાર છે. ફરી સ્કૅન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್ ಬದಲಾಗಿದೆ ಅಥವಾ ಅನುಮೋದಿತ ವ್ಯಾಪ್ತಿಯ ಹೊರಗಿದೆ. ಮತ್ತೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയൽ മാറി അല്ലെങ്കിൽ അംഗീകരിച്ച പരിധിക്ക് പുറത്താണ്. വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਾਈਲ ਬਦਲ ਗਈ ਹੈ ਜਾਂ ਮਨਜ਼ੂਰ ਦਾਇਰੇ ਤੋਂ ਬਾਹਰ ਹੈ। ਦੁਬਾਰਾ ਸਕੈਨ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo cambió o está fuera del alcance aprobado. Analiza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a changé ou sort du périmètre approuvé. Analysez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat sich geändert oder liegt außerhalb des genehmigten Bereichs. Erneut scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo mudou ou está fora do escopo aprovado. Analise novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è cambiato o è fuori dall'ambito approvato. Ripeti la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが変更されたか、承認済みの範囲外です。再スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 변경되었거나 승인된 범위를 벗어났습니다. 다시 스캔하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已更改或超出已批准范围。请重新扫描。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл изменился или находится вне одобренной области. Просканируйте снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغير الملف أو أصبح خارج النطاق المعتمد. افحص مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ השתנה או נמצא מחוץ להיקף המאושר. סרקו שוב."
          }
        }
      }
    },
