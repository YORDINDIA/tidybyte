    "This folder is protected and cannot be scanned.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is protected and cannot be scanned."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोल्डर सुरक्षित है और इसे स्कैन नहीं किया जा सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোল্ডারটি সুরক্ষিত এবং স্ক্যান করা যাবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கோப்புறை பாதுகாக்கப்பட்டுள்ளது, ஸ்கேன் செய்ய முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోల్డర్ రక్షించబడింది మరియు స్కాన్ చేయబడదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे फोल्डर सुरक्षित आहे आणि स्कॅन करता येत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ફોલ્ડર સુરક્ષિત છે અને સ્કૅન કરી શકાતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಫೋಲ್ಡರ್ ರಕ್ಷಿತವಾಗಿದೆ ಮತ್ತು ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഫോൾഡർ സംരക്ഷിതമാണ്, സ്കാൻ ചെയ്യാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਫੋਲਡਰ ਸੁਰੱਖਿਅਤ ਹੈ ਅਤੇ ਸਕੈਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta carpeta está protegida y no puede analizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier est protégé et ne peut pas être analysé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner ist geschützt und kann nicht gescannt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pasta é protegida e não pode ser analisada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa cartella è protetta e non può essere analizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは保護されているためスキャンできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더는 보호되어 있어 스캔할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
