          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この取り消し記録は %@ に期限切れとなったため復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실행 취소는 %@에 만료되어 더 이상 복원할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
