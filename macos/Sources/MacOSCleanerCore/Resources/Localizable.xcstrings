            "value": "कंप्रेस केलेले आउटपुट बदलले. मूळ फाइल ठेवली आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેસ કરેલું આઉટપુટ બદલાયું. મૂળ ફાઇલ રાખવામાં આવી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚಿತ ಔಟ್‌ಪುಟ್ ಬದಲಾಗಿದೆ. ಮೂಲ ಫೈಲ್ ಇರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രസ് ചെയ്ത ഔട്ട്പുട്ട് മാറി. യഥാർത്ഥ ഫയൽ നിലനിർത്തി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪ੍ਰੈਸ ਕੀਤਾ ਆਉਟਪੁੱਟ ਬਦਲ ਗਿਆ। ਮੂਲ ਫਾਈਲ ਰੱਖੀ ਗਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida comprimida cambió. Se conservó el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier compressé a changé. L'original a été conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die komprimierte Ausgabe hat sich geändert. Das Original wurde behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo comprimido mudou. O original foi mantido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'output compresso è cambiato. L'originale è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮出力ファイルが変更されたため、元のファイルを保持しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 출력이 변경되어 원본을 유지했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩输出发生了改变。已保留原文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сжатый результат изменился. Сохранен оригинал."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغير الملف المضغوط. تم الاحتفاظ بالأصل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפלט המכווץ השתנה. המקור נשמר."
          }
        }
      }
    },
    "The document package changed. Scan again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document package changed. Scan again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तावेज़ पैकेज बदल गया है। फिर से स्कैन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডকুমেন্ট প্যাকেজ পরিবর্তিত হয়েছে। আবার স্ক্যান করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆவணத் தொகுப்பு மாறிவிட்டது. மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పత్రం ప్యాకేజీ మారింది. మళ్లీ స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तऐवज पॅकेज बदलले आहे. पुन्हा स्कॅन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દસ્તાવેજ પૅકેજ બદલાયું છે. ફરી સ્કૅન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಾಖಲೆ ಪ್ಯಾಕೇಜ್ ಬದಲಾಗಿದೆ. ಮತ್ತೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡോക്യുമെന്റ് പാക്കേജ് മാറി. വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਸਤਾਵੇਜ਼ ਪੈਕੇਜ ਬਦਲ ਗਿਆ ਹੈ। ਦੁਬਾਰਾ ਸਕੈਨ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete del documento cambió. Analiza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet du document a changé. Analysez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokumentpaket hat sich geändert. Erneut scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote do documento mudou. Analise novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pacchetto del documento è cambiato. Ripeti la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類パッケージが変更されました。再スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 패키지가 변경되었습니다. 다시 스캔하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文稿包已更改。请重新扫描。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет документа изменился. Просканируйте снова."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت حزمة المستند. افحص مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבילת המסמך השתנתה. סרקו שוב."
          }
        }
      }
    },
    "The document package holds protected data, so it cannot be changed here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document package holds protected data, so it cannot be changed here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दस्तावेज़ पैकेज में सुरक्षित डेटा है, इसलिए इसे यहाँ बदला नहीं जा सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডকুমেন্ট প্যাকেজে সুরক্ষিত ডেটা রয়েছে, তাই এখানে এটি পরিবর্তন করা যাবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஆவணத் தொகுப்பில் பாதுகாக்கப்பட்ட தரவு உள்ளதால் இங்கே மாற்ற முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పత్రం ప్యాకేజీలో రక్షిత డేటా ఉంది, కాబట్టి ఇక్కడ మార్చలేము."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तऐवज पॅकेजमध्ये सुरक्षित डेटा आहे, त्यामुळे ते येथे बदलता येत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દસ્તાવેજ પૅકેજમાં સુરક્ષિત ડેટા છે, તેથી અહીં બદલી શકાતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಾಖಲೆ ಪ್ಯಾಕೇಜ್ ರಕ್ಷಿತ ಡೇಟಾವನ್ನು ಹೊಂದಿರುವುದರಿಂದ ಇಲ್ಲಿ ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡോക്യുമെന്റ് പാക്കേജിൽ സംരക്ഷിത ഡാറ്റയുള്ളതിനാൽ ഇവിടെ മാറ്റാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਸਤਾਵੇਜ਼ ਪੈਕੇਜ ਵਿੱਚ ਸੁਰੱਖਿਅਤ ਡੇਟਾ ਹੈ, ਇਸ ਲਈ ਇੱਥੇ ਬਦਲਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete del documento contiene datos protegidos y no puede modificarse aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet du document contient des données protégées et ne peut pas être modifié ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokumentpaket enthält geschützte Daten und kann hier nicht geändert werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote do documento contém dados protegidos e não pode ser alterado aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pacchetto del documento contiene dati protetti e non può essere modificato qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類パッケージには保護されたデータが含まれているため変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 패키지에 보호된 데이터가 있어 여기에서 변경할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文稿包包含受保护数据，无法在此处更改。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет документа содержит защищенные данные и не может быть изменен здесь."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي حزمة المستند على بيانات محمية، لذا لا يمكن تعديلها هنا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבילת המסמך מכילה נתונים מוגנים ולכן לא ניתן לשנותה כאן."
          }
        }
      }
    },
    "The document package is no longer available.": {
      "localizations": {
