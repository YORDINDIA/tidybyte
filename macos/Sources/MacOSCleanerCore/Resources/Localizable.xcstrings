    "Cloud-synced local path rejected for Phase 1 deletion: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-synced local path rejected for Phase 1 deletion: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चरण 1 विलोपन के लिए क्लाउड-सिंक स्थानीय पथ अस्वीकृत: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ধাপ 1 অপসারণের জন্য ক্লাউড-সিঙ্ক স্থানীয় পথ প্রত্যাখ্যাত: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கட்டம் 1 நீக்கத்திற்கான கிளவுட்-ஒத்திசைக்கப்பட்ட உள்ளூர் பாதை நிராகரிக்கப்பட்டது: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దశ 1 తొలగింపు కోసం క్లౌడ్-సింక్ స్థానిక మార్గం తిరస్కరించబడింది: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टप्पा 1 हटवण्यासाठी क्लाउड-सिंक स्थानिक मार्ग नाकारला: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તબક્કો 1 દૂર કરવા માટે ક્લાઉડ-સિંક સ્થાનિક માર્ગ નકાર્યો: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಂತ 1 ಅಳಿಸುವಿಕೆಗೆ ಕ್ಲೌಡ್-ಸಿಂಕ್ ಸ್ಥಳೀಯ ಮಾರ್ಗವನ್ನು ತಿರಸ್ಕರಿಸಲಾಗಿದೆ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഘട്ടം 1 ഇല്ലാതാക്കലിനായി ക്ലൗഡ്-സമന്വയിപ്പിച്ച പ്രാദേശിക പാത നിരസിച്ചു: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੜਾਅ 1 ਹਟਾਉਣ ਲਈ ਕਲਾਊਡ-ਸਿੰਕ ਸਥਾਨਕ ਮਾਰਗ ਅਸਵੀਕਾਰ: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruta local sincronizada en la nube rechazada para eliminación en fase 1: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chemin local synchronisé dans le nuage rejeté pour la suppression de phase 1 : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-synchronisierter lokaler Pfad für Phase-1-Löschung abgelehnt: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminho local sincronizado na nuvem rejeitado para exclusão na fase 1: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorso locale sincronizzato sul cloud rifiutato per eliminazione in fase 1: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド同期されたローカルパスはフェーズ 1 の削除対象から除外されました: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 동기화된 로컬 경로는 1단계 삭제에서 제외되었습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一阶段删除已拒绝云端同步的本地路径：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный облачный путь отклонен для удаления на первом этапе: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض المسار المحلي المتزامن سحابيًا لحذف المرحلة 1: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתיב מקומי מסונכרן לענן נדחה למחיקה בשלב 1: %@"
          }
        }
      }
