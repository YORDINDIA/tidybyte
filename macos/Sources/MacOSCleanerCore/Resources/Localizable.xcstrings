    "Helper started by this app's launch item": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper started by this app's launch item"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप के लॉगिन आइटम द्वारा शुरू किया गया हेल्पर"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অ্যাপের লগইন আইটেম থেকে শুরু হওয়া হেল্পার"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் செயலியின் உள்நுழைவு உருப்படியால் தொடங்கப்பட்ட உதவியாளர்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ యాప్ లాగిన్ అంశం ద్వారా ప్రారంభమైన హెల్పర్"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या अ‍ॅपच्या लॉगिन आयटमद्वारे सुरू केलेला हेल्पर"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઍપના લૉગિન આઇટમ દ્વારા શરૂ કરાયેલ હેલ્પર"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಆ್ಯಪ್‌ನ ಲಾಗಿನ್ ಐಟಂನಿಂದ ಪ್ರಾರಂಭವಾದ ಸಹಾಯಕ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ആപ്പിന്റെ ലോഗിൻ ഇനം വഴി തുടങ്ങിയ ഹെൽപ്പർ"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਐਪ ਦੀ ਲੌਗਇਨ ਆਈਟਮ ਦੁਆਰਾ ਸ਼ੁਰੂ ਕੀਤਾ ਹੈਲਪਰ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistente iniciado por el ítem de inicio de esta app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistant lancé par l'élément d'ouverture de cette app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilfsprogramm, das vom Anmeldeobjekt dieser App gestartet wurde"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Auxiliar iniciado pelo item de início deste app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Helper avviato dall'elemento di login di questa app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのログイン項目から起動されたヘルパー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 로그인 항목에서 시작된 도우미"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由该应用登录项启动的辅助程序"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вспомогательный процесс от объекта входа этого приложения"
