    "The item was moved, but its recovery record could not be saved. Check Trash or the destination in Finder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item was moved, but its recovery record could not be saved. Check Trash or the destination in Finder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम स्थानांतरित हो गया, लेकिन इसका पुनर्प्राप्ति रिकॉर्ड सहेजा नहीं जा सका। Finder में ट्रैश या गंतव्य जाँचें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আইটেমটি সরানো হয়েছে, তবে এর পুনরুদ্ধার রেকর্ড সংরক্ষণ করা যায়নি। Finder-এ ট্র্যাশ বা গন্তব্য পরীক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உருப்படி நகர்த்தப்பட்டது, ஆனால் அதன் மீட்புப் பதிவைச் சேமிக்க முடியவில்லை. Finder இல் குப்பைத் தொட்டி அல்லது இலக்கைப் பார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అంశం తరలించబడింది, కానీ దాని పునరుద్ధరణ రికార్డు సేవ్ చేయలేకపోయాము. Finder లో ట్రాష్ లేదా గమ్యస్థానాన్ని తనిఖీ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आयटम हलवला गेला, परंतु त्याची पुनर्प्राप्ती नोंद जतन करता आली नाही. Finder मध्ये ट्रॅश किंवा गंतव्य तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આઇટમ ખસેડાઈ, પરંતુ તેની પુનઃપ્રાપ્તિ નોંધ સાચવી શકાઈ નહીં. Finder માં ટ્રૅશ અથવા ગંતવ્ય તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐಟಂ ಅನ್ನು ಸರಿಸಲಾಗಿದೆ, ಆದರೆ ಅದರ ಮರುಪಡೆಯುವಿಕೆ ದಾಖಲೆಯನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. Finder ನಲ್ಲಿ ಟ್ರ್ಯಾಶ್ ಅಥವಾ ಗಮ್ಯಸ್ಥಾನವನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇനം മാറ്റി, പക്ഷേ അതിന്റെ വീണ്ടെടുക്കൽ രേഖ സംരക്ഷിക്കാനായില്ല. Finder-ൽ ട്രാഷോ ലക്ഷ്യസ്ഥാനമോ പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਈਟਮ ਭੇਜੀ ਗਈ, ਪਰ ਇਸਦਾ ਬਹਾਲੀ ਰਿਕਾਰਡ ਸੰਭਾਲਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ। Finder ਵਿੱਚ ਟਰੈਸ਼ ਜਾਂ ਟਿਕਾਣਾ ਜਾਂਚੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El elemento se movió, pero no se pudo guardar su registro de recuperación. Revisa el Basurero o el destino en Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément a été déplacé, mais son enregistrement de récupération n'a pas pu être sauvegardé. Vérifiez la Corbeille ou la destination dans le Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Objekt wurde verschoben, aber der Wiederherstellungseintrag konnte nicht gesichert werden. Prüfe den Papierkorb oder den Zielort im Finder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O item foi movido, mas seu registro de recuperação não pôde ser salvo. Verifique o Lixo ou o destino no Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elemento è stato spostato, ma non è stato possibile salvare il record di recupero. Controlla il Cestino o la destinazione nel Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "項目を移動しましたが、復元記録を保存できませんでした。Finder でゴミ箱または移動先を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목은 이동되었지만 복구 기록을 저장할 수 없었습니다. Finder에서 휴지통이나 대상 위치를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目已移动，但无法保存恢复记录。请在 Finder 中检查废纸篓或目标位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объект перемещен, но запись для восстановления не сохранилась. Проверьте Корзину или место назначения в Finder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نقل العنصر، لكن تعذّر حفظ سجل الاسترداد. تحقق من سلة المهملات أو الوجهة في Finder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריט הועבר, אך רשומת השחזור שלו לא נשמרה. בדקו בפח או ביעד ב-Finder."
          }
        }
      }
    },
    "The original file has not been restored yet, so the archive copy at %@ is being kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file has not been restored yet, so the archive copy at %@ is being kept."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल फ़ाइल अभी तक पुनर्स्थापित नहीं हुई है, इसलिए %@ पर आर्काइव प्रति रखी जा रही है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল ফাইল এখনও পুনরুদ্ধার করা হয়নি, তাই %@-এ আর্কাইভ কপিটি রাখা হচ্ছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசல் கோப்பு இன்னும் மீட்டெடுக்கப்படவில்லை, எனவே %@ இல் உள்ள காப்பக நகல் வைக்கப்படுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అసలు ఫైల్ ఇంకా పునరుద్ధరించబడలేదు, కాబట్టి %@ వద్ద ఉన్న ఆర్కైవ్ ప్రతి ఉంచబడుతోంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मूळ फाइल अद्याप पुनर्संचयित केलेली नाही, म्हणून %@ येथील संग्रह प्रत ठेवली जात आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૂળ ફાઇલ હજી સુધી પુનઃસ્થાપિત થઈ નથી, તેથી %@ પર આર્કાઇવ નકલ રાખવામાં આવી રહી છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೂಲ ಫೈಲ್ ಅನ್ನು ಇನ್ನೂ ಮರುಸ್ಥಾಪಿಸಲಾಗಿಲ್ಲ, ಆದ್ದರಿಂದ %@ ನಲ್ಲಿರುವ ಆರ್ಕೈವ್ ಪ್ರತಿಯನ್ನು ಇರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "യഥാർത്ഥ ഫയൽ ഇതുവരെ പുനഃസ്ഥാപിച്ചിട്ടില്ല, അതിനാൽ %@-ലുള്ള ആർക്കൈവ് പകർപ്പ് സൂക്ഷിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੂਲ ਫਾਈਲ ਅਜੇ ਬਹਾਲ ਨਹੀਂ ਹੋਈ, ਇਸ ਲਈ %@ 'ਤੇ ਆਰਕਾਈਵ ਕਾਪੀ ਰੱਖੀ ਜਾ ਰਹੀ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo original aún no se restauró, por lo que se conserva la copia archivada en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier original n'a pas encore été restauré ; la copie d'archive à %@ est donc conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originaldatei wurde noch nicht wiederhergestellt, daher wird die Archivkopie unter %@ behalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo original ainda não foi restaurado; portanto, a cópia arquivada em %@ está sendo mantida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file originale non è stato ancora ripristinato, quindi la copia archiviata in %@ viene mantenuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルがまだ復元されていないため、%@ のアーカイブコピーを保持しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일이 아직 복원되지 않았으므로 %@의 보관 사본을 유지하고 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件尚未还原，因此会继续保留位于 %@ 的归档副本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный файл еще не восстановлен, поэтому архивная копия в %@ сохраняется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُستعد الملف الأصلي بعد، لذا يُحتفظ بالنسخة المؤرشفة في %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ המקורי טרם שוחזר, ולכן עותק הארכיון ב-%@ נשמר."
          }
        }
      }
    },
    "The planned action is missing a destination.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The planned action is missing a destination."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजनाबद्ध क्रिया में गंतव्य अनुपस्थित है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিকল্পিত কাজে গন্তব্য অনুপস্থিত।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டமிடப்பட்ட செயலில் இலக்கு விடுபட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రణాళిక చేసిన చర్యలో గమ్యస్థానం లోపించింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नियोजित क्रियेमध्ये गंतव्य गहाळ आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આયોજિત ક્રિયામાં ગંતવ્ય ખૂટે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯೋಜಿತ ಕ್ರಿಯೆಯಲ್ಲಿ ಗಮ್ಯಸ್ಥಾನ ಕಾಣೆಯಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആസൂത്രണം ചെയ്ത പ്രവൃത്തിയിൽ ലക്ഷ്യസ്ഥാനം കാണാനില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਯੋਜਨਾਬੱਧ ਕਾਰਵਾਈ ਵਿੱਚ ਟਿਕਾਣਾ ਗੁੰਮ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A la acción planificada le falta un destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque une destination à l'action planifiée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der geplanten Aktion fehlt ein Ziel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação planejada está sem destino."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "All'azione pianificata manca una destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定されたアクションに移動先が設定されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획된 작업에 대상 위치가 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划的操作缺少目标路径。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У запланированного действия отсутствует путь назначения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتقر الإجراء المخطط له إلى وجهة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפעולה המתוכננת חסר יעד."
          }
        }
      }
    },
    "The recovery path changed. Check Trash in Finder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery path changed. Check Trash in Finder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्प्राप्ति पथ बदल गया है। Finder में ट्रैश जाँचें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরুদ্ধার পথ পরিবর্তিত হয়েছে। Finder-এ ট্র্যাশ পরীক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீட்புப் பாதை மாறிவிட்டது. Finder இல் குப்பைத் தொட்டியைப் பார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పునరుద్ధరణ మార్గం మారింది. Finder లో ట్రాష్ తనిఖీ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्प्राप्ती मार्ग बदलला आहे. Finder मध्ये ट्रॅश तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પુનઃપ્રાપ્તિ માર્ગ બદલાયો છે. Finder માં ટ્રૅશ તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮರುಪಡೆಯುವಿಕೆ ಮಾರ್ಗ ಬದಲಾಗಿದೆ. Finder ನಲ್ಲಿ ಟ್ರ್ಯಾಶ್ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വീണ്ടെടുക്കൽ പാത മാറി. Finder-ൽ ട്രാഷ് പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਹਾਲੀ ਮਾਰਗ ਬਦਲ ਗਿਆ ਹੈ। Finder ਵਿੱਚ ਟਰੈਸ਼ ਜਾਂਚੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta de recuperación cambió. Revisa el Basurero en Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin de récupération a changé. Vérifiez la Corbeille dans le Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wiederherstellungspfad hat sich geändert. Prüfe den Papierkorb im Finder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho de recuperação mudou. Verifique o Lixo no Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il percorso di recupero è cambiato. Controlla il Cestino nel Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元パスが変更されました。Finder でゴミ箱を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 경로가 변경되었습니다. Finder에서 휴지통을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复路径已更改。请在 Finder 中检查废纸篓。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путь восстановления изменился. Проверьте Корзину в Finder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغير مسار الاسترداد. تحقق من سلة المهملات في Finder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתיב השחזור השתנה. בדקו בפח ב-Finder."
          }
        }
      }
    },
    "The report cannot be saved there. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report cannot be saved there. %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट वहाँ सहेजी नहीं जा सकती। %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিবেদনটি সেখানে সংরক্ষণ করা যাবে না। %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிக்கையை அங்கே சேமிக்க முடியாது. %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నివేదిక అక్కడ సేవ్ చేయలేరు. %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अहवाल तेथे जतन करता येत नाही. %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહેવાલ ત્યાં સાચવી શકાતો નથી. %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವರದಿಯನ್ನು ಅಲ್ಲಿ ಉಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിപ്പോർട്ട് അവിടെ സംരക്ഷിക്കാനാകില്ല. %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਪੋਰਟ ਉੱਥੇ ਸੰਭਾਲੀ ਨਹੀਂ ਜਾ ਸਕਦੀ। %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede guardar el informe ahí. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rapport ne peut pas être enregistré à cet emplacement. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht kann dort nicht gespeichert werden. %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível salvar o relatório nesse local. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rapporto non può essere salvato lì. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこにはレポートを保存できません。%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 위치에 리포트를 저장할 수 없습니다. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将报告保存至此处。%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить отчет туда. %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حفظ التقرير هناك. %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשמור את הדוח שם. %@"
          }
        }
      }
    },
    "The report could not be laid out on its pages, so nothing was saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report could not be laid out on its pages, so nothing was saved."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट को पृष्ठों पर व्यवस्थित नहीं किया जा सका, इसलिए कुछ भी सहेजा नहीं गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পৃষ্ঠাগুলোতে প্রতিবেদন বিন্যাস করা যায়নি, তাই কিছুই সংরক্ষিত হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அறிக்கையைப் பக்கங்களில் அமைக்க முடியவில்லை, எனவே எதுவும் சேமிக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నివేదిక దాని పేజీలలో అమర్చలేకపోయాము, కాబట్టి ఏదీ సేవ్ చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अहवाल पृष्ठांवर मांडता आला नाही, म्हणून काहीही जतन केले गेले नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અહેવાલ તેના પૃષ્ઠો પર ગોઠવી શકાયો નહીં, તેથી કંઈ સાચવ્યું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವರದಿಯನ್ನು ಅದರ ಪುಟಗಳಲ್ಲಿ ವಿನ್ಯಾಸಗೊಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಆದ್ದರಿಂದ ಏನನ್ನೂ ಉಳಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിപ്പോർട്ട് അതിന്റെ പേജുകളിൽ ക്രമീകരിക്കാനായില്ല, അതിനാൽ ഒന്നും സംരക്ഷിച്ചില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਪੋਰਟ ਨੂੰ ਇਸਦੇ ਪੰਨਿਆਂ 'ਤੇ ਸਜਾਇਆ ਨਹੀਂ ਜਾ ਸਕਿਆ, ਇਸ ਲਈ ਕੁਝ ਨਹੀਂ ਸੰਭਾਲਿਆ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo maquetar el informe en sus páginas, por lo que no se guardó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise en page du rapport a échoué ; rien n'a été enregistré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bericht konnte nicht auf den Seiten angeordnet werden, daher wurde nichts gespeichert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível diagramar o relatório em suas páginas, portanto nada foi salvo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile impaginare il rapporto sulle pagine, quindi nulla è stato salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートのページレイアウトに失敗したため保存されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리포트 페이지 배치를 완료할 수 없어 저장되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告页面排版失败，因此未保存任何文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сверстать отчет на страницах, поэтому ничего не сохранено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تنسيق التقرير على صفحاته، لذا لم يُحفظ شيء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לעמד את הדוח על עמודיו, ולכן דבר לא נשמר."
          }
        }
      }
    },
    "The scan finished, but its status could not be saved. Results stay available until you quit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan finished, but its status could not be saved. Results stay available until you quit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन पूरा हुआ, लेकिन इसकी स्थिति सहेजी नहीं जा सकी। आपके ऐप बंद करने तक परिणाम उपलब्ध रहेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান শেষ হয়েছে, তবে এর অবস্থা সংরক্ষণ করা যায়নি। অ্যাপ বন্ধ না করা পর্যন্ত ফলাফল উপলব্ধ থাকবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் முடிந்தது, ஆனால் நிலையைச் சேமிக்க முடியவில்லை. நீங்கள் வெளியேறும் வரை முடிவுகள் கிடைக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ పూర్తయింది, కానీ దాని స్థితి సేవ్ చేయలేకపోయాము. మీరు మూసివేసే వరకు ఫలితాలు అందుబాటులో ఉంటాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन पूर्ण झाले, परंतु त्याची स्थिती जतन करता आली नाही. तुम्ही बाहेर पडेपर्यंत निकाल उपलब्ध राहतील."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન પૂર્ણ થયો, પણ તેની સ્થિતિ સાચવી શકાઈ નહીં. તમે બંધ ન કરો ત્યાં સુધી પરિણામો ઉપલબ્ધ રહેશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಮುಗಿದಿದೆ, ಆದರೆ ಅದರ ಸ್ಥಿತಿಯನ್ನು ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ನೀವು ಮುಚ್ಚುವವರೆಗೆ ಫಲಿತಾಂಶಗಳು ಲಭ್ಯವಿರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ പൂർത്തിയായി, പക്ഷേ അതിന്റെ നില സംരക്ഷിക്കാനായില്ല. നിങ്ങൾ നിർത്തുന്നത് വരെ ഫലങ്ങൾ ലഭ്യമായിരിക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਪੂਰਾ ਹੋਇਆ, ਪਰ ਸਥਿਤੀ ਸੰਭਾਲੀ ਨਹੀਂ ਜਾ ਸਕੀ। ਬੰਦ ਕਰਨ ਤੱਕ ਨਤੀਜੇ ਉਪਲਬਧ ਰਹਿਣਗੇ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis terminó, pero no se pudo guardar su estado. Los resultados permanecerán disponibles hasta que salgas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse est terminée, mais son état n'a pas pu être sauvegardé. Les résultats restent disponibles jusqu'à la fermeture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Scan wurde beendet, aber sein Status konnte nicht gesichert werden. Ergebnisse bleiben bis zum Beenden verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise terminou, mas seu status não pôde ser salvo. Os resultados ficam disponíveis até você encerrar o app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione è terminata, ma il suo stato non è stato salvato. I risultati restano disponibili finché non chiudi l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンは完了しましたが状態を保存できませんでした。終了するまで結果は確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔이 완료되었지만 상태를 저장할 수 없었습니다. 앱을 종료할 때까지 결과는 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描已完成，但无法保存扫描状态。在您退出应用前结果仍可查看。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование завершено, но не удалось сохранить его статус. Результаты доступны до выхода из программы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى الفحص، لكن تعذّر حفظ حالته. تبقى النتائج متاحة حتى الإنهاء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסריקה הסתיימה, אך מצבה לא נשמר. התוצאות זמינות עד ליציאה מהאפליקציה."
          }
        }
      }
    },
    "The selected album could not be found.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected album could not be found."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित एल्बम नहीं मिला।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত অ্যালবামটি খুঁজে পাওয়া যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த ஆல்பத்தைக் கண்டறிய முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న ఆల్బమ్ కనుగొనబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेला अल्बम सापडला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલ આલ્બમ મળી શક્યો નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಆಲ್ಬಮ್ ಕಂಡುಬಂದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത ആൽബം കണ്ടെത്താനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣਿਆ ਐਲਬਮ ਨਹੀਂ ਮਿਲ ਸਕਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el álbum seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'album sélectionné est introuvable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Album konnte nicht gefunden werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O álbum selecionado não foi encontrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare l'album selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したアルバムが見つかりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앨범을 찾을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到所选相簿。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный альбом не найден."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر العثور على الألبوم المحدد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האלבום שנבחר לא נמצא."
          }
        }
      }
    },
    "The selected resource is unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected resource is unavailable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित संसाधन उपलब्ध नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত রিসোর্স উপলব্ধ নয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த வளம் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న వనరు అందుబాటులో లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेले संसाधन उपलब्ध नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલ સંસાધન ઉપલબ્ધ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಸಂಪನ್ಮೂಲ ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത ഉറവിടം ലഭ്യമല്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣਿਆ ਸਰੋਤ ਉਪਲਬਧ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recurso seleccionado no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ressource sélectionnée est indisponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Ressource ist nicht verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recurso selecionado está indisponível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risorsa selezionata non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したリソースを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 리소스를 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选资源不可用。"
          }
        },
        "ru": {
          "stringUnit": {
