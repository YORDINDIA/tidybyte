    "Quit %@ first, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit %@ first, then try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले %@ को बंद करें, फिर पुनः प्रयास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে %@ বন্ধ করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் %@ ஐ நிறுத்திவிட்டு, பின்னர் மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందుగా %@ ను మూసివేసి, ఆపై మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रथम %@ बंद करा, नंतर पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પહેલાં %@ બંધ કરો, પછી ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೊದಲು %@ ಮುಚ್ಚಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യം %@ നിർത്തുക, തുടർന്ന് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਹਿਲਾਂ %@ ਬੰਦ ਕਰੋ, ਫਿਰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal primero de %@ e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez d'abord %@, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende zuerst %@ und versuche es erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre %@ primeiro e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi prima %@ e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に %@ を終了してからやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 %@을(를) 종료한 다음 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先退出 %@，然后再试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала закройте %@ и повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ %@ أولًا ثم حاول مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגרו קודם את %@ ונסו שוב."
          }
        }
      }
    },
