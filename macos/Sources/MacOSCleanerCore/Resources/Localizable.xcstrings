        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वीडियो 480p से कम है और इसे अपस्केल नहीं किया जाएगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিডিওটি 480p-এর নিচে এবং আপস্কেল করা হবে না।"
