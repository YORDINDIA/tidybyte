      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker Volume Prune (%@ reclaimable; removes unused named volumes)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker वॉल्यूम सफ़ाई (%@ प्राप्त करने योग्य; अनुपयोगी नामित वॉल्यूम हटाता है)।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ভলিউম ছাঁটাই (%@ উদ্ধারযোগ্য; অব্যবহৃত নামযুক্ত ভলিউম সরায়)।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker தொகுதி நீக்கம் (%@ மீட்கக்கூடியது; பயன்படுத்தாத பெயரிட்ட தொகுதிகளை நீக்குகிறது)."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker వాల్యూమ్ శుభ్రత (%@ తిరిగి పొందదగినది; ఉపయోగించని పేరు గల వాల్యూమ్‌లను తొలగిస్తుంది)."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker व्हॉल्यूम छंटणी (%@ मोकळी जागा; न वापरलेले नामित व्हॉल्यूम काढते)."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker વૉલ્યૂમ સફાઈ (%@ ખાલી કરી શકાય; વણવપરાયેલા નામવાળા વૉલ્યૂમ દૂર કરે છે)."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ವಾಲ್ಯೂಮ್ ಸ್ವಚ್ಛತೆ (%@ ಮರಳಿ ಪಡೆಯಬಹುದಾದದ್ದು; ಬಳಸದ ಹೆಸರಿಸಿದ ವಾಲ್ಯೂಮ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ)."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker വോളിയം വൃത്തിയാക്കൽ (%@ വീണ്ടെടുക്കാം; ഉപയോഗിക്കാത്ത പേരുള്ള വോളിയങ്ങൾ നീക്കം ചെയ്യുന്നു)."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ਵਾਲੀਅਮ ਛੰਟਾਈ (%@ ਖਾਲੀ ਯੋਗ; ਅਣਵਰਤੇ ਨਾਮ ਵਾਲੇ ਵਾਲੀਅਮ ਹਟਾਉਂਦਾ ਹੈ)।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpiar volúmenes de Docker (%@ recuperables; elimina volúmenes con nombre sin usar)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purge des volumes Docker (%@ récupérables ; supprime les volumes nommés inutilisés)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker-Volumes bereinigen (%@ freigebbar; entfernt ungenutzte benannte Volumes)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar volumes do Docker (%@ recuperáveis; remove volumes nomeados sem uso)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulizia volumi Docker (%@ recuperabili; rimuove i volumi con nome inutilizzati)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ボリューム整理（%@ 解放可能。未使用の名前付きボリュームを削除します）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 볼륨 정리(%@ 확보 가능, 사용하지 않는 이름 지정 볼륨 제거)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理 Docker 卷（可回收 %@；移除未使用的命名卷）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистка томов Docker (освободится %@; удаляет неиспользуемые именованные тома)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنظيف وحدات تخزين Docker (يمكن استعادة %@؛ يزيل وحدات التخزين المسماة غير المستخدمة)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוי אמצעי אחסון של Docker (%@ ניתנים לשחרור; מסיר אמצעי אחסון בעלי שם שאינם בשימוש)."
          }
        }
      }
    },
    "Docker aggressive cleanup prunes %@ including unused volumes. Volumes may contain persistent data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker aggressive cleanup prunes %@ including unused volumes. Volumes may contain persistent data."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आक्रामक Docker सफ़ाई अनुपयोगी वॉल्यूम सहित %@ हटाती है। वॉल्यूम में स्थायी डेटा हो सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগ্রাসী Docker ক্লিনআপ অব্যবহৃত ভলিউমসহ %@ অপসারণ করে। ভলিউমে স্থায়ী ডেটা থাকতে পারে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தீவிர Docker சுத்திகரிப்பு பயன்படுத்தாத தொகுதிகள் உட்பட %@ ஐ நீக்குகிறது. தொகுதிகளில் நிலையான தரவு இருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దూకుడు Docker శుభ్రత ఉపయోగించని వాల్యూమ్‌లతో సహా %@ ను తొలగిస్తుంది. వాల్యూమ్‌లలో శాశ్వత డేటా ఉండవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आक्रमक Docker क्लीनअप न वापरलेल्या व्हॉल्यूमसह %@ काढते. व्हॉल्यूममध्ये कायमस्वरूपी डेटा असू शकतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આક્રમક Docker ક્લીનઅપ વણવપરાયેલા વૉલ્યૂમ સહિત %@ દૂર કરે છે. વૉલ્યૂમમાં કાયમી ડેટા હોઈ શકે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಕ್ರಮಣಕಾರಿ Docker ಸ್ವಚ್ಛತೆಯು ಬಳಸದ ವಾಲ್ಯೂಮ್‌ಗಳು ಸೇರಿದಂತೆ %@ ಅನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ. ವಾಲ್ಯೂಮ್‌ಗಳಲ್ಲಿ ಶಾಶ್ವತ ಡೇಟಾ ಇರಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തീവ്ര Docker വൃത്തിയാക്കൽ ഉപയോഗിക്കാത്ത വോളിയങ്ങൾ ഉൾപ്പെടെ %@ നീക്കം ചെയ്യുന്നു. വോളിയങ്ങളിൽ സ്ഥിരമായ ഡാറ്റ ഉണ്ടാകാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਮਲਾਵਰ Docker ਸਫਾਈ ਅਣਵਰਤੇ ਵਾਲੀਅਮ ਸਮੇਤ %@ ਹਟਾਉਂਦੀ ਹੈ। ਵਾਲੀਅਮ ਵਿੱਚ ਸਥਾਈ ਡੇਟਾ ਹੋ ਸਕਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La limpieza agresiva de Docker elimina %@, incluidos los volúmenes sin usar. Los volúmenes pueden contener datos persistentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage Docker agressif supprime %@, y compris les volumes inutilisés. Ces volumes peuvent contenir des données persistantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggressive Docker-Bereinigung entfernt %@ inklusive ungenutzter Volumes. Volumes können dauerhafte Daten enthalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A limpeza agressiva do Docker remove %@, incluindo volumes sem uso. Volumes podem conter dados persistentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pulizia aggressiva Docker rimuove %@, inclusi i volumi inutilizzati. I volumi possono contenere dati persistenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker の積極的クリーンアップは未使用ボリュームを含め %@ を整理します。ボリュームには永続データが含まれている場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적극적 Docker 정리는 미사용 볼륨을 포함해 %@을(를) 제거합니다. 볼륨에 영구 데이터가 들어 있을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 深度清理将移除 %@（含未使用的卷）。数据卷中可能包含持久数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агрессивная очистка Docker удалит %@, включая неиспользуемые тома. Тома могут содержать важные данные."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل التنظيف المكثّف لـ Docker ما مقداره %@ بما فيها وحدات التخزين غير المستخدمة، وقد تحتوي على بيانات دائمة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוי Docker אגרסיבי מסיר %@ כולל אמצעי אחסון שאינם בשימוש. אמצעי אחסון עלולים להכיל נתונים קבועים."
          }
        }
      }
    },
    "Docker build cache can be cleared (%@). Images and containers stay.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker build cache can be cleared (%@). Images and containers stay."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker बिल्ड कैश (%@) साफ़ किया जा सकता है। इमेज और कंटेनर सुरक्षित रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker বিল্ড ক্যাশ (%@) পরিষ্কার করা যাবে। ইমেজ ও কন্টেইনার অক্ষুণ্ণ থাকবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker உருவாக்க கேச்சை (%@) அழிக்கலாம். படங்களும் கொள்கலன்களும் அப்படியே இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker బిల్డ్ క్యాష్ (%@) ను క్లియర్ చేయవచ్చు. చిత్రాలు మరియు కంటైనర్లు అలాగే ఉంటాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker बिल्ड कॅशे (%@) साफ करता येतो. प्रतिमा आणि कंटेनर्स राहतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker બિલ્ડ કૅશ (%@) સાફ કરી શકાય છે. ઇમેજ અને કન્ટેનર્સ રહેશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ಬಿಲ್ಡ್ ಕ್ಯಾಶ್ (%@) ಅನ್ನು ತೆರವುಗೊಳಿಸಬಹುದು. ಚಿತ್ರಗಳು ಮತ್ತು ಕಂಟೇನರ್‌ಗಳು ಉಳಿಯುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ബിൽഡ് ക്യാഷ് (%@) മായ്ക്കാവുന്നതാണ്. ഇമേജുകളും കണ്ടെയ്നറുകളും നിലനിൽക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ਬਿਲਡ ਕੈਸ਼ (%@) ਸਾਫ਼ ਕੀਤਾ ਜਾ ਸਕਦਾ ਹੈ। ਤਸਵੀਰਾਂ ਅਤੇ ਕੰਟੇਨਰ ਰਹਿਣਗੇ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede vaciar la caché de compilación de Docker (%@). Las imágenes y contenedores se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cache de compilation Docker peut être vidé (%@). Les images et conteneurs sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker-Build-Cache kann geleert werden (%@). Images und Container bleiben erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cache de compilação do Docker pode ser limpo (%@). Imagens e contêineres são mantidos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cache di build Docker può essere svuotata (%@). Immagini e container restano intatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker ビルドキャッシュを消去できます (%@)。イメージとコンテナは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 빌드 캐시를 비울 수 있습니다(%@). 이미지와 컨테이너는 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可清除 Docker 构建缓存 (%@)。镜像和容器将予保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэш сборки Docker можно очистить (%@). Образы и контейнеры останутся."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن مسح ذاكرة تخزين البناء لـ Docker (%@). تبقى الصور والحاويات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לנקות את מטמון הבנייה של Docker (%@). תמונות ומכולות נשמרות."
          }
        }
      }
    },
