    "Choose %@ to grant folder access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose %@ to grant folder access."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डर की अनुमति देने के लिए %@ चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোল্ডার অ্যাক্সেস দিতে %@ বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புறை அணுகலை வழங்க %@ ஐத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోల్డర్ యాక్సెస్ ఇవ్వడానికి %@ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोल्डर प्रवेश देण्यासाठी %@ निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોલ્ડર ઍક્સેસ આપવા માટે %@ પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಲ್ಡರ್ ಪ್ರವೇಶ ನೀಡಲು %@ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോൾഡർ ആക്സസ് നൽകാൻ %@ തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫੋਲਡਰ ਪਹੁੰਚ ਦੇਣ ਲਈ %@ ਚੁਣੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige %@ para conceder acceso a la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez %@ pour accorder l'accès au dossier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle %@ aus, um Ordnerzugriff zu gewähren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha %@ para conceder acesso à pasta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona %@ per concedere l'accesso alla cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダアクセスを許可するには %@ を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 접근 권한을 부여하려면 %@을(를) 선택하세요."
          }
        },
        "zh-Hans": {
