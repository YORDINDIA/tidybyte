    "Broken symbolic link.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broken symbolic link."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूटा हुआ सिंबॉलिक लिंक।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভাঙা সিম্বলিক লিংক।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உடைந்த குறியீட்டு இணைப்பு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విరిగిన సింబాలిక్ లింక్."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुटलेली सिम्बॉलिक लिंक."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તૂટેલી સિમ્બૉલિક લિંક."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
