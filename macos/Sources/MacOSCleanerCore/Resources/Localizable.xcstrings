        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਹੋਰ ਇੰਸਟਾਲ ਐਪ ਦੁਆਰਾ ਵੀ ਵਰਤਿਆ ਜਾਂਦਾ"
