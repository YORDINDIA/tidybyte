    "%lld proposed actions: %lld low risk, %lld medium risk, %lld high risk. Estimated reviewable space: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld proposed actions: %lld low risk, %lld medium risk, %lld high risk. Estimated reviewable space: %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld प्रस्तावित क्रियाएं: %lld कम जोखिम, %lld मध्यम जोखिम, %lld उच्च जोखिम। अनुमानित समीक्षणीय स्थान: %@।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldটি প্রস্তাবিত কাজ: %lldটি কম ঝুঁকি, %lldটি মাঝারি ঝুঁকি, %lldটি উচ্চ ঝুঁকি। আনুমানিক পর্যালোচনাযোগ্য স্থান: %@।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிந்துரைக்கப்பட்ட %lld செயல்கள்: %lld குறைந்த ஆபத்து, %lld நடுத்தர ஆபத்து, %lld அதிக ஆபத்து. மதிப்பாய்வு செய்யக்கூடிய மதிப்பீட்டு இடம்: %@."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ప్రతిపాదిత చర్యలు: %lld తక్కువ ప్రమాదం, %lld మధ్యస్థ ప్రమాదం, %lld అధిక ప్రమాదం. అంచనా వేసిన సమీక్షించదగిన స్థలం: %@."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld प्रस्तावित क्रिया: %lld कमी जोखीम, %lld मध्यम जोखीम, %lld उच्च जोखीम. अंदाजे पुनरावलोकनयोग्य जागा: %@."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld પ્રસ્તાવિત ક્રિયાઓ: %lld ઓછું જોખમ, %lld મધ્યમ જોખમ, %lld ઊંચું જોખમ. અંદાજિત સમીક્ષા-યોગ્ય જગ્યા: %@."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ಪ್ರಸ್ತಾವಿತ ಕ್ರಿಯೆಗಳು: %lld ಕಡಿಮೆ ಅಪಾಯ, %lld ಮಧ್ಯಮ ಅಪಾಯ, %lld ಹೆಚ್ಚು ಅಪಾಯ. ಅಂದಾಜು ಪರಿಶೀಲಿಸಬಹುದಾದ ಸ್ಥಳ: %@."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld നിർദ്ദേശിച്ച പ്രവൃത്തികൾ: %lld കുറഞ്ഞ അപകടസാധ്യത, %lld ഇടത്തരം അപകടസാധ്യത, %lld ഉയർന്ന അപകടസാധ്യത. അവലോകനം ചെയ്യാവുന്ന ഏകദേശ ഇടം: %@."
          }
        },
        "pa": {
