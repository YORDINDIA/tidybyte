            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " %lld આઇટમ સિસ્ટમ-વ્યાપી સ્થાન પર છે જે macOS અથવા અન્ય વપરાશકર્તાઓ સાથે શેર કરવામાં આવે છે. આ માર્ગોની કાળજીપૂર્વક સમીક્ષા કરો."
