    "Unable to create PDF report.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to create PDF report."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF रिपोर्ट बनाने में असमर्थ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF প্রতিবেদন তৈরি করা যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF அறிக்கையை உருவாக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF నివేదికను సృష్టించడం సాధ్యం కాలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF अहवाल तयार करता आला नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF અહેવાલ બનાવી શકાયો નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF ವರದಿಯನ್ನು ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF റിപ്പോർട്ട് സൃഷ്ടിക്കാനായില്ല."
