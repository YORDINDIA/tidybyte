    "Clone action has no keeper file on record: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone action has no keeper file on record: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लोन क्रिया में कोई रखी गई फ़ाइल दर्ज नहीं है: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লোন কাজে কোনো রক্ষিত ফাইল নথিভুক্ত নেই: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குளோன் செயலில் பதிவான முதன்மைக் கோப்பு இல்லை: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్లోన్ చర్యలో రికార్డులో ఉంచిన ఫైల్ లేదు: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लोन क्रियेमध्ये नोंदीवर कोणतीही ठेवलेली फाइल नाही: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્લોન ક્રિયામાં નોંધ પર કોઈ રાખેલી ફાઇલ નથી: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಲೋನ್ ಕ್ರಿಯೆಯ ದಾಖಲೆಯಲ್ಲಿ ಯಾವುದೇ ಇರಿಸಿದ ಫೈಲ್ ಇಲ್ಲ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലോൺ പ്രവൃത്തിയിൽ രേഖപ്പെടുത്തിയ പ്രധാന ഫയലില്ല: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਲੋਨ ਕਾਰਵਾਈ ਵਿੱਚ ਰਿਕਾਰਡ 'ਤੇ ਕੋਈ ਰੱਖੀ ਫਾਈਲ ਨਹੀਂ: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción de clonación no tiene ningún archivo conservado registrado: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'action de clonage ne mentionne aucun fichier conservé : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klon-Aktion hat keine hinterlegte Originaldatei: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação de clone não tem nenhum arquivo mantido registrado: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'azione di clonazione non registra alcun file da mantenere: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローンアクションに保持ファイルが記録されていません: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복제 작업에 기록된 유지 파일이 없습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "克隆操作未记录保留文件：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для операции клонирования не указан сохраняемый файл: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي إجراء النسخ على ملف محفوظ مسجّل: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפעולת השכפול אין קובץ שמור רשום: %@"
          }
        }
      }
    },
    "Clone action names no keeper file.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone action names no keeper file."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लोन क्रिया में किसी रखी गई फ़ाइल का नाम नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লোন কাজে কোনো রক্ষিত ফাইলের নাম নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குளோன் செயலில் முதன்மைக் கோப்பின் பெயர் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్లోన్ చర్యలో ఉంచిన ఫైల్ పేరు లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लोन क्रियेमध्ये ठेवलेल्या फाइलचे नाव नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્લોન ક્રિયામાં કોઈ રાખેલી ફાઇલનું નામ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಲೋನ್ ಕ್ರಿಯೆಯಲ್ಲಿ ಯಾವುದೇ ಇರಿಸಿದ ಫೈಲ್ ಹೆಸರಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലോൺ പ്രവൃത്തിയിൽ പ്രധാന ഫയലിന്റെ പേരില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਲੋਨ ਕਾਰਵਾਈ ਵਿੱਚ ਕਿਸੇ ਰੱਖੀ ਫਾਈਲ ਦਾ ਨਾਮ ਨਹੀਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción de clonación no indica ningún archivo conservado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'action de clonage n'indique aucun fichier conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klon-Aktion nennt keine Originaldatei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação de clone não indica nenhum arquivo mantido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'azione di clonazione non indica alcun file da mantenere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローンアクションに保持ファイルが指定されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복제 작업에 유지 파일이 지정되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "克隆操作未指定保留文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В действии клонирования отсутствует сохраняемый файл."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحدّد إجراء النسخ ملفًا محفوظًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולת השכפול אינה מציינת קובץ שמור."
          }
        }
