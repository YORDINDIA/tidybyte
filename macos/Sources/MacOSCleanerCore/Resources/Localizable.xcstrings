    " Natural-language command requested archive-oriented organization.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Natural-language command requested archive-oriented organization."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": " प्राकृतिक-भाषा कमांड ने आर्काइव-आधारित व्यवस्थापन का अनुरोध किया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": " প্রাকৃতিক-ভাষার কমান্ড আর্কাইভ-ভিত্তিক বিন্যাসের অনুরোধ করেছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": " இயற்கை-மொழி கட்டளை காப்பக அடிப்படையிலான ஒழுங்கமைப்பைக் கோரியது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": " సహజ-భాష కమాండ్ ఆర్కైవ్-ఆధారిత నిర్వహణను అభ్యర్థించింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": " नैसर्गिक-भाषा कमांडने संग्रहण-आधारित व्यवस्थेची विनंती केली."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": " કુદરતી-ભાષા કમાન્ડે આર્કાઇવ-આધારિત ગોઠવણની વિનંતી કરી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": " ಸಹಜ-ಭಾಷಾ ಆಜ್ಞೆಯು ಆರ್ಕೈವ್-ಆಧಾರಿತ ವ್ಯವಸ್ಥೆಯನ್ನು ಕೋರಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": " സ്വാഭാവിക-ഭാഷാ കമാൻഡ് ആർക്കൈവ്-അധിഷ്ഠിത ക്രമീകരണം അഭ്യർത്ഥിച്ചു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": " ਕੁਦਰਤੀ-ਭਾਸ਼ਾ ਕਮਾਂਡ ਨੇ ਆਰਕਾਈਵ-ਆਧਾਰਿਤ ਪ੍ਰਬੰਧ ਦੀ ਬੇਨਤੀ ਕੀਤੀ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " El comando en lenguaje natural solicitó una organización orientada a archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " La commande en langage naturel a demandé une organisation orientée vers l'archivage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Befehl in natürlicher Sprache forderte archivorientierte Organisation an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " O comando em linguagem natural solicitou organização voltada para arquivamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Il comando in linguaggio naturale ha richiesto l'organizzazione per archiviazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " 自然言語コマンドによりアーカイブ向けの整理が要求されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 자연어 명령이 보관 중심 정리를 요청했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 自然语言指令请求了面向归档的整理方式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " Команда на естественном языке запросила организацию с архивированием."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": " طلب الأمر باللغة الطبيعية تنظيمًا يعتمد على الأرشفة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": " הפקודה בשפה טבעית ביקשה סידור מוכוון-ארכיון."
          }
        }
      }
    },
