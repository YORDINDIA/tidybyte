        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರ್ಯಾಶ್ ಅಥವಾ ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವುಗೆ ಸರಿಸಿ"
