            "value": "बाद में समीक्षा करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরে পর্যালোচনা করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்னர் மதிப்பாய்வு செய்"
