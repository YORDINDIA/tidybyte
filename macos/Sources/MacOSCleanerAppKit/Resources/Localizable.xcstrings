    "What changed? %@, %lld candidates, %lld reviewable actions, %lld high-risk.": {
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "What changed? %1$@, %2$lld candidates, %3$lld reviewable actions, %4$lld high-risk."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या बदला? %@, %lld उम्मीदवार, %lld समीक्षा-योग्य क्रियाएँ, %lld उच्च-जोखिम।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী পরিবর্তিত হয়েছে? %@, %lldটি প্রার্থী, %lldটি পর্যালোচনাযোগ্য কাজ, %lldটি উচ্চ-ঝুঁকি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "என்ன மாறியது? %@, %lld தகுதியானவை, %lld மதிப்பாய்வு செய்யக்கூடிய செயல்கள், %lld அதிக ஆபத்து."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏం మారింది? %@, %lld అభ్యర్థులు, %lld సమీక్షించదగిన చర్యలు, %lld అధిక-ప్రమాదం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काय बदलले? %@, %lld उमेदवार, %lld पुनरावलोकनयोग्य क्रिया, %lld उच्च-जोखीम."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું બદલાયું? %@, %lld ઉમેદવારો, %lld સમીક્ષા-યોગ્ય ક્રિયાઓ, %lld ઉચ્ચ-જોખમ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನು ಬದಲಾಗಿದೆ? %@, %lld ಅಭ್ಯರ್ಥಿಗಳು, %lld ಪರಿಶೀಲಿಸಬಹುದಾದ ಕ್ರಿಯೆಗಳು, %lld ಹೆಚ್ಚಿನ-ಅಪಾಯ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്താണ് മാറിയത്? %@, %lld ഉദ്യോഗാർത്ഥികൾ, %lld അവലോകനം ചെയ്യാവുന്ന പ്രവൃത്തികൾ, %lld ഉയർന്ന അപകടസാധ്യത."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਬਦਲਿਆ? %@, %lld ਉਮੀਦਵਾਰ, %lld ਸਮੀਖਿਆ-ਯੋਗ ਕਾਰਵਾਈਆਂ, %lld ਉੱਚ-ਜੋਖਮ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué cambió? %@, %lld candidatos, %lld acciones revisables, %lld de alto riesgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'est-ce qui a changé ? %@, %lld candidats, %lld actions examinables, %lld à risque élevé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was hat sich geändert? %@, %lld Kandidaten, %lld prüfbare Aktionen, %lld mit hohem Risiko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que mudou? %@, %lld candidatos, %lld ações revisáveis, %lld de alto risco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa è cambiato? %@, %lld candidati, %lld azioni esaminabili, %lld ad alto rischio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更点: %@、候補 %lld 件、確認可能なアクション %lld 件、高リスク %lld 件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항: %@, 후보 %lld개, 검토 가능한 작업 %lld개, 높은 위험 %lld개."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变化情况：%@，%lld 个候选项，%lld 项可审阅操作，%lld 项高风险。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что изменилось? %@, кандидатов: %lld, проверяемых действий: %lld, высокого риска: %lld."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي تغير؟ %@، %lld مرشحًا، %lld إجراءات قابلة للمراجعة، %lld عالية الخطورة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה השתנה? %@, %lld מועמדים, %lld פעולות לבדיקה, %lld בסיכון גבוה."
          }
        }
      }
    },
    "When files were touched, plus big untouched ones.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When files were touched, plus big untouched ones."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें कब उपयोग हुईं, और बड़ी अनछुई फ़ाइलें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইলগুলো কবে ব্যবহার হয়েছে, সাথে অব্যবহৃত বড় ফাইলসমূহ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புகள் எப்போது பயன்படுத்தப்பட்டன, மற்றும் பயன்படுத்தாத பெரிய கோப்புகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైళ్లు ఎప్పుడు ఉపయోగించబడ్డాయి, మరియు ఉపయోగించని పెద్ద ఫైళ్లు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल्स कधी वापरल्या गेल्या आणि न वापरलेल्या मोठ्या फाइल्स."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલો ક્યારે વપરાઈ હતી, સાથે મોટી વણવપરાયેલી ફાઇલો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ಗಳನ್ನು ಯಾವಾಗ ಬಳಸಲಾಗಿದೆ, ಜೊತೆಗೆ ಬಳಸದ ದೊಡ್ಡ ಫೈಲ್‌ಗಳು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലുകൾ എപ്പോൾ ഉപയോഗിച്ചു, കൂടാതെ ഉപയോഗിക്കാത്ത വലിയ ഫയലുകളും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਾਈਲਾਂ ਕਦੋਂ ਵਰਤੀਆਂ ਗਈਆਂ, ਅਤੇ ਵੱਡੀਆਂ ਅਣਵਰਤੀਆਂ ਫਾਈਲਾਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo se usaron los archivos, además de los grandes sin usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Date de dernière modification des fichiers, plus les gros fichiers inutilisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann Dateien zuletzt verwendet wurden, plus große unberührte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando os arquivos foram usados, além dos grandes sem uso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando i file sono stati usati, oltre ai file grandi inutilizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが最後に使われた時期と、未使用の大容量ファイル。"
          }
        },
        "ko": {
          "stringUnit": {
