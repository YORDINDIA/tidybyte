    "Choose where Tidybyte should create the inbox folder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where Tidybyte should create the inbox folder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि Tidybyte इनबॉक्स फ़ोल्डर कहाँ बनाए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte কোথায় ইনবক্স ফোল্ডার তৈরি করবে তা বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte இன்பாக்ஸ் கோப்புறையை எங்கே உருவாக்க வேண்டும் எனத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte ఇన్‌బాక్స్ ఫోల్డర్ ఎక్కడ సృష్టించాలో ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte ने इनबॉक्स फोल्डर कुठे तयार करावे ते निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte ઇનબૉક્સ ફોલ્ડર ક્યાં બનાવે તે પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte ಇನ್‌ಬಾಕ್ಸ್ ಫೋಲ್ಡರ್ ಎಲ್ಲಿ ರಚಿಸಬೇಕೆಂದು ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte ഇൻബോക്സ് ഫോൾഡർ എവിടെ സൃഷ്ടിക്കണമെന്ന് തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੋ ਕਿ Tidybyte ਇਨਬਾਕਸ ਫੋਲਡਰ ਕਿੱਥੇ ਬਣਾਵੇ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde debe crear Tidybyte la carpeta de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où Tidybyte doit créer le dossier Boîte de réception."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wo Tidybyte den Posteingangsordner erstellen soll."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde o Tidybyte deve criar a pasta de entrada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli dove Tidybyte deve creare la cartella In arrivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte が受信トレイフォルダを作成する場所を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte가 받은 파일함 폴더를 생성할 위치를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Tidybyte 创建收件箱文件夹的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, где Tidybyte создаст входящую папку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مكان إنشاء مجلد الوارد بواسطة Tidybyte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו היכן Tidybyte תיצור את תיקיית הדואר הנכנס."
          }
        }
      }
    },
