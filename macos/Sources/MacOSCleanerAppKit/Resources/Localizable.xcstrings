    "Execution completed with pending approved actions.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Execution completed with pending approved actions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ लंबित स्वीकृत क्रियाओं के साथ निष्पादन पूर्ण हुआ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অপেক্ষমান অনুমোদিত কাজসহ কার্যকর করা সম্পন্ন হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிலுவையிலுள்ள அங்கீகரிக்கப்பட்ட செயல்களுடன் செயல்படுத்தல் முடிந்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పెండింగ్ ఆమోదించబడిన చర్యలతో అమలు పూర్తయింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रलंबित मंजूर क्रियांसाह अंमलबजावणी पूर्ण झाली."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બાકી મંજૂર ક્રિયાઓ સાથે અમલ પૂર્ણ થયો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬಾಕಿಯಿರುವ ಅನುಮೋದಿತ ಕ್ರಿಯೆಗಳೊಂದಿಗೆ ಕಾರ್ಯಗತಗೊಳಿಸುವಿಕೆ ಪೂರ್ಣಗೊಂಡಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തീരുമാനിക്കാത്ത അംഗീകരിച്ച പ്രവൃത്തികളോടെ നടപ്പാക്കൽ പൂർത്തിയായി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਾਕੀ ਮਨਜ਼ੂਰ ਕਾਰਵਾਈਆਂ ਸਮੇਤ ਅਮਲ ਪੂਰਾ ਹੋਇਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecución completada con acciones aprobadas pendientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécution terminée avec des actions approuvées encore en attente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausführung mit noch ausstehenden genehmigten Aktionen beendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execução concluída com ações aprovadas pendentes."
          }
        },
        "it": {
          "stringUnit": {
