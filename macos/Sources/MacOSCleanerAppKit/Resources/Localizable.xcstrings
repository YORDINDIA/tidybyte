    "%lld successful · %lld failed · %lld unprocessed. Check Activity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld successful · %lld failed · %lld unprocessed. Check Activity."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld सफल · %lld विफल · %lld असंसाधित। गतिविधि जांचें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldটি সফল · %lldটি ব্যর্থ · %lldটি অপ্রক্রিয়াজাত। কার্যকলাপ দেখুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld வெற்றி · %lld தோல்வி · %lld செயலாக்கப்படாதவை. செயல்பாட்டைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld విజయవంతం · %lld విఫలం · %lld ప్రాసెస్ కానివి. కార్యాచరణను తనిఖీ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld यशस्वी · %lld अयशस्वी · %lld प्रक्रिया बाकी. क्रियाकलाप तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld સફળ · %lld નિષ્ફળ · %lld બાકી. પ્રવૃત્તિ તપાસો."
          }
        },
        "kn": {
