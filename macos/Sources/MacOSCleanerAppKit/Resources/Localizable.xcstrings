    "Undo completed.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo completed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ववत पूरा हुआ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্বাবস্থায় ফেরানো সম্পন্ন হয়েছে।"
          }
        },
