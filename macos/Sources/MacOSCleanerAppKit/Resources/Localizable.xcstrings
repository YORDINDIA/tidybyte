    "Installs a symlink at ~/.local/bin/tidybyte or lets you link /usr/local/bin/tidybyte manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs a symlink at ~/.local/bin/tidybyte or lets you link /usr/local/bin/tidybyte manually."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte पर सिमलिंक इंस्टॉल करता है या आपको /usr/local/bin/tidybyte को मैन्युअल रूप से लिंक करने देता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte-এ একটি সিমলিংক ইনস্টল করে বা ম্যানুয়ালি /usr/local/bin/tidybyte লিংক করতে দেয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte இல் சிம்லிங்க் நிறுவும் அல்லது /usr/local/bin/tidybyte ஐ கைமுறையாக இணைக்க உதவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte వద్ద సిమ్‌లింక్ ఇన్‌స్టాల్ చేస్తుంది లేదా మాన్యువల్‌గా /usr/local/bin/tidybyte ను లింక్ చేయడానికి అనుమతిస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte येथे सिमलिंक इन्स्टॉल करतो किंवा मॅन्युअली /usr/local/bin/tidybyte लिंक करू देतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte પર સિમલિંક ઇન્સ્ટૉલ કરે છે અથવા તમને જાતે /usr/local/bin/tidybyte લિંક કરવા દે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte ನಲ್ಲಿ ಸಿಮ್‌ಲಿಂಕ್ ಸ್ಥಾಪಿಸುತ್ತದೆ ಅಥವಾ /usr/local/bin/tidybyte ಅನ್ನು ಕೈಯಾರೆ ಲಿಂಕ್ ಮಾಡಲು ಅನುಮತಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte-ൽ സിംലിങ്ക് ഇൻസ്റ്റാൾ ചെയ്യുന്നു അല്ലെങ്കിൽ സ്വയം /usr/local/bin/tidybyte ലിങ്ക് ചെയ്യാൻ അനുവദിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte 'ਤੇ ਸਿਮਲਿੰਕ ਇੰਸਟਾਲ ਕਰਦਾ ਹੈ ਜਾਂ ਖੁਦ /usr/local/bin/tidybyte ਲਿੰਕ ਕਰਨ ਦਿੰਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala un enlace simbólico en ~/.local/bin/tidybyte o te permite enlazar /usr/local/bin/tidybyte manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe un lien symbolique dans ~/.local/bin/tidybyte ou vous permet de lier /usr/local/bin/tidybyte manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert einen symbolischen Link unter ~/.local/bin/tidybyte oder lässt dich /usr/local/bin/tidybyte manuell verknüpfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala um link simbólico em ~/.local/bin/tidybyte ou permite vincular /usr/local/bin/tidybyte manualmente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa un collegamento simbolico in ~/.local/bin/tidybyte o consente di collegare /usr/local/bin/tidybyte manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte にシンボリックリンクを作成するか、手動で /usr/local/bin/tidybyte にリンクできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.local/bin/tidybyte에 심볼릭 링크를 설치하거나 /usr/local/bin/tidybyte에 수동으로 연결할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 ~/.local/bin/tidybyte 安装符号链接，或允许您手动链接至 /usr/local/bin/tidybyte。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создает символьную ссылку в ~/.local/bin/tidybyte или позволяет вручную связать /usr/local/bin/tidybyte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يثبت رابطًا رمزيًا في ~/.local/bin/tidybyte أو يتيح لك ربط /usr/local/bin/tidybyte يدويًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתקין קישור סימבולי ב-~/.local/bin/tidybyte או מאפשר לקשר ידנית ל-/usr/local/bin/tidybyte."
          }
        }
      }
    },
