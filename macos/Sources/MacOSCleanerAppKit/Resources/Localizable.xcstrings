            "value": "গত 30 দিনে প্রক্রিয়াকৃত লজিক্যাল বাইট"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த 30 நாட்களில் செயலாக்கப்பட்ட தருக்க பைட்கள்"
