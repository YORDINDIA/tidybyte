    "Cannot clear data while a scan, media cleanup, or execution is in progress.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot clear data while a scan, media cleanup, or execution is in progress."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन, मीडिया सफ़ाई या क्रियान्वयन चलने के दौरान डेटा साफ़ नहीं किया जा सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান, মিডিয়া ক্লিনআপ বা কার্যকর চলাকালীন ডেটা মুছে ফেলা যাবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன், மீடியா சுத்திகரிப்பு அல்லது செயல்படுத்தல் நடக்கும்போது தரவை அழிக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్, మీడియా శుభ్రత లేదా అమలు జరుగుతున్నప్పుడు డేటాను క్లియర్ చేయలేము."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन, मीडिया क्लीनअप किंवा अंमलबजावणी सुरू असताना डेटा साफ करता येत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન, મીડિયા ક્લીનઅપ અથવા અમલ ચાલુ હોય ત્યારે ડેટા સાફ કરી શકાતો નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್, ಮೀಡಿಯಾ ಸ್ವಚ್ಛತೆ ಅಥವಾ ಕಾರ್ಯಗತಗೊಳಿಸುವಿಕೆ ನಡೆಯುತ್ತಿರುವಾಗ ಡೇಟಾ ತೆರವುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ, മീഡിയ വൃത്തിയാക്കൽ അല്ലെങ്കിൽ നടപ്പാക്കൽ തുടരുമ്പോൾ ഡാറ്റ മായ്ക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ, ਮੀਡੀਆ ਸਫਾਈ ਜਾਂ ਅਮਲ ਦੌਰਾਨ ਡੇਟਾ ਸਾਫ਼ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden borrar los datos mientras haya un análisis, limpieza multimedia o ejecución en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'effacer les données pendant une analyse, un nettoyage média ou une exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten können nicht gelöscht werden, während ein Scan, eine Medienbereinigung oder eine Ausführung läuft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível apagar os dados enquanto uma análise, limpeza de mídia ou execução estiver em andamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare i dati mentre è in corso una scansione, una pulizia media o un'esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン、メディアクリーンアップ、または実行中はデータを消去できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔, 미디어 정리 또는 실행이 진행되는 동안에는 데이터를 지울 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描、媒体清理或执行操作进行期间无法清除数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельзя очистить данные во время сканирования, очистки медиа или выполнения действий."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن مسح البيانات أثناء فحص أو تنظيف وسائط أو تنفيذ قيد التقدم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לנקות נתונים בזמן שסריקה, ניקוי מדיה או ביצוע פעילים."
          }
        }
      }
    },
    "Cannot export while a scan or execution is in progress.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
