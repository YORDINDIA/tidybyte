    "None visible to this user.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None visible to this user."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस उपयोगकर्ता को कुछ भी दिखाई नहीं दे रहा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ব্যবহারকারীর জন্য কিছু দৃশ্যমান নয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பயனருக்கு எதுவும் தெரியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వినియోగదారుకు ఏదీ కనిపించడం లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या वापरकर्त्यासाठी काहीही दृश्यमान नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વપરાશકર્તાને કંઈ દેખાતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಬಳಕೆದಾರರಿಗೆ ಏನೂ ಗೋಚರಿಸುತ್ತಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപയോക്താവിന് ഒന്നും കാണാനില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵਰਤੋਂਕਾਰ ਨੂੰ ਕੁਝ ਦਿਖਾਈ ਨਹੀਂ ਦੇ ਰਿਹਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno visible para este usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun élément visible pour cet utilisateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Benutzer nichts sichtbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum visível para este usuário."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno visibile per questo utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユーザーに表示できる項目はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사용자에게 표시할 항목이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前用户不可见任何项目。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого пользователя нет видимых объектов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء مرئي لهذا المستخدم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין פריטים גלויים למשתמש זה."
          }
        }
      }
    },
