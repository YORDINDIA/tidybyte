            "value": "मॅन्युअल पुनरावलोकनाशिवाय स्रोत कोड फाइल्स हटवण्याचे सुचवू नका."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જાતે સમીક્ષા કર્યા વિના સ્રોત કોડ ફાઇલો કાઢી નાખવાનું સૂચવશો નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೈಯಾರೆ ಪರಿಶೀಲನೆಯಿಲ್ಲದೆ ಮೂಲ ಕೋಡ್ ಫೈಲ್‌ಗಳನ್ನು ಅಳಿಸಲು ಸೂಚಿಸಬೇಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയം അവലോകനമില്ലാതെ സോഴ്സ് കോഡ് ഫയലുകൾ ഇല്ലാതാക്കാൻ നിർദ്ദേശിക്കരുത്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖੁਦ ਸਮੀਖਿਆ ਤੋਂ ਬਿਨਾਂ ਸਰੋਤ ਕੋਡ ਫਾਈਲਾਂ ਮਿਟਾਉਣ ਦਾ ਸੁਝਾਅ ਨਾ ਦਿਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca sugerir eliminar archivos de código fuente sin revisión manual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais proposer la suppression de fichiers de code source sans examen manuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie das Löschen von Quellcodedateien ohne manuelle Prüfung vorschlagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca sugerir apagar arquivos de código-fonte sem revisão manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non suggerire mai di eliminare file di codice sorgente senza revisione manuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動確認なしにソースコードファイルの削除を提案しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 검토 없이 소스 코드 파일의 삭제를 제안하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
