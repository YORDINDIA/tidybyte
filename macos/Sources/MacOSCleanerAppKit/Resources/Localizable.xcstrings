    "%lld actions completed cleanly. Files in Trash can be restored or emptied anytime.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld action completed cleanly. Files in Trash can be restored or emptied anytime."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld actions completed cleanly. Files in Trash can be restored or emptied anytime."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld क्रिया सफलतापूर्वक पूरी हुई। ट्रैश की फ़ाइलों को कभी भी पुनर्स्थापित या खाली किया जा सकता है।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld क्रियाएं सफलतापूर्वक पूरी हुईं। ट्रैश की फ़ाइलों को कभी भी पुनर्स्थापित या खाली किया जा सकता है।"
                }
              }
            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lldটি কাজ সফলভাবে সম্পন্ন হয়েছে। ট্র্যাশের ফাইল যেকোনো সময় পুনরুদ্ধার বা খালি করা যাবে।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lldটি কাজ সফলভাবে সম্পন্ন হয়েছে। ট্র্যাশের ফাইল যেকোনো সময় পুনরুদ্ধার বা খালি করা যাবে।"
                }
              }
            }
          }
        },
        "ta": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld செயல் வெற்றிகரமாக முடிந்தது. குப்பைத் தொட்டியில் உள்ள கோப்புகளை எப்போது வேண்டுமானாலும் மீட்டெடுக்கலாம் அல்லது காலியாக்கலாம்."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld செயல்கள் வெற்றிகரமாக முடிந்தன. குப்பைத் தொட்டியில் உள்ள கோப்புகளை எப்போது வேண்டுமானாலும் மீட்டெடுக்கலாம் அல்லது காலியாக்கலாம்."
                }
              }
            }
          }
        },
        "te": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld చర్య విజయవంతంగా పూర్తయింది. ట్రాష్‌లోని ఫైళ్లను ఎప్పుడైనా పునరుద్ధరించవచ్చు లేదా ఖాళీ చేయవచ్చు."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
