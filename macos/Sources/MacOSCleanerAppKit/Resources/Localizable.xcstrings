    "Staged %@ for review in Proposed Actions.": {
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Staged %@ for review in Proposed Actions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रस्तावित क्रियाओं में समीक्षा के लिए %@ तैयार रखा गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্তাবিত কাজ-এ পর্যালোচনার জন্য %@ প্রস্তুত রাখা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பரிந்துரைக்கப்பட்ட செயல்களில் மதிப்பாய்வுக்கு %@ தயார்நிலையில் வைக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతిపాదిత చర్యలలో సమీక్ష కోసం %@ సిద్ధం చేయబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रस्तावित क्रियांमध्ये पुनरावलोकनासाठी %@ तयार ठेवले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રસ્તાવિત ક્રિયાઓમાં સમીક્ષા માટે %@ તૈયાર રાખ્યું."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಸ್ತಾವಿತ ಕ್ರಿಯೆಗಳಲ್ಲಿ ಪರಿಶೀಲನೆಗಾಗಿ %@ ಸಿದ್ಧಪಡಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിർദ്ദേശിച്ച പ്രവൃത്തികളിൽ അവലോകനത്തിനായി %@ സജ്ജമാക്കി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਸਤਾਵਿਤ ਕਾਰਵਾਈਆਂ ਵਿੱਚ ਸਮੀਖਿਆ ਲਈ %@ ਤਿਆਰ ਰੱਖਿਆ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se preparó %@ para revisar en Acciones propuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ préparé pour examen dans Actions proposées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zur Prüfung in „Vorgeschlagene Aktionen“ vorgemerkt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ preparado para revisão em Ações propostas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ preparato per la revisione in Azioni proposte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「提案されたアクション」で確認するため %@ を追加しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안된 작업에서 검토하도록 %@을(를) 대기시켰습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %@ 加入“建议操作”以待审阅。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объект %@ подготовлен для проверки в «Предложенных действиях»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تجهيز %@ للمراجعة في الإجراءات المقترحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הועבר להמתנה לבדיקה בפעולות מוצעות."
          }
        }
      }
