    "Only local folders can be added to a scan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only local folders can be added to a scan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन में केवल लोकल फ़ोल्डर ही जोड़े जा सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যানে শুধুমাত্র স্থানীয় ফোল্ডার যোগ করা যাবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் கோப்புறைகளை மட்டுமே ஸ்கேனில் சேர்க்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్‌కు స్థానిక ఫోల్డర్లను మాత్రమే జోడించవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅनमध्ये केवळ स्थानिक फोल्डर्स जोडता येतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅનમાં માત્ર સ્થાનિક ફોલ્ડર્સ જ ઉમેરી શકાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್‌ಗೆ ಸ್ಥಳೀಯ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಮಾತ್ರ ಸೇರಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാനിലേക്ക് പ്രാദേശിക ഫോൾഡറുകൾ മാത്രമേ ചേർക്കാൻ കഴിയൂ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਵਿੱਚ ਕੇਵਲ ਸਥਾਨਕ ਫੋਲਡਰ ਹੀ ਸ਼ਾਮਲ ਕੀਤੇ ਜਾ ਸਕਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden añadir carpetas locales a un análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls des dossiers locaux peuvent être ajoutés à une analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es können nur lokale Ordner zu einem Scan hinzugefügt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas pastas locais podem ser adicionadas a uma análise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le cartelle locali possono essere aggiunte a una scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンに追加できるのはローカルフォルダのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 폴더만 스캔에 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅可将本地文件夹添加到扫描中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сканирование можно добавлять только локальные папки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إضافة المجلدات المحلية فقط إلى الفحص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להוסיף לסריקה תיקיות מקומיות בלבד."
          }
        }
      }
    },
