    "Reclaims %@ without deleting anything. Every file keeps its name and metadata. Undoable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaims %@ without deleting anything. Every file keeps its name and metadata. Undoable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना कुछ हटाए %@ खाली करता है। हर फ़ाइल का नाम और मेटाडेटा सुरक्षित रहता है। पूर्ववत करने योग्य।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছু না মুছেই %@ উদ্ধার করে। প্রতিটি ফাইল তার নাম ও মেটাডেটা ধরে রাখে। পূর্বাবস্থায় ফেরানো যায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதையும் நீக்காமல் %@ இடத்தை மீட்டெடுக்கிறது. ஒவ்வொரு கோப்பும் தன் பெயரையும் மெட்டாடேட்டாவையும் வைத்திருக்கும். செயல்தவிர்க்கக்கூடியது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ తొలగించకుండా %@ స్థలాన్ని తిరిగి పొందుతుంది. ప్రతి ఫైల్ దాని పేరు మరియు మెటాడేటాను ఉంచుతుంది. రద్దు చేయదగినది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही न हटवता %@ मोकळे करते. प्रत्येक फाइल तिचे नाव आणि मेटाडेटा ठेवते. पूर्ववत करण्यायोग्य."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈપણ કાઢી નાખ્યા વિના %@ ખાલી કરે છે. દરેક ફાઇલ તેનું નામ અને મેટાડેટા જાળવી રાખે છે. પૂર્વવત કરી શકાય."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನನ್ನೂ ಅಳಿಸದೆ %@ ಸ್ಥಳವನ್ನು ಮರಳಿ ಪಡೆಯುತ್ತದೆ. ಪ್ರತಿ ಫೈಲ್ ತನ್ನ ಹೆಸರು ಮತ್ತು ಮೆಟಾಡೇಟಾವನ್ನು ಉಳಿಸಿಕೊಳ್ಳುತ್ತದೆ. ರದ್ದುಮಾಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും ഇല്ലാതാക്കാതെ %@ ഇടം വീണ്ടെടുക്കുന്നു. ഓരോ ഫയലും അതിന്റെ പേരും മെറ്റാഡാറ്റയും നിലനിർത്തുന്നു. പഴയപടിയാക്കാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਵੀ ਮਿਟਾਏ ਬਿਨਾਂ %@ ਖਾਲੀ ਕਰਦਾ ਹੈ। ਹਰ ਫਾਈਲ ਆਪਣਾ ਨਾਮ ਅਤੇ ਮੈਟਾਡੇਟਾ ਰੱਖਦੀ ਹੈ। ਵਾਪਸ ਕਰਨ ਯੋਗ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera %@ sin eliminar nada. Cada archivo conserva su nombre y metadatos. Reversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère %@ sans rien supprimer. Chaque fichier conserve son nom et ses métadonnées. Annulable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt %@ frei, ohne etwas zu löschen. Jede Datei behält Namen und Metadaten. Widerrufbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera %@ sem apagar nada. Cada arquivo mantém seu nome e metadados. Reversível."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera %@ senza eliminare nulla. Ogni file mantiene nome e metadati. Annullabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も削除せずに %@ を回収します。各ファイルの名前とメタデータは保持され、取り消し可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 삭제하지 않고 %@을(를) 확보합니다. 모든 파일의 이름과 메타데이터가 유지되며 실행 취소할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不删除任何文件即可回收 %@。所有文件都会保留名称与元数据，且可撤销。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освобождает %@ без удаления файлов. Имена и метаданные сохраняются. Обратимо."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد %@ دون حذف أي شيء. يحتفظ كل ملف باسمه وبياناته الوصفية. قابل للتراجع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משחרר %@ ללא מחיקת דבר. כל קובץ שומר על שמו ומטא-הנתונים שלו. ניתן לביטול."
          }
        }
      }
    },
