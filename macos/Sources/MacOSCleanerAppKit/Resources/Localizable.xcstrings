    "Affected file size; reclaimable space depends on the operation": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Affected file size; reclaimable space depends on the operation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रभावित फ़ाइल का आकार; प्राप्त होने वाला स्थान क्रिया पर निर्भर करता है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রভাবিত ফাইলের আকার; উদ্ধারযোগ্য স্থান কাজের ধরনের ওপর নির্ভর করে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதிக்கப்பட்ட கோப்பு அளவு; மீட்கக்கூடிய இடம் செயலைப் பொறுத்தது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రభావిత ఫైల్ పరిమాణం; తిరిగి పొందగల స్థలం చర్యపై ఆధారపడి ఉంటుంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रभावित फाइल आकार; परत मिळणारी जागा क्रियेवर अवलंबून असते"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અસરગ્રસ્ત ફાઇલનું કદ; ખાલી થતી જગ્યા ક્રિયા પર આધારિત છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಭಾವಿತ ಫೈಲ್ ಗಾತ್ರ; ಮರಳಿ ಪಡೆಯಬಹುದಾದ ಸ್ಥಳ ಕ್ರಿಯೆಯನ್ನು ಅವಲಂಬಿಸಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാധിച്ച ഫയൽ വലുപ്പം; വീണ്ടെടുക്കാവുന്ന ഇടം പ്രവൃത്തിയെ ആശ്രയിച്ചിരിക്കുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਭਾਵਿਤ ਫਾਈਲ ਆਕਾਰ; ਖਾਲੀ ਹੋਣ ਵਾਲੀ ਥਾਂ ਕਾਰਵਾਈ 'ਤੇ ਨਿਰਭਰ ਕਰਦੀ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño de archivo afectado; el espacio recuperable depende de la operación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille de fichier concernée ; l'espace récupérable dépend de l'opération"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe der betroffenen Datei; der freigebbare Platz hängt vom Vorgang ab"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho do arquivo afetado; o espaço recuperável depende da operação"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensione del file interessato; lo spazio recuperabile dipende dall'operazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象ファイルのサイズ。解放される容量は操作により異なります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 파일 크기. 확보 가능한 공간은 작업에 따라 다릅니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受影响的文件大小；实际可回收空间取决于具体操作"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер затрагиваемого файла; освобождаемый объем зависит от операции"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم الملف المتأثر؛ تعتمد المساحة المستعادة على العملية"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גודל הקובץ המושפע; הנפח שיתפנה תלוי בפעולה"
          }
        }
      }
    },
