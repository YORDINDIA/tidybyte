    "Or drop folders here to add them to your scan scope.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or drop folders here to add them to your scan scope."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "या अपने स्कैन दायरे में जोड़ने के लिए फ़ोल्डर यहाँ छोड़ें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অথবা আপনার স্ক্যান পরিসরে যোগ করতে ফোল্ডারগুলো এখানে ছেড়ে দিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அல்லது உங்கள் ஸ்கேன் வரம்பில் சேர்க்க கோப்புறைகளை இங்கே விடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లేదా మీ స్కాన్ పరిధిలో చేర్చడానికి ఫోల్డర్లను ఇక్కడ వదలండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "किंवा तुमच्या स्कॅन कार्यक्षेत्रात जोडण्यासाठी फोल्डर्स येथे सोडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અથવા તમારા સ્કૅન વિસ્તારમાં ઉમેરવા ફોલ્ડર્સ અહીં મૂકો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಥವಾ ನಿಮ್ಮ ಸ್ಕ್ಯಾನ್ ವ್ಯಾಪ್ತಿಗೆ ಸೇರಿಸಲು ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಇಲ್ಲಿ ಬಿಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അല്ലെങ്കിൽ നിങ്ങളുടെ സ്കാൻ പരിധിയിൽ ചേർക്കാൻ ഫോൾഡറുകൾ ഇവിടെ ഇടുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਂ ਆਪਣੇ ਸਕੈਨ ਦਾਇਰੇ ਵਿੱਚ ਸ਼ਾਮਲ ਕਰਨ ਲਈ ਫੋਲਡਰ ਇੱਥੇ ਛੱਡੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O suelta carpetas aquí para añadirlas al alcance del análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou déposez des dossiers ici pour les ajouter à votre périmètre d'analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder ziehe Ordner hierher, um sie zum Scan-Umfang hinzuzufügen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou solte pastas aqui para adicioná-las ao escopo da análise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure trascina qui le cartelle per aggiungerle all'area di scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "またはここにフォルダをドロップしてスキャン範囲に追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 여기에 폴더를 놓아 스캔 범위에 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或将文件夹拖放到此处以加入扫描范围。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или перетащите папки сюда, чтобы добавить их в область сканирования."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أو أفلت المجلدات هنا لإضافتها إلى نطاق الفحص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "או שחררו כאן תיקיות כדי להוסיף להיקף הסריקה."
          }
        }
      }
    },
    "Order containers by a metric": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order containers by a metric"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीट्रिक के अनुसार कंटेनर क्रमबद्ध करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেট্রিক অনুযায়ী কন্টেইনার সাজান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அளவீட்டின்படி கொள்கலன்களை வரிசைப்படுத்து"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మెట్రిక్ ప్రకారం కంటైనర్లను క్రమబద్ధీకరించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मेट्रिकनुसार कंटेनर्स क्रमवारीत लावा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મેટ્રિક પ્રમાણે કન્ટેનર્સ ગોઠવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆಟ್ರಿಕ್ ಪ್ರಕಾರ ಕಂಟೇನರ್‌ಗಳನ್ನು ವಿಂಗಡಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മെട്രിക് പ്രകാരം കണ്ടെയ്നറുകൾ ക്രമീകരിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੀਟਰਿਕ ਅਨੁਸਾਰ ਕੰਟੇਨਰ ਕ੍ਰਮਬੱਧ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar contenedores según una métrica"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trier les conteneurs selon une mesure"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Container nach einer Metrik sortieren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar contêineres por uma métrica"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina i container per una metrica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指標でコンテナを並べ替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지표별로 컨테이너 정렬"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按指标排列容器"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядочить контейнеры по показателю"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتيب الحاويات حسب مقياس"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדר מכולות לפי מדד"
          }
        }
      }
    },
    "Order the rows by a metric or name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order the rows by a metric or name"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीट्रिक या नाम के अनुसार पंक्तियाँ क्रमबद्ध करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মেট্রিক বা নাম অনুযায়ী সারি সাজান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அளவீடு அல்லது பெயரின்படி வரிசைகளை அமை"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మెట్రిక్ లేదా పేరు ప్రకారం వరుసలను అమర్చండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मेट्रिक किंवा नावानुसार रांगा क्रमवारीत लावा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મેટ્રિક અથવા નામ પ્રમાણે હરોળો ગોઠવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೆಟ್ರಿಕ್ ಅಥವಾ ಹೆಸರಿನ ಪ್ರಕಾರ ಸಾಲುಗಳನ್ನು ವಿಂಗಡಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മെട്രിക് അല്ലെങ്കിൽ പേര് പ്രകാരം വരികൾ ക്രമീകരിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੀਟਰਿਕ ਜਾਂ ਨਾਮ ਅਨੁਸਾਰ ਕਤਾਰਾਂ ਕ੍ਰਮਬੱਧ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar las filas por una métrica o por nombre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trier les lignes selon une mesure ou le nom"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeilen nach einer Metrik oder nach Namen sortieren"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenar linhas por uma métrica ou nome"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina le righe per metrica o nome"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指標または名前で行を並べ替え"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지표 또는 이름순으로 행 정렬"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按指标或名称排列列表行"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упорядочить строки по показателю или имени"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتيب الصفوف حسب مقياس أو بالاسم"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדר שורות לפי מדד או שם"
          }
        }
      }
    },
