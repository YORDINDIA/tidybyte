            "state": "translated",
            "value": "スキャンフォルダをすべて削除しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 스캔 폴더를 제거했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
