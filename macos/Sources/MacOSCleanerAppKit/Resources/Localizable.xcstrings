    "Offer to clean up after I delete an app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer to clean up after I delete an app"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे द्वारा कोई ऐप हटाने के बाद क्लीनअप का सुझाव दें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি কোনো অ্যাপ মুছে ফেলার পর ক্লিনআপের পরামর্শ দিন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் ஒரு செயலியை நீக்கிய பிறகு சுத்திகரிப்பைப் பரிந்துரைக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను యాప్ తొలగించిన తర్వాత శుభ్రతను సూచించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मी अ‍ॅप हटवल्यानंतर क्लीनअप सुचवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હું ઍપ કાઢી નાખું પછી ક્લીનઅપનું સૂચન કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಾನು ಆ್ಯಪ್ ಅಳಿಸಿದ ನಂತರ ಸ್ವಚ್ಛತೆಯನ್ನು ಸೂಚಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഞാൻ ഒരു ആപ്പ് ഇല്ലാതാക്കിയ ശേഷം വൃത്തിയാക്കൽ നിർദ്ദേശിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੇਰੇ ਵੱਲੋਂ ਐਪ ਮਿਟਾਉਣ ਤੋਂ ਬਾਅਦ ਸਫਾਈ ਦੀ ਪੇਸ਼ਕਸ਼ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofrecer limpiar los restos cuando borre una app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer un nettoyage après la suppression d'une app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Löschen einer App eine Bereinigung anbieten"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferecer limpeza após eu apagar um app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponi la pulizia dopo che elimino un'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを削除した後にクリーンアップを提案する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 삭제한 후 정리 제안"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除应用后主动提示清理残留"
