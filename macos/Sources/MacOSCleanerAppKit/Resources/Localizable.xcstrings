    "Fold %@ onto their keepers as APFS clones (nothing is deleted)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fold %@ onto their keepers as APFS clones (nothing is deleted)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को उनके मूल पर APFS क्लोन के रूप में समेकित करें (कुछ नहीं हटता)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে তাদের মূল ফাইলের সাথে APFS ক্লোন হিসেবে একত্রিত করুন (কিছুই মুছে যাবে না)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐ அவற்றின் முதன்மைக் கோப்புகளில் APFS குளோன்களாக மடிக்கவும் (எதுவும் நீக்கப்படாது)"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ను వాటి అసలు ఫైళ్లపై APFS క్లోన్లుగా ఫోల్డ్ చేయండి (ఏదీ తొలగించబడదు)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ त्यांच्या मूळ फाइल्सवर APFS क्लोन म्हणून एकत्रित करा (काहीही हटवले जात नाही)"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ને તેમની મૂળ ફાઇલો પર APFS ક્લોન તરીકે એકત્રિત કરો (કંઈ કાઢવામાં આવતું નથી)"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಅನ್ನು ಅವುಗಳ ಮೂಲ ಫೈಲ್‌ಗಳ ಮೇಲೆ APFS ಕ್ಲೋನ್‌ಗಳಾಗಿ ಫೋಲ್ಡ್ ಮಾಡಿ (ಏನನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ)"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ അവയുടെ പ്രധാന ഫയലുകളിൽ APFS ക്ലോണുകളായി ഫോൾഡ് ചെയ്യുക (ഒന്നും ഇല്ലാതാക്കില്ല)"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਨੂੰ ਉਹਨਾਂ ਦੀਆਂ ਮੂਲ ਫਾਈਲਾਂ ਉੱਤੇ APFS ਕਲੋਨਾਂ ਵਜੋਂ ਫੋਲਡ ਕਰੋ (ਕੁਝ ਨਹੀਂ ਮਿਟਾਇਆ ਜਾਂਦਾ)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plegar %@ sobre sus archivos conservados como clones APFS (no se elimina nada)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regrouper %@ sur leurs originaux en clones APFS (rien n'est supprimé)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ als APFS-Klone auf ihre Originale falten (nichts wird gelöscht)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Unificar %@ em seus arquivos mantidos como clones APFS (nada é apagado)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisci %@ sui file mantenuti come cloni APFS (nulla viene eliminato)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を保持ファイルの APFS クローンとして統合（削除なし）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 유지 파일의 APFS 복제본으로 통합 (삭제 없음)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 作为 APFS 克隆折叠到保留文件（不删除任何内容）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свернуть %@ на сохраняемые файлы как клоны APFS (без удаления)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طيّ %@ كنسخ APFS على ملفاتها المحفوظة (دون حذف شيء)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיפול %@ על גבי הקבצים השמורים כשכפולי APFS (דבר לא נמחק)"
          }
        }
      }
    },
