          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖੋਜ ਨਾਲ ਕੋਈ ਪ੍ਰਕਿਰਿਆ ਮੇਲ ਨਹੀਂ ਖਾਂਦੀ।"
          }
        },
