    "Replace & Trash Live Photo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace & Trash Live Photo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलें और मूल Live Photo को ट्रैश में भेजें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিস্থাপন করুন ও মূল Live Photo ট্র্যাশে পাঠান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மாற்றி அசல் Live Photo ஐ குப்பைத் தொட்டிக்கு அனுப்பு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "భర్తీ చేసి అసలు Live Photo ను ట్రాష్‌లోకి పంపండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
