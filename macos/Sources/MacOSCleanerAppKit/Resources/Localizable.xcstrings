        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધા સ્કૅન ફોલ્ડર્સ દૂર કર્યા."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಸ್ಕ್ಯಾನ್ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ."
