    "This Mac did not report GPU statistics.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac did not report GPU statistics."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac ने GPU आँकड़ों की रिपोर्ट नहीं दी।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac GPU পরিসংখ্যান রিপোর্ট করেনি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac GPU புள்ளிவிவரங்களை அறிவிக்கவில்லை."
          }
        },
        "te": {
