    "Be more willing to suggest cleanup for old downloads and installers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be more willing to suggest cleanup for old downloads and installers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने डाउनलोड और इंस्टॉलर की सफ़ाई अधिक बार सुझाएं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুরনো ডাউনলোড ও ইনস্টলারের ক্লিনআপ বেশি করে সুপারিশ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பழைய பதிவிறக்கங்கள் மற்றும் நிறுவிகளைச் சுத்திகரிக்க அதிகம் பரிந்துரைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాత డౌన్‌లోడ్‌లు మరియు ఇన్‌స్టాలర్‌ల శుభ్రతను మరింత తరచుగా సూచించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जुने डाउनलोड्स आणि इन्स्टॉलर्स साफ करण्याचे अधिक वेळा सुचवा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જૂના ડાઉનલોડ્સ અને ઇન્સ્ટૉલર્સ સાફ કરવા માટે વધુ વખત સૂચન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಳೆಯ ಡೌನ್‌ಲೋಡ್‌ಗಳು ಮತ್ತು ಇನ್‌ಸ್ಟಾಲರ್‌ಗಳನ್ನು ಸ್ವಚ್ಛಗೊಳಿಸಲು ಹೆಚ್ಚಾಗಿ ಸೂಚಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പഴയ ഡൗൺലോഡുകളും ഇൻസ്റ്റാളറുകളും വൃത്തിയാക്കാൻ കൂടുതൽ നിർദ്ദേശിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੁਰਾਣੇ ਡਾਊਨਲੋਡਸ ਅਤੇ ਇੰਸਟਾਲਰਾਂ ਦੀ ਸਫਾਈ ਵੱਧ ਵਾਰ ਸੁਝਾਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerir con mayor frecuencia la limpieza de descargas e instaladores antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer plus volontiers le nettoyage des anciens téléchargements et installateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Downloads und Installationsdateien häufiger zur Bereinigung vorschlagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerir com mais frequência a limpeza de downloads e instaladores antigos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponi più spesso la pulizia di download e installer obsoleti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いダウンロードファイルやインストーラのクリーンアップをより積極的に提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 다운로드 파일과 설치 프로그램 정리를 더 적극적으로 제안합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更积极地建议清理旧下载文件与安装器。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаще предлагать очистку старых загрузок и установщиков."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتراح تنظيف التنزيلات القديمة وبرامج التثبيت بشكل أكبر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הציעו לעיתים קרובות יותר ניקוי של הורדות ישנות וקבצי התקנה."
          }
        }
      }
    },
