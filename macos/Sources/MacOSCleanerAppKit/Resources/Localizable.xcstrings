            "value": "限定的なアクセス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한된 접근"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有限访问权限"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченный доступ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصول محدود"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גישה מוגבלת"
          }
        }
      }
    },
    "Limited Access only shows selected photos. Choose Select More Photos… to grant Full Access in System Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limited Access only shows selected photos. Choose Select More Photos… to grant Full Access in System Settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित एक्सेस केवल चुनी गई फ़ोटो दिखाता है। सिस्टम सेटिंग्स में पूर्ण एक्सेस देने के लिए अधिक फ़ोटो चुनें… चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমিত অ্যাক্সেসে কেবল নির্বাচিত ছবি দেখা যায়। সিস্টেম সেটিংসে সম্পূর্ণ অ্যাক্সেস দিতে আরও ছবি নির্বাচন করুন… বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரையறுக்கப்பட்ட அணுகல் தேர்ந்தெடுத்த புகைப்படங்களை மட்டுமே காட்டும். கணினி அமைப்புகளில் முழு அணுகல் வழங்க மேலும் புகைப்படங்களைத் தேர்ந்தெடு… என்பதைத் தேர்வுசெய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరిమిత యాక్సెస్ ఎంచుకున్న ఫోటోలను మాత్రమే చూపుతుంది. సిస్టమ్ సెట్టింగ్‌లలో పూర్తి యాక్సెస్ ఇవ్వడానికి మరిన్ని ఫోటోలు ఎంచుకోండి… ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मर्यादित प्रवेश केवळ निवडलेले फोटो दाखवतो. सिस्टम सेटिंग्जमध्ये पूर्ण प्रवेश देण्यासाठी अधिक फोटो निवडा… निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મર્યાદિત ઍક્સેસ માત્ર પસંદ કરેલા ફોટા બતાવે છે. સિસ્ટમ સેટિંગ્સમાં સંપૂર્ણ ઍક્સેસ આપવા વધુ ફોટો પસંદ કરો… પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೀಮಿತ ಪ್ರವೇಶವು ಆಯ್ಕೆಮಾಡಿದ ಫೋಟೋಗಳನ್ನು ಮಾತ್ರ ತೋರಿಸುತ್ತದೆ. ಸಿಸ್ಟಮ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಪೂರ್ಣ ಪ್ರವೇಶ ನೀಡಲು ಹೆಚ್ಚಿನ ಫೋಟೋಗಳನ್ನು ಆಯ್ಕೆಮಾಡಿ… ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിമിതമായ ആക്സസ് തിരഞ്ഞെടുത്ത ഫോട്ടോകൾ മാത്രമേ കാണിക്കൂ. സിസ്റ്റം ക്രമീകരണങ്ങളിൽ പൂർണ്ണ ആക്സസ് നൽകാൻ കൂടുതൽ ഫോട്ടോകൾ തിരഞ്ഞെടുക്കുക… തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੀਮਤ ਪਹੁੰਚ ਕੇਵਲ ਚੁਣੀਆਂ ਫੋਟੋਆਂ ਦਿਖਾਉਂਦੀ ਹੈ। ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਪੂਰੀ ਪਹੁੰਚ ਦੇਣ ਲਈ ਹੋਰ ਫੋਟੋਆਂ ਚੁਣੋ… ਚੁਣੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso limitado solo muestra las fotos seleccionadas. Elige Seleccionar más fotos… para conceder acceso completo en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès limité n'affiche que les photos sélectionnées. Choisissez Sélectionner plus de photos… pour accorder l'accès complet dans Réglages Système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei eingeschränktem Zugriff werden nur ausgewählte Fotos angezeigt. Wähle „Weitere Fotos auswählen…“, um in den Systemeinstellungen Vollzugriff zu gewähren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso limitado mostra apenas as fotos selecionadas. Escolha Selecionar mais fotos… para conceder acesso completo em Ajustes do Sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso limitato mostra solo le foto selezionate. Scegli Seleziona altre foto… per concedere l'accesso completo in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「制限付きアクセス」では選択した写真のみが表示されます。システム設定でフルアクセスを許可するには「さらに写真を選択…」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한된 접근에서는 선택한 사진만 표시됩니다. 시스템 설정에서 전체 접근 권한을 허용하려면 사진 더 선택…을 누르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受限访问仅显示选定照片。请选择“选择更多照片…”在“系统设置”中授予完全访问权限。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограниченный доступ показывает только выбранные фото. Нажмите «Выбрать больше фото…», чтобы предоставить полный доступ в Системных настройках."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الوصول المحدود الصور المحددة فقط. اختر «تحديد المزيد من الصور…» لمنح الوصول الكامل في إعدادات النظام."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גישה מוגבלת מציגה רק תמונות שנבחרו. בחרו ״בחירת תמונות נוספות…״ להענקת גישה מלאה בהגדרות המערכת."
          }
        }
      }
    },
