    "Monitor snapshot saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor snapshot saved."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉनिटर स्नैपशॉट सहेजा गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মনিটর স্ন্যাপশট সংরক্ষিত হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கண்காணிப்பு ஸ்னாப்ஷாட் சேமிக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మానిటర్ స్నాప్‌షాట్ సేవ్ చేయబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉनिटर स्नॅपशॉट जतन केला."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૉનિટર સ્નૅપશૉટ સાચવ્યો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾನಿಟರ್ ಸ್ನ್ಯಾಪ್‌ಶಾಟ್ ಉಳಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോണിറ്റർ സ്നാപ്പ്ഷോട്ട് സംരക്ഷിച്ചു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਾਨੀਟਰ ਸਨੈਪਸ਼ਾਟ ਸੰਭਾਲਿਆ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantánea del monitor guardada."
          }
        },
