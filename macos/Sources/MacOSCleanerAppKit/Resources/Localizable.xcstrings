        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর জন্য অপসারণযোগ্য কিছু পাওয়া যায়নি। এটি অনুপস্থিত বা সুরক্ষিত হতে পারে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கு அகற்றக்கூடியது எதுவும் கிடைக்கவில்லை. அது காணாமல் போயிருக்கலாம் அல்லது பாதுகாக்கப்பட்டிருக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కోసం తొలగించదగినది ఏదీ కనుగొనబడలేదు. అది లోపించి ఉండవచ్చు లేదా రక్షితంగా ఉండవచ్చు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ साठी काढण्यायोग्य काहीही सापडले नाही. ते कदाचित गहाळ किंवा सुरक्षित असेल."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ માટે દૂર કરી શકાય તેવું કંઈ મળ્યું નથી. તે ખૂટતું અથવા સુરક્ષિત હોઈ શકે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಗಾಗಿ ತೆಗೆದುಹಾಕಬಹುದಾದದ್ದು ಏನೂ ಕಂಡುಬಂದಿಲ್ಲ. ಅದು ಕಾಣೆಯಾಗಿರಬಹುದು ಅಥವಾ ರಕ್ಷಿತವಾಗಿರಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-നായി നീക്കം ചെയ്യാവുന്നതൊന്നും കണ്ടെത്തിയില്ല. ഇത് കാണാതായതോ സംരക്ഷിതമോ ആകാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਲਈ ਹਟਾਉਣਯੋਗ ਕੁਝ ਨਹੀਂ ਮਿਲਿਆ। ਇਹ ਗੁੰਮ ਜਾਂ ਸੁਰੱਖਿਅਤ ਹੋ ਸਕਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró nada eliminable para %@. Puede que falte o esté protegido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de supprimable trouvé pour %@. L'élément est peut-être absent ou protégé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Entfernbares für %@ gefunden. Möglicherweise fehlt es oder ist geschützt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada removível encontrado para %@. Pode estar ausente ou protegido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla di rimovibile trovato per %@. Potrebbe mancare o essere protetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の削除対象が見つかりませんでした。すでに存在しないか保護されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 제거할 수 있는 항목을 찾지 못했습니다. 누락되었거나 보호되고 있을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 %@ 的可移除项目。可能已丢失或受系统保护。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не найдено ничего удаляемого для %@. Объект может отсутствовать или быть защищен."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على شيء قابل للإزالة لـ %@. قد يكون مفقودًا أو محميًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא דבר להסרה עבור %@. ייתכן שהוא חסר או מוגן."
          }
        }
      }
    },
    "Nothing running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing running."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी नहीं चल रहा है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুই চলছে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதுவும் இயங்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదీ నడవడం లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काहीही सुरू नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કંઈ ચાલતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನೂ ನಡೆಯುತ್ತಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒന്നും പ്രവർത്തിക്കുന്നില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਨਹੀਂ ਚੱਲ ਰਿਹਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien en cours d'exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft nichts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada em execução."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna operazione in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 항목이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有运行任何项目。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не запущено."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يعمل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר אינו פועל."
          }
        }
      }
    },
    "Nothing to clean right now. Scan again after you use your Mac for a while.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to clean right now. Scan again after you use your Mac for a while."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी साफ करने के लिए कुछ नहीं है। कुछ समय Mac उपयोग करने के बाद फिर से स्कैन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মুহূর্তে পরিষ্কার করার মতো কিছু নেই। কিছুক্ষণ Mac ব্যবহার করার পর আবার স্ক্যান করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது சுத்தம் செய்ய எதுவும் இல்லை. சிறிது நேரம் Mac ஐப் பயன்படுத்திய பிறகு மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుతం శుభ్రం చేయడానికి ఏమీ లేదు. కొంతసేపు మీ Mac ఉపయోగించిన తర్వాత మళ్లీ స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्या साफ करण्यासारखे काही नाही. थोडा वेळ तुमचा Mac वापरल्यानंतर पुन्हा स्कॅन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અત્યારે સાફ કરવા જેવું કંઈ નથી. થોડો સમય તમારું Mac વાપર્યા પછી ફરી સ્કૅન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಸ್ತುತ ಸ್ವಚ್ಛಗೊಳಿಸಲು ಏನೂ ಇಲ್ಲ. ಸ್ವಲ್ಪ ಸಮಯ ನಿಮ್ಮ Mac ಬಳಸಿದ ನಂತರ ಮತ್ತೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ വൃത്തിയാക്കാൻ ഒന്നുമില്ല. അല്പസമയം Mac ഉപയോഗിച്ച ശേഷം വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਵੇਲੇ ਸਾਫ਼ ਕਰਨ ਲਈ ਕੁਝ ਨਹੀਂ। ਕੁਝ ਸਮਾਂ Mac ਵਰਤਣ ਤੋਂ ਬਾਅਦ ਦੁਬਾਰਾ ਸਕੈਨ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que limpiar por ahora. Vuelve a analizar después de usar el Mac un tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à nettoyer pour le moment. Relancez une analyse après avoir utilisé votre Mac quelque temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit nichts zu bereinigen. Scanne erneut, nachdem du deinen Mac eine Weile genutzt hast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para limpar no momento. Analise novamente após usar o Mac por um tempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla da pulire ora. Esegui una nuova scansione dopo aver usato il Mac per un po'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在クリーンアップ対象はありません。しばらく Mac を使用してから再度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 정리할 항목이 없습니다. Mac을 잠시 사용한 뒤 다시 스캔하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前无需清理。使用 Mac 一段时间后可再次扫描。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас очищать нечего. Запустите сканирование снова после некоторого времени работы на Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء لتنظيفه الآن. افحص مجددًا بعد استخدام Mac لفترة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מה לנקות כרגע. סרקו שוב לאחר שימוש מסוים ב-Mac."
          }
        }
      }
    },
