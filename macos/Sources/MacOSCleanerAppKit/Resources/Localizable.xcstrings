        "kn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ಐಟಂ · %@ ತೆಗೆದುಹಾಕಲಾಗಿದೆ. ಫೈಲ್‌ಗಳು ಟ್ರ್ಯಾಶ್‌ನಲ್ಲಿ ಮತ್ತು ಫೋಟೋಗಳು ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವುನಲ್ಲಿವೆ. ಸ್ಥಳವನ್ನು ಮರಳಿ ಪಡೆಯಲು Finder ಅಥವಾ ಫೋಟೋಗಳಲ್ಲಿ ಖಾಲಿ ಮಾಡಿ."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ಐಟಂಗಳು · %@ ತೆಗೆದುಹಾಕಲಾಗಿದೆ. ಫೈಲ್‌ಗಳು ಟ್ರ್ಯಾಶ್‌ನಲ್ಲಿ ಮತ್ತು ಫೋಟೋಗಳು ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವುನಲ್ಲಿವೆ. ಸ್ಥಳವನ್ನು ಮರಳಿ ಪಡೆಯಲು Finder ಅಥವಾ ಫೋಟೋಗಳಲ್ಲಿ ಖಾಲಿ ಮಾಡಿ."
                }
              }
            }
          }
        },
        "ml": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ഇനം · %@ നീക്കം ചെയ്തു. ഫയലുകൾ ട്രാഷിലും ഫോട്ടോകൾ അടുത്തിടെ ഇല്ലാതാക്കിയവയിലുമാണ്. ഇടം തിരികെ ലഭിക്കാൻ Finder-ലോ ഫോട്ടോസിലോ ഇവ ശൂന്യമാക്കുക."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ഇനങ്ങൾ · %@ നീക്കം ചെയ്തു. ഫയലുകൾ ട്രാഷിലും ഫോട്ടോകൾ അടുത്തിടെ ഇല്ലാതാക്കിയവയിലുമാണ്. ഇടം തിരികെ ലഭിക്കാൻ Finder-ലോ ഫോട്ടോസിലോ ഇവ ശൂന്യമാക്കുക."
