    "Never suggest actions on cloud-synced files without explicit review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never suggest actions on cloud-synced files without explicit review."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पष्ट समीक्षा के बिना क्लाउड-सिंक फ़ाइलों पर क्रियाओं का सुझाव कभी न दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্পষ্ট পর্যালোচনা ছাড়া ক্লাউড-সিঙ্ক ফাইলের ওপর কাজের পরামর্শ দেবেন না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெளிப்படையான மதிப்பாய்வின்றி கிளவுட்-ஒத்திசைக்கப்பட்ட கோப்புகளில் செயல்களைப் பரிந்துரைக்காதே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్పష్టమైన సమీక్ష లేకుండా క్లౌడ్-సింక్ ఫైళ్లపై చర్యలను సూచించవద్దు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पष्ट पुनरावलोकनाशिवाय क्लाउड-सिंक फाइल्सवर क्रिया सुचवू नका."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્પષ્ટ સમીક્ષા વિના ક્લાઉડ-સિંક ફાઇલો પર ક્રિયાઓ સૂચવશો નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಪಷ್ಟ ಪರಿಶೀಲನೆಯಿಲ್ಲದೆ ಕ್ಲೌಡ್-ಸಿಂಕ್ ಫೈಲ್‌ಗಳ ಮೇಲೆ ಕ್ರಿಯೆಗಳನ್ನು ಸೂಚಿಸಬೇಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വ്യക്തമായ അവലോകനമില്ലാതെ ക്ലൗഡ്-സമന്വയിപ്പിച്ച ഫയലുകളിൽ പ്രവൃത്തികൾ നിർദ്ദേശിക്കരുത്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਪਸ਼ਟ ਸਮੀਖਿਆ ਤੋਂ ਬਿਨਾਂ ਕਲਾਊਡ-ਸਿੰਕ ਫਾਈਲਾਂ 'ਤੇ ਕਾਰਵਾਈਆਂ ਨਾ ਸੁਝਾਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca sugerir acciones sobre archivos sincronizados en la nube sin revisión explícita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais proposer d'actions sur des fichiers synchronisés dans le nuage sans examen explicite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie Aktionen für cloud-synchronisierte Dateien ohne ausdrückliche Prüfung vorschlagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca sugerir ações em arquivos sincronizados na nuvem sem revisão explícita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non suggerire mai azioni su file sincronizzati sul cloud senza revisione esplicita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明示的な確認なしにクラウド同期ファイルへのアクションを提案しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명시적인 검토 없이 클라우드 동기화 파일에 대한 작업을 제안하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经明确审阅，不对云端同步文件提出操作建议。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не предлагать действия с облачными файлами без явной проверки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تقترح إجراءات على الملفات المتزامنة سحابيًا دون مراجعة صريحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעולם לא להציע פעולות על קבצים מסונכרנים לענן ללא בדיקה מפורשת."
          }
        }
      }
    },
    "Never suggest deleting design source files (.psd, .sketch, .fig) without review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never suggest deleting design source files (.psd, .sketch, .fig) without review."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा के बिना डिज़ाइन स्रोत फ़ाइलें (.psd, .sketch, .fig) हटाने का सुझाव कभी न दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্যালোচনা ছাড়া ডিজাইন সোর্স ফাইল (.psd, .sketch, .fig) মোছার পরামর্শ দেবেন না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மதிப்பாய்வின்றி வடிவமைப்பு மூலக் கோப்புகளை (.psd, .sketch, .fig) நீக்கப் பரிந்துரைக்காதே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్ష లేకుండా డిజైన్ సోర్స్ ఫైళ్లను (.psd, .sketch, .fig) తొలగించాలని సూచించవద్దు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरावलोकनाशिवाय डिझाइन स्रोत फाइल्स (.psd, .sketch, .fig) हटवण्याचे सुचवू नका."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમીક્ષા વિના ડિઝાઇન સ્રોત ફાઇલો (.psd, .sketch, .fig) કાઢી નાખવાનું સૂચવશો નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿಶೀಲನೆಯಿಲ್ಲದೆ ವಿನ್ಯಾಸ ಮೂಲ ಫೈಲ್‌ಗಳನ್ನು (.psd, .sketch, .fig) ಅಳಿಸಲು ಸೂಚಿಸಬೇಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവലോകനമില്ലാതെ ഡിസൈൻ സോഴ്സ് ഫയലുകൾ (.psd, .sketch, .fig) ഇല്ലാതാക്കാൻ നിർദ്ദേശിക്കരുത്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੀਖਿਆ ਤੋਂ ਬਿਨਾਂ ਡਿਜ਼ਾਈਨ ਸਰੋਤ ਫਾਈਲਾਂ (.psd, .sketch, .fig) ਮਿਟਾਉਣ ਦਾ ਸੁਝਾਅ ਨਾ ਦਿਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca sugerir eliminar archivos fuente de diseño (.psd, .sketch, .fig) sin revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais proposer la suppression de fichiers source de design (.psd, .sketch, .fig) sans examen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie das Löschen von Design-Quelldateien (.psd, .sketch, .fig) ohne Prüfung vorschlagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca sugerir apagar arquivos-fonte de design (.psd, .sketch, .fig) sem revisão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non suggerire mai di eliminare file sorgente di design (.psd, .sketch, .fig) senza revisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認なしにデザインソースファイル (.psd, .sketch, .fig) の削除を提案しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토 없이 디자인 원본 파일(.psd, .sketch, .fig)의 삭제를 제안하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经审阅，不建议删除设计源文件（.psd、.sketch、.fig）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не предлагать удаление исходников дизайна (.psd, .sketch, .fig) без проверки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تقترح حذف ملفات التصميم الأصلية (.psd، .sketch، .fig) دون مراجعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעולם לא להציע מחיקת קבצי מקור לעיצוב (.psd, .sketch, .fig) ללא בדיקה."
          }
        }
      }
    },
    "Never suggest deleting source code files without manual review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never suggest deleting source code files without manual review."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैन्युअल समीक्षा के बिना स्रोत कोड फ़ाइलें हटाने का सुझाव कभी न दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যানুয়াল পর্যালোচনা ছাড়া সোর্স কোড ফাইল মোছার পরামর্শ দেবেন না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கைமுறை மதிப்பாய்வின்றி மூலக் குறியீடு கோப்புகளை நீக்கப் பரிந்துரைக்காதே."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మాన్యువల్ సమీక్ష లేకుండా సోర్స్ కోడ్ ఫైళ్లను తొలగించాలని సూచించవద్దు."
          }
        },
        "mr": {
          "stringUnit": {
