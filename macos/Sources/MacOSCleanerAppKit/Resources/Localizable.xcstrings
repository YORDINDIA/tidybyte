    "No large untouched files found. Everything big was opened recently.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No large untouched files found. Everything big was opened recently."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बड़ी अनछुई फ़ाइल नहीं मिली। सभी बड़ी फ़ाइलें हाल ही में खोली गई थीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অব্যবহৃত কোনো বড় ফাইল পাওয়া যায়নি। বড় সব ফাইলই সম্প্রতি খোলা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயன்படுத்தாத பெரிய கோப்புகள் எதுவும் கிடைக்கவில்லை. பெரிய கோப்புகள் அனைத்தும் சமீபத்தில் திறக்கப்பட்டவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉపయోగించని పెద్ద ఫైళ్లు కనుగొనబడలేదు. పెద్దవన్నీ ఇటీవలే తెరవబడ్డాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणत्याही मोठ्या न वापरलेल्या फाइल्स आढळल्या नाहीत. सर्व मोठ्या फाइल्स अलीकडे उघडल्या गेल्या होत्या."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ મોટી વણવપરાયેલી ફાઇલો મળી નથી. બધી મોટી ફાઇલો તાજેતરમાં ખોલવામાં આવી હતી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬಳಸದ ದೊಡ್ಡ ಫೈಲ್‌ಗಳು ಕಂಡುಬಂದಿಲ್ಲ. ದೊಡ್ಡ ಫೈಲ್‌ಗಳೆಲ್ಲವನ್ನೂ ಇತ್ತೀಚೆಗೆ ತೆರೆಯಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉപയോഗിക്കാത്ത വലിയ ഫയലുകളൊന്നും കണ്ടെത്തിയില്ല. വലിയവയെല്ലാം അടുത്തിടെ തുറന്നിരുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਵੱਡੀਆਂ ਅਣਵਰਤੀਆਂ ਫਾਈਲਾਂ ਨਹੀਂ ਮਿਲੀਆਂ। ਸਾਰੀਆਂ ਵੱਡੀਆਂ ਫਾਈਲਾਂ ਹਾਲ ਹੀ ਵਿੱਚ ਖੋਲ੍ਹੀਆਂ ਗਈਆਂ ਸਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron archivos grandes sin usar. Todo lo pesado se abrió hace poco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun gros fichier inutilisé trouvé. Tous les fichiers volumineux ont été ouverts récemment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine großen unberührten Dateien gefunden. Alle großen Dateien wurden kürzlich geöffnet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum arquivo grande sem uso encontrado. Tudo o que é grande foi aberto recentemente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file grande inutilizzato trovato. Tutti i file grandi sono stati aperti di recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未使用の大容量ファイルは見つかりませんでした。大容量ファイルはいずれも最近開かれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하지 않은 대용량 파일이 없습니다. 큰 파일은 모두 최근에 열렸습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到久未访问的大文件。所有大文件最近都曾打开过。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупных неиспользуемых файлов не найдено. Все большие файлы открывались недавно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على ملفات كبيرة غير مستخدمة. تم فتح كل الملفات الكبيرة مؤخرًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאו קבצים גדולים ללא שימוש. כל הגדולים נפתחו לאחרונה."
          }
        }
      }
    },
