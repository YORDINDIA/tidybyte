            "value": "大容量ファイル、古いダウンロード、インストーラ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대용량 파일, 오래된 다운로드 및 설치 프로그램."
          }
        },
        "zh-Hans": {
