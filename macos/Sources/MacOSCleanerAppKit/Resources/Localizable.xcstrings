    "History builds up as the monitor runs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History builds up as the monitor runs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉनिटर के चलने के साथ इतिहास बनता जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মনিটর চলার সাথে সাথে ইতিহাস জমা হতে থাকে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கண்காணிப்பு இயங்கும்போது வரலாறு சேகரிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మానిటర్ నడుస్తున్నప్పుడు చరిత్ర పేరుకుపోతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉनिटर चालू असताना इतिहास जमा होत राहतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૉનિટર ચાલતું રહે તેમ ઇતિહાસ જમા થતો રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮಾನಿಟರ್ ಚಾಲನೆಯಲ್ಲಿರುವಂತೆ ಇತಿಹಾಸ ಸಂಗ್ರಹವಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മോണിറ്റർ പ്രവർത്തിക്കുമ്പോൾ ചരിത്രം ശേഖരിക്കപ്പെടും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਾਨੀਟਰ ਚੱਲਣ ਦੇ ਨਾਲ ਇਤਿਹਾਸ ਇਕੱਠਾ ਹੁੰਦਾ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se va creando mientras el monitor está en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique se construit pendant que le moniteur fonctionne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf wächst, während der Monitor läuft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico se acumula enquanto o monitor está em execução."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia si raccoglie mentre il monitor è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モニターの稼働に応じて履歴が蓄積されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모니터가 실행되는 동안 기록이 쌓입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监视器运行时会逐步累积历史记录。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История накапливается по мере работы монитора."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتراكم السجل أثناء عمل المراقب."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההיסטוריה מצטברת בזמן שהניטור פועל."
          }
        }
      }
    },
