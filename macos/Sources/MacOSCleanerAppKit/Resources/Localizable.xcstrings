    "Go to Cleanup Tools": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to Cleanup Tools"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लीनअप टूल पर जाएँ"
          }
