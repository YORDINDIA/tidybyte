    "Creates verified still photos and moves %lld original Live Photos to Recently Deleted, reclaiming about %@.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Creates verified still photos and moves %lld original Live Photo to Recently Deleted, reclaiming about %@."
