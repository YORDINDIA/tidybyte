    "Choose exported chat folder…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose exported chat folder…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यातित चैट फ़ोल्डर चुनें…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট করা চ্যাট ফোল্ডার বেছে নিন…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏற்றுமதி செய்த அரட்டைக் கோப்புறையைத் தேர்ந்தெடுக்கவும்…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎగుమతి చేసిన చాట్ ఫోల్డర్ ఎంచుకోండి…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात केलेले चॅट फोल्डर निवडा…"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિકાસ કરેલ ચૅટ ફોલ્ડર પસંદ કરો…"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರಫ್ತು ಮಾಡಿದ ಚಾಟ್ ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ…"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എക്സ്പോർട്ട് ചെയ്ത ചാറ്റ് ഫോൾഡർ തിരഞ്ഞെടുക്കുക…"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਿਰਯਾਤ ਕੀਤਾ ਚੈਟ ਫੋਲਡਰ ਚੁਣੋ…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir carpeta de chats exportados…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir le dossier de discussions exporté…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportierten Chat-Ordner wählen…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher pasta de conversas exportadas…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona cartella chat esportata…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したチャットフォルダを選択…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 채팅 폴더 선택…"
          }
