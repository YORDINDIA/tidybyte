    "Per-app history is kept for up to 90 days.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-app history is kept for up to 90 days."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति-ऐप इतिहास 90 दिनों तक रखा जाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি অ্যাপের ইতিহাস সর্বোচ্চ 90 দিন পর্যন্ত রাখা হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு செயலியின் வரலாறும் 90 நாட்கள் வரை சேமிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి యాప్ చరిత్ర 90 రోజుల వరకు ఉంచబడుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक अ‍ॅपचा इतिहास 90 दिवसांपर्यंत ठेवला जातो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક ઍપનો ઇતિહાસ 90 દિવસ સુધી રાખવામાં આવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಆ್ಯಪ್ ಇತಿಹಾಸವನ್ನು 90 ದಿನಗಳವರೆಗೆ ಇರಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ആപ്പിന്റെയും ചരിത്രം 90 ദിവസം വരെ സൂക്ഷിക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਤੀ-ਐਪ ਇਤਿਹਾਸ 90 ਦਿਨਾਂ ਤੱਕ ਰੱਖਿਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial por app se conserva hasta 90 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique par app est conservé jusqu'à 90 jours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf pro App wird bis zu 90 Tage aufbewahrt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico por app é mantido por até 90 dias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia per app viene conservata fino a 90 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリごとの履歴は最大 90 日間保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱별 기록은 최대 90일 동안 보관됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个应用的历史记录最多保存 90 天。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История по приложениям хранится до 90 дней."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ السجل لكل تطبيق حتى 90 يومًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היסטוריה לכל אפליקציה נשמרת עד 90 יום."
          }
        }
      }
    },
