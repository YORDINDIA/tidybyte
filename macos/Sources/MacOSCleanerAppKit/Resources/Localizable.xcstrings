    "Add %@ to Leftovers?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add %@ to Leftovers?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या %@ को बचे हुए डेटा में जोड़ें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে কি অবশিষ্টাংশে যোগ করবেন?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐ எஞ்சியவைகளில் சேர்க்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ను అవశేషాలకు జోడించాలా?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अवशेषांमध्ये जोडायचे का?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું %@ ને અવશેષોમાં ઉમેરવું?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಅನ್ನು ಉಳಿಕೆಗಳಿಗೆ ಸೇರಿಸುವುದೇ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ അവശിഷ്ടങ്ങളിൽ ചേർക്കണോ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ %@ ਨੂੰ ਬਚੀ ਸਮੱਗਰੀ ਵਿੱਚ ਸ਼ਾਮਲ ਕਰਨਾ ਹੈ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Añadir %@ a Sobras?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter %@ aux Résidus ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zu Resten hinzufügen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar %@ a Sobras?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungere %@ ai Residui?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を残存データに追加しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 잔여 파일에 추가할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 添加到残留文件？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить %@ в «Остатки»?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة %@ إلى البقايا؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להוסיף את %@ לשאריות?"
          }
        }
      }
    },
