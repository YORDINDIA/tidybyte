    "All processing happens on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All processing happens on this device."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सारा प्रसंस्करण इसी डिवाइस पर होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সমস্ত প্রক্রিয়াকরণ এই ডিভাইসেই হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து செயலாக்கமும் இந்தச் சாதனத்திலேயே நடக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని ప్రాసెసింగ్ ఈ పరికరంలోనే జరుగుతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व प्रक्रिया याच डिव्हाइसवर होते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધી પ્રક્રિયા આ ડિવાઇસ પર જ થાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಎಲ್ಲಾ ಪ್ರಕ್ರಿಯೆಯು ಈ ಸಾಧನದಲ್ಲಿಯೇ ನಡೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ പ്രോസസ്സിംഗും ഈ ഉപകരണത്തിൽ തന്നെയാണ് നടക്കുന്നത്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੀ ਪ੍ਰਕਿਰਿਆ ਇਸੇ ਡਿਵਾਈਸ 'ਤੇ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el procesamiento ocurre en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout le traitement s'effectue sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesamte Verarbeitung erfolgt auf diesem Gerät."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o processamento acontece neste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta l'elaborazione avviene su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての処理はこのデバイス上で完結します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 처리는 이 기기에서 수행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有处理均在此设备上本地完成。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся обработка выполняется на этом устройстве."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم جميع المعالجات على هذا الجهاز."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל העיבוד מתבצע במכשיר זה."
          }
        }
      }
    },
    "All remaining images are already under 2 MB or in HEIC format.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All remaining images are already under 2 MB or in HEIC format."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेष सभी छवियां पहले से ही 2 MB से कम या HEIC फ़ॉर्मैट में हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাকি সব ছবি ইতিমধ্যেই 2 MB-এর কম বা HEIC ফরম্যাটে আছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீதமுள்ள அனைத்துப் படங்களும் ஏற்கனவே 2 MB க்குக் கீழ் அல்லது HEIC வடிவத்தில் உள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మిగిలిన అన్ని చిత్రాలు ఇప్పటికే 2 MB కంటే తక్కువగా లేదా HEIC ఫార్మాట్‌లో ఉన్నాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उर्वरित सर्व प्रतिमा आधीपासून 2 MB पेक्षा कमी किंवा HEIC स्वरूपात आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બાકીની બધી છબીઓ પહેલેથી 2 MB થી ઓછી અથવા HEIC ફોર્મેટમાં છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿದ ಎಲ್ಲಾ ಚಿತ್ರಗಳು ಈಗಾಗಲೇ 2 MB ಗಿಂತ ಕಡಿಮೆ ಅಥವಾ HEIC ಸ್ವರೂಪದಲ್ಲಿವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശേഷിക്കുന്ന എല്ലാ ചിത്രങ്ങളും ഇതിനകം 2 MB-യിൽ താഴെയോ HEIC ഫോർമാറ്റിലോ ആണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਾਕੀ ਸਾਰੀਆਂ ਤਸਵੀਰਾਂ ਪਹਿਲਾਂ ਹੀ 2 MB ਤੋਂ ਘੱਟ ਜਾਂ HEIC ਫਾਰਮੈਟ ਵਿੱਚ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las imágenes restantes ya pesan menos de 2 MB o están en formato HEIC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les images restantes font déjà moins de 2 Mo ou sont au format HEIC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verbleibenden Bilder sind bereits unter 2 MB oder im HEIC-Format."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as imagens restantes já têm menos de 2 MB ou estão em HEIC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le immagini rimanenti sono già sotto i 2 MB o in formato HEIC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの画像はすべて 2 MB 未満か HEIC 形式です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 이미지는 모두 2 MB 미만이거나 HEIC 형식입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其余图像均已小于 2 MB 或为 HEIC 格式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все оставшиеся изображения уже меньше 2 МБ или в формате HEIC."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل الصور المتبقية أصغر بالفعل من 2 م.ب أو بصيغة HEIC."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל התמונות שנותרו כבר מתחת ל-2 MB או בפורמט HEIC."
          }
        }
      }
    },
    "All scan folders removed.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All scan folders removed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी स्कैन फ़ोल्डर हटा दिए गए।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব স্ক্যান ফোল্ডার সরানো হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்து ஸ்கேன் கோப்புறைகளும் அகற்றப்பட்டன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్ని స్కాన్ ఫోల్డర్లు తొలగించబడ్డాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व स्कॅन फोल्डर्स काढून टाकली."
