    "%@ is review-only and cannot be staged for cleanup.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is review-only and cannot be staged for cleanup."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ केवल समीक्षा के लिए है और इसे सफ़ाई के लिए चरणबद्ध नहीं किया जा सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ শুধুমাত্র পর্যালোচনার জন্য এবং ক্লিনআপের জন্য প্রস্তুত করা যাবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ மதிப்பாய்வுக்கு மட்டுமே; சுத்திகரிப்புக்காகத் தயார்நிலையில் வைக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ సమీక్షకు మాత్రమే మరియు శుభ్రత కోసం సిద్ధం చేయబడదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ केवळ पुनरावलोकनासाठी आहे आणि क्लीनअपसाठी तयार ठेवता येत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ માત્ર સમીક્ષા માટે છે અને ક્લીનઅપ માટે તૈયાર રાખી શકાતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಪರಿಶೀಲನೆಗೆ ಮಾತ್ರ ಮತ್ತು ಸ್ವಚ್ಛತೆಗಾಗಿ ಸಿದ್ಧಪಡಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ അവലോകനത്തിന് മാത്രമുള്ളതാണ്, വൃത്തിയാക്കലിനായി സജ്ജമാക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਕੇਵਲ ਸਮੀਖਿਆ ਲਈ ਹੈ ਅਤੇ ਸਫਾਈ ਲਈ ਤਿਆਰ ਨਹੀਂ ਰੱਖਿਆ ਜਾ ਸਕਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es solo para revisar y no puede prepararse para limpieza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en examen uniquement et ne peut pas être préparé pour le nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nur zur Prüfung vorgesehen und kann nicht für die Bereinigung vorgemerkt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é apenas para revisão e não pode ser preparado para limpeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è solo per revisione e non può essere preparato per la pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は確認専用のため、クリーンアップ対象に追加できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 검토 전용이므로 정리 대상으로 대기시킬 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仅供查看，不能加入待清理列表。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ предназначен только для просмотра и не может быть добавлен в план очистки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ للمراجعة فقط ولا يمكن تجهيزه للتنظيف."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מיועד לבדיקה בלבד ולא ניתן להוסיפו לניקוי."
          }
        }
      }
    },
    "%@ is still installed; leftover cleanup skipped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is still installed; leftover cleanup skipped."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अभी भी इंस्टॉल है; बचे हुए डेटा की सफ़ाई छोड़ी गई।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এখনও ইনস্টল করা আছে; অবশিষ্ট ডেটা ক্লিনআপ বাদ দেওয়া হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இன்னும் நிறுவப்பட்டுள்ளது; எஞ்சிய தரவு சுத்திகரிப்பு தவிர்க்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ఇంకా ఇన్‌స్టాల్ చేయబడింది; మిగిలిన డేటా శుభ్రత దాటవేయబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अजूनही इन्स्टॉल केलेले आहे; अवशेष क्लीनअप वगळले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ હજી પણ ઇન્સ્ટૉલ છે; બાકી ડેટા ક્લીનઅપ છોડી દીધું."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಇನ್ನೂ ಸ್ಥಾಪಿತವಾಗಿದೆ; ಉಳಿಕೆ ಡೇಟಾ ಸ್ವಚ್ಛತೆಯನ್ನು ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഇപ്പോഴും ഇൻസ്റ്റാൾ ചെയ്തിട്ടുണ്ട്; അവശിഷ്ട വൃത്തിയാക്കൽ ഒഴിവാക്കി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਅਜੇ ਵੀ ਇੰਸਟਾਲ ਹੈ; ਬਚੀ ਸਮੱਗਰੀ ਦੀ ਸਫਾਈ ਛੱਡੀ ਗਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue instalada; se omitió la limpieza de sobras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est toujours installé ; nettoyage des résidus ignoré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist noch installiert; Bereinigung von Resten übersprungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda está instalado; a limpeza de sobras foi ignorada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è ancora installata; pulizia dei residui ignorata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はまだインストールされているため、残存データのクリーンアップをスキップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 아직 설치되어 있어 잔여 파일 정리를 건너뛰었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍已安装；已跳过残留清理。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ все еще установлено; очистка остатков пропущена."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال %@ مثبتًا؛ تم تخطي تنظيف البقايا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ עדיין מותקנת; ניקוי השאריות דולג."
          }
        }
      }
    },
