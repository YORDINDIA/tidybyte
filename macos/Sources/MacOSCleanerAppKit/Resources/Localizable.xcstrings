    "Replacing originals reclaims about %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacing originals reclaims about %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल फ़ाइलों को बदलने से लगभग %@ स्पेस खाली होता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল ফাইল প্রতিস্থাপনে প্রায় %@ জায়গা উদ্ধার হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அசல்களை மாற்றினால் சுமார் %@ இடம் மீட்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అసలు ఫైళ్లను భర్తీ చేస్తే సుమారు %@ స్థలం తిరిగి లభిస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मूळ फाइल्स बदलल्यास सुमारे %@ जागा मोकळी होते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૂળ ફાઇલો બદલવાથી લગભગ %@ જગ્યા ખાલી થાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೂಲಗಳನ್ನು ಬದಲಿಸಿದರೆ ಸುಮಾರು %@ ಸ್ಥಳ ಮರಳಿ ಸಿಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "യഥാർത്ഥ ഫയലുകൾ മാറ്റിസ്ഥാപിക്കുന്നത് ഏകദേശം %@ ഇടം വീണ്ടെടുക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੂਲ ਫਾਈਲਾਂ ਬਦਲਣ ਨਾਲ ਲਗਭਗ %@ ਥਾਂ ਖਾਲੀ ਹੁੰਦੀ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reemplazar los originales se recuperan unos %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le remplacement des originaux libère environ %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Ersetzen der Originale werden ca. %@ frei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir os originais recupera cerca de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sostituzione degli originali recupera circa %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルを置き換えると約 %@ の空き容量が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본을 대체하면 약 %@의 공간을 확보합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换原文件预计可回收 %@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замена оригиналов освободит около %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستعيد استبدال الأصول نحو %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלפת המקורות תשחרר כ-%@."
          }
        }
      }
    },
    "Reset Review History": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Review History"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा इतिहास रीसेट करें"
          }
