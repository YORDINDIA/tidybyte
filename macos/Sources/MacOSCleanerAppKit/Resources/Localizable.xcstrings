    "Selects group; double-click to drill in": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selects group; double-click to drill in"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह चुनता है; भीतर देखने के लिए डबल-क्लिक करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গ্রুপ নির্বাচন করে; ভেতরে যেতে ডাবল-ক্লিক করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழுவைத் தேர்ந்தெடுக்கும்; உள்ளே செல்ல இருமுறை கிளிக் செய்யவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమూహాన్ని ఎంచుకుంటుంది; లోపలికి వెళ్లడానికి డబుల్-క్లిక్ చేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गट निवडतो; आत जाण्यासाठी डबल-क्लिक करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જૂથ પસંદ કરે છે; અંદર જવા ડબલ-ક્લિક કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುಂಪನ್ನು ಆಯ್ಕೆಮಾಡುತ್ತದೆ; ಒಳಗೆ ಹೋಗಲು ಡಬಲ್-ಕ್ಲಿಕ್ ಮಾಡಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗ്രൂപ്പ് തിരഞ്ഞെടുക്കുന്നു; ഉള്ളിലേക്ക് കടക്കാൻ ഡബിൾ-ക്ലിക്ക് ചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੂਹ ਚੁਣਦਾ ਹੈ; ਅੰਦਰ ਜਾਣ ਲਈ ਡਬਲ-ਕਲਿੱਕ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona el grupo; doble clic para entrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne le groupe ; double-cliquez pour explorer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt die Gruppe; Doppelklick zum Öffnen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleciona o grupo; clique duas vezes para entrar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona il gruppo; doppio clic per aprire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを選択、ダブルクリックで詳細へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹 선택; 이중 클릭하여 세부 보기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中分组；双击深入查看"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирает группу; двойной клик открывает детали"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد المجموعة؛ انقر مرتين لفتح التفاصيل"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוחר בקבוצה; לחיצה כפולה תיכנס פנימה"
          }
        }
      }
    },
