    "Nothing to visualize yet. Run a scan or clear the name filter.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to visualize yet. Run a scan or clear the name filter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिखाने के लिए अभी कुछ नहीं है। स्कैन चलाएँ या नाम फ़िल्टर साफ़ करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখানোর মতো এখনও কিছু নেই। স্ক্যান চালান বা নাম ফিল্টার মুছুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காட்சிப்படுத்த இன்னும் எதுவும் இல்லை. ஸ்கேன் இயக்கவும் அல்லது பெயர் வடிப்பானை அழிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చూపించడానికి ఇంకా ఏమీ లేదు. స్కాన్ అమలు చేయండి లేదా పేరు ఫిల్టర్‌ను క్లియర్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दाखवण्यासारखे अद्याप काहीही नाही. स्कॅन चालवा किंवा नाव फिल्टर साफ करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દર્શાવવા જેવું હજી કંઈ નથી. સ્કૅન ચલાવો અથવા નામ ફિલ્ટર સાફ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತೋರಿಸಲು ಇನ್ನೂ ಏನೂ ಇಲ್ಲ. ಸ್ಕ್ಯಾನ್ ನಡೆಸಿ ಅಥವಾ ಹೆಸರು ಫಿಲ್ಟರ್ ತೆರವುಗೊಳಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാണിക്കാൻ ഇതുവരെ ഒന്നുമില്ല. സ്കാൻ നടത്തുക അല്ലെങ്കിൽ പേര് ഫിൽട്ടർ മായ്ക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਿਖਾਉਣ ਲਈ ਅਜੇ ਕੁਝ ਨਹੀਂ। ਸਕੈਨ ਚਲਾਓ ਜਾਂ ਨਾਮ ਫਿਲਟਰ ਸਾਫ਼ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada que mostrar. Inicia un análisis o limpia el filtro de nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à visualiser pour le moment. Lancez une analyse ou videz le filtre de nom."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts darzustellen. Starte einen Scan oder leere den Namensfilter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para visualizar ainda. Execute uma análise ou limpe o filtro de nome."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nulla da visualizzare. Avvia una scansione o svuota il filtro per nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示できるデータはまだありません。スキャンを実行するか名前フィルタを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 시각화할 데이터가 없습니다. 스캔을 실행하거나 이름 필터를 지우세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可视化内容。请运行扫描或清除名称筛选条件。"
