    "%lld Trash · %lld kept · %lld moved · %lld skipped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Trash · %lld kept · %lld moved · %lld skipped"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ट्रैश · %lld रखे गए · %lld ले जाए गए · %lld छोड़े गए"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldটি ট্র্যাশ · %lldটি রাখা হয়েছে · %lldটি সরানো হয়েছে · %lldটি বাদ দেওয়া হয়েছে"
