    "Allow Photos access in System Settings to scan your library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Photos access in System Settings to scan your library."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइब्रेरी स्कैन करने के लिए सिस्टम सेटिंग्स में फ़ोटो पहुँच की अनुमति दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লাইব্রেরি স্ক্যান করতে সিস্টেম সেটিংসে ফটো অ্যাক্সেস অনুমতি দিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் நூலகத்தை ஸ்கேன் செய்ய கணினி அமைப்புகளில் புகைப்படங்கள் அணுகலை அனுமதிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ లైబ్రరీని స్కాన్ చేయడానికి సిస్టమ్ సెట్టింగ్‌లలో ఫోటోల యాక్సెస్ అనుమతించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची लायब्ररी स्कॅन करण्यासाठी सिस्टम सेटिंग्जमध्ये फोटो प्रवेशास परवानगी द्या."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી લાઇબ્રેરી સ્કૅન કરવા સિસ્ટમ સેટિંગ્સમાં ફોટો ઍક્સેસની મંજૂરી આપો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಲೈಬ್ರರಿಯನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ಸಿಸ್ಟಮ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಫೋಟೋಗಳ ಪ್ರವೇಶವನ್ನು ಅನುಮತಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലൈബ്രറി സ്കാൻ ചെയ്യാൻ സിസ്റ്റം ക്രമീകരണങ്ങളിൽ ഫോട്ടോസ് ആക്സസ് അനുവദിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀ ਲਾਇਬ੍ਰੇਰੀ ਸਕੈਨ ਕਰਨ ਲਈ ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਫੋਟੋ ਪਹੁੰਚ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a Fotos en Ajustes del Sistema para analizar tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès à Photos dans Réglages Système pour analyser votre photothèque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Fotos in den Systemeinstellungen, um deine Mediathek zu scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao Fotos em Ajustes do Sistema para analisar sua fototeca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso a Foto in Impostazioni di Sistema per analizzare la libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリをスキャンするには、システム設定で「写真」へのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함을 스캔하려면 시스템 설정에서 사진 접근을 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”中允许访问“照片”以扫描您的图库。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к «Фото» в Системных настройках, чтобы просканировать медиатеку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الصور في إعدادات النظام لفحص مكتبتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו גישה לתמונות בהגדרות המערכת כדי לסרוק את הספרייה."
          }
        }
      }
    },
