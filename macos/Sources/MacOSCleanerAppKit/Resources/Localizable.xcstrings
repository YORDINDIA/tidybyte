    "Prefer archiving files instead of moving to trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer archiving files instead of moving to trash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश में भेजने के बजाय फ़ाइलों को आर्काइव करने को प्राथमिकता दें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাশে পাঠানোর বদলে ফাইল আর্কাইভ করাকে অগ্রাধিকার দিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குப்பைத் தொட்டிக்கு நகர்த்துவதற்குப் பதிலாக கோப்புகளைக் காப்பகப்படுத்துவதற்கு முன்னுரிமை அளிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాష్‌లోకి తరలించడానికి బదులుగా ఫైళ్లను ఆర్కైవ్ చేయడానికి ప్రాధాన్యత ఇవ్వండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रॅशमध्ये हलवण्याऐवजी फाइल्स संग्रहित करण्याला प्राधान्य द्या."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રૅશમાં ખસેડવાને બદલે ફાઇલોને આર્કાઇવ કરવાને પ્રાધાન્ય આપો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರ್ಯಾಶ್‌ಗೆ ಸರಿಸುವ ಬದಲು ಫೈಲ್‌ಗಳನ್ನು ಆರ್ಕೈವ್ ಮಾಡುವುದಕ್ಕೆ ಆದ್ಯತೆ ನೀಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രാഷിലേക്ക് മാറ്റുന്നതിന് പകരം ഫയലുകൾ ആർക്കൈവ് ചെയ്യുന്നതിന് മുൻഗണന നൽകുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜਣ ਦੀ ਬਜਾਏ ਫਾਈਲਾਂ ਆਰਕਾਈਵ ਕਰਨ ਨੂੰ ਤਰਜੀਹ ਦਿਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferir archivar archivos en lugar de moverlos al Basurero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privilégier l'archivage des fichiers plutôt que le placement dans la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien lieber archivieren statt in den Papierkorb verschieben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferir arquivar arquivos em vez de mover para o Lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisci archiviare i file anziché spostarli nel Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に移動する代わりにファイルをアーカイブすることを優先します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동하는 대신 파일을 보관하는 것을 우선합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先将文件归档，而不是直接移入废纸篓。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпочитать архивирование файлов вместо перемещения в Корзину."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفضيل أرشفة الملفات بدلًا من نقلها إلى سلة المهملات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העדיפו העברת קבצים לארכיון במקום לפח."
          }
        }
      }
    },
