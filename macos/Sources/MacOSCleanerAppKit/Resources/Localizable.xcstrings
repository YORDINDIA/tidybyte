    "Depth as stacked bars, top group first.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depth as stacked bars, top group first."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गहराई स्टैक बार के रूप में, सबसे बड़ा समूह शीर्ष पर।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ট্যাকড বার হিসেবে গভীরতা, সবচেয়ে বড় গ্রুপ সবার উপরে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அடுக்கப்பட்ட பட்டைகளாக ஆழம், பெரிய குழு முதலில்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్టాక్ చేసిన బార్‌లుగా లోతు, అతిపెద్ద సమూహం మొదట."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खोली स्टॅक केलेल्या पट्ट्या म्हणून, सर्वात मोठा गट वर."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઊંડાઈ સ્ટૅક્ડ બાર તરીકે, સૌથી મોટું જૂથ ઉપર."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜೋಡಿಸಿದ ಪಟ್ಟಿಗಳಾಗಿ ಆಳ, ಅತಿ ದೊಡ್ಡ ಗುಂಪು ಮೊದಲು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുക്കിയ ബാറുകളായി ആഴം, ഏറ്റവും വലിയ ഗ്രൂപ്പ് മുകളിൽ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਡੂੰਘਾਈ ਸਟੈਕ ਕੀਤੀਆਂ ਪੱਟੀਆਂ ਵਜੋਂ, ਸਭ ਤੋਂ ਵੱਡਾ ਸਮੂਹ ਉੱਪਰ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidad en barras apiladas, con el grupo mayor arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondeur en barres empilées, le plus grand groupe en haut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefe als gestapelte Balken, größte Gruppe oben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Profundidade em barras empilhadas, maior grupo primeiro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profondità in barre impilate, prima il gruppo più grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "階層を積み上げ棒で表示（上位グループ優先）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깊이를 누적 막대로 표시(상위 그룹 우선)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以堆叠条形图显示层级深度，最大分组在前。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровни в виде столбцов с накоплением, крупнейшие сверху."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العمق كأشرطة مكدسة، المجموعة الأكبر أولًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עומק כעמודות מוערמות, הקבוצה הגדולה ראשונה."
          }
        }
      }
    },
