    "Sensor readings are not available on this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor readings are not available on this Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर सेंसर रीडिंग उपलब्ध नहीं हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এ সেন্সর রিডিং উপলব্ধ নয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac இல் சென்சார் அளவீடுகள் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Mac లో సెన్సార్ రీడింగులు అందుబాటులో లేవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Mac वर सेन्सर वाचन उपलब्ध नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Mac પર સેન્સર રીડિંગ્સ ઉપલબ્ધ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Mac ನಲ್ಲಿ ಸೆನ್ಸರ್ ರೀಡಿಂಗ್‌ಗಳು ಲಭ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Mac-ൽ സെൻസർ റീഡിംഗുകൾ ലഭ്യമല്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Mac 'ਤੇ ਸੈਂਸਰ ਰੀਡਿੰਗਾਂ ਉਪਲਬਧ ਨਹੀਂ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las lecturas de sensores no están disponibles en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mesures des capteurs ne sont pas disponibles sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensordaten sind auf diesem Mac nicht verfügbar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leituras de sensores não estão disponíveis neste Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le letture dei sensori non sono disponibili su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac ではセンサーの測定値を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서는 센서 측정값을 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 不支持传感器读数。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показания датчиков недоступны на этом Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قراءات المستشعرات غير متوفرة على هذا Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאות חיישנים אינן זמינות ב-Mac זה."
          }
        }
      }
    },
    "Sent to Recently Deleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent to Recently Deleted"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल ही में हटाए गए में भेजा गया"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্প্রতি মোছা-তে পাঠানো হয়েছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சமீபத்தில் நீக்கியவைக்கு அனுப்பப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇటీవల తొలగించినవికి పంపబడింది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अलीकडे हटवलेले मध्ये पाठवले"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તાજેતરમાં કાઢી નાખેલા માં મોકલ્યું"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವುಗೆ ಕಳುಹಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തിടെ ഇല്ലാതാക്കിയവയിലേക്ക് അയച്ചു"
          }
        },
        "pa": {
