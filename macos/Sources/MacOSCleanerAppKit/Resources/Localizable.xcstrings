    "Completed changes and available restore actions appear here.": {
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed changes and available restore actions appear here."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे किए गए बदलाव और उपलब्ध पुनर्स्थापना विकल्प यहां दिखते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পন্ন পরিবর্তন এবং উপলব্ধ পুনরুদ্ধার বিকল্প এখানে দেখা যায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிந்த மாற்றங்களும் கிடைக்கும் மீட்டெடுப்பு விருப்பங்களும் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తయిన మార్పులు మరియు అందుబాటులో ఉన్న పునరుద్ధరణ ఎంపికలు ఇక్కడ కనిపిస్తాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण झालेले बदल आणि उपलब्ध पुनर्संचयित पर्याय येथे दिसतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્ણ થયેલા ફેરફારો અને ઉપલબ્ધ પુનઃસ્થાપિત વિકલ્પો અહીં દેખાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೂರ್ಣಗೊಂಡ ಬದಲಾವಣೆಗಳು ಮತ್ತು ಲಭ್ಯವಿರುವ ಮರುಸ್ಥಾಪನೆ ಆಯ್ಕೆಗಳು ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൂർത്തിയാക്കിയ മാറ്റങ്ങളും ലഭ്യമായ പുനഃസ്ഥാപന പ്രവൃത്തികളും ഇവിടെ കാണാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੂਰੇ ਹੋਏ ਬਦਲਾਅ ਅਤੇ ਉਪਲਬਧ ਬਹਾਲੀ ਵਿਕਲਪ ਇੱਥੇ ਦਿਖਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios completados y las opciones de restauración aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications terminées et les options de restauration apparaissent ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Änderungen und verfügbare Wiederherstellungen erscheinen hier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações concluídas e ações de restauração disponíveis aparecem aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche completate e le opzioni di ripristino appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了した変更と利用可能な復元操作がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 변경 사항과 사용 가능한 복원 작업이 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的更改与可用的还原操作将显示在此处。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь отображаются завершенные изменения и доступное восстановление."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا التغييرات المكتملة وإجراءات الاستعادة المتاحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינויים שהושלמו ואפשרויות שחזור זמינות מופיעים כאן."
          }
        }
      }
    },
