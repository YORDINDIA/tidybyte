        "kn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ಕ್ರಿಯೆಗಾಗಿ ನಿರ್ಧಾರವನ್ನು ನವೀಕರಿಸಿ. ಯಾವುದೇ ಫೈಲ್‌ಗಳು ಬದಲಾಗುವುದಿಲ್ಲ."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ಕ್ರಿಯೆಗಳಿಗಾಗಿ ನಿರ್ಧಾರಗಳನ್ನು ನವೀಕರಿಸಿ. ಯಾವುದೇ ಫೈಲ್‌ಗಳು ಬದಲಾಗುವುದಿಲ್ಲ."
                }
