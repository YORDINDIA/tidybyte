    "Could not start a review for %@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start a review for %@: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए समीक्षा शुरू नहीं हो सकी: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এর জন্য পর্যালোচনা শুরু করা যায়নি: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ க்கான மதிப்பாய்வைத் தொடங்க முடியவில்லை: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ కోసం సమీక్షను ప్రారంభించలేకపోయాము: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ साठी पुनरावलोकन सुरू करता आले नाही: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ માટે સમીક્ષા શરૂ કરી શકાઈ નહીં: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಗಾಗಿ ಪರಿಶೀಲನೆಯನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-നുള്ള അവലോകനം തുടങ്ങാനായില്ല: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਲਈ ਸਮੀਖਿਆ ਸ਼ੁਰੂ ਨਹੀਂ ਹੋ ਸਕੀ: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la revisión de %@: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer l'examen de %@ : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfung für %@ konnte nicht gestartet werden: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a revisão de %@: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la revisione per %@: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の確認を開始できませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 검토를 시작할 수 없습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始审阅 %@：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать проверку для %@: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء مراجعة %@: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להתחיל בדיקה עבור %@: %@"
          }
        }
      }
    },
    "Could not update launch at login: %@": {
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update launch at login: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन पर खोलने की सेटिंग अपडेट नहीं हो सकी: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লগইনে চালুর সেটিং আপডেট করা যায়নি: %@"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்நுழைவில் தொடங்கும் அமைப்பைப் புதுப்பிக்க முடியவில்லை: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లాగిన్ వద్ద ప్రారంభ సెట్టింగ్‌ను అప్‌డేట్ చేయలేకపోయాము: %@"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिनवर सुरू करण्याची सेटिंग अपडेट करता आली नाही: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લૉગિન પર શરૂ કરવાની સેટિંગ અપડેટ કરી શકાઈ નહીં: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲಾಗಿನ್‌ನಲ್ಲಿ ಪ್ರಾರಂಭಿಸುವ ಸೆಟ್ಟಿಂಗ್ ನವೀಕರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
