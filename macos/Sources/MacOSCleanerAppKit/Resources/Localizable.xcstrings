    "Saving smaller compressed copies while keeping every original.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving smaller compressed copies while keeping every original."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर मूल फ़ाइल को रखते हुए छोटी संपीड़ित प्रतियाँ सहेजी जा रही हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি মূল ফাইল অক্ষুণ্ণ রেখে ছোট কমপ্রেসড কপি সংরক্ষণ করা হচ্ছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு அசலையும் வைத்துக்கொண்டு சிறிய சுருக்கப்பட்ட நகல்கள் சேமிக்கப்படுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి అసలు ఫైల్‌ను ఉంచుతూ చిన్న కుదించిన ప్రతులు సేవ్ చేయబడుతున్నాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक मूळ फाइल कायम ठेवून लहान कंप्रेस केलेल्या प्रती जतन करत आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક મૂળ ફાઇલ રાખીને નાની કોમ્પ્રેસ કરેલી નકલો સાચવી રહ્યું છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಮೂಲ ಫೈಲ್ ಉಳಿಸಿಕೊಂಡು ಚಿಕ್ಕ ಸಂಕುಚಿತ ಪ್ರತಿಗಳನ್ನು ಉಳಿಸಲಾಗುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ യഥാർത്ഥ ഫയലും സൂക്ഷിച്ചുകൊണ്ട് ചെറിയ കംപ്രസ് ചെയ്ത പകർപ്പുകൾ സംരക്ഷിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਮੂਲ ਫਾਈਲ ਰੱਖਦੇ ਹੋਏ ਛੋਟੀਆਂ ਕੰਪ੍ਰੈਸ ਕੀਤੀਆਂ ਕਾਪੀਆਂ ਸੰਭਾਲੀਆਂ ਜਾ ਰਹੀਆਂ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardando copias comprimidas más pequeñas y conservando cada original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement de copies compressées plus légères en conservant chaque original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kleinere komprimierte Kopien werden gesichert; jedes Original bleibt erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvando cópias comprimidas menores e mantendo todos os originais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio di copie compresse più piccole mantenendo tutti gli originali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての元ファイルを保持しつつ、容量の小さい圧縮コピーを保存中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 원본을 유지하면서 더 작은 압축 사본을 저장하는 중."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存更小的压缩副本，同时保留所有原件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение сжатых копий меньшего размера с сохранением всех оригиналов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاري حفظ نسخ مضغوطة أصغر مع الاحتفاظ بكل أصل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר עותקים מכווצים קטנים יותר תוך שמירה על כל מקור."
          }
        }
      }
    },
