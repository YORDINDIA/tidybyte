        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण झालेले बदल इतिहासात जतन करता आले नाहीत: %@"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્ણ થયેલા ફેરફારો ઇતિહાસમાં સાચવી શકાયા નહીં: %@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೂರ್ಣಗೊಂಡ ಬದಲಾವಣೆಗಳನ್ನು ಇತಿಹಾಸದಲ್ಲಿ ಉಳಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ: %@"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൂർത്തിയാക്കിയ മാറ്റങ്ങൾ ചരിത്രത്തിൽ സംരക്ഷിക്കാനായില്ല: %@"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੂਰੇ ਹੋਏ ਬਦਲਾਅ ਇਤਿਹਾਸ ਵਿੱਚ ਸੰਭਾਲੇ ਨਹੀਂ ਜਾ ਸਕੇ: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los cambios completados en Historial: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer les modifications terminées dans l'Historique : %@"
