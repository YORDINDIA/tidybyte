    "Wait for the current operation to finish before running a command.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current operation to finish before running a command."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड चलाने से पहले वर्तमान प्रक्रिया पूरी होने की प्रतीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমান্ড চালানোর আগে চলমান কাজটি শেষ হওয়া পর্যন্ত অপেক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கட்டளையை இயக்குவதற்கு முன் தற்போதைய செயல் முடியும் வரை காத்திருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కమాండ్ అమలు చేసే ముందు ప్రస్తుత చర్య పూర్తి అయ్యే వరకు వేచి ఉండండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड चालवण्यापूर्वी सध्याची क्रिया पूर्ण होईपर्यंत प्रतीक्षा करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કમાન્ડ ચલાવતાં પહેલાં ચાલુ ક્રિયા પૂર્ણ થાય ત્યાં સુધી રાહ જુઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಜ್ಞೆ ನಡೆಸುವ ಮೊದಲು ಪ್ರಸ್ತುತ ಕ್ರಿಯೆ ಮುಗಿಯುವವರೆಗೆ ಕಾಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കമാൻഡ് പ്രവർത്തിപ്പിക്കുന്നതിന് മുമ്പ് നിലവിലെ പ്രവൃത്തി തീരുന്നതുവരെ കാത്തിരിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਮਾਂਡ ਚਲਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਮੌਜੂਦਾ ਕਾਰਵਾਈ ਪੂਰੀ ਹੋਣ ਦੀ ਉਡੀਕ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la operación actual antes de ejecutar un comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin de l'opération en cours avant de lancer une commande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis der aktuelle Vorgang abgeschlossen ist, bevor du einen Befehl ausführst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a operação atual terminar antes de executar um comando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi la fine dell'operazione corrente prima di eseguire un comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドを実行する前に、現在の操作が完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령을 실행하기 전에 현재 작업이 끝날 때까지 기다려 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待当前操作完成后再运行指令。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь завершения текущей операции перед запуском команды."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر انتهاء العملية الحالية قبل تشغيل أمر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתינו לסיום הפעולה הנוכחית לפני הרצת פקודה."
          }
        }
      }
    },
    "Wait until scan or execution completes to change scan folders.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait until scan or execution completes to change scan folders."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन फ़ोल्डर बदलने के लिए स्कैन या निष्पादन पूरा होने तक प्रतीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান ফোল্ডার পরিবর্তন করতে স্ক্যান বা কার্যকর সম্পন্ন হওয়া পর্যন্ত অপেক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் கோப்புறைகளை மாற்ற ஸ்கேன் அல்லது செயல்படுத்தல் முடியும் வரை காத்திருக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ ఫోల్డర్లను మార్చడానికి స్కాన్ లేదా అమలు పూర్తయ్యే వరకు వేచి ఉండండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन फोल्डर्स बदलण्यासाठी स्कॅन किंवा अंमलबजावणी पूर्ण होईपर्यंत प्रतीक्षा करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન ફોલ્ડર્સ બદલવા માટે સ્કૅન અથવા અમલ પૂર્ણ થાય ત્યાં સુધી રાહ જુઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು ಸ್ಕ್ಯಾನ್ ಅಥವಾ ಕಾರ್ಯಗತಗೊಳಿಸುವಿಕೆ ಪೂರ್ಣಗೊಳ್ಳುವವರೆಗೆ ಕಾಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ ഫോൾഡറുകൾ മാറ്റാൻ സ്കാനോ നടപ്പാക്കലോ പൂർത്തിയാകുന്നത് വരെ കാത്തിരിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਫੋਲਡਰ ਬਦਲਣ ਲਈ ਸਕੈਨ ਜਾਂ ਅਮਲ ਪੂਰਾ ਹੋਣ ਤੱਕ ਉਡੀਕ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que finalice el análisis o ejecución para cambiar las carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin de l'analyse ou de l'exécution pour modifier les dossiers analysés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte bis zum Abschluss von Scan oder Ausführung, um Scan-Ordner zu ändern."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a conclusão da análise ou execução para alterar as pastas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi il termine della scansione o esecuzione per cambiare le cartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンまたは実行が完了してからスキャンフォルダを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 폴더를 변경하려면 스캔 또는 실행이 완료될 때까지 기다려 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待扫描或执行完成后再更改扫描文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь окончания сканирования или очистки, чтобы изменить папки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر اكتمال الفحص أو التنفيذ لتغيير مجلدات الفحص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתינו לסיום הסריקה או הביצוע לפני שינוי תיקיות הסריקה."
          }
        }
      }
    },
    "Wait until the current cleanup finishes, then restore again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait until the current cleanup finishes, then restore again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान क्लीनअप पूरा होने तक प्रतीक्षा करें, फिर पुनः पुनर्स्थापित करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমান ক্লিনআপ শেষ হওয়া পর্যন্ত অপেক্ষা করুন, তারপর আবার পুনরুদ্ধার করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போதைய சுத்திகரிப்பு முடியும் வரை காத்திருந்து, மீண்டும் மீட்டெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుత శుభ్రత పూర్తయ్యే వరకు వేచి ఉండి, మళ్లీ పునరుద్ధరించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्याचा क्लीनअप पूर्ण होईपर्यंत प्रतीक्षा करा, नंतर पुन्हा पुनर्संचयित करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચાલુ ક્લીનઅપ પૂર્ણ થાય ત્યાં સુધી રાહ જુઓ, પછી ફરી પુનઃસ્થાપિત કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಸ್ತುತ ಸ್ವಚ್ಛತೆ ಮುಗಿಯುವವರೆಗೆ ಕಾದು, ಮತ್ತೆ ಮರುಸ್ಥಾಪಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിലവിലെ വൃത്തിയാക്കൽ പൂർത്തിയാകുന്നത് വരെ കാത്തിരുന്ന് വീണ്ടും പുനഃസ്ഥാപിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੌਜੂਦਾ ਸਫਾਈ ਪੂਰੀ ਹੋਣ ਤੱਕ ਉਡੀਕ ਕਰੋ, ਫਿਰ ਦੁਬਾਰਾ ਬਹਾਲ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que termine la limpieza actual y vuelve a restaurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin du nettoyage en cours, puis relancez la restauration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis die aktuelle Bereinigung abgeschlossen ist, und stelle dann erneut wieder her."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a limpeza atual terminar e restaure novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendi la fine della pulizia corrente, poi ripeti il ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のクリーンアップが完了するまで待ってから再度復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 정리가 끝날 때까지 기다린 후 다시 복원하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待当前清理完成后再重新还原。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь окончания текущей очистки и повторите восстановление."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر انتهاء التنظيف الحالي ثم أعد الاستعادة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתינו לסיום הניקוי הנוכחי ואז שחזרו שוב."
          }
        }
      }
    },
