    "Includes nested files. Hidden files and protected folders are excluded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes nested files. Hidden files and protected folders are excluded."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें अंदर की फ़ाइलें भी शामिल हैं। छिपी फ़ाइलें और सुरक्षित फ़ोल्डर बाहर रखे गए हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ভেতরের ফাইলগুলোও অন্তর্ভুক্ত থাকে। লুকানো ফাইল ও সুরক্ষিত ফোল্ডার বাদ দেওয়া হয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளமைந்த கோப்புகளும் அடங்கும். மறைக்கப்பட்ட கோப்புகள் மற்றும் பாதுகாக்கப்பட்ட கோப்புறைகள் தவிர்க்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లోపలి ఫైళ్లు చేర్చబడ్డాయి. దాచిన ఫైళ్లు మరియు రక్షిత ఫోల్డర్లు మినహాయించబడ్డాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आतील फाइल्स समाविष्ट आहेत. लपलेल्या फाइल्स आणि सुरक्षित फोल्डर्स वगळली जातात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અંદરની ફાઇલો સામેલ છે. છુપાયેલી ફાઇલો અને સુરક્ષિત ફોલ્ડર્સ બાકાત રખાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಒಳಗಿನ ಫೈಲ್‌ಗಳು ಸೇರಿವೆ. ಮರೆಮಾಡಿದ ಫೈಲ್‌ಗಳು ಮತ್ತು ರಕ್ಷಿತ ಫೋಲ್ಡರ್‌ಗಳನ್ನು ಹೊರತುಪಡಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉള്ളിലെ ഫയലുകളും ഉൾപ്പെടുന്നു. മറച്ച ഫയലുകളും സംരക്ഷിത ഫോൾഡറുകളും ഒഴിവാക്കപ്പെടും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੰਦਰੂਨੀ ਫਾਈਲਾਂ ਸ਼ਾਮਲ ਹਨ। ਲੁਕੀਆਂ ਫਾਈਲਾਂ ਅਤੇ ਸੁਰੱਖਿਅਤ ਫੋਲਡਰ ਬਾਹਰ ਰੱਖੇ ਗਏ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye archivos anidados. Los archivos ocultos y las carpetas protegidas se excluyen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut les fichiers imbriqués. Les fichiers masqués et dossiers protégés sont exclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfasst verschachtelte Dateien. Versteckte Dateien und geschützte Ordner sind ausgeschlossen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui arquivos aninhados. Arquivos ocultos e pastas protegidas são excluídos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include i file annidati. File nascosti e cartelle protette sono esclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下位のファイルも含まれます。不可視ファイルと保護されたフォルダは除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 파일이 포함됩니다. 숨김 파일과 보호된 폴더는 제외됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含嵌套文件。隐藏文件与受保护文件夹除外。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает вложенные файлы. Скрытые файлы и защищенные папки исключены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل الملفات المتداخلة. تُستثنى الملفات المخفية والمجلدات المحمية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כולל קבצים מקוננים. קבצים מוסתרים ותיקיות מוגנות אינם נכללים."
          }
        }
      }
    },
