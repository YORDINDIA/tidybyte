    "Safe actions completed. Higher-risk approved actions are still pending.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe actions completed. Higher-risk approved actions are still pending."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित क्रियाएँ पूरी हो गईं। उच्च जोखिम वाली स्वीकृत क्रियाएँ अभी लंबित हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিরাপদ কাজ সম্পন্ন হয়েছে। উচ্চ-ঝুঁকির অনুমোদিত কাজ এখনও অপেক্ষমাণ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதுகாப்பான செயல்கள் முடிந்தன. அதிக ஆபத்துள்ள அங்கீகரிக்கப்பட்ட செயல்கள் இன்னும் நிலுவையில் உள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సురక్షిత చర్యలు పూర్తయ్యాయి. అధిక-ప్రమాద ఆమోదించిన చర్యలు ఇంకా పెండింగ్‌లో ఉన్నాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित क्रिया पूर्ण झाल्या. उच्च जोखमीच्या मंजूर क्रिया अजूनही प्रलंबित आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સુરક્ષિત ક્રિયાઓ પૂર્ણ થઈ. વધુ જોખમી મંજૂર ક્રિયાઓ હજી બાકી છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸುರಕ್ಷಿತ ಕ್ರಿಯೆಗಳು ಪೂರ್ಣಗೊಂಡಿವೆ. ಹೆಚ್ಚಿನ-ಅಪಾಯದ ಅನುಮೋದಿತ ಕ್ರಿಯೆಗಳು ಇನ್ನೂ ಬಾಕಿಯಿವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സുരക്ഷിത പ്രവൃത്തികൾ പൂർത്തിയായി. ഉയർന്ന അപകടസാധ്യതയുള്ള അംഗീകരിച്ച പ്രവൃത്തികൾ ഇപ്പോഴും ശേഷിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੁਰੱਖਿਅਤ ਕਾਰਵਾਈਆਂ ਪੂਰੀਆਂ ਹੋਈਆਂ। ਵੱਧ ਜੋਖਮ ਦੀਆਂ ਮਨਜ਼ੂਰ ਕਾਰਵਾਈਆਂ ਅਜੇ ਬਾਕੀ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acciones seguras completadas. Siguen pendientes las acciones aprobadas de mayor riesgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actions sûres terminées. Des actions approuvées à risque plus élevé restent en attente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Aktionen abgeschlossen. Genehmigte Aktionen mit höherem Risiko stehen noch aus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações seguras concluídas. Ações aprovadas de maior risco ainda estão pendentes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Azioni sicure completate. Le azioni approvate a rischio più elevato sono ancora in sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なアクションが完了しました。より高いリスクの承認済みアクションがまだ残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 작업이 완료되었습니다. 더 높은 위험의 승인된 작업이 아직 남아 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全操作已完成。较高风险的已批准操作仍在等待处理。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безопасные действия выполнены. Одобренные действия повышенного риска ожидают выполнения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتملت الإجراءات الآمنة. لا تزال الإجراءات المعتمدة ذات الخطورة الأعلى قيد الانتظار."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולות בטוחות הושלמו. פעולות מאושרות בסיכון גבוה יותר עדיין ממתינות."
          }
        }
      }
    },
