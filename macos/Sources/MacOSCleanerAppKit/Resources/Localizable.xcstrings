    "Choose what to scan": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what to scan"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि क्या स्कैन करना है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী স্ক্যান করবেন বেছে নিন"
          }
        },
        "ta": {
          "stringUnit": {
