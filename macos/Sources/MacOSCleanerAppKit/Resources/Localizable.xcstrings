    "Scanning does not change your files. Review proposed actions before applying them.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning does not change your files. Review proposed actions before applying them."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन करने से आपकी फ़ाइलें नहीं बदलतीं। लागू करने से पहले प्रस्तावित क्रियाओं की समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান করলে আপনার ফাইল পরিবর্তিত হয় না। প্রয়োগের আগে প্রস্তাবিত কাজগুলো পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் செய்வது உங்கள் கோப்புகளை மாற்றாது. செயல்படுத்துவதற்கு முன் பரிந்துரைக்கப்பட்ட செயல்களை மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ చేయడం వల్ల మీ ఫైళ్లు మారవు. వర్తింపజేసే ముందు ప్రతిపాదిత చర్యలను సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन केल्याने तुमच्या फाइल्स बदलत नाहीत. लागू करण्यापूर्वी प्रस्तावित क्रियांचे पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન કરવાથી તમારી ફાઇલો બદલાતી નથી. લાગુ કરતાં પહેલાં પ્રસ્તાવિત ક્રિયાઓની સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಮಾಡುವುದರಿಂದ ನಿಮ್ಮ ಫೈಲ್‌ಗಳು ಬದಲಾಗುವುದಿಲ್ಲ. ಅನ್ವಯಿಸುವ ಮೊದಲು ಪ್ರಸ್ತಾವಿತ ಕ್ರಿಯೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ ചെയ്യുന്നത് നിങ്ങളുടെ ഫയലുകളിൽ മാറ്റം വരുത്തില്ല. പ്രയോഗിക്കുന്നതിന് മുമ്പ് നിർദ്ദേശിച്ച പ്രവൃത്തികൾ അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਕਰਨ ਨਾਲ ਤੁਹਾਡੀਆਂ ਫਾਈਲਾਂ ਨਹੀਂ ਬਦਲਦੀਆਂ। ਲਾਗੂ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਪ੍ਰਸਤਾਵਿਤ ਕਾਰਵਾਈਆਂ ਦੀ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis no modifica tus archivos. Revisa las acciones propuestas antes de aplicarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse ne modifie pas vos fichiers. Examinez les actions proposées avant de les appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Scannen werden keine Dateien verändert. Prüfe vorgeschlagene Aktionen vor dem Anwenden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise não altera seus arquivos. Revise as ações propostas antes de aplicá-las."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scansione non modifica i file. Esamina le azioni proposte prima di applicarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンしてもファイルは変更されません。適用前に提案されたアクションを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔으로는 파일이 변경되지 않습니다. 적용하기 전에 제안된 작업을 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描不会修改您的文件。应用前请审阅建议操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование не изменяет файлы. Проверьте предложенные действия перед применением."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغيّر الفحص ملفاتك. راجع الإجراءات المقترحة قبل تطبيقها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סריקה אינה משנה קבצים. בדקו פעולות מוצעות לפני החלתן."
          }
        }
      }
    },
