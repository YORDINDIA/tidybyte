    "Affected: %@%@. Check the Trash and undo history.": {
      "comment": "Startup sweep affected-paths suffix",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Affected: %1$@%2$@. Check the Trash and undo history."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रभावित: %@%@। ट्रैश और पूर्ववत इतिहास जांचें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রভাবিত: %@%@। ট্র্যাশ ও পূর্বাবস্থার ইতিহাস পরীক্ষা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பாதிக்கப்பட்டவை: %@%@. குப்பைத் தொட்டியையும் செயல்தவிர் வரலாற்றையும் பார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రభావితమైనవి: %@%@. ట్రాష్ మరియు రద్దు చరిత్రను తనిఖీ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रभावित: %@%@. ट्रॅश आणि पूर्ववत इतिहास तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અસરગ્રસ્ત: %@%@. ટ્રૅશ અને પૂર્વવત ઇતિહાસ તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಭಾವಿತ: %@%@. ಟ್ರ್ಯಾಶ್ ಮತ್ತು ರದ್ದು ಇತಿಹಾಸವನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാധിച്ചവ: %@%@. ട്രാഷും പഴയപടിയാക്കൽ ചരിത്രവും പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਭਾਵਿਤ: %@%@। ਟਰੈਸ਼ ਅਤੇ ਵਾਪਸੀ ਇਤਿਹਾਸ ਜਾਂਚੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Afectados: %@%@. Revisa el Basurero y el historial de deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concernés : %@%@. Vérifiez la Corbeille et l'historique d'annulation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Betroffen: %@%@. Papierkorb und Wiederherstellungsverlauf prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Afetados: %@%@. Verifique o Lixo e o histórico de desfazer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interessati: %@%@. Controlla il Cestino e la cronologia di annullamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象: %@%@。ゴミ箱と取り消し履歴を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상: %@%@. 휴지통과 실행 취소 기록을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受影响项目：%@%@。请检查废纸篓与撤销历史。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затронуто: %@%@. Проверьте Корзину и историю отмены."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتأثر: %@%@. تحقق من سلة المهملات وسجل التراجع."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מושפעים: %@%@. בדקו בפח ובהיסטוריית הביטול."
          }
        }
      }
    },
