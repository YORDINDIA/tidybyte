    "Sorted ascending. Click to sort descending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorted ascending. Click to sort descending."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आरोही क्रम में। अवरोही करने के लिए क्लिक करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উর্ধ্বক্রমে সাজানো। অধঃক্রমে সাজাতে ক্লিক করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஏறுவரிசையில் அமைக்கப்பட்டது. இறங்குவரிசைக்கு கிளிக் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆరోహణ క్రమంలో అమర్చబడింది. అవరోహణ కోసం క్లిక్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चढत्या क्रमाने लावलेले. उतरत्या क्रमाने करण्यासाठी क्लिक करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચડતા ક્રમમાં. ઉતરતા ક્રમ માટે ક્લિક કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆರೋಹಣ ಕ್ರಮದಲ್ಲಿ ವಿಂಗಡಿಸಲಾಗಿದೆ. ಅವರೋಹಣಕ್ಕಾಗಿ ಕ್ಲಿಕ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരോഹണ ക്രമത്തിൽ. അവരോഹണ ക്രമത്തിലാക്കാൻ ക്ലിക്ക് ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਧਦੇ ਕ੍ਰਮ ਵਿੱਚ। ਘਟਦੇ ਕ੍ਰਮ ਲਈ ਕਲਿੱਕ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden ascendente. Haz clic para ordenar descendente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tri croissant. Cliquez pour passer au tri décroissant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufsteigend sortiert. Klicken für absteigende Sortierung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordem crescente. Clique para ordem decrescente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordine crescente. Fai clic per ordinamento decrescente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昇順で並べ替え済み。クリックで降順にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오름차순 정렬됨. 클릭하면 내림차순 정렬됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前为升序。点击切换为降序。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсортировано по возрастанию. Нажмите для убывания."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرتب تصاعديًا. انقر للترتيب تنازليًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוין בסדר עולה. לחצו למיון יורד."
          }
        }
      }
    },
