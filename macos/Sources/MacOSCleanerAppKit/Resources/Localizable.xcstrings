    "1 approved action is review-only and was not executed.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 approved action is review-only and was not executed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 स्वीकृत क्रिया केवल समीक्षा के लिए है और चलाई नहीं गई।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "1টি অনুমোদিত কাজ শুধুমাত্র পর্যালোচনার জন্য এবং চালানো হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "1 அங்கீகரிக்கப்பட்ட செயல் மதிப்பாய்வுக்கு மட்டுமே ஆனது, இயக்கப்படவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ఆమోదించబడిన చర్య సమీక్షకు మాత్రమే మరియు అమలు చేయబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 मंजूर क्रिया केवळ पुनरावलोकनासाठी आहे आणि ती चालवली गेली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "1 મંજૂર ક્રિયા માત્ર સમીક્ષા માટે છે અને ચલાવવામાં આવી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ಅನುಮೋದಿತ ಕ್ರಿಯೆ ಪರಿಶೀಲನೆಗೆ ಮಾತ್ರ ಮತ್ತು ಕಾರ್ಯಗತಗೊಳಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "1 അംഗീകരിച്ച പ്രവൃത്തി അവലോകനത്തിന് മാത്രമുള്ളതാണ്, പ്രവർത്തിപ്പിച്ചിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ਮਨਜ਼ੂਰ ਕਾਰਵਾਈ ਕੇਵਲ ਸਮੀਖਿਆ ਲਈ ਹੈ ਅਤੇ ਚਲਾਈ ਨਹੀਂ ਗਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 acción aprobada es solo para revisar y no se ejecutó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 action approuvée est en examen uniquement et n'a pas été exécutée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 genehmigte Aktion ist nur zur Prüfung vorgesehen und wurde nicht ausgeführt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ação aprovada é apenas para revisão e não foi executada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 azione approvata è solo per revisione e non è stata eseguita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認済みのアクション 1 件は確認専用のため実行されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 작업 1개는 검토 전용이므로 실행되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 项已批准操作仅供查看，未予执行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 одобренное действие предназначено только для проверки и не выполнялось."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجراء واحد معتمد مخصص للمراجعة فقط ولم يُنفَّذ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה מאושרת 1 מיועדת לבדיקה בלבד ולא בוצעה."
          }
        }
      }
    },
