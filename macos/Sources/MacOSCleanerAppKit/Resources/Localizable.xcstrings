    "Reviewed photos and media appear here once you clean them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewed photos and media appear here once you clean them."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा और साफ़ किए गए फ़ोटो व मीडिया यहाँ दिखाई देते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিষ্কার করার পর পর্যালোচিত ফটো ও মিডিয়া এখানে দেখা যায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுத்திகரித்தவுடன் மதிப்பாய்வு செய்த புகைப்படங்களும் மீடியாவும் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శుభ్రం చేసిన తర్వాత సమీక్షించిన ఫోటోలు మరియు మీడియా ఇక్కడ కనిపిస్తాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "साफ केल्यानंतर पुनरावलोकन केलेले फोटो आणि मीडिया येथे दिसतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સાફ કર્યા પછી સમીક્ષા કરેલા ફોટા અને મીડિયા અહીં દેખાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಚ್ಛಗೊಳಿಸಿದ ನಂತರ ಪರಿಶೀಲಿಸಿದ ಫೋಟೋಗಳು ಮತ್ತು ಮೀಡಿಯಾ ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൃത്തിയാക്കിയ ശേഷം അവലോകനം ചെയ്ത ഫോട്ടോകളും മീഡിയയും ഇവിടെ കാണാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਫ਼ ਕਰਨ ਤੋਂ ਬਾਅਦ ਸਮੀਖਿਆ ਕੀਤੀਆਂ ਫੋਟੋਆਂ ਅਤੇ ਮੀਡੀਆ ਇੱਥੇ ਦਿਖਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y archivos multimedia revisados aparecen aquí una vez limpiados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et médias examinés s'affichent ici une fois nettoyés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüfte Fotos und Medien erscheinen hier nach der Bereinigung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos e mídias revisadas aparecem aqui após a limpeza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto e i media esaminati appaiono qui dopo la pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンアップを完了した写真やメディアがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리한 사진과 미디어가 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理完成后，已审阅的照片和媒体将显示在此处。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверенные фото и медиафайлы появятся здесь после очистки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الصور والوسائط المراجَعة هنا بمجرد تنظيفها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות ומדיה שנבדקו יופיעו כאן לאחר הניקוי."
          }
        }
      }
    },
