    "Converted %lld of %lld; %lld failed. Check Activity.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Converted %lld of %lld; %lld failed. Check Activity."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld में से %1$lld बदले गए; %3$lld विफल। गतिविधि जांचें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lldটির মধ্যে %1$lldটি রূপান্তরিত; %3$lldটি ব্যর্থ। কার্যকলাপ দেখুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld இல் %1$lld மாற்றப்பட்டன; %3$lld தோல்வி. செயல்பாட்டைச் சரிபார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld లో %1$lld మార్చబడ్డాయి; %3$lld విఫలం. కార్యాచరణను తనిఖీ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld पैकी %1$lld रूपांतरित; %3$lld अयशस्वी. क्रियाकलाप तपासा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld માંથી %1$lld રૂપાંતરિત થયા; %3$lld નિષ્ફળ. પ્રવૃત્તિ તપાસો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld ರಲ್ಲಿ %1$lld ಪರಿವರ್ತಿಸಲಾಗಿದೆ; %3$lld ವಿಫಲವಾಗಿದೆ. ಚಟುವಟಿಕೆಯನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld-ൽ %1$lld മാറ്റി; %3$lld പരാജയപ്പെട്ടു. പ്രവർത്തനം പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld ਵਿੱਚੋਂ %1$lld ਬਦਲੇ ਗਏ; %3$lld ਅਸਫਲ। ਗਤੀਵਿਧੀ ਜਾਂਚੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se convirtieron %lld de %lld; %lld fallaron. Revisa Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sur %lld converties ; %lld échec(s). Consultez Activité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld von %lld konvertiert; %lld fehlgeschlagen. Prüfe die Aktivität."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld convertidas; %lld falharam. Verifique em Atividade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertite %lld su %lld; %lld non riuscite. Controlla Attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 件中 %1$lld 件を変換、%3$lld 件失敗しました。アクティビティを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld개 중 %1$lld개 변환됨, %3$lld개 실패. 활동 내역을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已转换 %1$lld/%2$lld；%3$lld 项失败。请查看活动记录。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразовано %lld из %lld; с ошибкой: %lld. Проверьте «Активность»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحويل %lld من أصل %lld؛ فشل %lld. راجع النشاط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הומרו %lld מתוך %lld; %lld נכשלו. בדקו בפעילות."
          }
        }
      }
    },
