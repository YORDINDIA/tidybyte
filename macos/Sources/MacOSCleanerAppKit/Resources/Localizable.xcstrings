    "%@ sent to Trash or Recently Deleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sent to Trash or Recently Deleted"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ट्रैश या हाल ही में हटाए गए में भेजा गया"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ট্র্যাশ বা সম্প্রতি মোছা-তে পাঠানো হয়েছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ குப்பைத் தொட்டி அல்லது சமீபத்தில் நீக்கியவைக்கு அனுப்பப்பட்டது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ట్రాష్ లేదా ఇటీవల తొలగించినవిలోకి పంపబడింది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ट्रॅश किंवा अलीकडे हटवलेले मध्ये पाठवले"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ટ્રૅશ અથવા તાજેતરમાં કાઢી નાખેલા માં મોકલ્યું"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಟ್ರ್ಯಾಶ್ ಅಥವಾ ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವುಗೆ ಕಳುಹಿಸಲಾಗಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ട്രാഷിലേക്കോ അടുത്തിടെ ഇല്ലാതാക്കിയവയിലേക്കോ അയച്ചു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਟਰੈਸ਼ ਜਾਂ ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਵਿੱਚ ਭੇਜਿਆ ਗਿਆ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enviados al Basurero o a Recientemente eliminados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ envoyé vers la Corbeille ou Récemment supprimés"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in den Papierkorb oder nach Zuletzt gelöscht verschoben"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enviados para o Lixo ou Excluídos recentemente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spostati nel Cestino o in Eliminati di recente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をゴミ箱または「最近削除した項目」へ移動済み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 휴지통 또는 최근 삭제된 항목으로 이동됨"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %@ 移至废纸篓或“最近删除”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ перемещено в Корзину или «Недавно удаленные»"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم نقل %@ إلى سلة المهملات أو المحذوفة مؤخرًا"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ הועבר לפח או לנמחקו לאחרונה"
          }
        }
      }
    },
