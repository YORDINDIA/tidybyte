    "Restored your last scan from %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored your last scan from %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ से आपका पिछला स्कैन पुनर्स्थापित किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ থেকে আপনার শেষ স্ক্যান পুনরুদ্ধার করা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இலிருந்து உங்கள் கடைசி ஸ்கேன் மீட்டெடுக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ నుండి మీ చివరి స్కాన్ పునరుద్ధరించబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ मधील तुमचा मागील स्कॅन पुनर्संचयित केला."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ માંથી તમારો છેલ્લો સ્કૅન પુનઃસ્થાપિત કર્યો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ನಿಂದ ನಿಮ್ಮ ಕೊನೆಯ ಸ್ಕ್ಯಾನ್ ಮರುಸ್ಥಾಪಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ൽ നിന്നുള്ള നിങ്ങളുടെ അവസാന സ്കാൻ പുനഃസ്ഥാപിച്ചു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਤੋਂ ਤੁਹਾਡਾ ਪਿਛਲਾ ਸਕੈਨ ਬਹਾਲ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restauró tu último análisis del %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière analyse du %@ restaurée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzter Scan vom %@ wiederhergestellt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua última análise de %@ foi restaurada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima scansione del %@ ripristinata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の前回のスキャンを復元しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 마지막 스캔을 복원했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复 %@ 的上次扫描。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановлено последнее сканирование от %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت استعادة آخر فحص لك من %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שוחזרה הסריקה האחרונה מ-%@."
          }
        }
      }
    },
    "Results come from the latest scan.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results come from the latest scan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिणाम नवीनतम स्कैन से लिए गए हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলাফল সর্বশেষ স্ক্যান থেকে প্রাপ্ত।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவுகள் சமீபத்திய ஸ்கேனிலிருந்து வருகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫలితాలు తాజా స్కాన్ నుండి వచ్చాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निकाल ताज्या स्कॅनवर आधारित आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરિણામો તાજેતરના સ્કૅનમાંથી આવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫಲಿತಾಂಶಗಳು ಇತ್ತೀಚಿನ ಸ್ಕ್ಯಾನ್‌ನಿಂದ ಬಂದಿವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫലങ്ങൾ ഏറ്റവും പുതിയ സ്കാനിൽ നിന്നുള്ളതാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਤੀਜੇ ਤਾਜ਼ਾ ਸਕੈਨ ਤੋਂ ਆਏ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados provienen del análisis más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats proviennent de la dernière analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ergebnisse stammen vom letzten Scan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados vêm da análise mais recente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati provengono dall'ultima scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のスキャン結果に基づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근 스캔에서 가져온 결과입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果来自最近一次扫描。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны результаты последнего сканирования."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النتائج مأخوذة من أحدث فحص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוצאות מגיעות מהסריקה האחרונה."
          }
        }
      }
    },
    "Results cover the scanned locations, not the whole disk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results cover the scanned locations, not the whole disk."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिणाम केवल स्कैन किए गए स्थानों को दिखाते हैं, पूरी डिस्क को नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলাফল কেবল স্ক্যান করা স্থানগুলো অন্তর্ভুক্ত করে, পুরো ডিস্ক নয়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிவுகள் முழு வட்டையும் அல்லாமல் ஸ்கேன் செய்த இடங்களை மட்டுமே உள்ளடக்குகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫలితాలు మొత్తం డిస్క్ కాకుండా స్కాన్ చేసిన స్థానాలను మాత్రమే కవర్ చేస్తాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निकाल केवळ स्कॅन केलेल्या ठिकाणांचे आहेत, संपूर्ण डिस्कचे नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પરિણામો માત્ર સ્કૅન કરેલા સ્થાનોને આવરી લે છે, આખી ડિસ્કને નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫಲಿತಾಂಶಗಳು ಸಂಪೂರ್ಣ ಡಿಸ್ಕ್ ಅಲ್ಲದೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಸ್ಥಳಗಳನ್ನು ಮಾತ್ರ ಒಳಗೊಳ್ಳುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫലങ്ങൾ മുഴുവൻ ഡിസ്കും അല്ല, സ്കാൻ ചെയ്ത സ്ഥലങ്ങൾ മാത്രമാണ് കാണിക്കുന്നത്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਤੀਜੇ ਕੇਵਲ ਸਕੈਨ ਕੀਤੇ ਟਿਕਾਣਿਆਂ ਨੂੰ ਦਰਸਾਉਂਦੇ ਹਨ, ਪੂਰੀ ਡਿਸਕ ਨੂੰ ਨਹੀਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados cubren solo las ubicaciones analizadas, no todo el disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats couvrent uniquement les emplacements analysés, pas tout le disque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ergebnisse decken nur die gescannten Orte ab, nicht das gesamte Laufwerk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados cobrem apenas os locais analisados, não o disco inteiro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati coprono le posizioni analizzate, non l'intero disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果はスキャン対象の場所のみであり、ディスク全体ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과는 전체 디스크가 아니라 스캔한 위치만 포함합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果仅涵盖已扫描位置，而非整块磁盘。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты охватывают только просканированные места, а не весь диск."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغطي النتائج المواقع المفحوصة فقط، وليس القرص بأكمله."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוצאות מכסות את המיקומים שנסרקו בלבד, לא את כל הדיסק."
          }
        }
      }
    },
