        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முடிந்த மாற்றங்களை வரலாற்றில் சேமிக்க முடியவில்லை: %@"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తయిన మార్పులను చరిత్రలో సేవ్ చేయలేకపోయాము: %@"
