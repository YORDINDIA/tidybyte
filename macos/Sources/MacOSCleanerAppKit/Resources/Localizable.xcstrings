    "Notifications are disabled in System Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are disabled in System Settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्स में सूचनाएँ बंद हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম সেটিংসে বিজ্ঞপ্তি নিষ্ক্রিয় রয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணினி அமைப்புகளில் அறிவிப்புகள் முடக்கப்பட்டுள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిస్టమ్ సెట్టింగ్‌లలో నోటిఫికేషన్లు ఆఫ్ చేయబడ్డాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्जमध्ये सूचना बंद आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિસ્ટમ સેટિંગ્સમાં સૂચનાઓ બંધ છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಸ್ಟಮ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅಧಿಸೂಚನೆಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിസ്റ്റം ക്രമീകരണങ്ങളിൽ അറിയിപ്പുകൾ പ്രവർത്തനരഹിതമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਸਟਮ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਸੂਚਨਾਵਾਂ ਬੰਦ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées dans Réglages Système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind in den Systemeinstellungen deaktiviert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas em Ajustes do Sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定で通知が無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 알림이 비활성화되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已在“系统设置”中停用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отключены в Системных настройках."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات معطّلة في إعدادات النظام."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראות מושבתות בהגדרות המערכת."
          }
        }
      }
    },
    "Notify me when an app misbehaves": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me when an app misbehaves"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई ऐप असामान्य व्यवहार करे तो मुझे सूचित करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো অ্যাপ অস্বাভাবিক আচরণ করলে আমাকে জানান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு செயலி தவறாகச் செயல்படும்போது எனக்கு அறிவிக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక యాప్ అసాధారణంగా ప్రవర్తించినప్పుడు నాకు తెలియజేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखादे अ‍ॅप अनपेक्षित वर्तन करत असल्यास मला कळवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે કોઈ ઍપ અસામાન્ય વર્તન કરે ત્યારે મને જણાવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್ ಅಸಹಜವಾಗಿ ವರ್ತಿಸಿದಾಗ ನನಗೆ ತಿಳಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ആപ്പ് അസ്വാഭാവികമായി പ്രവർത്തിക്കുമ്പോൾ എന്നെ അറിയിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਕੋਈ ਐਪ ਗਲਤ ਵਿਵਹਾਰ ਕਰੇ ਤਾਂ ਮੈਨੂੰ ਸੂਚਿਤ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisarme cuando una app tenga un consumo anómalo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "M'avertir lorsqu'une app a un comportement anormal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn sich eine App auffällig verhält"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar quando um app se comportar de forma anômala"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisami quando un'app si comporta in modo anomalo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの異常動作時に通知する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 비정상 동작을 보일 때 알림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当应用资源占用异常时通知我"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщать о сбоях или перегрузке со стороны приложений"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيهي عند إساءة استهلاك تطبيق للموارد"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התרע כשאפליקציה צורכת משאבים בחריגה"
          }
        }
      }
    },
