            "value": "クリーンアップしたい内容を自然な言葉で入力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리할 대상을 자연어로 입력"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用自己的话描述要清理的内容"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите своими словами, что нужно очистить"
          }
        },
        "ar": {
          "stringUnit": {
