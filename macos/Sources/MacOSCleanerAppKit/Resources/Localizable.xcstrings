            "value": "%lld ಯಶಸ್ವಿ · %lld ವಿಫಲ · %lld ಸಂಸ್ಕರಿಸದ. ಚಟುವಟಿಕೆಯನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld വിജയം · %lld പരാജയം · %lld പ്രോസസ്സ് ചെയ്യാത്തവ. പ്രവർത്തനം പരിശോധിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ਸਫਲ · %lld ਅਸਫਲ · %lld ਬਾਕੀ। ਗਤੀਵਿਧੀ ਜਾਂਚੋ।"
