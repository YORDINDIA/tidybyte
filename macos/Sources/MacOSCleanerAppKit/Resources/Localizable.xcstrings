        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਦ੍ਰਿਸ਼ ਭਰਨ ਲਈ ਸਕੈਨ ਚਲਾਓ ਜਾਂ ਨਾਮ ਫਿਲਟਰ ਸਾਫ਼ ਕਰੋ।"
