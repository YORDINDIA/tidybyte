    "Add to a Photos album without removing from library": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to a Photos album without removing from library"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी से हटाए बिना फ़ोटो एल्बम में जोड़ें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইব্রেরি থেকে না সরিয়ে ফটো অ্যালবামে যোগ করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நூலகத்திலிருந்து அகற்றாமல் புகைப்பட ஆல்பத்தில் சேர்க்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైబ్రరీ నుండి తీసివేయకుండా ఫోటో ఆల్బమ్‌కు జోడించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लायब्ररीतून न काढता फोटो अल्बममध्ये जोडा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાઇબ્રેરીમાંથી દૂર કર્યા વિના ફોટો આલ્બમમાં ઉમેરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೈಬ್ರರಿಯಿಂದ ತೆಗೆಯದೆ ಫೋಟೋ ಆಲ್ಬಮ್‌ಗೆ ಸೇರಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈബ്രറിയിൽ നിന്ന് നീക്കം ചെയ്യാതെ ഫോട്ടോ ആൽബത്തിലേക്ക് ചേർക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਇਬ੍ਰੇਰੀ ਤੋਂ ਹਟਾਏ ਬਿਨਾਂ ਫੋਟੋ ਐਲਬਮ ਵਿੱਚ ਸ਼ਾਮਲ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir a un álbum de Fotos sin quitarlo de la fototeca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter à un album Photos sans le retirer de la photothèque"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu einem Fotos-Album hinzufügen, ohne es aus der Mediathek zu entfernen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar a um álbum do Fotos sem remover da fototeca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi a un album di Foto senza rimuovere dalla libreria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリから削除せずに「写真」アルバムへ追加"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함에서 제거하지 않고 사진 앨범에 추가"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到“照片”相簿，不从图库中移除"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить в альбом «Фото», не удаляя из медиатеки"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة إلى ألبوم في الصور دون إزالة من المكتبة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספה לאלבום תמונות ללא הסרה מהספרייה"
          }
        }
      }
    },
    "Added %@ to Leftovers for review.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %@ to Leftovers for review."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा के लिए %@ को बचे हुए डेटा में जोड़ा गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্যালোচনার জন্য %@-কে অবশিষ্টাংশে যোগ করা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மதிப்பாய்வுக்காக %@ எஞ்சியவைகளில் சேர்க்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమీక్ష కోసం %@ అవశేషాలకు జోడించబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरावलोकनासाठी %@ अवशेषांमध्ये जोडले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમીક્ષા માટે %@ અવશેષોમાં ઉમેર્યું."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿಶೀಲನೆಗಾಗಿ %@ ಅನ್ನು ಉಳಿಕೆಗಳಿಗೆ ಸೇರಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവലോകനത്തിനായി %@ അവശിഷ്ടങ്ങളിൽ ചേർത്തു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੀਖਿਆ ਲਈ %@ ਬਚੀ ਸਮੱਗਰੀ ਵਿੱਚ ਸ਼ਾਮਲ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadió %@ a Sobras para revisarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajouté aux Résidus pour examen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zur Prüfung zu Resten hinzugefügt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adicionado a Sobras para revisão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aggiunto ai Residui per revisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のため %@ を残存データに追加しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토를 위해 %@을(를) 잔여 파일에 추가했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将 %@ 添加到残留文件以供审阅。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объект %@ добавлен в «Остатки» для проверки."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إضافة %@ إلى البقايا للمراجعة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ נוסף לשאריות לבדיקה."
          }
        }
      }
    },
    "Added to the cleanup plan. Review it in Proposed Actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added to the cleanup plan. Review it in Proposed Actions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफ़ाई योजना में जोड़ा गया। इसे प्रस्तावित क्रियाओं में देखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লিনআপ পরিকল্পনায় যোগ করা হয়েছে। প্রস্তাবিত কাজ-এ এটি পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுத்திகரிப்புத் திட்டத்தில் சேர்க்கப்பட்டது. பரிந்துரைக்கப்பட்ட செயல்களில் மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శుభ్రత ప్రణాళికకు జోడించబడింది. ప్రతిపాదిత చర్యలలో సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लीनअप योजनेत जोडले. प्रस्तावित क्रियांमध्ये याचे पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્લીનઅપ યોજનામાં ઉમેર્યું. પ્રસ્તાવિત ક્રિયાઓમાં સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಚ್ಛತಾ ಯೋಜನೆಗೆ ಸೇರಿಸಲಾಗಿದೆ. ಪ್ರಸ್ತಾವಿತ ಕ್ರಿಯೆಗಳಲ್ಲಿ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വൃത്തിയാക്കൽ പ്ലാനിൽ ചേർത്തു. നിർദ്ദേശിച്ച പ്രവൃത്തികളിൽ അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਫਾਈ ਯੋਜਨਾ ਵਿੱਚ ਸ਼ਾਮਲ ਕੀਤਾ ਗਿਆ। ਪ੍ਰਸਤਾਵਿਤ ਕਾਰਵਾਈਆਂ ਵਿੱਚ ਇਸਦੀ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadido al plan de limpieza. Revísalo en Acciones propuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté au plan de nettoyage. Examinez-le dans Actions proposées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Bereinigungsplan hinzugefügt. Unter „Vorgeschlagene Aktionen“ prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionado ao plano de limpeza. Revise em Ações propostas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunto al piano di pulizia. Esaminalo in Azioni proposte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンアッププランに追加しました。「提案されたアクション」で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 계획에 추가되었습니다. 제안된 작업에서 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加到清理计划。请在“建议操作”中审阅。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлено в план очистки. Проверьте в разделе «Предложенные действия»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت الإضافة إلى خطة التنظيف. راجعها في الإجراءات المقترحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נוסף לתוכנית הניקוי. בדקו אותו בפעולות מוצעות."
          }
        }
      }
    },
