      }
    },
    "This command has no restore action.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This command has no restore action."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कमांड के लिए कोई पुनर्स्थापना क्रिया नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কমান্ডের কোনো পুনরুদ্ধার কাজ নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் கட்டளைக்கு மீட்டெடுப்புச் செயல் இல்லை."
