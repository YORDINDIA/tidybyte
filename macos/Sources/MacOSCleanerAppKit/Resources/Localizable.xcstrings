    "Run Package Cleanup": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run Package Cleanup"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैकेज क्लीनअप चलाएँ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাকেজ ক্লিনআপ চালান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொகுப்பு சுத்திகரிப்பை இயக்கு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్యాకేజీ శుభ్రత అమలు చేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पॅकेज क्लीनअप चालवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૅકેજ ક્લીનઅપ ચલાવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ಯಾಕೇಜ್ ಸ್ವಚ್ಛತೆ ನಡೆಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പാക്കേജ് വൃത്തിയാക്കൽ പ്രവർത്തിപ്പിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੈਕੇਜ ਸਫਾਈ ਚਲਾਓ"
