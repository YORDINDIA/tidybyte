    "Showing largest %lld of %lld files in this month.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing largest %lld of %lld files in this month."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस महीने की %2$lld फ़ाइलों में से सबसे बड़ी %1$lld फ़ाइलें दिखाई जा रही हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মাসের %2$lldটি ফাইলের মধ্যে সবচেয়ে বড় %1$lldটি দেখানো হচ্ছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த மாதத்தின் %2$lld கோப்புகளில் மிகப்பெரிய %1$lld காட்டப்படுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ నెలలోని %2$lld ఫైళ్లలో అతిపెద్ద %1$lld చూపుతోంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या महिन्यातील %2$lld फाइल्सपैकी सर्वात मोठ्या %1$lld दाखवत आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ મહિનાની %2$lld ફાઇલોમાંથી સૌથી મોટી %1$lld બતાવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ತಿಂಗಳ %2$lld ಫೈಲ್‌ಗಳಲ್ಲಿ ಅತಿ ದೊಡ್ಡ %1$lld ತೋರಿಸಲಾಗುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ മാസത്തെ %2$lld ഫയലുകളിൽ ഏറ്റവും വലിയ %1$lld കാണിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਮਹੀਨੇ ਦੀਆਂ %2$lld ਫਾਈਲਾਂ ਵਿੱਚੋਂ ਸਭ ਤੋਂ ਵੱਡੀਆਂ %1$lld ਦਿਖਾ ਰਿਹਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando los %lld archivos más grandes de %lld en este mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage des %lld plus gros fichiers sur %lld ce mois-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld größten von %lld Dateien in diesem Monat werden angezeigt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando os %lld maiores de %lld arquivos neste mês."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrati i %lld file più grandi su %lld in questo mese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月の %2$lld 個のファイルのうち大きい順 %1$lld 個を表示中。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이달의 %2$lld개 파일 중 가장 큰 %1$lld개 표시 중."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示本月 %2$lld 个文件中体积最大的 %1$lld 个。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показаны %lld самых крупных из %lld файлов за этот месяц."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض أكبر %lld من %lld ملف في هذا الشهر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את %lld הקבצים הגדולים מתוך %lld בחודש זה."
          }
        }
      }
    },
    "Shows free space and quick actions. Tidybyte keeps running when its window closes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows free space and quick actions. Tidybyte keeps running when its window closes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाली स्पेस और त्वरित क्रियाएँ दिखाता है। विंडो बंद होने पर भी Tidybyte चलता रहता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "খালি জায়গা ও দ্রুত কাজগুলো দেখায়। উইন্ডো বন্ধ হলেও Tidybyte চলতে থাকে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காலி இடத்தையும் விரைவு செயல்களையும் காட்டும். சாளரம் மூடினாலும் Tidybyte தொடர்ந்து இயங்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఖాళీ స్థలం మరియు శీఘ్ర చర్యలను చూపుతుంది. విండో మూసినప్పుడు కూడా Tidybyte నడుస్తూ ఉంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोकळी जागा आणि त्वरित क्रिया दाखवते. विंडो बंद केल्यानंतरही Tidybyte चालू राहते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ખાલી જગ્યા અને ઝડપી ક્રિયાઓ બતાવે છે. વિન્ડો બંધ થયા પછી પણ Tidybyte ચાલુ રહે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಖಾಲಿ ಸ್ಥಳ ಮತ್ತು ತ್ವರಿತ ಕ್ರಿಯೆಗಳನ್ನು ತೋರಿಸುತ್ತದೆ. ವಿಂಡೋ ಮುಚ್ಚಿದಾಗಲೂ Tidybyte ಚಾಲನೆಯಲ್ಲಿರುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒഴിഞ്ഞ ഇടവും വേഗത്തിലുള്ള പ്രവൃത്തികളും കാണിക്കുന്നു. വിൻഡോ അടയ്ക്കുമ്പോഴും Tidybyte പ്രവർത്തിച്ചുകൊണ്ടിരിക്കും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖਾਲੀ ਥਾਂ ਅਤੇ ਤੇਜ਼ ਕਾਰਵਾਈਆਂ ਦਿਖਾਉਂਦਾ ਹੈ। ਵਿੰਡੋ ਬੰਦ ਹੋਣ 'ਤੇ ਵੀ Tidybyte ਚੱਲਦਾ ਰਹਿੰਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el espacio libre y acciones rápidas. Tidybyte sigue funcionando al cerrar la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l'espace libre et les actions rapides. Tidybyte continue de fonctionner lorsque sa fenêtre se ferme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt freien Speicherplatz und Schnellaktionen. Tidybyte läuft beim Schließen des Fensters weiter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o espaço livre e ações rápidas. O Tidybyte continua rodando quando a janela fecha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra lo spazio libero e le azioni rapide. Tidybyte rimane attivo alla chiusura della finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量とクイックアクションを表示します。ウィンドウを閉じても Tidybyte は動作を続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 공간과 빠른 동작을 표시합니다. 창을 닫아도 Tidybyte는 계속 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示可用磁盘空间与快捷操作。关闭窗口后 Tidybyte 仍会继续在后台运行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает свободное место и быстрые действия. Tidybyte продолжает работать при закрытии окна."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض المساحة الحرة والإجراءات السريعة. يواصل Tidybyte العمل عند إغلاق نافذته."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג שטח פנוי ופעולות מהירות. ‏Tidybyte ממשיך לפעול גם כשהחלון נסגר."
          }
        }
      }
    },
