    "This permanently erases %@. You can't undo this action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently erases %@. You can't undo this action."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे %@ स्थायी रूप से मिट जाता है। आप इस क्रिया को पूर्ववत नहीं कर सकते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি %@-কে স্থায়ীভাবে মুছে ফেলে। আপনি এই কাজ পূর্বাবস্থায় ফেরাতে পারবেন না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது %@ ஐ நிரந்தரமாக அழிக்கும். இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది %@ ను శాశ్వతంగా తుడిచివేస్తుంది. మీరు ఈ చర్యను రద్దు చేయలేరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे %@ कायमस्वरूपी पुसून टाकते. तुम्ही ही क्रिया पूर्ववत करू शकत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ %@ ને કાયમી ધોરણે ભૂંસી નાખે છે. તમે આ ક્રિયા પૂર્વવત કરી શકતા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು %@ ಅನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸುತ್ತದೆ. ನೀವು ಈ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് %@-നെ സ്ഥിരമായി മായ്ച്ചുകളയുന്നു. ഈ പ്രവൃത്തി പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ %@ ਨੂੰ ਸਥਾਈ ਤੌਰ 'ਤੇ ਮਿਟਾ ਦਿੰਦਾ ਹੈ। ਤੁਸੀਂ ਇਸ ਕਾਰਵਾਈ ਨੂੰ ਵਾਪਸ ਨਹੀਂ ਕਰ ਸਕਦੇ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra permanentemente %@. No puedes deshacer esta acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface définitivement %@. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird %@ endgültig gelöscht. Diese Aktion kann nicht widerrufen werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
