    "Clearing local data removes the records needed to restore previous changes.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing local data removes the records needed to restore previous changes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय डेटा साफ़ करने से पिछले बदलावों को पुनर्स्थापित करने वाले रिकॉर्ड हट जाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানীয় ডেটা মুছলে আগের পরিবর্তনগুলো পুনরুদ্ধার করার রেকর্ড হারিয়ে যাবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் தரவை அழிப்பது முந்தைய மாற்றங்களை மீட்டெடுக்கத் தேவையான பதிவுகளை நீக்கிவிடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్థానిక డేటాను క్లియర్ చేయడం వల్ల మునుపటి మార్పులను పునరుద్ధరించడానికి అవసరమైన రికార్డులు తొలగించబడతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानिक डेटा साफ केल्यास मागील बदल पुनर्संचयित करण्यासाठी आवश्यक नोंदी काढल्या जातात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્થાનિક ડેટા સાફ કરવાથી અગાઉના ફેરફારો પુનઃસ્થાપિત કરવા માટે જરૂરી નોંધો દૂર થઈ જાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳೀಯ ಡೇಟಾವನ್ನು ತೆರವುಗೊಳಿಸುವುದು ಹಿಂದಿನ ಬದಲಾವಣೆಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಲು ಅಗತ್ಯವಿರುವ ದಾಖಲೆಗಳನ್ನು ತೆಗೆದುಹಾಕುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രാദേശിക ഡാറ്റ മായ്ക്കുന്നത് മുൻ മാറ്റങ്ങൾ പുനഃസ്ഥാപിക്കാൻ ആവശ്യമായ രേഖകൾ നീക്കം ചെയ്യും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਥਾਨਕ ਡੇਟਾ ਸਾਫ਼ ਕਰਨ ਨਾਲ ਪਿਛਲੇ ਬਦਲਾਅ ਬਹਾਲ ਕਰਨ ਵਾਲੇ ਰਿਕਾਰਡ ਹਟ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al borrar los datos locales se eliminan los registros necesarios para restaurar cambios anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'effacement des données locales supprime les journaux nécessaires pour restaurer les modifications précédentes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen lokaler Daten entfernt die Einträge, die zur Wiederherstellung früherer Änderungen benötigt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar os dados locais remove os registros necessários para restaurar alterações anteriores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellare i dati locali rimuove i record necessari per ripristinare le modifiche precedenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルデータを消去すると、以前の変更を復元するための記録も削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데이터를 지우면 이전 변경 사항을 복원하는 데 필요한 기록이 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除本地数据将删除用于还原此前更改的记录。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистка локальных данных удалит записи, необходимые для восстановления прошлых изменений."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل مسح البيانات المحلية السجلات اللازمة لاستعادة التغييرات السابقة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניקוי הנתונים המקומיים מוחק את הרשומות הדרושות לשחזור שינויים קודמים."
          }
        }
      }
    },
