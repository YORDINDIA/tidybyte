    "Should have archived, not deleted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should have archived, not deleted"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने के बजाय आर्काइव करना चाहिए था"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মুছে না ফেলে আর্কাইভ করা উচিত ছিল"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீக்குவதற்குப் பதிலாக காப்பகப்படுத்தியிருக்க வேண்டும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తొలగించడానికి బదులుగా ఆర్కైవ్ చేసి ఉండాల్సింది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हटवण्याऐवजी संग्रहित करायला हवे होते"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કાઢી નાખવાને બદલે આર્કાઇવ કરવું જોઈતું હતું"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಳಿಸುವ ಬದಲು ಆರ್ಕೈವ್ ಮಾಡಬೇಕಿತ್ತು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇല്ലാതാക്കുന്നതിന് പകരം ആർക്കൈവ് ചെയ്യേണ്ടതായിരുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਟਾਉਣ ਦੀ ਬਜਾਏ ਆਰਕਾਈਵ ਕਰਨਾ ਚਾਹੀਦਾ ਸੀ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debía archivarse, no eliminarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aurait dû être archivé, pas supprimé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hätte archiviert, nicht gelöscht werden sollen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deveria ter arquivado, não apagado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Andava archiviato, non eliminato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除ではなくアーカイブすべきだった"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 대신 보관했어야 함"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应归档而非删除"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно было архивировать, а не удалять"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كان ينبغي أرشفته لا حذفه"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היה צריך לארכב, לא למחוק"
          }
        }
      }
    },
