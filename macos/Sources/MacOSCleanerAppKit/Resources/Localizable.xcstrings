    "Include System Photos Library": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include System Photos Library"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम फ़ोटो लाइब्रेरी शामिल करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম ফটো লাইব্রেরি অন্তর্ভুক্ত করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கணினி புகைப்பட நூலகத்தைச் சேர்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిస్టమ్ ఫోటోల లైబ్రరీని చేర్చండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम फोटो लायब्ररी समाविष्ट करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સિસ્ટમ ફોટો લાઇબ્રેરી સામેલ કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿಸ್ಟಮ್ ಫೋಟೋಗಳ ಲೈಬ್ರರಿಯನ್ನು ಸೇರಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിസ്റ്റം ഫോട്ടോസ് ലൈബ്രറി ഉൾപ്പെടുത്തുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਸਟਮ ਫੋਟੋ ਲਾਇਬ੍ਰੇਰੀ ਸ਼ਾਮਲ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir fototeca del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure la photothèque système"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemfotomediathek einbeziehen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir Fototeca do Sistema"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi libreria Foto di sistema"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム写真ライブラリを含める"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 사진 보관함 포함"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括系统照片图库"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить системную медиатеку Фото"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تضمين مكتبة صور النظام"
          }
        },
