    "No approved actions in the selected risk band to execute.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No approved actions in the selected risk band to execute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित जोखिम स्तर में निष्पादित करने के लिए कोई स्वीकृत क्रिया नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত ঝুঁকি স্তরে চালানোর মতো কোনো অনুমোদিত কাজ নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுத்த ஆபத்து நிலையில் இயக்க அங்கீகரிக்கப்பட்ட செயல்கள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న ప్రమాద స్థాయిలో అమలు చేయడానికి ఆమోదించబడిన చర్యలు లేవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "निवडलेल्या जोखीम पातळीत चालवण्यासाठी कोणतीही मंजूर क्रिया नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પસંદ કરેલ જોખમ સ્તરમાં ચલાવવા માટે કોઈ મંજૂર ક્રિયા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಅಪಾಯ ಮಟ್ಟದಲ್ಲಿ ಕಾರ್ಯಗತಗೊಳಿಸಲು ಅನುಮೋದಿತ ಕ್ರಿಯೆಗಳಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത അപകടസാധ്യതാ തലത്തിൽ നടപ്പാക്കാൻ അംഗീകരിച്ച പ്രവൃത്തികളില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚੁਣੇ ਜੋਖਮ ਪੱਧਰ ਵਿੱਚ ਚਲਾਉਣ ਲਈ ਕੋਈ ਮਨਜ਼ੂਰ ਕਾਰਵਾਈ ਨਹੀਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay acciones aprobadas para ejecutar en la banda de riesgo seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune action approuvée à exécuter dans ce niveau de risque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine genehmigten Aktionen im gewählten Risikobereich zum Ausführen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ação aprovada na faixa de risco selecionada para executar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna azione approvata da eseguire nella fascia di rischio selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したリスク区分に実行可能な承認済みアクションがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 위험 수준에 실행할 승인된 작업이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选风险等级中没有可执行的高批准操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В выбранной категории риска нет одобренных действий для выполнения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إجراءات معتمدة لتنفيذها في نطاق الخطورة المحدد."
          }
        },
        "he": {
          "stringUnit": {
