    "APFS Clone Fold (no deletion, undoable)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS Clone Fold (no deletion, undoable)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS क्लोन समेकन (कोई हटाव नहीं, पूर्ववत करने योग्य)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ক্লোন ভাঁজ (মুছে ফেলা নয়, পূর্বাবস্থায় ফেরানো যায়)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS குளோன் மடிப்பு (நீக்கம் இல்லை, திரும்பப் பெறக்கூடியது)"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS క్లోన్ ఫోల్డ్ (తొలగింపు లేదు, రద్దు చేయవచ్చు)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS क्लोन एकत्रीकरण (हटवले जात नाही, पूर्ववत करता येते)"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ક્લોન ફોલ્ડ (કોઈ કાઢી નાખવું નહીં, પૂર્વવત કરી શકાય)"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ಕ್ಲೋನ್ ಫೋಲ್ಡ್ (ಅಳಿಸುವಿಕೆಯಿಲ್ಲ, ರದ್ದುಮಾಡಬಹುದು)"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ക്ലോൺ ഫോൾഡ് (ഇല്ലാതാക്കലില്ല, പഴയപടിയാക്കാം)"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ਕਲੋਨ ਫੋਲਡ (ਕੋਈ ਮਿਟਾਉਣਾ ਨਹੀਂ, ਵਾਪਸ ਕੀਤਾ ਜਾ ਸਕਦਾ)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliegue de clon APFS (sin borrado, reversible)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupement de clones APFS (sans suppression, annulable)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS-Klon-Zusammenführung (ohne Löschen, widerrufbar)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Unificação por clone APFS (sem apagar, reversível)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unione clone APFS (nessuna eliminazione, annullabile)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS クローン統合（削除なし・取り消し可能）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 복제 통합 (삭제 없음, 실행 취소 가능)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 克隆折叠（不删除文件，可撤销）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединение клонов APFS (без удаления, обратимо)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طيّ نسخ APFS (دون حذف، قابل للتراجع)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיפול שכפול APFS (ללא מחיקה, ניתן לביטול)"
          }
        }
      }
    },
    "APFS clone folds and package-manager commands do not count toward the file-mutation byte cap.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS clone folds and package-manager commands do not count toward the file-mutation byte cap."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS क्लोन समेकन और पैकेज-प्रबंधक कमांड फ़ाइल-परिवर्तन बाइट सीमा में नहीं गिने जाते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ক্লোন ভাঁজ এবং প্যাকেজ-ম্যানেজার কমান্ড ফাইল-পরিবর্তন বাইট সীমার মধ্যে গণ্য হয় না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS குளோன் மடிப்புகளும் தொகுப்பு-மேலாளர் கட்டளைகளும் கோப்பு-மாற்ற பைட் வரம்பில் கணக்கிடப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS క్లోన్ ఫోల్డ్‌లు మరియు ప్యాకేజీ-మేనేజర్ కమాండ్‌లు ఫైల్-మార్పు బైట్ పరిమితిలో లెక్కించబడవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS क्लोन एकत्रीकरण आणि पॅकेज-मॅनेजर कमांड फाइल-बदल बाइट मर्यादेत मोजले जात नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ક્લોન ફોલ્ડ્સ અને પૅકેજ-મૅનેજર કમાન્ડ્સ ફાઇલ-ફેરફાર બાઇટ મર્યાદામાં ગણાતા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ಕ್ಲೋನ್ ಫೋಲ್ಡ್‌ಗಳು ಮತ್ತು ಪ್ಯಾಕೇಜ್-ಮ್ಯಾನೇಜರ್ ಆಜ್ಞೆಗಳು ಫೈಲ್-ಬದಲಾವಣೆ ಬೈಟ್ ಮಿತಿಗೆ ಸೇರುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ക്ലോൺ ഫോൾഡുകളും പാക്കേജ്-മാനേജർ കമാൻഡുകളും ഫയൽ-മാറ്റ ബൈറ്റ് പരിധിയിൽ കണക്കാക്കില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS ਕਲੋਨ ਫੋਲਡ ਅਤੇ ਪੈਕੇਜ-ਮੈਨੇਜਰ ਕਮਾਂਡਾਂ ਫਾਈਲ-ਬਦਲਾਅ ਬਾਈਟ ਸੀਮਾ ਵਿੱਚ ਨਹੀਂ ਗਿਣੀਆਂ ਜਾਂਦੀਆਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pliegues de clon APFS y los comandos de gestores de paquetes no cuentan para el límite de bytes de modificación de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les regroupements de clones APFS et les commandes de gestionnaires de paquets ne comptent pas dans la limite d'octets de modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS-Klon-Zusammenführungen und Paketmanager-Befehle zählen nicht zum Byte-Limit für Dateiänderungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Unificações por clone APFS e comandos de gerenciador de pacotes não entram no limite de bytes de modificação de arquivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le unioni di cloni APFS e i comandi dei gestori pacchetti non rientrano nel limite di byte per le modifiche ai file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS クローン統合とパッケージマネージャコマンドは、ファイル変更バイト数上限に算入されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 복제 통합과 패키지 관리자 명령은 파일 변경 바이트 한도에 포함되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 克隆折叠与包管理器命令不计入文件变更字节上限。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объединение клонов APFS и команды пакетных менеджеров не учитываются в лимите байтов изменения файлов."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُحتسب عمليات طيّ نسخ APFS وأوامر مديري الحزم ضمن حد بايتات تعديل الملفات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיפולי שכפול APFS ופקודות מנהלי חבילות אינם נספרים במגבלת הבתים לשינוי קבצים."
          }
        }
      }
    },
    "API base URL": {
      "extractionState": "manual",
