    "Keep at least one member of each group. Keep this item or undo an earlier decision.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep at least one member of each group. Keep this item or undo an earlier decision."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक समूह का कम से कम एक आइटम रखें। इस आइटम को रखें या पिछला निर्णय पूर्ववत करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি গ্রুপের অন্তত একটি সদস্য রাখুন। এই আইটেমটি রাখুন বা আগের সিদ্ধান্ত পূর্বাবস্থায় ফেরান।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு குழுவிலும் குறைந்தது ஒரு உறுப்பினரை வைத்திருக்கவும். இந்த உருப்படியை வைத்திருக்கவும் அல்லது முந்தைய முடிவைத் தவிர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి సమూహంలో కనీసం ఒక సభ్యుడిని ఉంచండి. ఈ అంశాన్ని ఉంచండి లేదా మునుపటి నిర్ణయాన్ని రద్దు చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक गटातील किमान एक सदस्य ठेवा. हा आयटम ठेवा किंवा मागील निर्णय पूर्ववत करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક જૂથનો ઓછામાં ઓછો એક સભ્ય રાખો. આ આઇટમ રાખો અથવા અગાઉનો નિર્ણય પૂર્વવત કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಗುಂಪಿನಲ್ಲಿ ಕನಿಷ್ಠ ಒಬ್ಬ ಸದಸ್ಯರನ್ನು ಇರಿಸಿ. ಈ ಐಟಂ ಅನ್ನು ಇರಿಸಿ ಅಥವಾ ಹಿಂದಿನ ನಿರ್ಧಾರವನ್ನು ರದ್ದುಗೊಳಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ഗ്രൂപ്പിലെയും കുറഞ്ഞത് ഒരു അംഗത്തെയെങ്കിലും നിലനിർത്തുക. ഈ ഇനം നിലനിർത്തുക അല്ലെങ്കിൽ മുമ്പത്തെ തീരുമാനം പഴയപടിയാക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਸਮੂਹ ਦਾ ਘੱਟੋ-ਘੱਟ ਇੱਕ ਮੈਂਬਰ ਰੱਖੋ। ਇਸ ਆਈਟਮ ਨੂੰ ਰੱਖੋ ਜਾਂ ਪਹਿਲਾਂ ਦਾ ਫੈਸਲਾ ਵਾਪਸ ਲਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva al menos un elemento de cada grupo. Conserva este elemento o deshaz una decisión anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez au moins un élément de chaque groupe. Conservez cet élément ou annulez une décision précédente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte mindestens ein Objekt pro Gruppe. Behalte dieses Objekt oder mache eine frühere Entscheidung rückgängig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ao menos um item de cada grupo. Mantenha este item ou desfaça uma decisão anterior."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva almeno un elemento di ciascun gruppo. Conserva questo elemento o annulla una decisione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループに少なくとも 1 つの項目を残してください。この項目を残すか、前の判断を取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 그룹마다 최소 하나의 항목을 남겨 두세요. 이 항목을 유지하거나 이전 결정을 실행 취소하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每组至少保留一个成员。请保留此项目或撤销早前的决定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте хотя бы один элемент в каждой группе. Оставьте этот объект или отмените прежнее решение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ عنصرًا واحدًا على الأقل في كل مجموعة. أبقِ هذا العنصر أو تراجع عن قرار سابق."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו על פריט אחד לפחות מכל קבוצה. שמרו פריט זה או בטלו החלטה קודמת."
          }
        }
      }
    },
