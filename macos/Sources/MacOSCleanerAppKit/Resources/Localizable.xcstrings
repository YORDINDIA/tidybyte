            "value": "বর্তমান কাজের পর কার্যকর করা বাতিল করা হচ্ছে…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போதைய செயலுக்குப் பிறகு செயல்படுத்தல் ரத்துசெய்யப்படுகிறது…"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రస్తుత చర్య తర్వాత అమలు రద్దు చేయబడుతోంది…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्याच्या क्रियेनंतर अंमलबजावणी रद्द करत आहे…"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વર્તમાન ક્રિયા પછી અમલ રદ થઈ રહ્યો છે…"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಸ್ತುತ ಕ್ರಿಯೆಯ ನಂತರ ಕಾರ್ಯಗತಗೊಳಿಸುವಿಕೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುತ್ತಿದೆ…"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിലവിലെ പ്രവൃത്തിക്ക് ശേഷം നടപ്പാക്കൽ റദ്ദാക്കുന്നു…"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੌਜੂਦਾ ਕਾਰਵਾਈ ਤੋਂ ਬਾਅਦ ਅਮਲ ਰੱਦ ਹੋ ਰਿਹਾ ਹੈ…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelando la ejecución tras la acción actual…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation de l'exécution après l'action en cours…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausführung wird nach der aktuellen Aktion abgebrochen…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelando execução após a ação atual…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullamento dell'esecuzione dopo l'azione corrente…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のアクション後に実行をキャンセルしています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업 이후 실행 취소 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前操作完成后将取消执行…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена выполнения после текущего действия…"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء التنفيذ بعد الإجراء الحالي…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבטל ביצוע לאחר הפעולה הנוכחית…"
          }
        }
      }
    },
