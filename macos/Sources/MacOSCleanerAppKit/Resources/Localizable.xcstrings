            "value": "Заменить и убрать Live Photo в Корзину"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال ونقل Live Photo إلى سلة المهملات"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלף והעבר Live Photo לפח"
          }
        }
      }
    },
