    "Reject and Save Never Rule": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reject and Save Never Rule"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
