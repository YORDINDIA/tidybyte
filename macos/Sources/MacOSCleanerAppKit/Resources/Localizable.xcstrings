    "Force quit %@?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force quit %@?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या %@ को जबरन बंद करें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে কি বাধ্যতামূলক বন্ধ করবেন?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐ வலுக்கட்டாயமாக நிறுத்தவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ను బలవంతంగా మూసివేయాలా?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सक्तीने बंद करायचे का?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું %@ ને ફોર્સ ક્વિટ કરવું?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಅನ್ನು ಬಲವಂತವಾಗಿ ಮುಚ್ಚುವುದೇ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ബലമായി നിർത്തണോ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ %@ ਨੂੰ ਜ਼ਬਰਦਸਤੀ ਬੰਦ ਕਰਨਾ ਹੈ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Forzar la salida de %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer %@ à quitter ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sofort beenden?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forçar encerramento de %@?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forzare la chiusura di %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を強制終了しますか？"
          }
