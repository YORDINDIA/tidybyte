        }
      }
    },
    "The plan changed. Review the current actions and confirm again.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan changed. Review the current actions and confirm again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना बदल गई है। वर्तमान क्रियाओं की समीक्षा करें और फिर से पुष्टि करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিকল্পনা পরিবর্তিত হয়েছে। বর্তমান কাজগুলো পর্যালোচনা করে আবার নিশ্চিত করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டம் மாறிவிட்டது. தற்போதைய செயல்களை மதிப்பாய்வு செய்து மீண்டும் உறுதிப்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రణాళిక మారింది. ప్రస్తుత చర్యలను సమీక్షించి మళ్లీ నిర్ధారించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना बदलली आहे. सध्याच्या क्रियांचे पुनरावलोकन करा आणि पुन्हा पुष्टी करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "યોજના બદલાઈ ગઈ. વર્તમાન ક્રિયાઓની સમીક્ષા કરી ફરી પુષ્ટિ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯೋಜನೆ ಬದಲಾಗಿದೆ. ಪ್ರಸ್ತುತ ಕ್ರಿಯೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತೆ ದೃಢೀಕರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്ലാൻ മാറി. നിലവിലെ പ്രവൃത്തികൾ അവലോകനം ചെയ്ത് വീണ്ടും സ്ഥിരീകരിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਯੋਜਨਾ ਬਦਲ ਗਈ ਹੈ। ਮੌਜੂਦਾ ਕਾਰਵਾਈਆਂ ਦੀ ਸਮੀਖਿਆ ਕਰਕੇ ਦੁਬਾਰਾ ਪੁਸ਼ਟੀ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan cambió. Revisa las acciones actuales y confirma de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan a changé. Examinez les actions actuelles et confirmez de nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan hat sich geändert. Prüfe die aktuellen Aktionen und bestätige erneut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano mudou. Revise as ações atuais e confirme novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano è cambiato. Esamina le azioni attuali e conferma di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランが変更されました。現在のアクションを確認して再度確定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획이 변경되었습니다. 현재 작업을 검토하고 다시 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划已变化。请审阅当前操作并重新确认。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "План изменился. Проверьте текущие действия и подтвердите повторно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت الخطة. راجع الإجراءات الحالية وأكد مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוכנית השתנתה. בדקו את הפעולות הנוכחיות ואשרו שוב."
          }
        }
      }
    },
    "The process is killed immediately. Unsaved work is lost.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The process is killed immediately. Unsaved work is lost."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोसेस तुरंत समाप्त कर दिया जाएगा। बिना सहेजा गया कार्य खो जाएगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রসেসটি তৎক্ষণাৎ বন্ধ করা হয়। সংরক্ষিত নয় এমন কাজ হারিয়ে যায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்முறை உடனடியாக நிறுத்தப்படும். சேமிக்காத வேலை இழக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రక్రియ వెంటనే ఆపివేయబడుతుంది. సేవ్ చేయని పని కోల్పోతుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रक्रिया ताबडतोब बंद केली जाते. जतन न केलेले काम गमावले जाते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પ્રક્રિયા તરત બંધ કરવામાં આવે છે. સાચવેલ ન હોય તેવું કામ ગુમાવાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಕ್ರಿಯೆಯನ್ನು ತಕ್ಷಣವೇ ನಿಲ್ಲಿಸಲಾಗುತ್ತದೆ. ಉಳಿಸದ ಕೆಲಸ ಕಳೆದುಹೋಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രോസസ്സ് ഉടൻ നിർത്തുന്നു. സംരക്ഷിക്കാത്ത ജോലി നഷ്ടമാകും."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਕਿਰਿਆ ਤੁਰੰਤ ਬੰਦ ਕੀਤੀ ਜਾਂਦੀ ਹੈ। ਨਾ ਸੰਭਾਲਿਆ ਕੰਮ ਗੁੰਮ ਹੋ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proceso se termina de inmediato. El trabajo sin guardar se pierde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le processus est arrêté immédiatement. Le travail non enregistré est perdu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prozess wird sofort beendet. Ungesicherte Arbeit geht verloren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O processo é encerrado imediatamente. Trabalho não salvo é perdido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il processo viene terminato immediatamente. Il lavoro non salvato andrà perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロセスを即座に終了します。保存されていない作業は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스가 즉시 종료됩니다. 저장하지 않은 작업은 손실됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将立即强制终止该进程。未保存的工作将会丢失。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процесс будет прерван немедленно. Несохраненные данные пропадут."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إنهاء العملية فورًا. يُفقد العمل غير المحفوظ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התהליך מופסק מיד. עבודה שלא נשמרה אובדת."
          }
        }
      }
    },
    "The selected folder no longer exists.": {
