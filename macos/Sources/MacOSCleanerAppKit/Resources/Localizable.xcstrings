            "state": "translated",
            "value": "Ejecutar limpieza de paquetes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer le nettoyage des paquets"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketbereinigung ausführen"
          }
        },
        "pt-BR": {
