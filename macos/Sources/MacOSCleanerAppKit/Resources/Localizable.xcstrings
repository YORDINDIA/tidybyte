          "stringUnit": {
            "state": "translated",
            "value": "Внимательно проверяйте облачные файлы"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع الملفات السحابية بعناية"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו קבצי ענן בקפידה"
          }
        }
      }
