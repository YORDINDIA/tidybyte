    "Install the app in /Applications to enable automatic maintenance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install the app in /Applications to enable automatic maintenance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित रखरखाव सक्षम करने के लिए ऐप को /Applications में इंस्टॉल करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয় রক্ষণাবেক্ষণ সক্রিয় করতে অ্যাপটি /Applications-এ ইনস্টল করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தானியங்கி பராமரிப்பை இயக்க செயலியை /Applications இல் நிறுவவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్వయంచాలక నిర్వహణను ప్రారంభించడానికి యాప్‌ను /Applications లో ఇన్‌స్టాల్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वयंचलित देखभाल सक्षम करण्यासाठी अ‍ॅप /Applications मध्ये इन्स्टॉल करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આપોઆપ જાળવણી સક્ષમ કરવા ઍપને /Applications માં ઇન્સ્ટૉલ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ವಯಂಚಾಲಿತ ನಿರ್ವಹಣೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಆ್ಯಪ್ ಅನ್ನು /Applications ನಲ್ಲಿ ಸ್ಥಾಪಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്വയമേവയുള്ള പരിപാലനം പ്രവർത്തനക്ഷമമാക്കാൻ ആപ്പ് /Applications-ൽ ഇൻസ്റ്റാൾ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਆਪ ਸਾਂਭ-ਸੰਭਾਲ ਸਮਰੱਥ ਕਰਨ ਲਈ ਐਪ ਨੂੰ /Applications ਵਿੱਚ ਇੰਸਟਾਲ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la app en /Applications para activar el mantenimiento automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez l'app dans /Applications pour activer la maintenance automatique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere die App in /Applications, um die automatische Wartung zu aktivieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o app em /Applications para ativar a manutenção automática."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa l'app in /Applications per abilitare la manutenzione automatica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動メンテナンスを有効にするには、アプリを /Applications にインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 유지 관리를 활성화하려면 앱을 /Applications에 설치하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将应用安装到 /Applications 以启用自动维护。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите приложение в /Applications, чтобы включить автоматическое обслуживание."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت التطبيق في /Applications لتفعيل الصيانة التلقائية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקינו את האפליקציה ב-/Applications כדי להפעיל תחזוקה אוטומטית."
          }
        }
      }
    },
