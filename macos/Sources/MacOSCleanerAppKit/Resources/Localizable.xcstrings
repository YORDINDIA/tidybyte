    "Move to Trash (recoverable 30 days)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move to Trash (recoverable 30 days)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश में भेजें (30 दिनों तक पुनर्प्राप्ति योग्य)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাশে পাঠান (30 দিন পর্যন্ত পুনরুদ্ধারযোগ্য)"
          }
