            }
          }
        },
        "pa": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ਪ੍ਰਮਾਣਿਤ ਸਥਿਰ ਫੋਟੋਆਂ ਬਣਾਉਂਦਾ ਹੈ ਅਤੇ %lld ਮੂਲ Live Photo ਨੂੰ ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਵਿੱਚ ਭੇਜਦਾ ਹੈ, ਲਗਭਗ %@ ਥਾਂ ਖਾਲੀ ਕਰਦਾ ਹੈ।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ਪ੍ਰਮਾਣਿਤ ਸਥਿਰ ਫੋਟੋਆਂ ਬਣਾਉਂਦਾ ਹੈ ਅਤੇ %lld ਮੂਲ Live Photos ਨੂੰ ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਵਿੱਚ ਭੇਜਦਾ ਹੈ, ਲਗਭਗ %@ ਥਾਂ ਖਾਲੀ ਕਰਦਾ ਹੈ।"
                }
              }
            }
          }
        },
