    "Need at least two scans to compare.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need at least two scans to compare."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुलना के लिए कम से कम दो स्कैन आवश्यक हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুলনা করতে অন্তত দুটি স্ক্যান প্রয়োজন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒப்பிட குறைந்தது இரண்டு ஸ்கேன்கள் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సరిపోల్చడానికి కనీసం రెండు స్కాన్లు అవసరం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुलना करण्यासाठी किमान दोन स्कॅन आवश्यक आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરખામણી કરવા ઓછામાં ઓછા બે સ્કૅન જરૂરી છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೋಲಿಸಲು ಕನಿಷ್ಠ ಎರಡು ಸ್ಕ್ಯಾನ್‌ಗಳು ಅಗತ್ಯವಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "താരതമ്യം ചെയ്യാൻ കുറഞ്ഞത് രണ്ട് സ്കാനുകളെങ്കിലും ആവശ്യമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਲਨਾ ਕਰਨ ਲਈ ਘੱਟੋ-ਘੱਟ ਦੋ ਸਕੈਨ ਜ਼ਰੂਰੀ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan al menos dos análisis para comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins deux analyses sont nécessaires pour comparer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einen Vergleich sind mindestens zwei Scans nötig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessárias ao menos duas análises para comparar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono almeno due scansioni per confrontare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較するには少なくとも 2 回のスキャンが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교하려면 최소 두 번의 스캔이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要两次扫描才能进行对比。"
          }
        },
