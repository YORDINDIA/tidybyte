    "Nothing to undo. No completed cleanup operations yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to undo. No completed cleanup operations yet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ववत करने के लिए कुछ नहीं है। अभी तक कोई क्लीनअप प्रक्रिया पूरी नहीं हुई।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্বাবস্থায় ফেরানোর কিছু নেই। এখনও কোনো ক্লিনআপ কাজ সম্পন্ন হয়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்தவிர்க்க எதுவும் இல்லை. இன்னும் முடிந்த சுத்திகரிப்பு செயல்கள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రద్దు చేయడానికి ఏమీ లేదు. ఇంకా పూర్తయిన శుభ్రత చర్యలు లేవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ववत करण्यासारखे काही नाही. अद्याप कोणतीही क्लीनअप क्रिया पूर्ण झालेली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્વવત કરવા જેવું કંઈ નથી. હજી સુધી કોઈ ક્લીનઅપ ક્રિયા પૂર્ણ થઈ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರದ್ದುಗೊಳಿಸಲು ಏನೂ ಇಲ್ಲ. ಇನ್ನೂ ಯಾವುದೇ ಸ್ವಚ್ಛತಾ ಕ್ರಿಯೆಗಳು ಪೂರ್ಣಗೊಂಡಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പഴയപടിയാക്കാൻ ഒന്നുമില്ല. ഇതുവരെ വൃത്തിയാക്കൽ പ്രവൃത്തികളൊന്നും പൂർത്തിയായിട്ടില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਾਪਸ ਕਰਨ ਲਈ ਕੁਝ ਨਹੀਂ। ਅਜੇ ਕੋਈ ਸਫਾਈ ਕਾਰਵਾਈ ਪੂਰੀ ਨਹੀਂ ਹੋਈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que deshacer. Aún no hay operaciones de limpieza completadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à annuler. Aucune opération de nettoyage terminée pour le moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts rückgängig zu machen. Noch keine abgeschlossenen Bereinigungen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
