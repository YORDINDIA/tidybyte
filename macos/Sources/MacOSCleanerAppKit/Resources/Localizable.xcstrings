    "Choose the %@ folder to grant access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the %@ folder to grant access."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति देने के लिए “%@” फ़ोल्डर चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাক্সেস দিতে “%@” ফোল্ডার বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அணுகலை வழங்க “%@” கோப்புறையைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాక్సెస్ ఇవ్వడానికి “%@” ఫోల్డర్ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रवेश देण्यासाठी “%@” फोल्डर निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઍક્સેસ આપવા માટે “%@” ફોલ્ડર પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರವೇಶ ನೀಡಲು “%@” ಫೋಲ್ಡರ್ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
