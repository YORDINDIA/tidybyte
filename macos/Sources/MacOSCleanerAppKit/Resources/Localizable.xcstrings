    "Finds caches, leftovers, duplicates, and large files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds caches, leftovers, duplicates, and large files."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैश, बचे अंश, डुप्लिकेट और बड़ी फ़ाइलें खोजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাশ, অবশিষ্টাংশ, ডুপ্লিকেট এবং বড় ফাইল খুঁজে বের করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேச்கள், எஞ்சியவை, நகல்கள் மற்றும் பெரிய கோப்புகளைக் கண்டறியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్యాష్‌లు, అవశేషాలు, నకిలీలు మరియు పెద్ద ఫైళ్లను కనుగొంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅशे, अवशेष, डुप्लिकेट्स आणि मोठ्या फाइल्स शोधतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૅશ, અવશેષો, ડુપ્લિકેટ્સ અને મોટી ફાઇલો શોધે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಯಾಶ್‌ಗಳು, ಉಳಿಕೆಗಳು, ನಕಲಿಗಳು ಮತ್ತು ದೊಡ್ಡ ಫೈಲ್‌ಗಳನ್ನು ಹುಡುಕುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്യാഷുകൾ, അവശിഷ്ടങ്ങൾ, ഡ്യൂപ്ലിക്കേറ്റുകൾ, വലിയ ഫയലുകൾ എന്നിവ കണ്ടെത്തുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਸ਼, ਬਚੀ ਸਮੱਗਰੀ, ਡੁਪਲੀਕੇਟ ਅਤੇ ਵੱਡੀਆਂ ਫਾਈਲਾਂ ਲੱਭਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra cachés, sobras, duplicados y archivos grandes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détecte caches, résidus, doublons et fichiers volumineux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet Caches, Reste, Duplikate und große Dateien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontra caches, sobras, duplicatas e arquivos grandes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova cache, residui, duplicati e file grandi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュ、残存データ、重複、大容量ファイルを検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시, 잔여 파일, 중복 파일 및 대용량 파일을 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找缓存、残留文件、重复项及大文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит кэши, остатки приложений, дубликаты и крупные файлы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعثر على الذاكرة المؤقتة والبقايا والملفات المكررة والكبيرة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאתר מטמונים, שאריות, כפולים וקבצים גדולים."
          }
        }
      }
    },
    "Finish the current operation first, then try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the current operation first, then try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले चल रही क्रिया पूरी होने दें, फिर पुनः प्रयास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে চলমান কাজটি শেষ হতে দিন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் தற்போதைய செயல் முடியட்டும், பின்னர் மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందుగా ప్రస్తుత చర్య పూర్తి కానివ్వండి, ఆపై మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रथम सध्याची क्रिया पूर्ण होऊ द्या, नंतर पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પહેલાં ચાલુ ક્રિયા પૂર્ણ થવા દો, પછી ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೊದಲು ಪ್ರಸ್ತುತ ಕ್ರಿಯೆ ಮುಗಿಯಲಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യം നിലവിലെ പ്രവൃത്തി പൂർത്തിയാകട്ടെ, എന്നിട്ട് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਹਿਲਾਂ ਚੱਲ ਰਹੀ ਕਾਰਵਾਈ ਪੂਰੀ ਹੋਣ ਦਿਓ, ਫਿਰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina primero la operación actual e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez d'abord l'opération en cours, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst den laufenden Vorgang beenden, dann erneut versuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a operação atual primeiro e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa prima l'operazione in corso, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の操作を完了してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업을 먼저 마친 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成当前操作，然后再试。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала дождитесь завершения текущей операции и повторите попытку."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ العملية الحالية أولًا ثم حاول مجددًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השלימו קודם את הפעולה הנוכחית ונסו שוב."
          }
        }
      }
    },
