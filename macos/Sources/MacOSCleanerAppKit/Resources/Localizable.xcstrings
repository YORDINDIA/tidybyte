        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء لعرضه بعد. شغّل فحصًا أو امسح فلتر الاسم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מה להציג עדיין. הפעילו סריקה או נקו את מסנן השם."
