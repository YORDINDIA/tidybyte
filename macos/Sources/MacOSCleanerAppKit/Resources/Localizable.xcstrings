            "value": "স্ক্যান বা কার্যকর চলাকালীন এক্সপোর্ট করা যাবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் அல்லது செயல்படுத்தல் நடக்கும்போது ஏற்றுமதி செய்ய முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ లేదా అమలు జరుగుతున్నప్పుడు ఎగుమతి చేయలేము."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन किंवा अंमलबजावणी सुरू असताना निर्यात करता येत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન અથવા અમલ ચાલુ હોય ત્યારે નિકાસ કરી શકાતી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಅಥವಾ ಕಾರ್ಯಗತಗೊಳಿಸುವಿಕೆ ನಡೆಯುತ್ತಿರುವಾಗ ರಫ್ತು ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ അല്ലെങ്കിൽ നടപ്പാക്കൽ തുടരുമ്പോൾ എക്സ്പോർട്ട് ചെയ്യാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਜਾਂ ਅਮਲ ਦੌਰਾਨ ਨਿਰਯਾਤ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede exportar mientras haya un análisis o ejecución en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'exporter pendant qu'une analyse ou une exécution est en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Export nicht möglich, während ein Scan oder eine Ausführung läuft."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível exportar enquanto houver uma análise ou execução em andamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile esportare mentre è in corso una scansione o un'esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンまたは実行中は書き出しできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔이나 실행이 진행 중일 때는 내보낼 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描或执行进行期间无法导出。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт невозможен во время сканирования или выполнения."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التصدير أثناء وجود فحص أو تنفيذ قيد التقدم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לייצא בזמן שסריקה או ביצוע פעילים."
          }
        }
      }
