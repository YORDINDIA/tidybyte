        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রত্যাখ্যান করুন এবং 'কখনো নয়' নিয়ম সংরক্ষণ করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிராகரித்து 'ஒருபோதும் இல்லை' விதியைச் சேமி"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తిరస్కరించి 'ఎప్పుడూ కాదు' నియమాన్ని సేవ్ చేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
