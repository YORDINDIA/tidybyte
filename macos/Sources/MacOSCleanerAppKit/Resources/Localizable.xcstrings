    "Start a scan to browse files and storage.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a scan to browse files and storage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें और स्टोरेज देखने के लिए स्कैन शुरू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল ও স্টোরেজ ব্রাউজ করতে একটি স্ক্যান শুরু করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புகளையும் சேமிப்பகத்தையும் உலாவ ஸ்கேன் தொடங்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైళ్లు మరియు స్టోరేజ్ బ్రౌజ్ చేయడానికి స్కాన్ ప్రారంభించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल्स आणि स्टोरेज पाहण्यासाठी स्कॅन सुरू करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલો અને સ્ટોરેજ જોવા સ્કૅન શરૂ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ಗಳು ಮತ್ತು ಸಂಗ್ರಹಣೆಯನ್ನು ಬ್ರೌಸ್ ಮಾಡಲು ಸ್ಕ್ಯಾನ್ ಪ್ರಾರಂಭಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലുകളും സ്റ്റോറേജും ബ്രൗസ് ചെയ്യാൻ സ്കാൻ ആരംഭിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਾਈਲਾਂ ਅਤੇ ਸਟੋਰੇਜ ਵੇਖਣ ਲਈ ਸਕੈਨ ਸ਼ੁਰੂ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un análisis para explorar archivos y almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une analyse pour parcourir les fichiers et le stockage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte einen Scan, um Dateien und Speicherplatz zu durchsuchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma análise para navegar pelos arquivos e armazenamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una scansione per esplorare file e archivio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルとストレージを確認するにはスキャンを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일과 저장 공간을 탐색하려면 스캔을 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始扫描即可浏览文件与存储占用情况。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите сканирование для просмотра файлов и объема."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ فحصًا لاستعراض الملفات والتخزين."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחילו סריקה לעיון בקבצים ובאחסון."
          }
        }
      }
    },
