              }
            }
          }
        },
        "ta": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld செயலுக்கான முடிவைப் புதுப்பிக்கவும். எந்தக் கோப்பும் மாறாது."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld செயல்களுக்கான முடிவுகளைப் புதுப்பிக்கவும். எந்தக் கோப்பும் மாறாது."
                }
              }
            }
          }
        },
        "te": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld చర్యకు నిర్ణయాన్ని అప్‌డేట్ చేయండి. ఏ ఫైళ్లూ మారవు."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld చర్యలకు నిర్ణయాలను అప్‌డేట్ చేయండి. ఏ ఫైళ్లూ మారవు."
                }
              }
            }
          }
        },
        "mr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld क्रियेसाठी निर्णय अपडेट करा. कोणतीही फाइल बदलणार नाही."
