    "Drag into the Full Disk Access list": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag into the Full Disk Access list"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण डिस्क पहुँच सूची में खींचकर छोड़ें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পূর্ণ ডিস্ক অ্যাক্সেস তালিকায় টেনে আনুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழு வட்டு அணுகல் பட்டியலில் இழுத்து விடவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తి డిస్క్ యాక్సెస్ జాబితాలోకి లాగండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण डिस्क प्रवेश सूचीमध्ये ड्रॅग करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સંપૂર્ણ ડિસ્ક ઍક્સેસ યાદીમાં ખેંચો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೂರ್ಣ ಡಿಸ್ಕ್ ಪ್ರವೇಶ ಪಟ್ಟಿಗೆ ಎಳೆಯಿರಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൂർണ്ണ ഡിസ്ക് ആക്സസ് പട്ടികയിലേക്ക് വലിച്ചിടുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੂਰੀ ਡਿਸਕ ਪਹੁੰਚ ਸੂਚੀ ਵਿੱਚ ਖਿੱਚੋ"
          }
        },
        "es": {
