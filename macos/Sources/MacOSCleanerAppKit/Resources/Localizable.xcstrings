        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਸਵੀਕਾਰ ਕਰੋ ਅਤੇ 'ਕਦੇ ਨਹੀਂ' ਨਿਯਮ ਸੰਭਾਲੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechazar y guardar regla Nunca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeter et enregistrer la règle Jamais"
          }
        },
        "de": {
