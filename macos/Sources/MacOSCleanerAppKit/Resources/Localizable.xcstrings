    "Playing or recording now": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playing or recording now"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी चल रहा है या रिकॉर्ड हो रहा है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখন চলছে বা রেকর্ড হচ্ছে"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போது இயங்குகிறது அல்லது பதிவு செய்கிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇప్పుడు ప్లే అవుతోంది లేదా రికార్డ్ చేస్తోంది"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सध्या सुरू किंवा रेकॉर्डिंग करत आहे"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અત્યારે ચાલી રહ્યું છે અથવા રેકોર્ડ થઈ રહ્યું છે"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈಗ ಪ್ಲೇ ಆಗುತ್ತಿದೆ ಅಥವಾ ರೆಕಾರ್ಡ್ ಆಗುತ್ತಿದೆ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇപ്പോൾ പ്ലേ ചെയ്യുന്നു അല്ലെങ്കിൽ റെക്കോർഡ് ചെയ്യുന്നു"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੁਣ ਚੱਲ ਰਿਹਾ ਜਾਂ ਰਿਕਾਰਡ ਹੋ ਰਿਹਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduciendo o grabando ahora"
          }
        },
