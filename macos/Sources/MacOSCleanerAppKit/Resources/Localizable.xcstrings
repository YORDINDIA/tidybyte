    "Select an action to inspect it. Approval is a separate step.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an action to inspect it. Approval is a separate step."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँच करने के लिए कोई क्रिया चुनें। स्वीकृति एक अलग चरण है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরীক্ষা করতে একটি কাজ নির্বাচন করুন। অনুমোদন একটি আলাদা ধাপ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சரிபார்க்க ஒரு செயலைத் தேர்ந்தெடுக்கவும். அங்கீகாரம் என்பது தனிப்படியாகும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పరిశీలించడానికి ఒక చర్యను ఎంచుకోండి. ఆమోదం వేరే దశ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तपासण्यासाठी एक क्रिया निवडा. मंजुरी ही स्वतंत्र पायरी आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તપાસવા માટે કોઈ ક્રિયા પસંદ કરો. મંજૂરી એક અલગ પગલું છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರಿಶೀಲಿಸಲು ಕ್ರಿಯೆಯನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಅನುಮೋದನೆ ಪ್ರತ್ಯೇಕ ಹಂತವಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരിശോധിക്കാൻ ഒരു പ്രവൃത്തി തിരഞ്ഞെടുക്കുക. അംഗീകാരം ഒരു പ്രത്യേക ഘട്ടമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਾਂਚਣ ਲਈ ਕੋਈ ਕਾਰਵਾਈ ਚੁਣੋ। ਮਨਜ਼ੂਰੀ ਇੱਕ ਵੱਖਰਾ ਕਦਮ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una acción para inspeccionarla. Aprobarla es un paso aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une action pour l'inspecter. L'approbation est une étape distincte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Aktion zur Prüfung aus. Die Genehmigung erfolgt in einem eigenen Schritt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma ação para inspecionar. A aprovação é uma etapa separada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un'azione per ispezionarla. L'approvazione è un passaggio separato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容を確認するアクションを選択してください。承認は別ステップです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할 작업을 선택하세요. 승인은 별도의 단계입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一项操作以查看详情。批准是单独的步骤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите действие для проверки. Одобрение выполняется отдельно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد إجراءً لفحصه. الاعتماد خطوة منفصلة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו פעולה כדי לבדוק אותה. אישור הוא שלב נפרד."
          }
        }
      }
    },
    "Select an app to see its details.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an app to see its details."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विवरण देखने के लिए कोई ऐप चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিস্তারিত দেখতে একটি অ্যাপ নির্বাচন করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விவரங்களைப் பார்க்க ஒரு செயலியைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వివరాలు చూడటానికి ఒక యాప్ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तपशील पाहण्यासाठी एक अ‍ॅप निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વિગતો જોવા માટે કોઈ ઍપ પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿವರಗಳನ್ನು ನೋಡಲು ಆ್ಯಪ್ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വിശദാംശങ്ങൾ കാണാൻ ഒരു ആപ്പ് തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੇਰਵੇ ਵੇਖਣ ਲਈ ਕੋਈ ਐਪ ਚੁਣੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una app para ver sus detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une app pour voir ses détails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine App aus, um Details anzuzeigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um app para ver seus detalhes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un'app per vederne i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細を表示するにはアプリを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세부 정보를 보려면 앱을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个应用以查看详情。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите приложение, чтобы увидеть подробности."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد تطبيقًا لعرض تفاصيله."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו אפליקציה לצפייה בפרטיה."
          }
        }
      }
    },
