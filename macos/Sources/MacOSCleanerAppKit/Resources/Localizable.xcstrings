    "Nothing changes until you approve it in Leftovers and confirm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes until you approve it in Leftovers and confirm."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवशेष में आपकी स्वीकृति और पुष्टि होने तक कुछ नहीं बदलता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবশিষ্টাংশে আপনি অনুমোদন ও নিশ্চিত না করা পর্যন্ত কিছুই পরিবর্তিত হয় না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எஞ்சியவைகளில் நீங்கள் அங்கீகரித்து உறுதிப்படுத்தும் வரை எதுவும் மாறாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అవశేషాలలో మీరు ఆమోదించి నిర్ధారించే వరకు ఏమీ మారదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अवशेषांमध्ये तुम्ही मंजुरी आणि पुष्टी करेपर्यंत काहीही बदलत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અવશેષોમાં તમે મંજૂરી અને પુષ્ટિ ન કરો ત્યાં સુધી કંઈ બદલાતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉಳಿಕೆಗಳಲ್ಲಿ ನೀವು ಅನುಮೋದಿಸಿ ದೃಢೀಕರಿಸುವವರೆಗೆ ಏನೂ ಬದಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവശിഷ്ടങ്ങളിൽ നിങ്ങൾ അംഗീകരിച്ച് സ്ഥിരീകരിക്കുന്നത് വരെ ഒന്നും മാറില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਚੀ ਸਮੱਗਰੀ ਵਿੱਚ ਤੁਹਾਡੀ ਮਨਜ਼ੂਰੀ ਅਤੇ ਪੁਸ਼ਟੀ ਤੱਕ ਕੁਝ ਨਹੀਂ ਬਦਲਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada cambia hasta que lo apruebes en Sobras y lo confirmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change tant que vous ne l'approuvez pas dans Résidus et ne confirmez pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ändert sich, bis du es unter „Reste“ genehmigst und bestätigst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda até você aprovar em Sobras e confirmar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla cambia finché non lo approvi in Residui e confermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「残存データ」で承認して確定するまで何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔여 파일에서 승인하고 확인할 때까지 아무것도 변경되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“残留文件”中批准并确认前，不会更改任何内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не изменится, пока вы не одобрите в «Остатках» и не подтвердите."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتغير شيء حتى توافق عليه في البقايا وتؤكد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דבר לא ישתנה עד שתאשרו זאת בשאריות."
          }
        }
      }
    },
