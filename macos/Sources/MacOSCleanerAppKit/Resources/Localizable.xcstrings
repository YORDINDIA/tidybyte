    "Full Disk Access is needed to measure the Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access is needed to measure the Trash."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश का आकार मापने के लिए पूर्ण डिस्क एक्सेस आवश्यक है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাশের আকার পরিমাপ করতে সম্পূর্ণ ডিস্ক অ্যাক্সেস প্রয়োজন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குப்பைத் தொட்டியை அளவிட முழு வட்டு அணுகல் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ట్రాష్‌ను కొలవడానికి పూర్తి డిస్క్ యాక్సెస్ అవసరం."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रॅश मोजण्यासाठी पूर्ण डिस्क प्रवेश आवश्यक आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ટ્રૅશ માપવા માટે સંપૂર્ણ ડિસ્ક ઍક્સેસ જરૂરી છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಟ್ರ್ಯಾಶ್ ಅನ್ನು ಅಳೆಯಲು ಪೂರ್ಣ ಡಿಸ್ಕ್ ಪ್ರವೇಶ ಅಗತ್ಯವಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ട്രാഷ് അളക്കാൻ പൂർണ്ണ ഡിസ്ക് ആക്സസ് ആവശ്യമാണ്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਰੈਸ਼ ਨੂੰ ਮਾਪਣ ਲਈ ਪੂਰੀ ਡਿਸਕ ਪਹੁੰਚ ਜ਼ਰੂਰੀ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso total al disco para medir el Basurero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès complet au disque est nécessaire pour mesurer la Corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Ermitteln der Papierkorbgröße ist Festplattenvollzugriff erforderlich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Acesso Total ao Disco é necessário para medir o Lixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario l'Accesso completo al disco per misurare il Cestino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱のサイズを計測するにはフルディスクアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통 크기를 측정하려면 전체 디스크 접근 권한이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要“完全磁盘访问权限”才能测量废纸篓大小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для определения размера Корзины требуется полный доступ к диску."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم الوصول الكامل إلى القرص لقياس حجم سلة المهملات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשת גישה מלאה לדיסק כדי למדוד את הפח."
          }
        }
      }
    },
