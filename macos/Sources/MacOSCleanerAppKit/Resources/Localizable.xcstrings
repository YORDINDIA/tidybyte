    "Blocked actions cannot run.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked actions cannot run."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवरुद्ध क्रियाएं नहीं चल सकतीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবরুদ্ধ কাজ চালানো যাবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தடுக்கப்பட்ட செயல்களை இயக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నిరోధించబడిన చర్యలు అమలు కావు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अवरोधित क्रिया चालू शकत नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અવરોધિત ક્રિયાઓ ચાલી શકતી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿರ್ಬಂಧಿಸಿದ ಕ್ರಿಯೆಗಳು ನಡೆಯುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തടഞ്ഞ പ്രവൃത്തികൾ പ്രവർത്തിക്കില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰੋਕੀਆਂ ਕਾਰਵਾਈਆਂ ਨਹੀਂ ਚੱਲ ਸਕਦੀਆਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones bloqueadas no pueden ejecutarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions bloquées ne peuvent pas être exécutées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockierte Aktionen können nicht ausgeführt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações bloqueadas não podem ser executadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni bloccate non possono essere eseguite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックされたアクションは実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단된 작업은 실행할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已阻止的操作无法运行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокированные действия выполнить нельзя."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تشغيل الإجراءات المحظورة."
