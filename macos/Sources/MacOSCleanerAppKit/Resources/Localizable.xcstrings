    "Optional AI features are off by default and send data only to the provider you configure.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional AI features are off by default and send data only to the provider you configure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक AI सुविधाएँ डिफ़ॉल्ट रूप से बंद रहती हैं और केवल आपके द्वारा कॉन्फ़िगर किए गए प्रदाता को डेटा भेजती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক AI বৈশিষ্ট্যগুলো ডিফল্টরূপে বন্ধ থাকে এবং শুধুমাত্র আপনার নির্ধারিত প্রদানকারীর কাছে ডেটা পাঠায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருப்ப AI அம்சங்கள் இயல்பாக முடக்கத்தில் இருக்கும், மேலும் நீங்கள் அமைக்கும் வழங்குநருக்கு மட்டுமே தரவை அனுப்பும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఐచ్ఛిక AI ఫీచర్లు డిఫాల్ట్‌గా ఆఫ్‌లో ఉంటాయి మరియు మీరు కాన్ఫిగర్ చేసిన ప్రొవైడర్‌కు మాత్రమే డేటా పంపుతాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्यायी AI वैशिष्ट्ये डीफॉल्टनुसार बंद असतात आणि केवळ तुम्ही कॉन्फिगर केलेल्या प्रदात्याला डेटा पाठवतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૈકલ્પિક AI સુવિધાઓ ડિફૉલ્ટ રૂપે બંધ રહે છે અને માત્ર તમે કૉન્ફિગર કરેલ પ્રદાતાને જ ડેટા મોકલે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐಚ್ಛಿಕ AI ವೈಶಿಷ್ಟ್ಯಗಳು ಡೀಫಾಲ್ಟ್ ಆಗಿ ಆಫ್ ಆಗಿರುತ್ತವೆ ಮತ್ತು ನೀವು ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ ಪೂರೈಕೆದಾರರಿಗೆ ಮಾತ್ರ ಡೇಟಾ ಕಳುಹಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഐച്ഛിക AI സവിശേഷതകൾ ഡിഫോൾട്ടായി ഓഫാണ്, നിങ്ങൾ ക്രമീകരിച്ച ദാതാവിന് മാത്രമേ ഡാറ്റ അയയ്ക്കൂ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਕਲਪਿਕ AI ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਡਿਫੌਲਟ ਤੌਰ 'ਤੇ ਬੰਦ ਰਹਿੰਦੀਆਂ ਹਨ ਅਤੇ ਕੇਵਲ ਤੁਹਾਡੇ ਵੱਲੋਂ ਸੈੱਟ ਕੀਤੇ ਪ੍ਰਦਾਤਾ ਨੂੰ ਡੇਟਾ ਭੇਜਦੀਆਂ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones opcionales de IA están desactivadas por defecto y solo envían datos al proveedor que configures."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctions d'IA optionnelles sont désactivées par défaut et n'envoient des données qu'au fournisseur que vous configurez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale KI-Funktionen sind standardmäßig aus und senden Daten nur an den von dir konfigurierten Anbieter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recursos opcionais de IA vêm desativados por padrão e enviam dados apenas ao provedor configurado por você."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzioni IA opzionali sono disattive per impostazione predefinita e inviano dati solo al provider configurato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オプションの AI 機能はデフォルトでオフであり、設定したプロバイダにのみデータを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택적 AI 기능은 기본적으로 꺼져 있으며 사용자가 설정한 공급자에게만 데이터를 전송합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选 AI 功能默认关闭，仅向您配置的服务商发送数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дополнительные функции ИИ отключены по умолчанию и отправляют данные только выбранному вами поставщику."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزات الذكاء الاصطناعي الاختيارية متوقفة افتراضيًا ولا ترسل البيانات إلا للمزوّد الذي تعدّه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תכונות בינה מלאכותית אופציונליות כבויות כברירת מחדל ושולחות נתונים רק לספק שתגדירו."
          }
        }
      }
    },
    "Optional: tell Tidybyte why you want to restore it.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: tell Tidybyte why you want to restore it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक: Tidybyte को बताएँ कि आप इसे क्यों पुनर्स्थापित करना चाहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঐচ্ছিক: কেন আপনি এটি পুনরুদ্ধার করতে চান তা Tidybyte-কে বলুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "விருப்பம்: இதை ஏன் மீட்டெடுக்க விரும்புகிறீர்கள் என்பதை Tidybyte இடம் கூறவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఐచ్ఛికం: మీరు దీనిని ఎందుకు పునరుద్ధరించాలనుకుంటున్నారో Tidybyte కు చెప్పండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्यायी: तुम्हाला हे का पुनर्संचयित करायचे आहे ते Tidybyte ला सांगा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વૈકલ્પિક: તમે આ કેમ પુનઃસ્થાપિત કરવા માંગો છો તે Tidybyte ને જણાવો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಐಚ್ಛಿಕ: ನೀವು ಇದನ್ನು ಏಕೆ ಮರುಸ್ಥಾಪಿಸಲು ಬಯಸುತ್ತೀರಿ ಎಂದು Tidybyte ಗೆ ತಿಳಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഐച്ഛികം: എന്തുകൊണ്ടാണ് ഇത് പുനഃസ്ഥാപിക്കാൻ ആഗ്രഹിക്കുന്നതെന്ന് Tidybyte-നോട് പറയുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਿਕਲਪਿਕ: Tidybyte ਨੂੰ ਦੱਸੋ ਕਿ ਤੁਸੀਂ ਇਸਨੂੰ ਕਿਉਂ ਬਹਾਲ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: indica a Tidybyte por qué quieres restaurarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif : indiquez à Tidybyte pourquoi vous voulez le restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: Teile Tidybyte mit, warum du es wiederherstellen möchtest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: informe ao Tidybyte por que você deseja restaurá-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo: indica a Tidybyte perché vuoi ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意: 復元する理由を Tidybyte に伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항: 복원하려는 이유를 Tidybyte에 알려주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选：告诉 Tidybyte 您希望还原的原因。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно: укажите, почему вы хотите это восстановить."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختياري: أخبر Tidybyte بسبب رغبتك في الاستعادة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אופציונלי: ספרו ל-Tidybyte מדוע ברצונכם לשחזר."
          }
        }
      }
    },
