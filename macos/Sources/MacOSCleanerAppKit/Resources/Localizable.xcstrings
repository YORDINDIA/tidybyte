    "Review and approve proposed changes before applying them.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and approve proposed changes before applying them."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लागू करने से पहले प्रस्तावित बदलावों की समीक्षा करें और उन्हें स्वीकृत करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রয়োগের আগে প্রস্তাবিত পরিবর্তনগুলো পর্যালোচনা ও অনুমোদন করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்படுத்துவதற்கு முன் பரிந்துரைக்கப்பட்ட மாற்றங்களை மதிப்பாய்வு செய்து அங்கீகரிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వర్తింపజేసే ముందు ప్రతిపాదిత మార్పులను సమీక్షించి ఆమోదించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लागू करण्यापूर्वी प्रस्तावित बदलांचे पुनरावलोकन करा आणि मंजूर करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાગુ કરતાં પહેલાં પ્રસ્તાવિત ફેરફારોની સમીક્ષા અને મંજૂરી કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನ್ವಯಿಸುವ ಮೊದಲು ಪ್ರಸ್ತಾವಿತ ಬದಲಾವಣೆಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತು ಅನುಮೋದಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രയോഗിക്കുന്നതിന് മുമ്പ് നിർദ്ദേശിച്ച മാറ്റങ്ങൾ അവലോകനം ചെയ്ത് അംഗീകരിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਗੂ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਪ੍ਰਸਤਾਵਿਤ ਬਦਲਾਵਾਂ ਦੀ ਸਮੀਖਿਆ ਅਤੇ ਮਨਜ਼ੂਰੀ ਦਿਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa y aprueba los cambios propuestos antes de aplicarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez et approuvez les modifications proposées avant de les appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgeschlagene Änderungen vor dem Anwenden prüfen und genehmigen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise e aprove as alterações propostas antes de aplicá-las."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esamina e approva le modifiche proposte prima di applicarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用する前に、提案された変更を確認して承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용하기 전에 제안된 변경 사항을 검토하고 승인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用前审阅并批准建议的更改。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте и одобрите предложенные изменения перед применением."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع التغييرات المقترحة واعتمدها قبل تطبيقها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו ואשרו שינויים מוצעים לפני החלתם."
          }
        }
      }
    },
    "Review card for %@, %@": {
      "localizations": {
