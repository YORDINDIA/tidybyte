        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹುಡುಕಾಟಕ್ಕೆ ಯಾವುದೇ ಪ್ರಕ್ರಿಯೆಗಳು ಹೊಂದಿಕೆಯಾಗುವುದಿಲ್ಲ."
