    "Inbox creation canceled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbox creation canceled."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनबॉक्स बनाना रद्द किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনবক্স তৈরি বাতিল করা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்பாக்ஸ் உருவாக்கம் ரத்துசெய்யப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇన్‌బాక్స్ సృష్టి రద్దు చేయబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इनबॉक्स तयार करणे रद्द केले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇનબૉક્સ બનાવવાનું રદ કર્યું."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್‌ಬಾಕ್ಸ್ ರಚನೆ ರದ್ದಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇൻബോക്സ് സൃഷ്ടിക്കൽ റദ്ദാക്കി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਨਬਾਕਸ ਬਣਾਉਣਾ ਰੱਦ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creación de la carpeta de entrada cancelada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Création de la boîte de réception annulée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellung des Posteingangs abgebrochen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criação da caixa de entrada cancelada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creazione della cartella In arrivo annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信トレイの作成をキャンセルしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 파일함 생성이 취소되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
