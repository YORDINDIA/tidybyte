    "Temporary storage is in use. History will not persist after this session.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary storage is in use. History will not persist after this session."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्थायी स्टोरेज उपयोग में है। इस सत्र के बाद इतिहास सुरक्षित नहीं रहेगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অস্থায়ী স্টোরেজ ব্যবহৃত হচ্ছে। এই সেশনের পর ইতিহাস সংরক্ষিত থাকবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்காலிக சேமிப்பகம் பயன்பாட்டில் உள்ளது. இந்த அமர்வுக்குப் பிறகு வரலாறு நிலைக்காது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తాత్కాలిక స్టోరేజ్ ఉపయోగంలో ఉంది. ఈ సెషన్ తర్వాత చరిత్ర నిలిచి ఉండదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तात्पुरते स्टोरेज वापरात आहे. या सत्रानंतर इतिहास टिकणार नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અસ્થાયી સ્ટોરેજ વપરાશમાં છે. આ સત્ર પછી ઇતિહાસ રહેશે નહીં."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತಾತ್ಕಾಲಿಕ ಸಂಗ್ರಹಣೆ ಬಳಕೆಯಲ್ಲಿದೆ. ಈ ಸೆಷನ್ ನಂತರ ಇತಿಹಾಸ ಉಳಿಯುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "താൽക്കാലിക സ്റ്റോറേജ് ഉപയോഗത്തിലാണ്. ഈ സെഷന് ശേഷം ചരിത്രം നിലനിൽക്കില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਸਥਾਈ ਸਟੋਰੇਜ ਵਰਤੋਂ ਵਿੱਚ ਹੈ। ਇਸ ਸੈਸ਼ਨ ਤੋਂ ਬਾਅਦ ਇਤਿਹਾਸ ਨਹੀਂ ਰਹੇਗਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está usando almacenamiento temporal. El historial no se conservará tras esta sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un stockage temporaire est utilisé. L'historique ne sera pas conservé après cette session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporärer Speicher wird verwendet. Der Verlauf bleibt nach dieser Sitzung nicht erhalten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenamento temporário em uso. O histórico não persistirá após esta sessão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivio temporaneo in uso. La cronologia non persisterà dopo questa sessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時ストレージを使用中のため、履歴はこのセッション終了後に保持されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 저장소가 사용 중입니다. 이 세션이 끝나면 기록이 유지되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用临时存储。本次会话结束后历史记录将不会保留。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется временное хранилище. После этой сессии история не сохранится."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التخزين المؤقت قيد الاستخدام. لن يُحفظ السجل بعد هذه الجلسة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעשה שימוש באחסון זמני. ההיסטוריה לא תישמר לאחר הפעלה זו."
          }
        }
      }
    },
