    "Branches fanning out from your scan.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Branches fanning out from your scan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके स्कैन से निकलती शाखाएं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার স্ক্যান থেকে বিস্তৃত শাখাসমূহ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் ஸ்கேனிலிருந்து விரியும் கிளைகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ స్కాన్ నుండి విస్తరించే శాఖలు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या स्कॅनमधून पसरलेल्या शाखा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા સ્કૅનમાંથી વિસ્તરતી શાખાઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸ್ಕ್ಯಾನ್‌ನಿಂದ ಹರಡುವ ಶಾಖೆಗಳು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ സ്കാനിൽ നിന്ന് വികസിക്കുന്ന ശാഖകൾ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਸਕੈਨ ਤੋਂ ਫੈਲਦੀਆਂ ਸ਼ਾਖਾਵਾਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramas desplegadas desde tu análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branches déployées depuis votre analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzweigungen ausgehend von deinem Scan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramos partindo da sua análise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rami che si diramano dalla scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン結果から枝分かれして表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 결과에서 뻗어나가는 가지 형태."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从扫描根目录展开的分支。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ветви от корня вашего сканирования."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فروع متشعبة من الفحص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ענפים המתפצלים מתוך הסריקה."
          }
        }
      }
    },
