    "Prefer archiving": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer archiving"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्काइव को प्राथमिकता दें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আর্কাইভ করা অগ্রাধিকার দিন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "காப்பகப்படுத்துவதற்கு முன்னுரிமை அளி"
