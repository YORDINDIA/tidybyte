    "All selected approved actions completed.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All selected approved actions completed."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी चयनित स्वीकृत क्रियाएं पूरी हो गईं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব নির্বাচিত অনুমোদিত কাজ সম্পন্ন হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுக்கப்பட்ட அனைத்து அங்கீகரிக்கப்பட்ட செயல்களும் முடிந்தன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎంచుకున్న అన్ని ఆమోదించబడిన చర్యలు పూర్తయ్యాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्व निवडलेल्या मंजूर क्रिया पूर्ण झाल्या."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બધી પસંદ કરેલી મંજૂર ક્રિયાઓ પૂર્ણ થઈ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಯ್ಕೆಮಾಡಿದ ಎಲ್ಲಾ ಅನುಮೋದಿತ ಕ್ರಿಯೆಗಳು ಪೂರ್ಣಗೊಂಡಿವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരഞ്ഞെടുത്ത എല്ലാ അംഗീകരിച്ച പ്രവൃത്തികളും പൂർത്തിയായി."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੀਆਂ ਚੁਣੀਆਂ ਮਨਜ਼ੂਰ ਕਾਰਵਾਈਆਂ ਪੂਰੀਆਂ ਹੋਈਆਂ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se completaron todas las acciones aprobadas seleccionadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les actions approuvées sélectionnées sont terminées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ausgewählten genehmigten Aktionen abgeschlossen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as ações aprovadas selecionadas foram concluídas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le azioni approvate selezionate completate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した承認済みアクションがすべて完了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 승인 작업이 모두 완료되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有选定的已批准操作均已完成。"
          }
        },
