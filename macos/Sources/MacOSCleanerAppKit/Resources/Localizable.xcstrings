    "Undo Last Cleanup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo Last Cleanup"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछला क्लीनअप पूर्ववत करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ ক্লিনআপ পূর্বাবস্থায় ফেরান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடைசி சுத்திகரிப்பைச் செயல்தவிர்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చివరి శుభ్రతను రద్దు చేయండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील क्लीनअप पूर्ववत करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લો ક્લીનઅપ પૂર્વવત કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೊನೆಯ ಸ್ವಚ್ಛತೆಯನ್ನು ರದ್ದುಗೊಳಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവസാന വൃത്തിയാക്കൽ പഴയപടിയാക്കുക"
