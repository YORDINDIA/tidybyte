        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എല്ലാ സ്കാൻ ഫോൾഡറുകളും നീക്കം ചെയ്തു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਾਰੇ ਸਕੈਨ ਫੋਲਡਰ ਹਟਾਏ ਗਏ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitaron todas las carpetas de análisis."
          }
        },
        "fr": {
