        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 영구적으로 지웁니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久抹掉 %@。此操作不可撤销。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это окончательно сотрет %@. Отменить это действие будет невозможно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح هذا %@ نهائيًا. لا يمكنك التراجع عن هذا الإجراء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת לצמיתות את %@. לא ניתן לבטל פעולה זו."
