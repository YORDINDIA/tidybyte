    "Duplicate results appear when the scan finishes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate results appear when the scan finishes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन पूरा होने पर डुप्लिकेट परिणाम दिखेंगे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান শেষ হলে ডুপ্লিকেট ফলাফল দেখা যাবে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் முடிந்ததும் நகல் முடிவுகள் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ పూర్తయినప్పుడు నకిలీ ఫలితాలు కనిపిస్తాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन पूर्ण झाल्यावर डुप्लिकेट निकाल दिसतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન પૂર્ણ થાય ત્યારે ડુપ્લિકેટ પરિણામો દેખાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಪೂರ್ಣಗೊಂಡಾಗ ನಕಲಿ ಫಲಿತಾಂಶಗಳು ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ പൂർത്തിയാകുമ്പോൾ ഡ്യൂപ്ലിക്കേറ്റ് ഫലങ്ങൾ കാണാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਪੂਰਾ ਹੋਣ 'ਤੇ ਡੁਪਲੀਕੇਟ ਨਤੀਜੇ ਦਿਖਾਈ ਦੇਣਗੇ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de duplicados aparecen al finalizar el análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les doublons s'affichent à la fin de l'analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplikatergebnisse erscheinen, sobald der Scan abgeschlossen ist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados de duplicatas aparecem quando a análise termina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I duplicati appaiono al termine della scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンが完了すると重複結果が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔이 완료되면 중복 결과가 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描完成后将显示重复项结果。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты по дубликатам появятся после завершения сканирования."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر نتائج الملفات المكررة عند انتهاء الفحص."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוצאות הכפולים יופיעו עם סיום הסריקה."
          }
        }
      }
    },
