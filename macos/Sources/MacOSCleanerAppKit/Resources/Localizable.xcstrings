        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل تنظيف الحزم"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל ניקוי חבילות"
          }
        }
      }
    },
