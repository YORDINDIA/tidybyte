            "value": "ব্যবহারকারীর অ্যাপ, সিস্টেম ব্যাকগ্রাউন্ড বা সবকিছু দেখান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பயனர் செயலிகள், கணினி பின்னணி அல்லது அனைத்தையும் காட்டு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వినియోగదారు యాప్‌లు, సిస్టమ్ బ్యాక్‌గ్రౌండ్ లేదా అన్నీ చూపండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वापरकर्ता अ‍ॅप्स, सिस्टम पार्श्वभूमी किंवा सर्वकाही दाखवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "વપરાશકર્તા ઍપ્સ, સિસ્ટમ બૅકગ્રાઉન્ડ અથવા બધું બતાવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬಳಕೆದಾರ ಆ್ಯಪ್‌ಗಳು, ಸಿಸ್ಟಮ್ ಹಿನ್ನೆಲೆ ಅಥವಾ ಎಲ್ಲವನ್ನೂ ತೋರಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉപയോക്തൃ ആപ്പുകൾ, സിസ്റ്റം പശ്ചാത്തലം അല്ലെങ്കിൽ എല്ലാം കാണിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਰਤੋਂਕਾਰ ਐਪਸ, ਸਿਸਟਮ ਬੈਕਗ੍ਰਾਊਂਡ ਜਾਂ ਸਭ ਕੁਝ ਦਿਖਾਓ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar apps de usuario, procesos del sistema o todo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher les apps utilisateur, les tâches système ou tout"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzer-Apps, System-Hintergrundprozesse oder alles anzeigen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar apps do usuário, processos em segundo plano ou tudo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra app utente, processi di sistema o tutto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーアプリ、システムバックグラウンド、またはすべてを表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 앱, 시스템 백그라운드 또는 모두 보기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示用户应用、系统后台或全部项目"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать программы пользователя, фоновые службы или все"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار تطبيقات المستخدم أو عمليات النظام أو الكل"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג אפליקציות משתמש, רקע מערכת או הכל"
          }
        }
      }
    },
    "Showing %lld of %lld apps. Search to narrow the list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing %lld of %lld apps. Search to narrow the list."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld ऐप्स में से %1$lld दिखाए जा रहे हैं। सूची सीमित करने के लिए खोजें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lldটি অ্যাপের মধ্যে %1$lldটি দেখানো হচ্ছে। তালিকা ছোট করতে খুঁজুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld செயலிகளில் %1$lld காட்டப்படுகிறது. பட்டியலைச் சுருக்கத் தேடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld యాప్‌లలో %1$lld చూపుతోంది. జాబితాను తగ్గించడానికి శోధించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld अ‍ॅप्सपैकी %1$lld दाखवत आहे. यादी मर्यादित करण्यासाठी शोधा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld ઍપ્સમાંથી %1$lld બતાવે છે. યાદી સીમિત કરવા શોધો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld ಆ್ಯಪ್‌ಗಳಲ್ಲಿ %1$lld ತೋರಿಸಲಾಗುತ್ತಿದೆ. ಪಟ್ಟಿಯನ್ನು ಕುಗ್ಗಿಸಲು ಹುಡುಕಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld ആപ്പുകളിൽ %1$lld കാണിക്കുന്നു. പട്ടിക ചുരുക്കാൻ തിരയുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld ਐਪਸ ਵਿੱਚੋਂ %1$lld ਦਿਖਾ ਰਿਹਾ ਹੈ। ਸੂਚੀ ਸੀਮਤ ਕਰਨ ਲਈ ਖੋਜੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando %lld de %lld apps. Busca para acotar la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage de %lld sur %lld apps. Recherchez pour affiner la liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden %lld von %lld Apps angezeigt. Suche, um die Liste einzugrenzen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando %lld de %lld apps. Pesquise para filtrar a lista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrate %lld di %lld app. Cerca per restringere l'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 個のアプリのうち %1$lld 個を表示中。検索で絞り込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld개 앱 중 %1$lld개 표시 중. 검색하여 목록을 좁히세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在显示 %2$lld 个应用中的 %1$lld 个。搜索可缩小列表范围。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано %lld из %lld программ. Используйте поиск для фильтрации."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض %lld من %lld تطبيق. ابحث لتضييق القائمة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג %lld מתוך %lld אפליקציות. חפשו לצמצום הרשימה."
          }
        }
      }
    },
