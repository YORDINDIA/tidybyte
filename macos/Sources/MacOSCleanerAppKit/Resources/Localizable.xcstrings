            "value": "%@ இன் ZIP காப்பகத்தை உருவாக்கி, அசல்களைக் குப்பைத் தொட்டிக்கு அனுப்பு"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ యొక్క ZIP ఆర్కైవ్ సృష్టించి, అసలు ఫైళ్లను ట్రాష్‌లోకి పంపండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ चा ZIP संग्रह तयार करा, नंतर मूळ फाइल्स ट्रॅशमध्ये पाठवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ નો ZIP આર્કાઇવ બનાવો, પછી મૂળ ફાઇલો ટ્રૅશમાં મોકલો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ನ ZIP ಆರ್ಕೈವ್ ರಚಿಸಿ, ನಂತರ ಮೂಲಗಳನ್ನು ಟ್ರ್ಯಾಶ್‌ಗೆ ಕಳುಹಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ന്റെ ZIP ആർക്കൈവ് സൃഷ്ടിച്ച് യഥാർത്ഥ ഫയലുകൾ ട്രാഷിലേക്ക് അയയ്ക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ਦਾ ZIP ਆਰਕਾਈਵ ਬਣਾਓ, ਫਿਰ ਮੂਲ ਫਾਈਲਾਂ ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear archivo ZIP de %@ y luego mover originales al Basurero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une archive ZIP de %@, puis placer les originaux dans la Corbeille"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP-Archiv von %@ erstellen, dann Originale in den Papierkorb"
          }
        },
        "pt-BR": {
          "stringUnit": {
