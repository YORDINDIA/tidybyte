            "state": "translated",
            "value": "Tidybyte /Applications और ~/Applications की जाँच करता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte /Applications এবং ~/Applications পরীক্ষা করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidybyte /Applications மற்றும் ~/Applications ஆகியவற்றைச் சரிபார்க்கிறது."
          }
        },
        "te": {
