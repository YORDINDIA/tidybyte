    "Browse groups as cards, then drill in.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse groups as cards, then drill in."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूहों को कार्ड के रूप में देखें और गहराई में जाएं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কার্ড হিসেবে গ্রুপ দেখুন, তারপর গভীরে প্রবেশ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழுக்களை அட்டைகளாகப் பார்த்து, உள்ளே செல்லவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమూహాలను కార్డులుగా చూసి, లోపలికి వెళ్లండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गट कार्ड्सच्या स्वरूपात पहा, नंतर आत जा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જૂથોને કાર્ડ તરીકે જુઓ, પછી અંદર જાઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಗುಂಪುಗಳನ್ನು ಕಾರ್ಡ್‌ಗಳಾಗಿ ನೋಡಿ, ನಂತರ ಒಳಗೆ ಹೋಗಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഗ്രൂപ്പുകൾ കാർഡുകളായി കണ്ട് ഉള്ളിലേക്ക് പോകുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮੂਹਾਂ ਨੂੰ ਕਾਰਡਾਂ ਵਜੋਂ ਵੇਖੋ, ਫਿਰ ਅੰਦਰ ਜਾਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora los grupos en tarjetas y entra en detalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez les groupes sous forme de cartes puis explorez-les."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppen als Karten durchsuchen und eintauchen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue pelos grupos em cartões e entre neles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia i gruppi come schede, poi entra nei dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループをカード形式で閲覧し、詳細へ進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 카드로 탐색한 다음 자세히 살펴봅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以卡片形式浏览分组并深入查看。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте группы в виде карточек и открывайте детали."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفح المجموعات كبطاقات ثم تعمق فيها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עיינו בקבוצות ככרטיסיות ואז העמיקו פנימה."
          }
        }
      }
    },
    "Browse scanned files.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse scanned files."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन की गई फ़ाइलें ब्राउज़ करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান করা ফাইল ব্রাউজ করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் செய்த கோப்புகளை உலாவவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ చేసిన ఫైళ్లను బ్రౌజ్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन केलेल्या फाइल्स ब्राउझ करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન કરેલી ફાઇલો બ્રાઉઝ કરો."
          }
