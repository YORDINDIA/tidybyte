    "Compressed and replaced originals; saved %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressed and replaced originals; saved %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल आइटम कंप्रेस करके बदले गए; %@ की बचत हुई।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপ্রেস করে মূল ফাইল প্রতিস্থাপন করা হয়েছে; %@ সাশ্রয় হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கப்பட்டு அசல்கள் மாற்றப்பட்டன; %@ சேமிக்கப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదించి అసలు ఫైళ్లను భర్తీ చేశాము; %@ ఆదా అయింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेस करून मूळ फाइल्स बदलल्या; %@ वाचवले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેસ કરીને મૂળ ફાઇલો બદલી; %@ બચાવ્યા."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚಿಸಿ ಮೂಲ ಫೈಲ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲಾಗಿದೆ; %@ ಉಳಿತಾಯವಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രസ് ചെയ്ത് യഥാർത്ഥ ഫയലുകൾ മാറ്റി; %@ ലാഭിച്ചു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪ੍ਰੈਸ ਕਰਕੇ ਮੂਲ ਫਾਈਲਾਂ ਬਦਲੀਆਂ ਗਈਆਂ; %@ ਬਚਾਏ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Originales comprimidos y reemplazados; %@ ahorrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaux compressés et remplacés ; %@ économisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale komprimiert und ersetzt; %@ gespart."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Originais comprimidos e substituídos; %@ economizados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Originali compressi e sostituiti; %@ risparmiati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルを圧縮して置き換えました（%@ 削減）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본을 압축하여 대치했습니다(%@ 절감)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已压缩并替换原件；节省了 %@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригиналы сжаты и заменены; сэкономлено %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الضغط واستبدال الأصول؛ تم توفير %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המקורות כווצו והוחלפו; נחסכו %@."
          }
        }
      }
    },
