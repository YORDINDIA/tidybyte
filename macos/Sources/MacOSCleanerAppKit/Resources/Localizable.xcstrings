    "Removed %@ from the cleanup plan.": {
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed %@ from the cleanup plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को क्लीनअप योजना से हटाया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে ক্লিনআপ পরিকল্পনা থেকে সরানো হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ சுத்திகரிப்புத் திட்டத்திலிருந்து அகற்றப்பட்டது."
