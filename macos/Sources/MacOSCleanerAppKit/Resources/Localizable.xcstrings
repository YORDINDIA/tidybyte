    "Recover in Photos → Recently Deleted (normally 30 days)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover in Photos → Recently Deleted (normally 30 days)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो → हाल ही में हटाए गए में पुनर्प्राप्त करें (सामान्यतः 30 दिन)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফটো → সম্প্রতি মোছা থেকে পুনরুদ্ধার করুন (সাধারণত 30 দিন)"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படங்கள் → சமீபத்தில் நீக்கியவை இல் மீட்டெடுக்கவும் (பொதுவாக 30 நாட்கள்)"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటోలు → ఇటీవల తొలగించినవిలో పునరుద్ధరించండి (సాధారణంగా 30 రోజులు)"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोटो → अलीकडे हटवलेले मध्ये परत मिळवा (सामान्यतः 30 दिवस)"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટા → તાજેતરમાં કાઢી નાખેલા માંથી પાછું મેળવો (સામાન્ય રીતે 30 દિવસ)"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋಗಳು → ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವುನಲ್ಲಿ ಮರುಪಡೆಯಿರಿ (ಸಾಮಾನ್ಯವಾಗಿ 30 ದಿನಗಳು)"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോട്ടോസ് → അടുത്തിടെ ഇല്ലാതാക്കിയവയിൽ വീണ്ടെടുക്കുക (സാധാരണ 30 ദിവസം)"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫੋਟੋ → ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਤੋਂ ਬਹਾਲ ਕਰੋ (ਆਮ ਤੌਰ 'ਤੇ 30 ਦਿਨ)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar en Fotos → Recientemente eliminados (normalmente 30 días)"
          }
        },
        "fr": {
