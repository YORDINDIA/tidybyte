    "Approved. Review it in Proposed Actions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved. Review it in Proposed Actions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वीकृत। प्रस्तावित क्रियाओं में इसकी समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমোদিত। প্রস্তাবিত কাজ-এ এটি পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அங்கீகரிக்கப்பட்டது. பரிந்துரைக்கப்பட்ட செயல்களில் மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆమోదించబడింది. ప్రతిపాదిత చర్యలలో సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मंजूर केले. प्रस्तावित क्रियांमध्ये याचे पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મંજૂર. પ્રસ્તાવિત ક્રિયાઓમાં તેની સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅನುಮೋದಿಸಲಾಗಿದೆ. ಪ್ರಸ್ತಾವಿತ ಕ್ರಿಯೆಗಳಲ್ಲಿ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അംഗീകരിച്ചു. നിർദ്ദേശിച്ച പ്രവൃത്തികളിൽ അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਨਜ਼ੂਰ। ਪ੍ਰਸਤਾਵਿਤ ਕਾਰਵਾਈਆਂ ਵਿੱਚ ਇਸਦੀ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobada. Revísala en Acciones propuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvée. Examinez-la dans Actions proposées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmigt. Unter „Vorgeschlagene Aktionen“ prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovada. Revise em Ações propostas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approvata. Esaminala in Azioni proposte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認しました。「提案されたアクション」で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인되었습니다. 제안된 작업에서 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准。请在“建议操作”中查看。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрено. Проверьте в разделе «Предложенные действия»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاعتماد. راجعه في الإجراءات المقترحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אושר. בדקו זאת בפעולות מוצעות."
          }
        }
      }
    },
