            "state": "translated",
            "value": "Questo elimina definitivamente %@. Non puoi annullare questa azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を完全に消去します。この操作は取り消せません。"
