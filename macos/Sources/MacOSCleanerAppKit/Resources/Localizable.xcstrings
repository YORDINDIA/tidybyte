    "Similar photos, screenshots, and large videos.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Similar photos, screenshots, and large videos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समान फ़ोटो, स्क्रीनशॉट और बड़े वीडियो।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুরূপ ছবি, স্ক্রিনশট এবং বড় ভিডিও।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒத்த புகைப்படங்கள், ஸ்கிரீன்ஷாட்கள் மற்றும் பெரிய வீடியோக்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సారూప్య ఫోటోలు, స్క్రీన్షాట్లు మరియు పెద్ద వీడియోలు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "समान फोटो, स्क्रीनशॉट्स आणि मोठे व्हिडिओ."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમાન ફોટા, સ્ક્રીનશોટ્સ અને મોટા વિડિયો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೋಲುವ ಫೋಟೋಗಳು, ಸ್ಕ್ರೀನ್ಶಾಟ್‌ಗಳು ಮತ್ತು ದೊಡ್ಡ ವೀಡಿಯೊಗಳು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സമാന ഫോട്ടോകൾ, സ്ക്രീൻഷോട്ടുകൾ, വലിയ വീഡിയോകൾ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਿਲਦੀਆਂ-ਜੁਲਦੀਆਂ ਫੋਟੋਆਂ, ਸਕ੍ਰੀਨਸ਼ਾਟ ਅਤੇ ਵੱਡੇ ਵੀਡੀਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos similares, capturas de pantalla y vídeos grandes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos similaires, captures d'écran et vidéos volumineuses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähnliche Fotos, Screenshots und große Videos."
          }
        },
        "pt-BR": {
