    "Include your Photos library?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include your Photos library?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपकी फ़ोटो लाइब्रेरी शामिल करें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফটো লাইব্রেরি অন্তর্ভুক্ত করবেন?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் புகைப்பட நூலகத்தைச் சேர்க்கவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోటోల లైబ్రరీని చేర్చాలా?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची फोटो लायब्ररी समाविष्ट करायची का?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું તમારી ફોટો લાઇબ્રેરી સામેલ કરવી?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋಟೋಗಳ ಲೈಬ್ರರಿಯನ್ನು ಸೇರಿಸುವುದೇ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോട്ടോസ് ലൈബ്രറി ഉൾപ്പെടുത്തണോ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ ਤੁਹਾਡੀ ਫੋਟੋ ਲਾਇਬ੍ਰੇਰੀ ਸ਼ਾਮਲ ਕਰਨੀ ਹੈ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Incluir tu fototeca de Fotos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure votre photothèque Photos ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fotos-Mediathek einbeziehen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir sua fototeca do Fotos?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includere la tua libreria Foto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリを含めますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 보관함을 포함할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括您的“照片”图库？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить вашу медиатеку «Фото»?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد تضمين مكتبة الصور؟"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכלול את ספריית התמונות שלך?"
          }
        }
      }
    },
