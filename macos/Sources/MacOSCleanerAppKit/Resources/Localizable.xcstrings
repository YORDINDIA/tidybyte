    "Undo skipped. A scan or cleanup is already running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo skipped. A scan or cleanup is already running."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ववत छोड़ा गया। एक स्कैन या क्लीनअप पहले से चल रहा है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্বাবস্থায় ফেরানো বাদ দেওয়া হয়েছে। একটি স্ক্যান বা ক্লিনআপ ইতিমধ্যেই চলছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயல்தவிர் தவிர்க்கப்பட்டது. ஒரு ஸ்கேன் அல்லது சுத்திகரிப்பு ஏற்கனவே இயங்குகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రద్దు దాటవేయబడింది. స్కాన్ లేదా శుభ్రత ఇప్పటికే నడుస్తోంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ववत वगळले. स्कॅन किंवा क्लीनअप आधीपासून सुरू आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્વવત છોડી દીધું. સ્કૅન અથવા ક્લીનઅપ પહેલેથી ચાલી રહ્યું છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ರದ್ದು ಬಿಟ್ಟುಬಿಡಲಾಗಿದೆ. ಸ್ಕ್ಯಾನ್ ಅಥವಾ ಸ್ವಚ್ಛತೆ ಈಗಾಗಲೇ ನಡೆಯುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പഴയപടിയാക്കൽ ഒഴിവാക്കി. ഒരു സ്കാനോ വൃത്തിയാക്കലോ ഇതിനകം നടക്കുന്നുണ്ട്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਾਪਸੀ ਛੱਡੀ ਗਈ। ਇੱਕ ਸਕੈਨ ਜਾਂ ਸਫਾਈ ਪਹਿਲਾਂ ਹੀ ਚੱਲ ਰਹੀ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitió deshacer. Ya hay un análisis o limpieza en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation ignorée. Une analyse ou un nettoyage est déjà en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung übersprungen. Ein Scan oder eine Bereinigung läuft bereits."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfazer ignorado. Já há uma análise ou limpeza em andamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annullamento ignorato. È già in corso una scansione o una pulizia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンまたはクリーンアップが実行中のため、取り消しをスキップしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔이나 정리가 이미 실행 중이므로 실행 취소를 건너뛰었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已跳过撤销。扫描或清理正在进行中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена пропущена: уже выполняется сканирование или очистка."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تخطي التراجع. هناك فحص أو تنظيف قيد التشغيل بالفعل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הביטול דולג. סריקה או ניקוי כבר פועלים."
          }
        }
      }
    },
