          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Scan-Ordner entfernt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as pastas de análise foram removidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le cartelle di scansione rimosse."
          }
        },
        "ja": {
