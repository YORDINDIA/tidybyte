    "Replace and trash originals after compression": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace and trash originals after compression"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपीड़न के बाद मूल फ़ाइलें बदलें और ट्रैश में भेजें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপ্রেশনের পর প্রতিস্থাপন করুন ও মূল ফাইল ট্র্যাশে পাঠান"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சுருக்கத்திற்குப் பிறகு மாற்றி அசல்களைக் குப்பைத் தொட்டிக்கு அனுப்பவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కుదింపు తర్వాత భర్తీ చేసి అసలు ఫైళ్లను ట్రాష్‌లోకి పంపండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कंप्रेशननंतर मूळ फाइल्स बदला आणि ट्रॅशमध्ये पाठवा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોમ્પ્રેશન પછી મૂળ ફાઇલો બદલો અને ટ્રૅશમાં મોકલો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಕುಚನೆಯ ನಂತರ ಬದಲಿಸಿ ಮತ್ತು ಮೂಲಗಳನ್ನು ಟ್ರ್ಯಾಶ್‌ಗೆ ಕಳುಹಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കംപ്രഷന് ശേഷം മാറ്റിസ്ഥാപിച്ച് യഥാർത്ഥ ഫയലുകൾ ട്രാഷിലേക്ക് അയയ്ക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪ੍ਰੈਸ਼ਨ ਤੋਂ ਬਾਅਦ ਬਦਲੋ ਅਤੇ ਮੂਲ ਫਾਈਲਾਂ ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar y enviar originales al Basurero tras comprimir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer et placer les originaux dans la Corbeille après compression"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale nach der Komprimierung ersetzen und in den Papierkorb bewegen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir e mover originais para o Lixo após comprimir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci e sposta gli originali nel Cestino dopo la compressione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮後に置き換えて元のファイルをゴミ箱へ移動"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 후 대체하고 원본을 휴지통으로 이동"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩后替换并将原文件移至废纸篓"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заменять и отправлять оригиналы в Корзину после сжатия"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استبدال الأصول ونقلها إلى سلة المهملات بعد الضغط"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלף והעבר מקורות לפח לאחר כיווץ"
          }
        }
      }
    },
