          }
        },
        "mr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld आयटम · %@ काढला. फाइल्स ट्रॅशमध्ये आणि फोटो आयटम अलीकडे हटवलेले मध्ये आहेत. जागा परत मिळवण्यासाठी Finder किंवा फोटोमध्ये ते रिकामे करा."
                }
              },
