        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ കാഴ്ച നിറയ്ക്കാൻ സ്കാൻ പ്രവർത്തിപ്പിക്കുക അല്ലെങ്കിൽ പേര് ഫിൽട്ടർ മായ്ക്കുക."
