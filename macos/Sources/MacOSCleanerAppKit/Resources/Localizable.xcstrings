    "Scan complete. Review every action before execution.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan complete. Review every action before execution."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन पूरा हुआ। निष्पादन से पहले हर क्रिया की समीक्षा करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যান সম্পন্ন হয়েছে। কার্যকর করার আগে প্রতিটি কাজ পর্যালোচনা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேன் முடிந்தது. செயல்படுத்துவதற்கு முன் ஒவ்வொரு செயலையும் மதிப்பாய்வு செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ పూర్తయింది. అమలు చేసే ముందు ప్రతి చర్యను సమీక్షించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅन पूर्ण झाले. चालवण्यापूर्वी प्रत्येक क्रियेचे पुनरावलोकन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન પૂર્ણ થયો. અમલ કરતાં પહેલાં દરેક ક્રિયાની સમીક્ષા કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಪೂರ್ಣಗೊಂಡಿದೆ. ಕಾರ್ಯಗತಗೊಳಿಸುವ ಮೊದಲು ಪ್ರತಿ ಕ್ರಿಯೆಯನ್ನು ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ പൂർത്തിയായി. നടപ്പാക്കുന്നതിന് മുമ്പ് ഓരോ പ്രവൃത്തിയും അവലോകനം ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਪੂਰਾ ਹੋਇਆ। ਚਲਾਉਣ ਤੋਂ ਪਹਿਲਾਂ ਹਰ ਕਾਰਵਾਈ ਦੀ ਸਮੀਖਿਆ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis completo. Revisa cada acción antes de ejecutarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse terminée. Examinez chaque action avant exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan abgeschlossen. Prüfe jede Aktion vor der Ausführung."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Análise concluída. Revise cada ação antes de executar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansione completata. Esamina ogni azione prima dell'esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンが完了しました。実行前にすべてのアクションを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 완료. 실행하기 전에 모든 작업을 검토하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描完成。执行前请审阅每项操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование завершено. Проверьте каждое действие перед выполнением."
          }
        },
        "ar": {
          "stringUnit": {
