    "No third-party agents or daemons start with this Mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No third-party agents or daemons start with this Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac के साथ कोई तृतीय-पक्ष एजेंट या डीमन शुरू नहीं होता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এর সাথে কোনো তৃতীয়-পক্ষের এজেন্ট বা ডিমন শুরু হয় না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த Mac உடன் மூன்றாம் தரப்பு முகவர்கள் அல்லது டீமன்கள் எதுவும் தொடங்குவதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Mac తో మూడవ పక్ష ఏజెంట్లు లేదా డీమన్లు ఏవీ ప్రారంభం కావు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या Mac सोबत कोणतेही तृतीय-पक्ष एजंट किंवा डीमन सुरू होत नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ Mac સાથે કોઈ તૃતીય-પક્ષ એજન્ટ્સ અથવા ડીમન્સ શરૂ થતા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ Mac ನೊಂದಿಗೆ ಯಾವುದೇ ತೃತೀಯ-ಪಕ್ಷ ಏಜೆಂಟ್‌ಗಳು ಅಥವಾ ಡೀಮನ್‌ಗಳು ಪ್ರಾರಂಭವಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ Mac-നൊപ്പം മൂന്നാം കക്ഷി ഏജന്റുകളോ ഡീമണുകളോ ഒന്നും തുടങ്ങുന്നില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ Mac ਨਾਲ ਕੋਈ ਤੀਜੀ-ਧਿਰ ਏਜੰਟ ਜਾਂ ਡੀਮਨ ਸ਼ੁਰੂ ਨਹੀਂ ਹੁੰਦੇ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún agente o daemon de terceros se inicia con este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun agent ou démon tiers ne démarre avec ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es starten keine Drittanbieter-Agenten oder -Daemons mit diesem Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum agente ou daemon de terceiros inicia com este Mac."
          }
