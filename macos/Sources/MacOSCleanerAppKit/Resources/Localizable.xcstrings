            "value": "%@ पर सिमलिंक इंस्टॉल किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ সিমলিংক ইনস্টল করা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ இல் சிம்லிங்க் நிறுவப்பட்டது."
