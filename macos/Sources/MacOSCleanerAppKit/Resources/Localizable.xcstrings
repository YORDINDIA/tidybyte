    "A media scan is already running.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A media scan is already running."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया स्कैन पहले से चल रहा है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি মিডিয়া স্ক্যান ইতিমধ্যেই চলছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீடியா ஸ்கேன் ஏற்கனவே இயங்குகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీడియా స్కాన్ ఇప్పటికే నడుస్తోంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया स्कॅन आधीपासून सुरू आहे."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મીડિયા સ્કૅન પહેલેથી ચાલી રહ્યો છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೀಡಿಯಾ ಸ್ಕ್ಯಾನ್ ಈಗಾಗಲೇ ನಡೆಯುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു മീഡിയ സ്കാൻ ഇതിനകം നടക്കുന്നുണ്ട്."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੀਡੀਆ ਸਕੈਨ ਪਹਿਲਾਂ ਹੀ ਚੱਲ ਰਿਹਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un análisis multimedia en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une analyse multimédia est déjà en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Medienscan läuft bereits."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma análise de mídia já está em andamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una scansione dei file multimediali è già in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアのスキャンはすでに実行中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 스캔이 이미 실행 중입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体扫描已在运行中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование медиафайлов уже выполняется."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فحص الوسائط قيد التشغيل بالفعل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סריקת מדיה כבר פועלת."
          }
        }
      }
    },
    "A previous cleanup was interrupted; %lld operations may be incomplete.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A previous cleanup was interrupted; %lld operation may be incomplete."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A previous cleanup was interrupted; %lld operations may be incomplete."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "पिछली सफ़ाई बाधित हुई थी; %lld क्रिया अधूरी हो सकती है।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "पिछली सफ़ाई बाधित हुई थी; %lld क्रियाएं अधूरी हो सकती हैं।"
                }
              }
            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "আগের একটি ক্লিনআপ বাধাপ্রাপ্ত হয়েছিল; %lldটি কাজ অসম্পূর্ণ থাকতে পারে।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "আগের একটি ক্লিনআপ বাধাপ্রাপ্ত হয়েছিল; %lldটি কাজ অসম্পূর্ণ থাকতে পারে।"
                }
              }
            }
          }
        },
        "ta": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "முந்தைய சுத்திகரிப்பு இடைநிறுத்தப்பட்டது; %lld செயல் முழுமையடையாமல் இருக்கலாம்."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "முந்தைய சுத்திகரிப்பு இடைநிறுத்தப்பட்டது; %lld செயல்கள் முழுமையடையாமல் இருக்கலாம்."
                }
              }
            }
          }
        },
        "te": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "మునుపటి శుభ్రతకు అంతరాయం కలిగింది; %lld చర్య అసంపూర్తిగా ఉండవచ్చు."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "మునుపటి శుభ్రతకు అంతరాయం కలిగింది; %lld చర్యలు అసంపూర్తిగా ఉండవచ్చు."
                }
              }
            }
          }
        },
        "mr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "मागील क्लीनअपमध्ये व्यत्यय आला होता; %lld क्रिया अपूर्ण असू शकते."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "मागील क्लीनअपमध्ये व्यत्यय आला होता; %lld क्रिया अपूर्ण असू शकतात."
                }
              }
            }
          }
        },
        "gu": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "અગાઉનો ક્લીનઅપ અવરોધાયો હતો; %lld ક્રિયા અધૂરી હોઈ શકે છે."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "અગાઉનો ક્લીનઅપ અવરોધાયો હતો; %lld ક્રિયાઓ અધૂરી હોઈ શકે છે."
                }
              }
            }
          }
        },
        "kn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ಹಿಂದಿನ ಸ್ವಚ್ಛತೆಗೆ ಅಡ್ಡಿಯಾಯಿತು; %lld ಕ್ರಿಯೆ ಅಪೂರ್ಣವಾಗಿರಬಹುದು."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ಹಿಂದಿನ ಸ್ವಚ್ಛತೆಗೆ ಅಡ್ಡಿಯಾಯಿತು; %lld ಕ್ರಿಯೆಗಳು ಅಪೂರ್ಣವಾಗಿರಬಹುದು."
                }
              }
            }
          }
        },
        "ml": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "മുൻ വൃത്തിയാക്കൽ തടസ്സപ്പെട്ടു; %lld പ്രവൃത്തി അപൂർണ്ണമായിരിക്കാം."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "മുൻ വൃത്തിയാക്കൽ തടസ്സപ്പെട്ടു; %lld പ്രവൃത്തികൾ അപൂർണ്ണമായിരിക്കാം."
                }
              }
            }
          }
        },
        "pa": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ਪਿਛਲੀ ਸਫਾਈ ਵਿੱਚ ਵਿਘਨ ਪਿਆ ਸੀ; %lld ਕਾਰਵਾਈ ਅਧੂਰੀ ਹੋ ਸਕਦੀ ਹੈ।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ਪਿਛਲੀ ਸਫਾਈ ਵਿੱਚ ਵਿਘਨ ਪਿਆ ਸੀ; %lld ਕਾਰਵਾਈਆਂ ਅਧੂਰੀਆਂ ਹੋ ਸਕਦੀਆਂ ਹਨ।"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se interrumpió una limpieza anterior; es posible que %lld operación esté incompleta."
