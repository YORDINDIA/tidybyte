            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "सत्यापित स्थिर फ़ोटो बनाता है और %lld मूल Live Photo को हाल ही में हटाए गए में भेजता है, लगभग %@ खाली करता है।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "सत्यापित स्थिर फ़ोटो बनाता है और %lld मूल Live Photos को हाल ही में हटाए गए में भेजता है, लगभग %@ खाली करता है।"
                }
              }
            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "যাচাইকৃত স্থির ছবি তৈরি করে এবং %lldটি মূল Live Photo সম্প্রতি মোছা-তে সরায়, প্রায় %@ জায়গা উদ্ধার করে।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "যাচাইকৃত স্থির ছবি তৈরি করে এবং %lldটি মূল Live Photos সম্প্রতি মোছা-তে সরায়, প্রায় %@ জায়গা উদ্ধার করে।"
                }
              }
            }
          }
        },
        "ta": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "சரிபார்க்கப்பட்ட நிலைப் புகைப்படத்தை உருவாக்கி, %lld அசல் Live Photo ஐ சமீபத்தில் நீக்கியவைக்கு நகர்த்துகிறது, சுமார் %@ இடத்தை மீட்டெடுக்கிறது."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "சரிபார்க்கப்பட்ட நிலைப் புகைப்படங்களை உருவாக்கி, %lld அசல் Live Photos ஐ சமீபத்தில் நீக்கியவைக்கு நகர்த்துகிறது, சுமார் %@ இடத்தை மீட்டெடுக்கிறது."
                }
              }
            }
          }
        },
        "te": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ధృవీకరించబడిన స్థిర ఫోటోను సృష్టించి, %lld అసలు Live Photo ను ఇటీవల తొలగించినవికి తరలిస్తుంది, సుమారు %@ స్థలాన్ని తిరిగి పొందుతుంది."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ధృవీకరించబడిన స్థిర ఫోటోలను సృష్టించి, %lld అసలు Live Photos ను ఇటీవల తొలగించినవికి తరలిస్తుంది, సుమారు %@ స్థలాన్ని తిరిగి పొందుతుంది."
                }
              }
            }
          }
        },
        "mr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "पडताळलेले स्थिर फोटो तयार करते आणि %lld मूळ Live Photo अलीकडे हटवलेले मध्ये हलवते, सुमारे %@ जागा मोकळी करते."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "पडताळलेले स्थिर फोटो तयार करते आणि %lld मूळ Live Photos अलीकडे हटवलेले मध्ये हलवते, सुमारे %@ जागा मोकळी करते."
                }
