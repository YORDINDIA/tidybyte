    "%@ could not be added because the plan changed. Try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ could not be added because the plan changed. Try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना बदल जाने के कारण %@ को जोड़ा नहीं जा सका। फिर से प्रयास करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিকল্পনা পরিবর্তিত হওয়ায় %@ যোগ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டம் மாறியதால் %@ ஐச் சேர்க்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రణాళిక మారినందున %@ ను జోడించలేకపోయాము. మళ్లీ ప్రయత్నించండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "योजना बदलल्यामुळे %@ जोडता आले नाही. पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "યોજના બદલાઈ હોવાથી %@ ઉમેરી શકાયું નહીં. ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯೋಜನೆ ಬದಲಾಗಿರುವುದರಿಂದ %@ ಅನ್ನು ಸೇರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്ലാൻ മാറിയതിനാൽ %@ ചേർക്കാനായില്ല. വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਯੋਜਨਾ ਬਦਲਣ ਕਾਰਨ %@ ਸ਼ਾਮਲ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਿਆ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
