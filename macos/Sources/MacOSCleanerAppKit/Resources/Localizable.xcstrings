    "Review cloud files carefully": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review cloud files carefully"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड फ़ाइलों की सावधानी से समीक्षा करें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্লাউড ফাইল সাবধানে পর্যালোচনা করুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிளவுட் கோப்புகளைக் கவனமாக மதிப்பாய்வு செய்யவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్లౌడ్ ఫైళ్లను జాగ్రత్తగా సమీక్షించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड फाइल्सचे काळजीपूर्वक पुनरावलोकन करा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ક્લાઉડ ફાઇલોની કાળજીપૂર્વક સમીક્ષા કરો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಲೌಡ್ ಫೈಲ್‌ಗಳನ್ನು ಎಚ್ಚರಿಕೆಯಿಂದ ಪರಿಶೀಲಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ക്ലൗഡ് ഫയലുകൾ ശ്രദ്ധാപൂർവ്വം അവലോകനം ചെയ്യുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਲਾਊਡ ਫਾਈਲਾਂ ਦੀ ਧਿਆਨ ਨਾਲ ਸਮੀਖਿਆ ਕਰੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa bien los archivos en la nube"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez attentivement les fichiers dans le nuage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Dateien sorgfältig prüfen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise arquivos da nuvem com cuidado"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla bene i file sul cloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドファイルを慎重に確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 파일 주의 깊게 검토"
          }
        },
