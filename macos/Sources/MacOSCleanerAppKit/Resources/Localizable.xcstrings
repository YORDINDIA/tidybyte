          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "/Applications અથવા ~/Applications માં કોઈ ઍપ્સ મળી નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "/Applications ಅಥವಾ ~/Applications ನಲ್ಲಿ ಯಾವುದೇ ಆ್ಯಪ್‌ಗಳು ಕಂಡುಬಂದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "/Applications അല്ലെങ്കിൽ ~/Applications-ൽ ആപ്പുകളൊന്നും കണ്ടെത്തിയില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "/Applications ਜਾਂ ~/Applications ਵਿੱਚ ਕੋਈ ਐਪਸ ਨਹੀਂ ਮਿਲੇ।"
          }
