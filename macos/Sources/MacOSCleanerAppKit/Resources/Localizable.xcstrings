    "Could not save completed changes in History: %@": {
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save completed changes in History: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण हुए बदलाव इतिहास में सहेजे नहीं जा सके: %@"
