    "This action is for review only. Tidybyte cannot execute it.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is for review only. Tidybyte cannot execute it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह क्रिया केवल समीक्षा के लिए है। Tidybyte इसे निष्पादित नहीं कर सकता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই কাজটি শুধুমাত্র পর্যালোচনার জন্য। Tidybyte এটি চালাতে পারবে না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் செயல் மதிப்பாய்வுக்கு மட்டுமே. Tidybyte இதை இயக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ చర్య సమీక్షకు మాత్రమే. Tidybyte దీనిని అమలు చేయలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही क्रिया केवळ पुनरावलोकनासाठी आहे. Tidybyte ती चालवू शकत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ક્રિયા માત્ર સમીક્ષા માટે છે. Tidybyte તે ચલાવી શકતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಕ್ರಿಯೆ ಪರಿಶೀಲನೆಗೆ ಮಾತ್ರ. Tidybyte ಇದನ್ನು ಕಾರ್ಯಗತಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്രവൃത്തി അവലോകനത്തിന് മാത്രമാണ്. Tidybyte-ന് ഇത് നടപ്പാക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਕਾਰਵਾਈ ਕੇਵਲ ਸਮੀਖਿਆ ਲਈ ਹੈ। Tidybyte ਇਸਨੂੰ ਚਲਾ ਨਹੀਂ ਸਕਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción es solo para revisar. Tidybyte no puede ejecutarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est en examen uniquement. Tidybyte ne peut pas l'exécuter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion dient nur zur Prüfung. Tidybyte kann sie nicht ausführen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação é somente para revisão. O Tidybyte não pode executá-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione è solo per revisione. Tidybyte non può eseguirla."
          }
        },
        "ja": {
          "stringUnit": {
