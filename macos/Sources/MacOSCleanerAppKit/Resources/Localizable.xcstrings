        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حد بايتات تعديل الملفات"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגבלת בתים לשינוי קבצים"
          }
        }
      }
    },
    "Files changed since the last scan. Scan again to refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files changed since the last scan. Scan again to refresh."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले स्कैन के बाद फ़ाइलें बदल गई हैं। ताज़ा करने के लिए फिर से स्कैन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেষ স্ক্যানের পর ফাইল পরিবর্তিত হয়েছে। রিফ্রেশ করতে আবার স্ক্যান করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடைசி ஸ்கேனுக்குப் பிறகு கோப்புகள் மாறிவிட்டன. புதுப்பிக்க மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చివరి స్కాన్ తర్వాత ఫైళ్లు మారాయి. రిఫ్రెష్ చేయడానికి మళ్లీ స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मागील स्कॅननंतर फाइल्स बदलल्या आहेत. ताजेतवाने करण्यासाठी पुन्हा स्कॅन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા સ્કૅન પછી ફાઇલો બદલાઈ છે. તાજું કરવા ફરી સ્કૅન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೊನೆಯ ಸ್ಕ್ಯಾನ್ ನಂತರ ಫೈಲ್‌ಗಳು ಬದಲಾಗಿವೆ. ರಿಫ್ರೆಶ್ ಮಾಡಲು ಮತ್ತೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അവസാന സ്കാനിന് ശേഷം ഫയലുകൾ മാറിയിട്ടുണ്ട്. പുതുക്കാൻ വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ ਸਕੈਨ ਤੋਂ ਬਾਅਦ ਫਾਈਲਾਂ ਬਦਲੀਆਂ ਹਨ। ਤਾਜ਼ਾ ਕਰਨ ਲਈ ਦੁਬਾਰਾ ਸਕੈਨ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos cambiaron desde el último análisis. Analiza de nuevo para actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fichiers ont changé depuis la dernière analyse. Relancez une analyse pour actualiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien haben sich seit dem letzten Scan geändert. Zum Aktualisieren erneut scannen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos mudaram desde a última análise. Analise novamente para atualizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file sono cambiati dall'ultima scansione. Ripeti la scansione per aggiornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のスキャン以降にファイルが変更されました。更新するには再スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 스캔 이후 파일이 변경되었습니다. 새로고침하려면 다시 스캔하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自上次扫描以来部分文件已更改。请重新扫描以刷新。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы изменились со времени последнего сканирования. Просканируйте снова для обновления."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيرت الملفات منذ آخر فحص. افحص مجددًا للتحديث."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים השתנו מאז הסריקה האחרונה. סרקו שוב לרענון."
          }
        }
      }
    },
    "Files go to the Trash, and History can restore them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files go to the Trash, and History can restore them."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें ट्रैश में जाती हैं, और इतिहास से उन्हें पुनर्स्थापित किया जा सकता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল ট্র্যাশে যায়, এবং ইতিহাস থেকে এগুলো পুনরুদ্ধার করা যায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கோப்புகள் குப்பைத் தொட்டிக்குச் செல்லும், வரலாற்றிலிருந்து அவற்றை மீட்டெடுக்கலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫైళ్లు ట్రాష్‌లోకి వెళ్తాయి, మరియు చరిత్ర వాటిని పునరుద్ధరించగలదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइल्स ट्रॅशमध्ये जातात, आणि इतिहास त्या पुनर्संचयित करू शकतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફાઇલો ટ્રૅશમાં જાય છે, અને ઇતિહાસ તેમને પુનઃસ્થાપિત કરી શકે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೈಲ್‌ಗಳು ಟ್ರ್ಯಾಶ್‌ಗೆ ಹೋಗುತ್ತವೆ, ಮತ್ತು ಇತಿಹಾಸ ಅವುಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಬಲ್ಲದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫയലുകൾ ട്രാഷിലേക്ക് പോകുന്നു, ചരിത്രത്തിൽ നിന്ന് അവ പുനഃസ്ഥാപിക്കാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਾਈਲਾਂ ਟਰੈਸ਼ ਵਿੱਚ ਜਾਂਦੀਆਂ ਹਨ, ਅਤੇ ਇਤਿਹਾਸ ਉਹਨਾਂ ਨੂੰ ਬਹਾਲ ਕਰ ਸਕਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos van al Basurero y pueden restaurarse desde Historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers vont dans la Corbeille et l'Historique permet de les restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien wandern in den Papierkorb und können über den Verlauf wiederhergestellt werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos vão para o Lixo e o Histórico pode restaurá-los."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file vanno nel Cestino e possono essere ripristinati dalla Cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはゴミ箱へ移動し、履歴から復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 휴지통으로 이동하며 기록에서 복원할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会移入废纸篓，可通过历史记录还原。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы перемещаются в Корзину и могут быть восстановлены из «Истории»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتقل الملفات إلى سلة المهملات، ويمكن استعادتها من السجل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים עוברים לפח, וניתן לשחזרם מההיסטוריה."
          }
        }
      }
    },
