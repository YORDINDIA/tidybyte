    "No snapshots yet: each scan saves one.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No snapshots yet: each scan saves one."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई स्नैपशॉट नहीं: प्रत्येक स्कैन एक सहेजता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোনো স্ন্যাপশট নেই: প্রতিটি স্ক্যান একটি সংরক্ষণ করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இன்னும் ஸ்னாப்ஷாட்கள் இல்லை: ஒவ்வொரு ஸ்கேனும் ஒன்றைச் சேமிக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇంకా స్నాప్‌షాట్లు లేవు: ప్రతి స్కాన్ ఒకటి సేవ్ చేస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अद्याप कोणतेही स्नॅपशॉट्स नाहीत: प्रत्येक स्कॅन एक जतन करतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હજી સુધી કોઈ સ્નૅપશૉટ્સ નથી: દરેક સ્કૅન એક સાચવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್ನೂ ಸ್ನ್ಯಾಪ್‌ಶಾಟ್‌ಗಳಿಲ್ಲ: ಪ್ರತಿ ಸ್ಕ್ಯಾನ್ ಒಂದನ್ನು ಉಳಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇതുവരെ സ്നാപ്പ്ഷോട്ടുകളില്ല: ഓരോ സ്കാനും ഒന്ന് സംരക്ഷിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਜੇ ਕੋਈ ਸਨੈਪਸ਼ਾਟ ਨਹੀਂ: ਹਰ ਸਕੈਨ ਇੱਕ ਸੰਭਾਲਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay instantáneas: cada análisis guarda una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun instantané pour le moment : chaque analyse en enregistre un."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Schnappschüsse: Jeder Scan sichert einen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma captura ainda: cada análise salva uma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna istantanea: ogni scansione ne salva una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットはまだありません。スキャンごとに 1 件保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 스냅샷이 없습니다. 스캔할 때마다 하나씩 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无快照：每次扫描都会保存一份。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимков пока нет: каждое сканирование сохраняет один снимок."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد لقطات بعد: يحفظ كل فحص لقطة واحدة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תמונות מצב עדיין: כל סריקה שומרת אחת."
          }
        }
      }
    },
