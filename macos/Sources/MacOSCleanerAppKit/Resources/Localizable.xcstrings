    "No %@ risk actions in this area.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@ risk actions in this area."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस क्षेत्र में कोई %@ जोखिम वाली क्रिया नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অংশে কোনো %@ ঝুঁকিপূর্ণ কাজ নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்பகுதியில் %@ ஆபத்துள்ள செயல்கள் எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రాంతంలో %@ ప్రమాద చర్యలు ఏవీ లేవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या भागात कोणतीही %@ जोखमीची क्रिया नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ વિસ્તારમાં કોઈ %@ જોખમી ક્રિયા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪ್ರದೇಶದಲ್ಲಿ ಯಾವುದೇ %@ ಅಪಾಯದ ಕ್ರಿಯೆಗಳಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഭാഗത്ത് %@ അപകടസാധ്യതയുള്ള പ്രവൃത്തികളൊന്നുമില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਖੇਤਰ ਵਿੱਚ ਕੋਈ %@ ਜੋਖਮ ਵਾਲੀ ਕਾਰਵਾਈ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay acciones de riesgo %@ en esta área."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune action à risque %@ dans cette zone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Aktionen mit Risiko „%@“ in diesem Bereich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ação de risco %@ nesta área."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna azione a rischio %@ in quest'area."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この領域に %@ リスクのアクションはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 영역에 %@ 위험 작업이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此区域内没有 %@ 风险的操作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой области нет действий с риском «%@»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إجراءات خطورة %@ في هذا القسم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין פעולות בסיכון %@ באזור זה."
          }
        }
      }
    },
    "No %@ risk actions match “%@”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@ risk actions match “%@”."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” से मेल खाने वाली कोई %1$@ जोखिम क्रिया नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”-এর সাথে কোনো %1$@ ঝুঁকিপূর্ণ কাজ মেলেনি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” உடன் பொருந்தும் %1$@ ஆபத்து செயல்கள் எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” కు సరిపోలే %1$@ ప్రమాద చర్యలు ఏవీ లేవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” शी जुळणारी कोणतीही %1$@ जोखमीची क्रिया नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” સાથે મેળ ખાતી કોઈ %1$@ જોખમી ક્રિયા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” ಗೆ ಹೊಂದಿಕೆಯಾಗುವ ಯಾವುದೇ %1$@ ಅಪಾಯದ ಕ್ರಿಯೆಗಳಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” എന്നതുമായി പൊരുത്തപ്പെടുന്ന %1$@ അപകടസാധ്യതാ പ്രവൃത്തികളൊന്നുമില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@” ਨਾਲ ਮੇਲ ਖਾਂਦੀ ਕੋਈ %1$@ ਜੋਖਮ ਕਾਰਵਾਈ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna acción de riesgo %@ coincide con «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune action à risque %@ ne correspond à « %@ »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Aktionen mit Risiko „%@“ passen zu „%@“."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ação de risco %@ corresponde a “%@”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna azione a rischio %@ corrisponde a “%@”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”に一致する %1$@ リスクのアクションはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”와(과) 일치하는 %1$@ 위험 작업이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 %1$@ 风险操作匹配“%2$@”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет действий с риском «%@» для «%@»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد إجراءات خطورة %@ تطابق «%@»."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין פעולות בסיכון %@ המתאימות ל-״%@״."
          }
        }
      }
    },
