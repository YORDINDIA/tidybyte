    "Choose folders or a scan mode to begin.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose folders or a scan mode to begin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू करने के लिए फ़ोल्डर या स्कैन मोड चुनें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরু করতে ফোল্ডার বা স্ক্যান মোড বেছে নিন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்க கோப்புறைகள் அல்லது ஸ்கேன் பயன்முறையைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రారంభించడానికి ఫోల్డర్లు లేదా స్కాన్ మోడ్ ఎంచుకోండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरू करण्यासाठी फोल्डर्स किंवा स्कॅन मोड निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શરૂ કરવા માટે ફોલ્ડર્સ અથવા સ્કૅન મોડ પસંદ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಾರಂಭಿಸಲು ಫೋಲ್ಡರ್‌ಗಳು ಅಥವಾ ಸ್ಕ್ಯಾನ್ ಮೋಡ್ ಆಯ್ಕೆಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആരംഭിക്കാൻ ഫോൾഡറുകളോ സ്കാൻ മോഡോ തിരഞ്ഞെടുക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਫੋਲਡਰ ਜਾਂ ਸਕੈਨ ਮੋਡ ਚੁਣੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige carpetas o un modo de análisis para comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des dossiers ou un mode d'analyse pour commencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Ordner oder einen Scan-Modus, um zu beginnen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha pastas ou um modo de análise para começar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cartelle o una modalità di scansione per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始するにはフォルダまたはスキャンモードを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하려면 폴더나 스캔 모드를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择文件夹或扫描模式以开始。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папки или режим сканирования, чтобы начать."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجلدات أو وضع فحص للبدء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו תיקיות או מצב סריקה כדי להתחיל."
          }
        }
      }
    },
