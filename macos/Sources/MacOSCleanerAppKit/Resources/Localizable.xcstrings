          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "/Applications அல்லது ~/Applications இல் செயலிகள் எதுவும் கிடைக்கவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "/Applications లేదా ~/Applications లో ఏ యాప్‌లూ కనుగొనబడలేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
