    "Convert Live Photos to Still Images?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert Live Photos to Still Images?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या Live Photos को स्थिर छवियों में बदलें?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos-কে কি স্থির ছবিতে রূপান্তর করবেন?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos ஐ நிலைப் படங்களாக மாற்றவா?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos ను స్థిర చిత్రాలుగా మార్చాలా?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos स्थिर प्रतिमांमध्ये रूपांतरित करायचे का?"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું Live Photos ને સ્થિર છબીઓમાં રૂપાંતરિત કરવા?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos ಅನ್ನು ಸ್ಥಿರ ಚಿತ್ರಗಳಾಗಿ ಪರಿವರ್ತಿಸುವುದೇ?"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos നിശ്ചല ചിത്രങ്ങളാക്കി മാറ്റണോ?"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ Live Photos ਨੂੰ ਸਥਿਰ ਤਸਵੀਰਾਂ ਵਿੱਚ ਬਦਲਣਾ ਹੈ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Convertir Live Photos en imágenes fijas?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertir les Live Photos en images fixes ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos in Standbilder umwandeln?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converter Live Photos em fotos estáticas?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertire le Live Photos in immagini fisse?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos を静止画に変換しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos를 스틸 이미지로 변환할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Live Photos 转换为静态照片？"
          }
        },
        "ru": {
