    "Paired devices show up here with their battery levels.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paired devices show up here with their battery levels."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेयर किए गए डिवाइस उनकी बैटरी स्तर के साथ यहाँ दिखाई देते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেয়ার করা ডিভাইসগুলো তাদের ব্যাটারি স্তরসহ এখানে দেখা যায়।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இணைக்கப்பட்ட சாதனங்கள் அவற்றின் மின்கல அளவுகளுடன் இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జతచేసిన పరికరాలు వాటి బ్యాటరీ స్థాయిలతో ఇక్కడ కనిపిస్తాయి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पेअर केलेली डिव्हाइसेस त्यांच्या बॅटरी पातळीसह येथे दिसतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જોડાયેલા ડિવાઇસ તેમના બૅટરી સ્તર સાથે અહીં દેખાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜೋಡಿಸಲಾದ ಸಾಧನಗಳು ಅವುಗಳ ಬ್ಯಾಟರಿ ಮಟ್ಟಗಳೊಂದಿಗೆ ಇಲ್ಲಿ ಕಾಣಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ജോടിയാക്കിയ ഉപകരണങ്ങൾ അവയുടെ ബാറ്ററി നിലയോടെ ഇവിടെ കാണാം."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੇਅਰ ਕੀਤੇ ਡਿਵਾਈਸ ਆਪਣੇ ਬੈਟਰੀ ਪੱਧਰ ਸਮੇਤ ਇੱਥੇ ਦਿਖਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos enlazados aparecen aquí con su nivel de batería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils jumelés s'affichent ici avec leur niveau de batterie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelte Geräte erscheinen hier mit ihrem Batteriestand."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos emparelhados aparecem aqui com seus níveis de bateria."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi abbinati appaiono qui con i livelli di batteria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスがバッテリー残量とともにここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 기기가 배터리 잔량과 함께 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的设备及其电量会显示在此处。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключенные устройства появятся здесь с уровнем заряда."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الأجهزة المقترنة هنا مع مستويات بطاريتها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכשירים מקושרים יופיעו כאן עם רמות הסוללה שלהם."
          }
        }
      }
    },
    "Parent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parent"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैरेंट प्रोसेस"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যারেন্ট প্রসেস"
          }
        },
        "ta": {
          "stringUnit": {
