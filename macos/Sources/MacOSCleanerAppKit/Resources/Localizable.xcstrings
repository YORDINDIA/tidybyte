        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ವಿವರವನ್ನು ರಿಫ್ರೆಶ್ ಮಾಡಲು ಫೋಟೋಗಳು & ಮೀಡಿಯಾ ಸ್ಕ್ಯಾನ್ ನಡೆಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ വിവരണം പുതുക്കാൻ ഫോട്ടോകളും മീഡിയയും സ്കാൻ പ്രവർത്തിപ്പിക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਵੇਰਵਾ ਤਾਜ਼ਾ ਕਰਨ ਲਈ ਫੋਟੋਆਂ ਅਤੇ ਮੀਡੀਆ ਸਕੈਨ ਚਲਾਓ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta un análisis de Fotos y multimedia para actualizar este desglose."
