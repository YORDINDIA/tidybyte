    "Caches, logs, and browser data that apps rebuild.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, logs, and browser data that apps rebuild."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैश, लॉग और ब्राउज़र डेटा जिन्हें ऐप्स फिर से बनाते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাশ, লগ এবং ব্রাউজার ডেটা যা অ্যাপগুলো পুনরায় তৈরি করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "செயலிகள் மீண்டும் உருவாக்கும் கேச்கள், பதிவுகள் மற்றும் உலாவித் தரவு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "యాప్‌లు మళ్లీ నిర్మించే క్యాష్‌లు, లాగ్‌లు మరియు బ్రౌజర్ డేటా."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅशे, लॉग आणि ब्राउझर डेटा जो अ‍ॅप्स पुन्हा तयार करतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કૅશ, લૉગ અને બ્રાઉઝર ડેટા જે ઍપ્સ ફરી બનાવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆ್ಯಪ್‌ಗಳು ಮರುನಿರ್ಮಿಸುವ ಕ್ಯಾಶ್‌ಗಳು, ಲಾಗ್‌ಗಳು ಮತ್ತು ಬ್ರೌಸರ್ ಡೇಟಾ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആപ്പുകൾ വീണ്ടും നിർമ്മിക്കുന്ന ക്യാഷുകൾ, ലോഗുകൾ, ബ്രൗസർ ഡാറ്റ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਸ਼, ਲੌਗ ਅਤੇ ਬ੍ਰਾਊਜ਼ਰ ਡੇਟਾ ਜੋ ਐਪਸ ਮੁੜ ਬਣਾਉਂਦੇ ਹਨ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachés, registros y datos de navegación que las apps vuelven a crear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, journaux et données de navigation que les apps recréent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, Protokolle und Browserdaten, die Apps neu erstellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches, registros e dados de navegador que os apps recriam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache, log e dati del browser che le app rigenerano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが再構築するキャッシュ、ログ、ブラウザデータ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 다시 생성하는 캐시, 로그 및 브라우저 데이터."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用会自动重建的缓存、日志和浏览器数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэши, журналы и данные браузеров, которые приложения создают заново."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذاكرة المؤقتة والسجلات وبيانات المتصفح التي تعيد التطبيقات إنشاءها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מטמונים, יומנים ונתוני דפדפן שאפליקציות יוצרות מחדש."
          }
        }
      }
    },
