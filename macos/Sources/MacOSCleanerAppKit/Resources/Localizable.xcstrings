    "I'll scan later": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll scan later"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं बाद में स्कैन करूँगा"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি পরে স্ক্যান করব"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நான் பின்னர் ஸ்கேன் செய்கிறேன்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను తర్వాత స్కాన్ చేస్తాను"
          }
        },
        "mr": {
