          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બદલો અને મૂળ Live Photo ટ્રૅશમાં મોકલો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬದಲಿಸಿ ಮತ್ತು ಮೂಲ Live Photo ಟ್ರ್ಯಾಶ್‌ಗೆ ಕಳುಹಿಸಿ"
