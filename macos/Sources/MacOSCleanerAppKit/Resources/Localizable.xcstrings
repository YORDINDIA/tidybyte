    "⌘Z or Edit ▸ Undo reverts the last decision.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z or Edit ▸ Undo reverts the last decision."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z या संपादित करें ▸ पूर्ववत करें पिछले निर्णय को वापस लाता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z বা সম্পাদনা ▸ পূর্বাবস্থায় ফেরান শেষ সিদ্ধান্তটি ফিরিয়ে আনে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z அல்லது திருத்து ▸ செயல்தவிர் கடைசி முடிவைத் திரும்பப்பெறும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z లేదా సవరణ ▸ రద్దు చేయండి చివరి నిర్ణయాన్ని వెనక్కి తీసుకుంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z किंवा संपादन ▸ पूर्ववत करा शेवटचा निर्णय परत आणते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z અથવા સંપાદન ▸ પૂર્વવત કરો છેલ્લો નિર્ણય પાછો લાવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ಅಥವಾ ಸಂಪಾದನೆ ▸ ರದ್ದುಮಾಡಿ ಕೊನೆಯ ನಿರ್ಧಾರವನ್ನು ಹಿಂಪಡೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z അല്ലെങ്കിൽ തിരുത്തുക ▸ പഴയപടിയാക്കുക അവസാന തീരുമാനം തിരികെ കൊണ്ടുവരുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ਜਾਂ ਸੰਪਾਦਨ ▸ ਵਾਪਸ ਲਓ ਪਿਛਲੇ ਫੈਸਲੇ ਨੂੰ ਵਾਪਸ ਲਿਆਉਂਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z o Edición ▸ Deshacer revierte la última decisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ou Édition ▸ Annuler annule la dernière décision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z oder Bearbeiten ▸ Widerrufen macht die letzte Entscheidung rückgängig."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z ou Editar ▸ Desfazer reverte a última decisão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z o Modifica ▸ Annulla ripristina l'ultima decisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z または 編集 ▸ 取り消す で直前の判断を取り消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z 또는 편집 ▸ 실행 취소로 마지막 결정을 되돌릴 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z 或 编辑 ▸ 撤销 可撤回上一步决定。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z или Правка ▸ Отменить возвращает последнее решение."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z أو تحرير ▸ تراجع يعكس القرار الأخير."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Z או עריכה ▸ בטל מבטל את ההחלטה האחרונה."
          }
        }
      }
    }
  },
  "version": "1.0"
}
