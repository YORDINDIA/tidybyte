    "Focused %@.": {
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focused %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर फ़ोकस किया गया।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ ফোকাস করা হয়েছে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ மீது கவனம் செலுத்தப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ పై ఫోకస్ చేయబడింది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ वर फोकस केले."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ પર ફોકસ કર્યું."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಮೇಲೆ ಫೋಕಸ್ ಮಾಡಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-ൽ ഫോക്കസ് ചെയ്തു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 'ਤੇ ਫੋਕਸ ਕੀਤਾ ਗਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enfocado en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciblé sur %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fokussiert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Focado em %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Focalizzato su %@."
          }
        },
        "ja": {
