        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാറ്റിസ്ഥാപിച്ച് യഥാർത്ഥ Live Photo ട്രാഷിലേക്ക് അയയ്ക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਦਲੋ ਅਤੇ ਮੂਲ Live Photo ਟਰੈਸ਼ ਵਿੱਚ ਭੇਜੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar y enviar Live Photo al Basurero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer et placer la Live Photo dans la Corbeille"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo ersetzen & in den Papierkorb"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir e mover Live Photo para o Lixo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci e sposta Live Photo nel Cestino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換えて元の Live Photo をゴミ箱へ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체하고 Live Photo 휴지통으로"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换并将 Live Photo 移至废纸篓"
          }
