    "1 item · %@ removed. Files are in Trash; Photos assets are in Recently Deleted. Empty them in Finder or Photos to return space.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 item · %@ removed. Files are in Trash; Photos assets are in Recently Deleted. Empty them in Finder or Photos to return space."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 आइटम · %@ हटाया गया। फ़ाइलें ट्रैश में और फ़ोटो आइटम हाल ही में हटाए गए में हैं। स्थान खाली करने के लिए उन्हें Finder या फ़ोटो में खाली करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "1টি আইটেম · %@ সরানো হয়েছে। ফাইল ট্র্যাশে এবং ফটো আইটেম সম্প্রতি মোছা-তে রয়েছে। জায়গা ফিরে পেতে Finder বা ফটো-তে এগুলো খালি করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "1 உருப்படி · %@ அகற்றப்பட்டது. கோப்புகள் குப்பைத் தொட்டியிலும், புகைப்பட உருப்படிகள் சமீபத்தில் நீக்கியவையிலும் உள்ளன. இடத்தை மீட்டெடுக்க Finder அல்லது புகைப்படங்களில் காலியாக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "1 అంశం · %@ తొలగించబడింది. ఫైళ్లు ట్రాష్‌లో మరియు ఫోటోలు ఇటీవల తొలగించినవిలో ఉన్నాయి. స్థలం తిరిగి పొందడానికి Finder లేదా ఫోటోలలో ఖాళీ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 आयटम · %@ काढला. फाइल्स ट्रॅशमध्ये आणि फोटो आयटम अलीकडे हटवलेले मध्ये आहेत. जागा परत मिळवण्यासाठी Finder किंवा फोटोमध्ये ते रिकामे करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "1 આઇટમ · %@ દૂર કર્યા. ફાઇલો ટ્રૅશમાં અને ફોટો આઇટમ તાજેતરમાં કાઢી નાખેલા માં છે. જગ્યા ખાલી કરવા Finder અથવા ફોટોમાં ખાલી કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ಐಟಂ · %@ ತೆಗೆದುಹಾಕಲಾಗಿದೆ. ಫೈಲ್‌ಗಳು ಟ್ರ್ಯಾಶ್‌ನಲ್ಲಿ ಮತ್ತು ಫೋಟೋಗಳು ಇತ್ತೀಚೆಗೆ ಅಳಿಸಿದವುನಲ್ಲಿವೆ. ಸ್ಥಳವನ್ನು ಮರಳಿ ಪಡೆಯಲು Finder ಅಥವಾ ಫೋಟೋಗಳಲ್ಲಿ ಖಾಲಿ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ഇനം · %@ നീക്കം ചെയ്തു. ഫയലുകൾ ട്രാഷിലും ഫോട്ടോകൾ അടുത്തിടെ ഇല്ലാതാക്കിയവയിലുമാണ്. ഇടം തിരികെ ലഭിക്കാൻ Finder-ലോ ഫോട്ടോസിലോ ശൂന്യമാക്കുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ਆਈਟਮ · %@ ਹਟਾਇਆ ਗਿਆ। ਫਾਈਲਾਂ ਟਰੈਸ਼ ਵਿੱਚ ਅਤੇ ਫੋਟੋ ਆਈਟਮਾਂ ਹਾਲ ਹੀ ਵਿੱਚ ਮਿਟਾਏ ਵਿੱਚ ਹਨ। ਥਾਂ ਖਾਲੀ ਕਰਨ ਲਈ Finder ਜਾਂ ਫੋਟੋ ਵਿੱਚ ਇਹਨਾਂ ਨੂੰ ਖਾਲੀ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 elemento · %@ eliminados. Los archivos están en el Basurero; los de Fotos, en Recientemente eliminados. Vacíalos en Finder o Fotos para recuperar espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 élément · %@ supprimés. Les fichiers sont dans la Corbeille ; les éléments Photos dans Récemment supprimés. Videz-les dans Finder ou Photos pour libérer l'espace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Objekt · %@ entfernt. Dateien liegen im Papierkorb, Fotos-Objekte in Zuletzt gelöscht. Leere sie im Finder oder in Fotos, um Speicherplatz freizugeben."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 item · %@ removidos. Os arquivos estão no Lixo; os itens do Fotos estão em Excluídos recentemente. Esvazie no Finder ou no Fotos para liberar espaço."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 elemento · %@ rimossi. I file sono nel Cestino; gli elementi di Foto sono in Eliminati di recente. Svuotali nel Finder o in Foto per liberare spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 項目 · %@ を移動しました。ファイルはゴミ箱に、「写真」の項目は「最近削除した項目」にあります。空き容量を増やすには Finder または「写真」で空にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1개 항목 · %@ 제거됨. 파일은 휴지통에, 사진 항목은 최근 삭제된 항목에 있습니다. 공간을 되돌리려면 Finder 또는 사진 앱에서 비우세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个项目 · 已移除 %@。文件已放入废纸篓，“照片”项目已放入“最近删除”。在 Finder 或“照片”中清倒即可释放空间。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1 объект · %@ удалено. Файлы находятся в Корзине, объекты «Фото» — в «Недавно удаленные». Очистите их в Finder или «Фото», чтобы освободить место."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنصر واحد · تمت إزالة %@. الملفات في سلة المهملات وعناصر الصور في المحذوفة مؤخرًا. أفرغهما في Finder أو الصور لاستعادة المساحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פריט 1 · %@ הוסרו. הקבצים בפח; פריטי תמונות בנמחקו לאחרונה. רוקנו אותם ב-Finder או בתמונות כדי לפנות שטח."
          }
        }
      }
    },
    "1 location could not be read during the scan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 location could not be read during the scan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन के दौरान 1 स्थान पढ़ा नहीं जा सका।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্যানের সময় 1টি স্থান পড়া যায়নি।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஸ்கேனின்போது 1 இடத்தைப் படிக்க முடியவில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్కాన్ సమయంలో 1 స్థానం చదవలేకపోయాము."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कॅनदरम्यान 1 ठिकाण वाचता आले नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્કૅન દરમિયાન 1 સ્થાન વાંચી શકાયું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಕ್ಯಾನ್ ಸಮಯದಲ್ಲಿ 1 ಸ್ಥಳವನ್ನು ಓದಲಾಗಲಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്കാൻ ചെയ്യുന്നതിനിടെ 1 സ്ഥലം വായിക്കാനായില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕੈਨ ਦੌਰਾਨ 1 ਟਿਕਾਣਾ ਪੜ੍ਹਿਆ ਨਹੀਂ ਜਾ ਸਕਿਆ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer 1 ubicación durante el análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 emplacement n'a pas pu être lu pendant l'analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Speicherort konnte während des Scans nicht gelesen werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 local não pôde ser lido durante a análise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere 1 posizione durante la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン中に 1 か所を読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 중 1개 위치를 읽을 수 없었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描期间有 1 个位置无法读取。"
          }
        },
        "ru": {
