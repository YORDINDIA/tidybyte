          "stringUnit": {
            "state": "translated",
            "value": "Einstellung konnte nicht gesichert werden: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar sua preferência: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la preferenza: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を保存できませんでした: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 저장할 수 없습니다: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存您的偏好设置：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить настройку: %@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ تفضيلك: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשמור את ההעדפה שלך: %@"
          }
        }
      }
    },
    "Could not stage. A scan, execution, or plan change is in flight — or there is nothing to stage yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not stage. A scan, execution, or plan change is in flight — or there is nothing to stage yet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तैयार सूची में जोड़ा नहीं जा सका। कोई स्कैन, क्रियान्वयन या योजना बदलाव अभी जारी है — या जोड़ने के लिए कुछ नहीं है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্তুত তালিকায় যোগ করা যায়নি। কোনো স্ক্যান, কার্যকর বা পরিকল্পনা পরিবর্তন চলছে — অথবা যোগ করার মতো কিছু নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தயார்நிலையில் வைக்க முடியவில்லை. ஸ்கேன், செயல்படுத்தல் அல்லது திட்ட மாற்றம் நடந்துகொண்டிருக்கிறது — அல்லது வைக்க எதுவும் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సిద్ధం చేయలేకపోయాము. స్కాన్, అమలు లేదా ప్రణాళిక మార్పు జరుగుతోంది — లేదా సిద్ధం చేయడానికి ఏమీ లేదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तयार यादीत ठेवता आले नाही. स्कॅन, अंमलबजावणी किंवा योजना बदल सुरू आहे — किंवा ठेवण्यासाठी काहीही नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તૈયાર યાદીમાં મૂકી શકાયું નહીં. સ્કૅન, અમલ અથવા યોજનામાં ફેરફાર ચાલુ છે — અથવા મૂકવા માટે કંઈ નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಿದ್ಧಪಡಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಸ್ಕ್ಯಾನ್, ಕಾರ್ಯಗತಗೊಳಿಸುವಿಕೆ ಅಥವಾ ಯೋಜನೆ ಬದಲಾವಣೆ ನಡೆಯುತ್ತಿದೆ — ಅಥವಾ ಸಿದ್ಧಪಡಿಸಲು ಏನೂ ಇಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തയ്യാറാക്കാനായില്ല. സ്കാൻ, നടപ്പാക്കൽ അല്ലെങ്കിൽ പ്ലാൻ മാറ്റം നടക്കുന്നുണ്ട് — അല്ലെങ്കിൽ തയ്യാറാക്കാൻ ഒന്നുമില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤਿਆਰ ਸੂਚੀ ਵਿੱਚ ਨਹੀਂ ਰੱਖਿਆ ਜਾ ਸਕਿਆ। ਕੋਈ ਸਕੈਨ, ਅਮਲ ਜਾਂ ਯੋਜਨਾ ਬਦਲਾਅ ਚੱਲ ਰਿਹਾ ਹੈ — ਜਾਂ ਰੱਖਣ ਲਈ ਕੁਝ ਨਹੀਂ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar. Hay un análisis, una ejecución o un cambio de plan en curso — o aún no hay nada que preparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de préparer. Une analyse, une exécution ou une modification du plan est en cours — ou rien n'est encore prêt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vormerken nicht möglich. Ein Scan, eine Ausführung oder eine Planänderung läuft – oder es gibt noch nichts vorzumerken."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível preparar. Há uma análise, execução ou alteração de plano em andamento — ou ainda não há nada para preparar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile preparare. È in corso una scansione, un'esecuzione o una modifica al piano — oppure non c'è nulla da preparare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象に追加できませんでした。スキャン、実行、またはプラン変更が進行中か、まだ追加できる項目がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 목록에 추가할 수 없습니다. 스캔, 실행 또는 계획 변경이 진행 중이거나 아직 추가할 항목이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加入待处理列表。当前有扫描、执行或计划更改正在进行，或暂无可加入的内容。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось добавить в план. Выполняется сканирование, очистка или изменение плана — либо пока нечего добавлять."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التجهيز. يوجد فحص أو تنفيذ أو تعديل خطة قيد التشغيل — أو لا يوجد شيء جاهز بعد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להוסיף להמתנה. סריקה, ביצוע או שינוי תוכנית פועלים כעת — או שאין עדיין מה להוסיף."
          }
        }
      }
    },
