        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નકારો અને 'ક્યારેય નહીં' નિયમ સાચવો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ತಿರಸ್ಕರಿಸಿ ಮತ್ತು 'ಎಂದಿಗೂ ಬೇಡ' ನಿಯಮ ಉಳಿಸಿ"
