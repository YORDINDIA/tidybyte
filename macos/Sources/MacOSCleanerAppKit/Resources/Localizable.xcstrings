        }
      }
    },
    "This permanently erases everything in the Trash. You can't undo this action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently erases everything in the Trash. You can't undo this action."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे ट्रैश में मौजूद सब कुछ स्थायी रूप से मिट जाता है। आप इस क्रिया को पूर्ववत नहीं कर सकते।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ট্র্যাশের সবকিছু স্থায়ীভাবে মুছে ফেলে। আপনি এই কাজ পূর্বাবস্থায় ফেরাতে পারবেন না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது குப்பைத் தொட்டியில் உள்ள அனைத்தையும் நிரந்தரமாக அழிக்கும். இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ట్రాష్‌లోని ప్రతిదాన్ని శాశ్వతంగా తుడిచివేస్తుంది. మీరు ఈ చర్యను రద్దు చేయలేరు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे ट्रॅशमधील सर्वकाही कायमस्वरूपी पुसून टाकते. तुम्ही ही क्रिया पूर्ववत करू शकत नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ટ્રૅશમાંનું બધું કાયમી ધોરણે ભૂંસી નાખે છે. તમે આ ક્રિયા પૂર્વવત કરી શકતા નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಟ್ರ್ಯಾಶ್‌ನಲ್ಲಿರುವ ಎಲ್ಲವನ್ನೂ ಶಾಶ್ವತವಾಗಿ ಅಳಿಸುತ್ತದೆ. ನೀವು ಈ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ട്രാഷിലുള്ള എല്ലാം സ്ഥിരമായി മായ്ച്ചുകളയുന്നു. ഈ പ്രവൃത്തി പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਟਰੈਸ਼ ਵਿੱਚ ਸਭ ਕੁਝ ਸਥਾਈ ਤੌਰ 'ਤੇ ਮਿਟਾ ਦਿੰਦਾ ਹੈ। ਤੁਸੀਂ ਇਸ ਕਾਰਵਾਈ ਨੂੰ ਵਾਪਸ ਨਹੀਂ ਕਰ ਸਕਦੇ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra permanentemente todo lo que hay en el Basurero. No puedes deshacer esta acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela efface définitivement tout le contenu de la Corbeille. Cette action est irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird alles im Papierkorb endgültig gelöscht. Diese Aktion kann nicht widerrufen werden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga permanentemente tudo o que está no Lixo. Esta ação não pode ser desfeita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina definitivamente tutto il contenuto del Cestino. Non puoi annullare questa azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱内のすべてを完全に消去します。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 있는 모든 항목을 영구적으로 지웁니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久抹掉废纸篓中的所有项目。此操作不可撤销。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это безвозвратно удалит все из Корзины. Отменить это действие будет невозможно."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمسح هذا كل ما في سلة المهملات نهائيًا. لا يمكنك التراجع عن هذا الإجراء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מוחקת לצמיתות את כל התכולה בפח. לא ניתן לבטל פעולה זו."
          }
        }
      }
    },
    "This scan uses local rules. File data is not sent to an AI provider.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This scan uses local rules. File data is not sent to an AI provider."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्कैन लोकल नियमों का उपयोग करता है। फ़ाइल डेटा किसी AI प्रदाता को नहीं भेजा जाता।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই স্ক্যান স্থানীয় নিয়ম ব্যবহার করে। ফাইলের ডেটা কোনো AI প্রদানকারীর কাছে পাঠানো হয় না।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த ஸ்கேன் உள்ளூர் விதிகளைப் பயன்படுத்துகிறது. கோப்புத் தரவு எந்த AI வழங்குநருக்கும் அனுப்பப்படாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ స్కాన్ స్థానిక నియమాలను ఉపయోగిస్తుంది. ఫైల్ డేటా ఏ AI ప్రొవైడర్‌కు పంపబడదు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा स्कॅन स्थानिक नियम वापरतो. फाइल डेटा कोणत्याही AI प्रदात्याला पाठवला जात नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ સ્કૅન સ્થાનિક નિયમો વાપરે છે. ફાઇલ ડેટા કોઈ AI પ્રદાતાને મોકલાતો નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸ್ಕ್ಯಾನ್ ಸ್ಥಳೀಯ ನಿಯಮಗಳನ್ನು ಬಳಸುತ್ತದೆ. ಫೈಲ್ ಡೇಟಾವನ್ನು ಯಾವುದೇ AI ಪೂರೈಕೆದಾರರಿಗೆ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സ്കാൻ പ്രാദേശിക നിയമങ്ങൾ ഉപയോഗിക്കുന്നു. ഫയൽ ഡാറ്റ ഒരു AI ദാതാവിനും അയയ്ക്കില്ല."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸਕੈਨ ਸਥਾਨਕ ਨਿਯਮ ਵਰਤਦਾ ਹੈ। ਫਾਈਲ ਡੇਟਾ ਕਿਸੇ AI ਪ੍ਰਦਾਤਾ ਨੂੰ ਨਹੀਂ ਭੇਜਿਆ ਜਾਂਦਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este análisis usa reglas locales. No se envían datos de archivos a ningún proveedor de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette analyse utilise des règles locales. Aucune donnée de fichier n'est envoyée à un fournisseur d'IA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Scan nutzt lokale Regeln. Dateidaten werden nicht an einen KI-Anbieter gesendet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta análise usa regras locais. Nenhum dado de arquivo é enviado a um provedor de IA."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa scansione usa regole locali. I dati dei file non vengono inviati a un provider IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキャンはローカルルールを使用します。ファイルデータは AI プロバイダに送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스캔은 로컬 규칙을 사용합니다. 파일 데이터는 AI 공급자에게 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次扫描使用本地规则，不会将文件数据发送至 AI 服务商。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом сканировании используются локальные правила. Данные файлов не отправляются поставщику ИИ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم هذا الفحص قواعد محلية. لا تُرسل بيانات الملفات إلى مزوّد ذكاء اصطناعي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סריקה זו משתמשת בכללים מקומיים. נתוני קבצים אינם נשלחים לספק בינה מלאכותית."
          }
        }
      }
    },
    "This selection cannot be changed. Scan again if the results are out of date.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This selection cannot be changed. Scan again if the results are out of date."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस चयन को बदला नहीं जा सकता। यदि परिणाम पुराने हो गए हैं तो फिर से स्कैन करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই নির্বাচন পরিবর্তন করা যাবে না। ফলাফল পুরনো হলে আবার স্ক্যান করুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தத் தேர்வை மாற்ற முடியாது. முடிவுகள் பழையதாக இருந்தால் மீண்டும் ஸ்கேன் செய்யவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఎంపికను మార్చలేరు. ఫలితాలు పాతవిగా ఉంటే మళ్లీ స్కాన్ చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ही निवड बदलता येत नाही. निकाल जुने असल्यास पुन्हा स्कॅन करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પસંદગી બદલી શકાતી નથી. પરિણામો જૂના હોય તો ફરી સ્કૅન કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಆಯ್ಕೆಯನ್ನು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಫಲಿತಾಂಶಗಳು ಹಳೆಯದಾಗಿದ್ದರೆ ಮತ್ತೆ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ തിരഞ്ഞെടുപ്പ് മാറ്റാനാകില്ല. ഫലങ്ങൾ പഴയതാണെങ്കിൽ വീണ്ടും സ്കാൻ ചെയ്യുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਚੋਣ ਬਦਲੀ ਨਹੀਂ ਜਾ ਸਕਦੀ। ਨਤੀਜੇ ਪੁਰਾਣੇ ਹੋਣ 'ਤੇ ਦੁਬਾਰਾ ਸਕੈਨ ਕਰੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta selección no se puede cambiar. Analiza de nuevo si los resultados están desactualizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sélection ne peut pas être modifiée. Relancez l'analyse si les résultats ne sont plus à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auswahl kann nicht geändert werden. Scanne erneut, falls die Ergebnisse veraltet sind."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta seleção não pode ser alterada. Analise novamente se os resultados estiverem desatualizados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa selezione non può essere modificata. Avvia una nuova scansione se i risultati non sono aggiornati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この選択は変更できません。結果が古い場合は再スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 선택은 변경할 수 없습니다. 결과가 오래되었다면 다시 스캔하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改此选择。若结果已过时，请重新扫描。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот выбор нельзя изменить. Просканируйте снова, если результаты устарели."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير هذا التحديد. افحص مجددًا إذا كانت النتائج قديمة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשנות בחירה זו. סרקו שוב אם התוצאות אינן עדכניות."
          }
        }
      }
    },
