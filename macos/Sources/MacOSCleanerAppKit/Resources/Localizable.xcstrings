            }
          }
        },
        "bn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lldটি কাজের সিদ্ধান্ত আপডেট করুন। কোনো ফাইল পরিবর্তন হবে না।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lldটি কাজের সিদ্ধান্ত আপডেট করুন। কোনো ফাইল পরিবর্তন হবে না।"
