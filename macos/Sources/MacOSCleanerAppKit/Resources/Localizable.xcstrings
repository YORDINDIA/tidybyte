    "Use Restore in the history list. Recovery depends on the files remaining available.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Restore in the history list. Recovery depends on the files remaining available."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास सूची में पुनर्स्थापित करें का उपयोग करें। पुनर्प्राप्ति इस बात पर निर्भर करती है कि फ़ाइलें अभी भी उपलब्ध हैं या नहीं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইতিহাস তালিকায় পুনরুদ্ধার করুন ব্যবহার করুন। পুনরুদ্ধার ফাইলগুলো উপলব্ধ থাকার ওপর নির্ভর করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரலாற்றுப் பட்டியலில் மீட்டெடுப்பைப் பயன்படுத்தவும். மீட்பு கோப்புகள் இருப்பதைப் பொறுத்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చరిత్ర జాబితాలో పునరుద్ధరించండి ఉపయోగించండి. పునరుద్ధరణ ఫైళ్లు అందుబాటులో ఉండటంపై ఆధారపడి ఉంటుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास सूचीमध्ये पुनर्संचयित करा वापरा. पुनर्प्राप्ती फाइल्स उपलब्ध राहण्यावर अवलंबून असते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇતિહાસ યાદીમાં પુનઃસ્થાપિત કરો વાપરો. પુનઃપ્રાપ્તિ ફાઇલો ઉપલબ્ધ રહેવા પર આધાર રાખે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತಿಹಾಸ ಪಟ್ಟಿಯಲ್ಲಿ ಮರುಸ್ಥಾಪಿಸಿ ಬಳಸಿ. ಮರುಪಡೆಯುವಿಕೆ ಫೈಲ್‌ಗಳು ಲಭ್ಯವಿರುವುದನ್ನು ಅವಲಂಬಿಸಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചരിത്ര പട്ടികയിൽ പുനഃസ്ഥാപിക്കുക ഉപയോഗിക്കുക. വീണ്ടെടുക്കൽ ഫയലുകൾ ലഭ്യമായിരിക്കുന്നതിനെ ആശ്രയിച്ചിരിക്കുന്നു."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਤਿਹਾਸ ਸੂਚੀ ਵਿੱਚ ਬਹਾਲ ਕਰੋ ਵਰਤੋ। ਬਹਾਲੀ ਫਾਈਲਾਂ ਦੇ ਉਪਲਬਧ ਰਹਿਣ 'ਤੇ ਨਿਰਭਰ ਕਰਦੀ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Restaurar en la lista del historial. La recuperación depende de que los archivos sigan disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Restaurer dans la liste de l'historique. La récupération dépend de la disponibilité des fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende „Wiederherstellen“ in der Verlaufsliste. Die Wiederherstellung hängt davon ab, dass die Dateien noch verfügbar sind."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Restaurar na lista do histórico. A recuperação depende de os arquivos continuarem disponíveis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Ripristina nell'elenco cronologia. Il recupero dipende dal fatto che i file siano ancora disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴リストの「復元」を使用してください。復元できるかどうかはファイルが残っているかによります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 목록에서 복원을 사용하세요. 복구는 파일이 아직 남아 있는지에 따라 달라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在历史记录列表中使用“还原”。能否恢复取决于文件是否仍存在。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Восстановить» в списке истории. Восстановление возможно, пока файлы остаются доступными."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «استعادة» في قائمة السجل. يعتمد الاسترداد على بقاء الملفات متوفرة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו בשחזור מתוך רשימת ההיסטוריה. השחזור תלוי בכך שהקבצים עדיין זמינים."
          }
        }
      }
    },
