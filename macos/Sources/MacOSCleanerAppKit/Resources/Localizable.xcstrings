    "Run a Photos & Media scan to refresh this breakdown.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a Photos & Media scan to refresh this breakdown."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस विवरण को ताज़ा करने के लिए फ़ोटो और मीडिया स्कैन चलाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই বিবরণ রিফ্রেশ করতে একটি ফটো ও মিডিয়া স্ক্যান চালান।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பிரிவைப் புதுப்பிக்க புகைப்படங்கள் & மீடியா ஸ்கேனை இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ వివరాన్ని రిఫ్రెష్ చేయడానికి ఫోటోలు & మీడియా స్కాన్ అమలు చేయండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हा तपशील ताजा करण्यासाठी फोटो आणि मीडिया स्कॅन चालवा."
