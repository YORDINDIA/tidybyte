          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह सफ़ाई बताएं जिसकी आप समीक्षा करना चाहते हैं। यह फ़ाइलों को नहीं, केवल योजना को बदलता है।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে ক্লিনআপ পর্যালোচনা করতে চান তা বর্ণনা করুন। এটি ফাইল নয়, কেবল পরিকল্পনা পরিবর্তন করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் மதிப்பாய்வு செய்ய விரும்பும் சுத்திகரிப்பை விவரிக்கவும். இது உங்கள் கோப்புகளை அல்ல, திட்டத்தை மட்டுமே மாற்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు సమీక్షించాలనుకుంటున్న శుభ్రతను వివరించండి. ఇది మీ ఫైళ్లను కాదు, ప్రణాళికను మాత్రమే మారుస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला ज्या क्लीनअपचे पुनरावलोकन करायचे आहे त्याचे वर्णन करा. हे तुमच्या फाइल्स नव्हे, फक्त योजना बदलते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જે ક્લીનઅપની સમીક્ષા કરવા માંગો છો તેનું વર્ણન કરો. આ તમારી ફાઇલોને નહીં, માત્ર યોજનાને બદલે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಪರಿಶೀಲಿಸಲು ಬಯಸುವ ಸ್ವಚ್ಛತೆಯನ್ನು ವಿವರಿಸಿ. ಇದು ನಿಮ್ಮ ಫೈಲ್‌ಗಳನ್ನಲ್ಲ, ಯೋಜನೆಯನ್ನು ಮಾತ್ರ ಬದಲಾಯಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അവലോകനം ചെയ്യാൻ ആഗ്രഹിക്കുന്ന വൃത്തിയാക്കൽ വിവരിക്കുക. ഇത് നിങ്ങളുടെ ഫയലുകളെയല്ല, പ്ലാനിനെ മാത്രമേ മാറ്റുകയുള്ളൂ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਹ ਸਫਾਈ ਦੱਸੋ ਜਿਸਦੀ ਤੁਸੀਂ ਸਮੀਖਿਆ ਕਰਨਾ ਚਾਹੁੰਦੇ ਹੋ। ਇਹ ਤੁਹਾਡੀਆਂ ਫਾਈਲਾਂ ਨਹੀਂ, ਕੇਵਲ ਯੋਜਨਾ ਬਦਲਦਾ ਹੈ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe la limpieza que quieres revisar. Esto modifica el plan, no tus archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez le nettoyage à examiner. Cela ajuste le plan, sans toucher à vos fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe die Bereinigung, die du prüfen möchtest. Das ändert den Plan, nicht deine Dateien."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva a limpeza que você deseja revisar. Isso altera o plano, não seus arquivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi la pulizia da esaminare. Questo modifica il piano, non i tuoi file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認したいクリーンアップ内容を入力してください。ファイルではなくプランが更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토하려는 정리 내용을 설명하세요. 파일이 아닌 계획이 변경됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述您想审阅的清理内容。这只会更新计划，不会改动您的文件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите нужную очистку. Это обновит план, не затрагивая ваши файлы."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صف التنظيف الذي تريد مراجعته. يغيّر هذا الخطة وليس ملفاتك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תארו את הניקוי שברצונכם לבדוק. פעולה זו משנה את התוכנית, לא את הקבצים."
          }
        }
      }
    },
    "Describe what to clean in your own words": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what to clean in your own words"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने शब्दों में बताएं कि क्या साफ़ करना है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিজের ভাষায় কী পরিষ্কার করতে চান তা লিখুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எதைச் சுத்தம் செய்ய வேண்டும் என்பதை உங்கள் சொந்த வார்த்தைகளில் விவரிக்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏమి శుభ్రం చేయాలో మీ స్వంత మాటల్లో వివరించండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काय साफ करायचे आहे ते तुमच्या स्वतःच्या शब्दांत लिहा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શું સાફ કરવું છે તે તમારા પોતાના શબ્દોમાં લખો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಏನನ್ನು ಸ್ವಚ್ಛಗೊಳಿಸಬೇಕೆಂದು ನಿಮ್ಮ ಸ್ವಂತ ಪದಗಳಲ್ಲಿ ವಿವರಿಸಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എന്താണ് വൃത്തിയാക്കേണ്ടതെന്ന് നിങ്ങളുടെ സ്വന്തം വാക്കുകളിൽ വിവരിക്കുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਸ਼ਬਦਾਂ ਵਿੱਚ ਦੱਸੋ ਕਿ ਕੀ ਸਾਫ਼ ਕਰਨਾ ਹੈ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe con tus palabras qué quieres limpiar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez avec vos mots ce qu'il faut nettoyer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe in eigenen Worten, was bereinigt werden soll"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva com suas palavras o que limpar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi con parole tue cosa pulire"
          }
        },
        "ja": {
          "stringUnit": {
