    "Build folders, package caches, and simulator data.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build folders, package caches, and simulator data."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्ड फ़ोल्डर, पैकेज कैश और सिम्युलेटर डेटा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিল্ড ফোল্ডার, প্যাকেজ ক্যাশ এবং সিমুলেটর ডেটা।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உருவாக்கக் கோப்புறைகள், தொகுப்பு கேச்கள் மற்றும் சிமுலேட்டர் தரவு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "బిల్డ్ ఫోల్డర్లు, ప్యాకేజీ క్యాష్‌లు మరియు సిమ్యులేటర్ డేటా."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्ड फोल्डर्स, पॅकेज कॅशे आणि सिम्युलेटर डेटा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બિલ્ડ ફોલ્ડર્સ, પૅકેજ કૅશ અને સિમ્યુલેટર ડેટા."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬಿಲ್ಡ್ ಫೋಲ್ಡರ್‌ಗಳು, ಪ್ಯಾಕೇಜ್ ಕ್ಯಾಶ್‌ಗಳು ಮತ್ತು ಸಿಮ್ಯುಲೇಟರ್ ಡೇಟಾ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബിൽഡ് ഫോൾഡറുകൾ, പാക്കേജ് ക്യാഷുകൾ, സിമുലേറ്റർ ഡാറ്റ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬਿਲਡ ਫੋਲਡਰ, ਪੈਕੇਜ ਕੈਸ਼ ਅਤੇ ਸਿਮੂਲੇਟਰ ਡੇਟਾ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpetas de compilación, cachés de paquetes y datos de simuladores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossiers de compilation, caches de paquets et données de simulateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build-Ordner, Paket-Caches und Simulator-Daten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas de compilação, caches de pacotes e dados de simuladores."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartelle di build, cache dei pacchetti e dati dei simulatori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドフォルダ、パッケージキャッシュ、シミュレータデータ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드 폴더, 패키지 캐시 및 시뮬레이터 데이터."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建文件夹、包缓存和模拟器数据。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папки сборок, кэши пакетов и данные симуляторов."
