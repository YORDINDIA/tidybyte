        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বড় ফাইল, পুরনো ডাউনলোড এবং ইনস্টলার।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பெரிய கோப்புகள், பழைய பதிவிறக்கங்கள் மற்றும் நிறுவிகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పెద్ద ఫైళ్లు, పాత డౌన్‌లోడ్‌లు మరియు ఇన్‌స్టాలర్‌లు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मोठ्या फाइल्स, जुने डाउनलोड्स आणि इन्स्टॉलर्स."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મોટી ફાઇલો, જૂના ડાઉનલોડ્સ અને ઇન્સ્ટૉલર્સ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದೊಡ್ಡ ಫೈಲ್‌ಗಳು, ಹಳೆಯ ಡೌನ್‌ಲೋಡ್‌ಗಳು ಮತ್ತು ಇನ್‌ಸ್ಟಾಲರ್‌ಗಳು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വലിയ ഫയലുകൾ, പഴയ ഡൗൺലോഡുകൾ, ഇൻസ്റ്റാളറുകൾ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵੱਡੀਆਂ ਫਾਈਲਾਂ, ਪੁਰਾਣੇ ਡਾਊਨਲੋਡਸ ਅਤੇ ਇੰਸਟਾਲਰ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos grandes, descargas antiguas e instaladores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers volumineux, anciens téléchargements et installateurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Dateien, alte Downloads und Installationsprogramme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos grandes, downloads antigos e instaladores."
          }
        },
        "it": {
          "stringUnit": {
