    "For example, find old installers": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example, find old installers"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उदाहरण के लिए, पुराने इंस्टॉलर खोजें"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উদাহরণস্বরূপ, পুরনো ইনস্টলার খুঁজুন"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எடுத்துக்காட்டாக, பழைய நிறுவிகளைக் கண்டறிக"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఉదాహరణకు, పాత ఇన్‌స్టాలర్లను కనుగొనండి"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उदाहरणार्थ, जुने इन्स्टॉलर्स शोधा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઉદાહરણ તરીકે, જૂના ઇન્સ્ટૉલર્સ શોધો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉದಾಹರಣೆಗೆ, ಹಳೆಯ ಇನ್‌ಸ್ಟಾಲರ್‌ಗಳನ್ನು ಹುಡುಕಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉദാഹരണത്തിന്, പഴയ ഇൻസ്റ്റാളറുകൾ കണ്ടെത്തുക"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਉਦਾਹਰਨ ਲਈ, ਪੁਰਾਣੇ ਇੰਸਟਾਲਰ ਲੱਭੋ"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo, buscar instaladores antiguos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple, trouver d'anciens installateurs"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel: alte Installationsdateien finden"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo, encontrar instaladores antigos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad esempio, trova vecchi programmi di installazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: 古いインストーラを探す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 오래된 설치 프로그램 찾기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：查找旧版安装器"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например, найти старые установщики"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلًا، العثور على برامج التثبيت القديمة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לדוגמה, מצאו קבצי התקנה ישנים"
          }
        }
      }
    },
