    "See the latest execution errors in History for failure details.": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the latest execution errors in History for failure details."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विफलता के विवरण के लिए इतिहास में नवीनतम निष्पादन त्रुटियाँ देखें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যর্থতার বিবরণের জন্য ইতিহাসে সর্বশেষ কার্যকর ত্রুটিগুলো দেখুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோல்வி விவரங்களுக்கு வரலாற்றில் சமீபத்திய செயல்படுத்தல் பிழைகளைப் பார்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "విఫలమైన వివరాల కోసం చరిత్రలో తాజా అమలు లోపాలను చూడండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अयशस्वीतेच्या तपशीलांसाठी इतिहासातील ताज्या अंमलबजावणी त्रुटी पहा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નિષ્ફળતાની વિગતો માટે ઇતિહાસમાં તાજેતરની અમલ ભૂલો જુઓ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವಿಫಲತೆಯ ವಿವರಗಳಿಗಾಗಿ ಇತಿಹಾಸದಲ್ಲಿ ಇತ್ತೀಚಿನ ಕಾರ್ಯಗತಗೊಳಿಸುವಿಕೆ ದೋಷಗಳನ್ನು ನೋಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പരാജയ വിശദാംശങ്ങൾക്ക് ചരിത്രത്തിലെ ഏറ്റവും പുതിയ നടപ്പാക്കൽ പിശകുകൾ കാണുക."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਸਫਲਤਾ ਦੇ ਵੇਰਵਿਆਂ ਲਈ ਇਤਿਹਾਸ ਵਿੱਚ ਤਾਜ਼ਾ ਅਮਲ ਗਲਤੀਆਂ ਵੇਖੋ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta los últimos errores de ejecución en Historial para ver los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les dernières erreurs d'exécution dans l'Historique pour plus de détails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir die letzten Ausführungsfehler im Verlauf für Details an."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja os erros de execução mais recentes no Histórico para detalhes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta gli ultimi errori di esecuzione in Cronologia per i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗の詳細は履歴の最新の実行エラーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패 세부 정보는 기록의 최근 실행 오류를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“历史”中查看最新执行错误以了解失败详情。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробности ошибок смотрите в последних записях «Истории»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على أحدث أخطاء التنفيذ في السجل لمعرفة تفاصيل الفشل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ראו את שגיאות הביצוע האחרונות בהיסטוריה לפרטי התקלה."
          }
        }
      }
    },
