---
// The marketing landing page body, as a real Astro component.
//
// One page for both apps: the hero, stats, and toolkit cover iPhone and Mac
// together, and the two app replicas are rebuilt in HTML/CSS right here —
// the iPhone's four tabs and the Mac window's four screens are switchable
// with radio inputs and CSS only (the .ios-demo / .mac-home-demo blocks at
// the bottom of src/input.css), so the demos work with JavaScript disabled
// and arrow keys move between screens.
//
// This component is the SOURCE OF TRUTH for the landing page's translatable
// copy: scripts/localization/site/extract-site-strings.mjs pulls the strings
// out of this file, and build-site-translations.mjs writes one translated
// component per language to src/content/pages/index.<slug>.astro (plus the
// English index.html snapshot the llms.txt / *.md endpoints read). Every
// label you add here needs a translation in all 20
// scripts/localization/site/site-translations/<lang>.json files or the
// build fails; unit symbols, disk/file names, and glyph entities that read
// the same everywhere stay English via keep-literal.mjs.
interface Props {
  /** The rendered "Quick answer" box, built from the page description. */
  quickAnswer?: string;
  iosVersion: string;
}
const { quickAnswer = "", iosVersion } = Astro.props;
---
<main id="main">
<!-- Announcement bar: pill + link. Semantic tokens only — flips with theme. -->
<div class="border-b border-hairline bg-surface-soft/80 backdrop-blur-sm">
  <div class="container-prose flex items-center justify-center py-2.5">
    <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center text-xs text-body sm:text-sm">
      <span class="badge shadow-sm">
        <span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-clay-pink ring-4 ring-clay-pink/15"></span>
        {iosVersion}
      </span>
      <a href="/changelog" class="link group inline-flex items-center gap-1 whitespace-nowrap">Veja o que mudou &rarr;</a>
    </p>
  </div>
</div>

<!-- Hero. Above the fold: no scroll-reveal attributes on the h1 — renders
     fully without JS. One app per screen, one promise for both: the mock
     devices to the right are pure HTML/CSS replicas of the real apps (the
     same screens their sections below let you click through), so the page
     shows the product with zero image weight. -->
<section class="relative overflow-hidden">
  <div aria-hidden="true" class="absolute inset-x-0 -top-24 -z-10 h-[520px] bg-hero-glow"></div>
  <div class="container-prose grid items-center gap-12 pb-16 pt-12 sm:pt-20 lg:grid-cols-[0.98fr_1.02fr] lg:gap-10 lg:pb-24">
    <div>
      <p class="badge shadow-sm" data-rise style="--in:0">
        <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="text-clay-pink"><circle cx="12" cy="12" r="5"/></svg>
        Grátis &middot; iPhone &amp; iPad &middot; Mac &middot; iOS 17+ &amp; macOS 26
      </p>
      <svg aria-hidden="true" focusable="false" width="76" height="10" viewBox="0 0 76 10" fill="none" class="mt-2.5 block text-clay-pink" data-rise style="--in:1"><path d="M2 7c6-5.5 11-5.5 17 0s11 5.5 17 0 11-5.5 17 0 11 5 21-1" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
      <h1 class="h-display mt-5">O melhor limpador de armazenamento gratuito para iPhone e Mac.</h1>
      <p class="lede mt-5 max-w-prose">No iPhone, deslize pelas fotos e recupere gigas em minutos. No Mac, limpe caches, arquivos de desenvolvedor, duplicados e sobras de apps. Tudo roda no seu dispositivo. Sem anúncios, sem assinatura, sem conta.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3" data-rise style="--in:3">
        <a href="https://apps.apple.com/app/id6775769763" class="btn-primary px-6 py-3" target="_blank" rel="noopener">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.46 2.23-1.21 3.05-.81.87-2.14 1.55-3.23 1.46-.14-1.1.4-2.25 1.16-3.04.85-.89 2.29-1.55 3.28-1.47Zm3.61 16.04c-.6 1.39-1.31 2.62-2.18 3.66-1.13 1.39-2.46 3.05-4.25 3.07-1.7.02-2.14-.99-4.46-.99-2.32 0-2.8 1.01-4.5.99-1.79-.02-3.15-1.6-4.28-2.99-2.6-3.2-4.59-9.05-1.92-12.99 1.32-1.95 3.69-3.18 6.25-3.22 1.78-.04 3.46 1.05 4.55 1.05 1.08 0 3.13-1.3 5.28-1.11.9.04 3.43.36 5.05 2.71-.13.08-3.02 1.76-2.99 5.25.04 4.17 3.66 5.55 3.45 5.57Z"/></svg>
          Baixe o TidyByte grátis
        </a>
        <a href="/mac" class="btn-ghost px-6 py-3">Baixar para Mac</a>
      </div>
      <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted" data-rise style="--in:4">
        <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-success/15 text-success"><svg aria-hidden="true" focusable="false" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>Sem anúncios</span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-success/15 text-success"><svg aria-hidden="true" focusable="false" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>Sem conta</span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-success/15 text-success"><svg aria-hidden="true" focusable="false" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>Nenhuma foto é enviada ao TidyByte</span>
      </p>
    </div>

    <!-- Hero devices: Mac window cleanly framed at start-top so traffic lights,
         titlebar, sidebar, and disk bar stay 100% readable; titanium iPhone
         anchored at bottom-end with layered foreground depth. -->
    <div class="relative mx-auto hidden w-full max-w-[590px] pb-10 sm:block" data-settle style="--in:1" role="img" aria-label="TidyByte no iPhone no meio de um deslizamento, diante da janela de Visão geral do TidyByte para Mac.">
      <div aria-hidden="true" class="pointer-events-none absolute -inset-6 -z-10 rounded-full bg-[radial-gradient(circle_at_30%_35%,rgba(10,132,255,0.16),transparent_58%),radial-gradient(circle_at_78%_68%,rgba(255,77,139,0.16),transparent_58%)] blur-2xl"></div>

      <!-- Mac window: top-start, full-height NavigationSplitView sidebar -->
      <div aria-hidden="true" class="me-auto ms-0 w-[84%]">
        <div class="mac-home-window flex overflow-hidden rounded-2xl">
          <div class="flex w-[34%] shrink-0 flex-col border-e border-white/[0.08] bg-[#151517]/95">
            <div class="flex h-8 items-center justify-between px-3">
              <div class="flex items-center gap-1.5">
                <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57] ring-1 ring-inset ring-black/20"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e] ring-1 ring-inset ring-black/20"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#28c840] ring-1 ring-inset ring-black/20"></span>
              </div>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-white/55 rtl:-scale-x-100"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M9 4v16"/></svg>
            </div>
            <div class="px-2.5 pb-2.5">
              <div class="flex items-center gap-1.5 rounded-md bg-white/[0.12] px-2 py-1 text-[10px] font-semibold text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#5cb0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 14h18"/><circle cx="17" cy="16.5" r="0.9" fill="#5cb0ff" stroke="none"/></svg>
                <span class="truncate">Visão geral</span>
              </div>
              <div class="mt-2 space-y-1 text-[10px] text-white/65">
                <div class="flex items-center gap-1.5 px-2 py-0.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#ff453a" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13"/></svg><span class="truncate">Lixo do sistema</span></div>
                <div class="flex items-center justify-between gap-1 px-2 py-0.5"><span class="flex min-w-0 items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#bf5af2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 12l-9.5 9.5a1.8 1.8 0 0 1-2.5-2.5L12.5 9.5"/><path d="M17.5 6.5l2.5 2.5-3.5 3.5-5-5 2-2a4.5 4.5 0 0 1 6-.5l-2 1.5z"/></svg><span class="truncate">Desenvolvedor</span></span><span dir="ltr" class="inline-flex shrink-0 items-baseline gap-0.5 text-[8px] tabular-nums text-white/55"><span>11.2</span> <span>GB</span></span></div>
                <div class="flex items-center gap-1.5 px-2 py-0.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#5cb0ff" stroke-width="2"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg><span class="truncate">Duplicatas</span></div>
                <div class="flex items-center gap-1.5 px-2 py-0.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l6.5 3.5"/></svg><span class="truncate">Explorador de Espaço</span></div>
              </div>
            </div>
          </div>
          <div class="flex min-w-0 flex-1 flex-col bg-[#1b1b1e]">
            <div class="flex h-8 items-center justify-between border-b border-white/[0.08] bg-[#242427] px-3">
              <span class="text-[11px] font-semibold tracking-tight text-white/85">TidyByte</span>
              <span class="rounded-full bg-white/[0.07] px-2 py-0.5 text-[9px] font-medium text-white/70">macOS 26</span>
            </div>
            <div class="flex-1 space-y-2.5 p-3">
              <div class="rounded-xl border border-white/[0.06] bg-[#262629] p-2.5">
                <div class="flex items-center justify-between text-[10px] font-semibold text-white"><span>Macintosh HD</span><span dir="ltr" class="inline-flex items-baseline gap-0.5 font-normal tabular-nums text-white/70"><span>7.59</span> <span>GB</span></span></div>
                <div class="mt-2 flex h-1.5 gap-[1.5px] overflow-hidden rounded-full bg-white/10">
                  <span class="h-full w-[42%] rounded-s-full bg-[#0a84ff]"></span>
                  <span class="h-full w-[18%] bg-[#bf5af2]"></span>
                  <span class="h-full w-[14%] bg-[#30d158]"></span>
                  <span class="h-full w-[11%] bg-[#ff9f0a]"></span>
                  <span class="h-full w-[8%] bg-[#636366]"></span>
                </div>
              </div>
              <div class="rounded-xl border border-white/[0.06] bg-[#222225] p-3.5 text-start">
                <div class="flex h-7 w-7 items-center justify-center rounded-full bg-[#0a84ff]/15">
                  <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5cb0ff" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35M11 8v6M8 11h6"/></svg>
                </div>
                <p class="mt-2 text-[11px] font-semibold text-white">Descubra o que você pode limpar</p>
                <p class="mt-1 w-3/4 text-[9px] leading-snug text-white/60">Caches, sobras, duplicados, arquivos grandes.</p>
                <div class="mt-2.5 w-fit rounded-lg bg-[#0066cc] px-3 py-1 text-[10px] font-semibold text-white shadow-[0_4px_14px_rgba(0,102,204,0.35)]">Escanear meu Mac</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- iPhone, front and inset at bottom-end: titanium chassis + Dynamic Island + waterfall card -->
      <div aria-hidden="true" class="absolute -bottom-3 -end-1 w-[36%] max-w-[196px] lg:-end-4">
        <div class="sim-iphone sim-iphone--hero">
          <div class="sim-iphone__screen">
            <div class="sim-iphone__sheen"></div>
            <div dir="ltr" class="flex items-center justify-between px-3 pt-2 text-[8.5px] font-semibold text-white/90">
              <span>12:05</span>
              <div class="sim-iphone__island"><span class="sim-iphone__lens"></span></div>
              <span class="flex items-center gap-1 text-white/90">
                <svg width="10" height="8" viewBox="0 0 14 10" fill="currentColor"><rect x="0" y="6" width="2.2" height="4" rx=".6"/><rect x="3.5" y="4" width="2.2" height="6" rx=".6"/><rect x="7" y="2" width="2.2" height="8" rx=".6"/><rect x="10.5" y="0" width="2.2" height="10" rx=".6"/></svg>
                <svg width="13" height="8" viewBox="0 0 20 11" fill="none"><rect x=".75" y="1" width="16" height="9" rx="2.2" stroke="currentColor" stroke-width="1.3"/><rect x="2.2" y="2.5" width="11.5" height="6" rx="1" fill="currentColor"/><path d="M18 3.8v3.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </div>
            <div class="flex items-center justify-between px-2.5 pt-1.5">
              <div class="flex items-center gap-1">
                <span class="flex h-4 w-4 items-center justify-center rounded-full bg-[#242426] text-[8px] text-white/85 ring-1 ring-white/10 rtl:-scale-x-100">&#x2039;</span>
                <span class="rounded-full border border-white/10 bg-[#242426] px-1.5 py-0.5 text-[7px] font-semibold text-[#ff6961]">Encerrar</span>
              </div>
              <span class="truncate px-1 text-[8px] font-semibold text-white">Sessão de deslizes</span>
              <span class="flex h-4 w-4 items-center justify-center rounded-full bg-[#242426] text-white/60 ring-1 ring-white/10"><svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg></span>
            </div>
            <div class="mx-2.5 mt-2 aspect-[3/3.9] overflow-hidden rounded-xl shadow-[0_8px_20px_rgba(0,0,0,0.45)]">
              <svg viewBox="0 0 240 310" class="block h-full w-full" preserveAspectRatio="xMidYMid slice">
                <defs>
                  <linearGradient id="hero-wf-sky" x1="0" y1="0" x2=".15" y2="1"><stop offset="0%" stop-color="#ded8eb"/><stop offset="50%" stop-color="#b4a7cb"/><stop offset="100%" stop-color="#766a90"/></linearGradient>
                  <linearGradient id="hero-wf-rock" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#605466"/><stop offset="100%" stop-color="#352d3c"/></linearGradient>
                  <linearGradient id="hero-wf-moss" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6c8248"/><stop offset="100%" stop-color="#3b5026"/></linearGradient>
                  <linearGradient id="hero-wf-water" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ffffff"/><stop offset="48%" stop-color="#ece8f8"/><stop offset="100%" stop-color="#c3b8dd" stop-opacity=".22"/></linearGradient>
                  <radialGradient id="hero-wf-spray" cx="56%" cy="74%" r="38%"><stop offset="0%" stop-color="#efeaf9" stop-opacity=".85"/><stop offset="55%" stop-color="#b8add3" stop-opacity=".38"/><stop offset="100%" stop-color="#6e638a" stop-opacity="0"/></radialGradient>
                  <filter id="hero-wf-mist" x="-25%" y="-25%" width="150%" height="150%"><feGaussianBlur stdDeviation="10"/></filter>
                </defs>
                <rect width="240" height="310" fill="url(#hero-wf-sky)"/>
                <ellipse cx="70" cy="36" rx="110" ry="30" fill="#efeaf8" opacity=".45"/>
                <path d="M0 68 C45 58 95 62 135 58 L240 50 L240 240 L0 240 Z" fill="url(#hero-wf-rock)"/>
                <!-- Basalt rock strata -->
                <path d="M0 84 C36 78 78 85 126 78 L128 94 C80 100 38 94 0 98 Z" fill="#4b4052" opacity=".78"/>
                <path d="M0 108 C42 100 84 110 124 102 L126 120 C84 128 40 118 0 124 Z" fill="#393040" opacity=".72"/>
                <path d="M0 134 C38 128 82 136 120 130 L122 146 C78 154 36 144 0 150 Z" fill="#514558" opacity=".68"/>
                <path d="M0 162 C44 156 80 164 118 158 L120 178 C78 184 38 174 0 180 Z" fill="#352c3b" opacity=".65"/>
                <path d="M4 96 C40 91 80 96 122 90" stroke="#7a6d82" stroke-width="1.1" stroke-opacity=".45" fill="none"/>
                <path d="M0 122 C42 117 82 123 120 117" stroke="#786b80" stroke-width="1" stroke-opacity=".4" fill="none"/>
                <path d="M12 102 C36 98 56 104 78 100 L76 112 C54 116 32 110 12 114 Z" fill="#5b723a" opacity=".62"/>
                <path d="M62 142 C86 138 104 142 120 138 L120 154 C98 158 80 152 62 154 Z" fill="#4e6632" opacity=".58"/>
                <path d="M132 62 C168 56 205 52 240 48 L240 230 L152 230 C142 165 138 110 132 62 Z" fill="url(#hero-wf-moss)"/>
                <path d="M168 82 C196 74 220 76 240 70 L240 165 C210 155 186 120 168 82 Z" fill="#7c9352" opacity=".45"/>
                <!-- Multi-strand waterfall spray -->
                <path d="M124 62 C132 60 144 62 150 66 C160 118 168 176 176 238 L108 238 C114 172 118 114 124 62 Z" fill="url(#hero-wf-water)"/>
                <path d="M128 65 C134 118 139 175 142 228" stroke="#ffffff" stroke-width="3.2" stroke-opacity=".8" stroke-linecap="round" fill="none"/>
                <path d="M136 66 C143 120 148 176 152 228" stroke="#ffffff" stroke-width="2.2" stroke-opacity=".62" stroke-linecap="round" fill="none"/>
                <path d="M144 69 C152 122 158 178 163 226" stroke="#f7f5fc" stroke-width="1.6" stroke-opacity=".48" stroke-linecap="round" fill="none"/>
                <path d="M120 76 C124 126 126 176 126 222" stroke="#e9e4f7" stroke-width="2" stroke-opacity=".55" stroke-linecap="round" fill="none"/>
                <path d="M115 98 C117 142 117 182 116 218" stroke="#dcd6ef" stroke-width="1.3" stroke-opacity=".42" stroke-linecap="round" fill="none"/>
                <!-- Soft Gaussian blur mist plumes -->
                <g filter="url(#hero-wf-mist)">
                  <ellipse cx="140" cy="212" rx="46" ry="22" fill="#f1ecfa" opacity=".72"/>
                  <ellipse cx="118" cy="224" rx="34" ry="18" fill="#dfd7f2" opacity=".62"/>
                  <ellipse cx="160" cy="222" rx="30" ry="16" fill="#ebe5f8" opacity=".55"/>
                </g>
                <rect width="240" height="310" fill="url(#hero-wf-spray)"/>
                <path d="M0 226 C55 212 105 218 156 232 C192 216 218 192 240 184 L240 310 L0 310 Z" fill="#2b3d25"/>
                <path d="M148 232 C180 198 212 172 240 162 L240 264 L148 264 Z" fill="#4f6934"/>
                <path d="M0 255 C72 240 150 258 240 242 L240 310 L0 310 Z" fill="#1d2b18"/>
                <!-- Delicate alpine wildflowers -->
                <path d="M52 282 C54 264 56 248 54 234 M54 248 C48 242 44 238 42 234 M55 244 C61 238 64 235 66 231" stroke="#628048" stroke-width="1.2" stroke-linecap="round" fill="none"/>
                <circle cx="54" cy="233" r="4.5" fill="#e8dcd4" opacity=".82"/><circle cx="42" cy="233" r="3" fill="#dec6c2" opacity=".76"/><circle cx="66" cy="231" r="2.8" fill="#e8dcd4" opacity=".72"/>
                <path d="M88 288 C88 270 90 258 88 246 M89 258 C84 253 81 250 79 247" stroke="#57743f" stroke-width="1.1" stroke-linecap="round" fill="none"/>
                <circle cx="88" cy="245" r="3.8" fill="#e2cfc8" opacity=".8"/><circle cx="79" cy="247" r="2.3" fill="#f0e6df" opacity=".7"/>
                <circle cx="72" cy="274" r="2.2" fill="#a8c796" opacity=".65"/>
              </svg>
            </div>
            <div dir="ltr" class="flex items-center justify-center gap-3 py-2.5">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#ff453a] shadow-[0_0_12px_rgba(255,69,58,0.45)]"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span>
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#636366]/85"><svg width="8" height="8" viewBox="0 0 24 24" fill="#fff"><path d="M4 5v14l8-7zM13 5v14l8-7z"/></svg></span>
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#30d158] shadow-[0_0_12px_rgba(48,209,88,0.45)]"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>
            </div>
            <div class="mx-2 mb-1.5 grid grid-cols-4 rounded-full border border-white/10 bg-[#222226]/90 p-0.5 text-[6px] font-medium text-[#c7c7cc]">
              <span class="flex flex-col items-center gap-[1px] rounded-full bg-white/[0.12] py-0.5 text-[#5cb0ff]"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="7" y="4" width="12" height="16" rx="2"/><path d="M5 8v12h9"/></svg><span>Deslizar</span></span>
