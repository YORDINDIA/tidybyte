---
// The marketing landing page body, as a real Astro component.
//
// One page for both apps: the hero, stats, and toolkit cover iPhone and Mac
// together, and the two app replicas are rebuilt in HTML/CSS right here —
// the iPhone's four tabs and the Mac window's three screens are switchable
// with radio inputs and CSS only (the .ios-demo / .mac-home-demo blocks at
// the bottom of src/input.css), so the demos work with JavaScript disabled
// and arrow keys move between screens.
//
// This component is the SOURCE OF TRUTH for the landing page's translatable
// copy: scripts/localization/site/extract-site-strings.mjs pulls the strings
// out of this file, and build-site-translations.mjs writes one translated
// component per language to src/content/pages/index.<slug>.astro (plus the
// English index.html snapshot the llms.txt / *.md endpoints read). Every
// label you add here needs a translation in all 20
// scripts/localization/site/site-translations/<lang>.json files or the
// build fails; unit symbols, disk/file names, and glyph entities that read
// the same everywhere stay English via keep-literal.mjs.
interface Props {
  /** The rendered "Quick answer" box, built from the page description. */
  quickAnswer?: string;
}
const { quickAnswer = "" } = Astro.props;
---
<main id="main">
<!-- Announcement bar: pill + link. Semantic tokens only — flips with theme. -->
<div class="border-b border-hairline bg-surface-soft">
  <div class="container-prose flex items-center justify-center py-2">
    <p class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-center text-xs text-body sm:text-sm">
      <span class="badge">
        <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="text-clay-pink"><circle cx="12" cy="12" r="5"/></svg>
        1.1.3
      </span>
      <a href="/changelog" class="link whitespace-nowrap">Voir les nouveautés &rarr;</a>
    </p>
  </div>
</div>

<!-- Hero. Above the fold: no scroll-reveal attributes on the h1 — renders
     fully without JS. One app per screen, one promise for both: the mock
     devices to the right are pure HTML/CSS replicas of the real apps (the
     same screens their sections below let you click through), so the page
     shows the product with zero image weight. -->
<section class="relative overflow-hidden">
  <div aria-hidden="true" class="absolute inset-x-0 -top-24 -z-10 h-[460px] bg-hero-glow"></div>
  <div class="container-prose grid items-center gap-12 pb-16 pt-14 sm:pt-20 lg:grid-cols-[1.02fr_0.98fr] lg:pb-24">
    <div>
      <p class="badge" data-rise style="--in:0">
        <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="text-clay-pink"><circle cx="12" cy="12" r="5"/></svg>
        Gratuit &middot; iPhone &amp; iPad &middot; Mac &middot; iOS 17+ &amp; macOS 26
      </p>
      <svg aria-hidden="true" focusable="false" width="76" height="10" viewBox="0 0 76 10" fill="none" class="mt-2 block text-clay-pink" data-rise style="--in:1"><path d="M2 7c6-5.5 11-5.5 17 0s11 5.5 17 0 11-5.5 17 0 11 5 21-1" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
      <h1 class="h-display mt-5">Le meilleur nettoyeur de stockage gratuit pour iPhone et Mac.</h1>
      <p class="lede mt-5 max-w-prose">Sur iPhone, balayez vos photos et récupérez des gigaoctets en quelques minutes. Sur Mac, effacez caches, fichiers de développeur, doublons et restes d'apps. Tout s'exécute sur votre appareil. Sans pubs, sans abonnement, sans compte.</p>
      <div class="mt-7 flex flex-wrap items-center gap-3" data-rise style="--in:3">
        <a href="https://apps.apple.com/app/id6775769763" class="btn-primary" target="_blank" rel="noopener">
          <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.46 2.23-1.21 3.05-.81.87-2.14 1.55-3.23 1.46-.14-1.1.4-2.25 1.16-3.04.85-.89 2.29-1.55 3.28-1.47Zm3.61 16.04c-.6 1.39-1.31 2.62-2.18 3.66-1.13 1.39-2.46 3.05-4.25 3.07-1.7.02-2.14-.99-4.46-.99-2.32 0-2.8 1.01-4.5.99-1.79-.02-3.15-1.6-4.28-2.99-2.6-3.2-4.59-9.05-1.92-12.99 1.32-1.95 3.69-3.18 6.25-3.22 1.78-.04 3.46 1.05 4.55 1.05 1.08 0 3.13-1.3 5.28-1.11.9.04 3.43.36 5.05 2.71-.13.08-3.02 1.76-2.99 5.25.04 4.17 3.66 5.55 3.45 5.57Z"/></svg>
          Télécharger TidyByte gratuitement
        </a>
        <a href="/mac" class="btn-ghost">Télécharger pour Mac</a>
      </div>
      <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted" data-rise style="--in:4">
        <span class="inline-flex items-center gap-1.5"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M5 12l5 5 9-11"/></svg>Sans pub</span>
        <span class="inline-flex items-center gap-1.5"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M5 12l5 5 9-11"/></svg>Sans compte</span>
        <span class="inline-flex items-center gap-1.5"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M5 12l5 5 9-11"/></svg>Aucune photo n’est envoyée à TidyByte</span>
      </p>
    </div>

    <!-- Hero devices: a static Mac window behind, the iPhone in front. Pure
         decoration (role="img" + one label); the interactive, fully labelled
         replicas live in the two sections below. Hidden entirely below sm so
         it can never crowd the h1 on mobile. -->
    <div class="relative mx-auto hidden w-full max-w-[540px] sm:block" data-settle style="--in:1" role="img" aria-label="TidyByte sur iPhone en plein balayage, devant la fenêtre Aperçu de TidyByte pour Mac.">
      <div aria-hidden="true" class="me-0 ms-auto w-[86%]">
        <!-- Mac window: title bar + sidebar + Overview pane, at hero scale. -->
        <div class="overflow-hidden rounded-2xl border border-hairline-strong bg-[#1c1c1e] shadow-pop">
          <div class="flex h-8 items-center gap-1.5 border-b border-white/10 bg-[#2a2a2c] px-3.5">
            <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
            <span class="ms-3 text-[11px] font-semibold text-white/70">TidyByte</span>
          </div>
          <div class="flex">
            <div class="w-[30%] border-e border-white/10 bg-[#141416] p-2.5">
              <div class="flex items-center gap-1.5 rounded-md bg-white/10 px-2 py-1 text-[10px] font-semibold text-white"><span class="h-2.5 w-2.5 rounded-[3px] bg-[#0a84ff]"></span><span class="truncate">Aperçu</span></div>
              <div class="mt-2 space-y-1 text-[10px] text-white/55">
                <div class="flex items-center gap-1.5 px-2 py-0.5"><span class="h-2.5 w-2.5 rounded-[3px] bg-[#ff453a]"></span><span class="truncate">Déchets système</span></div>
                <div class="flex items-center gap-1.5 px-2 py-0.5"><span class="h-2.5 w-2.5 rounded-[3px] bg-[#bf5af2]"></span><span class="truncate">Développeur</span></div>
                <div class="flex items-center gap-1.5 px-2 py-0.5"><span class="h-2.5 w-2.5 rounded-[3px] bg-[#0a84ff]"></span><span class="truncate">Doublons</span></div>
                <div class="flex items-center gap-1.5 px-2 py-0.5"><span class="h-2.5 w-2.5 rounded-[3px] bg-[#30d158]"></span><span class="truncate">Explorateur d'espace</span></div>
              </div>
            </div>
            <div class="flex-1 space-y-2.5 p-3">
              <div class="rounded-lg bg-[#2c2c2e] p-2.5">
                <div class="flex items-center justify-between text-[10px] font-semibold text-white"><span>Macintosh HD</span><span class="font-normal text-white/55"><span>7.59</span> <span>GB</span></span></div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/15"><div class="h-full w-[92%] rounded-full bg-gradient-to-r from-[#ff453a] to-[#ff9f0a]"></div></div>
              </div>
              <div class="rounded-lg bg-[#2c2c2e] p-3 text-center">
                <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0a84ff" stroke-width="2" stroke-linecap="round" class="mx-auto"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35M11 8v6M8 11h6"/></svg>
                <p class="mt-1.5 text-[11px] font-semibold text-white">Découvrez ce que vous pouvez nettoyer</p>
                <p class="mx-auto mt-1 w-4/5 text-[9px] leading-snug text-white/50">Caches, restes, doublons, fichiers volumineux.</p>
                <div class="mx-auto mt-2 w-fit rounded-md bg-[#0a84ff] px-3 py-1 text-[10px] font-semibold text-white">Scanner mon Mac</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- iPhone, front and inset: the swipe session screen. -->
      <div aria-hidden="true" class="absolute -bottom-8 -start-2 w-[38%] max-w-[210px] sm:-start-6">
        <div class="overflow-hidden rounded-[2.2rem] border-[6px] border-black bg-black shadow-pop">
          <div class="px-4 pt-3 text-[10px] font-semibold text-white/90"><span>12:05</span></div>
          <div class="flex items-center gap-2 px-3 pt-1.5">
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#2c2c2e] text-[9px] text-white/80">&#x2039;</span>
            <span class="rounded-full border border-[#ff453a]/60 px-2 py-0.5 text-[8px] font-semibold text-[#ff453a]">Terminer</span>
            <span class="text-[10px] font-semibold text-white">Session de balayage</span>
          </div>
          <div class="mx-3 mt-2 aspect-[3/4] overflow-hidden rounded-xl">
            <div class="h-full w-full bg-gradient-to-b from-[#8fb8d8] via-[#c3d8ea] to-[#eadfc8]">
              <div class="mx-auto mt-[22%] h-8 w-8 rounded-full bg-[#fff3c4] shadow-[0_0_18px_6px_rgba(255,243,196,0.55)]"></div>
              <div class="mt-[18%] h-10 w-full bg-gradient-to-t from-[#3f6f54] to-[#79a183]"></div>
            </div>
          </div>
          <div class="flex items-center justify-center gap-4 py-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#ff453a]"><svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span>
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#3a3a3c]"><svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="#fff"><path d="M4 5v14l8-7zM13 5v14l8-7z"/></svg></span>
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#30d158]"><svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>
          </div>
          <div class="flex items-center justify-around border-t border-white/10 bg-[#141416] px-2 py-1.5 text-[8px] font-medium text-[#8e8e93]">
            <span class="flex flex-col items-center gap-0.5 text-[#0a84ff]"><svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="4" width="12" height="16" rx="2"/><path d="M5 8v12h9"/></svg>Balayer</span>
            <span class="flex flex-col items-center gap-0.5"><svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.8 4.6L18 9.4l-4.2 1.8L12 15.8l-1.8-4.6L6 9.4l4.2-1.8z"/></svg>Nettoyage</span>
            <span class="flex flex-col items-center gap-0.5"><svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l6 4"/></svg>Stockage</span>
            <span class="flex flex-col items-center gap-0.5"><svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.1-1.2l2-1.5-2-3.5-2.4 1a7 7 0 0 0-2-1.2L14 3h-4l-.5 2.6a7 7 0 0 0-2 1.2l-2.4-1-2 3.5 2 1.5a7 7 0 0 0 0 2.4l-2 1.5 2 3.5 2.4-1a7 7 0 0 0 2 1.2L10 21h4l.5-2.6a7 7 0 0 0 2-1.2l2.4 1 2-3.5-2-1.5c.1-.4.1-.8.1-1.2Z"/></svg>Réglages</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Quick answer: rendered here from the page's meta description, so the
     direct answer sits above the fold for featured snippets and AI citations.
     The wrapper supplies the container width the injected box expects. -->
<section class="section-tight pt-0 sm:pt-0">
  <div class="container-prose">
    <Fragment set:html={quickAnswer} />
  </div>
</section>

<!-- Stats band. Fixes the old flex-ordering bug (order classes did nothing
     inside a block parent, so labels rendered above numbers): every stat is one
     self-contained cell with the number first and the label second, so the
     reading order is correct at every breakpoint (2 cols mobile / 4 desktop). -->
<section aria-label="TidyByte en chiffres" class="section-tight pt-0 sm:pt-0">
  <div class="container-prose">
    <ul role="list" class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-hairline bg-hairline md:grid-cols-4">
      <li class="bg-surface-card px-4 py-6 text-center sm:px-6">
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-clay-pink"><rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/></svg>
        <p class="mt-2 font-display text-3xl font-medium text-ink">12</p>
        <p class="mt-1 text-sm text-muted">outils de nettoyage</p>
      </li>
      <li class="bg-surface-card px-4 py-6 text-center sm:px-6">
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-clay-teal"><path d="M12 3l7 3v5c0 4.6-3 7.6-7 9-4-1.4-7-4.4-7-9V6l7-3z"/><path d="M9.5 11.5l2 2 3.5-4"/></svg>
        <p class="mt-2 font-display text-3xl font-medium text-ink">0</p>
        <p class="mt-1 text-sm text-muted">données photo envoyées à TidyByte</p>
      </li>
      <li class="bg-surface-card px-4 py-6 text-center sm:px-6">
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-clay-ochre"><path d="M12 2H3v9l9.3 9.3a1.5 1.5 0 0 0 2.1 0l7-7a1.5 1.5 0 0 0 0-2.1L12 2z"/><circle cx="8" cy="7" r="1" fill="currentColor" stroke="none"/></svg>
        <p class="mt-2 font-display text-3xl font-medium text-ink">$0</p>
        <p class="mt-1 text-sm text-muted">et il est à vous pour de bon</p>
      </li>
      <li class="bg-surface-card px-4 py-6 text-center sm:px-6">
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="mx-auto text-clay-lav"><path d="M12 .5C5.73.5.74 5.49.74 11.76c0 4.96 3.22 9.16 7.68 10.65.56.1.77-.24.77-.55v-1.93c-3.12.68-3.78-1.5-3.78-1.5-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.23.71-1.51-2.49-.28-5.12-1.25-5.12-5.55 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15.9-.25 1.86-.38 2.82-.39.96.01 1.92.14 2.82.39 2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.31-2.64 5.27-5.15 5.54.4.34.76 1.02.76 2.06v3.05c0 .31.2.66.78.55 4.46-1.49 7.67-5.69 7.67-10.65C23.26 5.49 18.27.5 12 .5Z"/></svg>
        <p class="mt-2 font-display text-3xl font-medium text-ink">100%</p>
        <p class="mt-1 text-sm text-muted">open source, MIT</p>
      </li>
    </ul>
  </div>
</section>

<!-- 01 · The iPhone app, replicated in HTML/CSS. The four screens are the
     real app's four tabs; the tab bar inside the phone is the switcher.
     Radio inputs and CSS only (same pattern as the Mac page's screen
     switcher): the checked radio shows its screen, so it works with no JS,
     arrow keys move between tabs, and the panels are only hidden after
     CSS loads. Nothing here is an image. -->
<section id="iphone-app" class="section scroll-mt-24 pt-0">
  <div class="container-prose">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="eyebrow">01 &mdash; L'app iPhone</p>
      <h2 class="h-section mt-3">C'est la vraie interface. Essayez-la.</h2>
      <p class="lede mt-4">Les quatre onglets de la vraie app, reconstruits pixel par pixel dans la page elle-même. Touchez un onglet : le deck de balayage, les outils de nettoyage, le tableau de bord de stockage et les réglages sont tous là.</p>
    </div>

    <fieldset class="ios-demo mx-auto mt-12 w-fit" data-reveal>
      <legend class="sr-only">TidyByte sur iPhone &mdash; écrans</legend>
      <input type="radio" name="tidy-ios" id="tidy-ios-swipe" class="sr-only" checked>
      <input type="radio" name="tidy-ios" id="tidy-ios-cleanup" class="sr-only">
      <input type="radio" name="tidy-ios" id="tidy-ios-storage" class="sr-only">
      <input type="radio" name="tidy-ios" id="tidy-ios-settings" class="sr-only">

      <div class="demo-phone w-[280px] overflow-hidden rounded-[2.6rem] border-[8px] border-black bg-black shadow-pop sm:w-[300px]">
        <div class="px-5 pt-3 text-[11px] font-semibold text-white/90"><span>12:05</span></div>

        <div class="ios-screens mx-1 mt-1 h-[430px] sm:h-[460px]">
          <!-- Screen 1: Swipe session -->
          <div data-ios="swipe" class="flex h-full flex-col">
            <div class="flex items-center gap-2 px-2.5 pt-1">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#2c2c2e] text-[11px] leading-none text-white/80">&#x2039;</span>
              <span class="rounded-full border border-[#ff453a]/60 px-2 py-0.5 text-[9px] font-semibold text-[#ff453a]">Terminer</span>
              <span class="text-[12px] font-semibold text-white">Session de balayage</span>
            </div>
            <div class="mx-3 mt-2.5 flex-1 overflow-hidden rounded-2xl">
              <div class="relative h-full w-full bg-gradient-to-b from-[#8fb8d8] via-[#c3d8ea] to-[#eadfc8]">
                <div class="absolute start-1/2 top-[24%] h-9 w-9 -translate-x-1/2 rounded-full bg-[#fff3c4] shadow-[0_0_22px_8px_rgba(255,243,196,0.55)]"></div>
                <div class="absolute inset-x-0 bottom-0 h-[46%] bg-gradient-to-t from-[#3f6f54] to-[#79a183]"></div>
                <div class="absolute bottom-1.5 start-2 text-[8px] font-medium text-white/85"><span>09.08.2012</span></div>
                <div class="absolute bottom-1.5 end-2 text-[8px] font-medium text-white/85"><span>1.9</span> <span>MB</span></div>
              </div>
            </div>
            <div class="flex items-center justify-center gap-5 py-3.5">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#ff453a]" aria-label="Supprimer"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span>
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#3a3a3c]" aria-label="Ignorer"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M4 5v14l8-7zM13 5v14l8-7z"/></svg></span>
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#30d158]" aria-label="Garder"><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>
            </div>
          </div>

          <!-- Screen 2: Cleanup tool grid -->
          <div data-ios="cleanup" class="flex h-full flex-col px-3">
