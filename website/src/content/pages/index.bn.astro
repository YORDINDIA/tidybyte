---
// The marketing landing page body, as a real Astro component.
//
// Styled with the Snaptitle crayon-and-paper (.cp / .cr / .paper) design
// system while preserving all TidyByte interactive iPhone/Mac HTML+CSS
// replicas, 21-language string extraction, and FAQ JSON-LD parity.
interface Props {
  /** The rendered "Quick answer" box, built from the page description. */
  quickAnswer?: string;
  iosVersion: string;
}
const { quickAnswer = "", iosVersion } = Astro.props;
---
<main id="main" data-home>
<!-- Release pill strip -->
<div class="pt-4 sm:pt-6">
  <div class="cp-wrap flex items-center justify-center">
    <p class="badge px-3.5 py-1.5 text-xs sm:text-sm">
      <span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-cp-orange"></span>
      <span>{iosVersion}</span>
      <span aria-hidden="true" class="text-muted-soft">&middot;</span>
      <a href="/changelog" class="link inline-flex items-center gap-1 whitespace-nowrap">কী বদলেছে দেখুন &rarr;</a>
    </p>
  </div>
</div>

<!-- Hero with floating doodles, Gaegu 120px display type, and crayon-framed showcase -->
<section class="home-hero relative">
  <div class="cp-wrap relative">
    <!-- Floating hand-drawn SVG doodles (purely decorative) -->
    <svg aria-hidden="true" focusable="false" width="74" height="74" viewBox="0 0 80 80" fill="none" class="cp-doodle cp-bob hidden start-4 top-2 lg:block" style="--rot:-6deg;--bob-delay:0s">
      <circle cx="40" cy="40" r="18" fill="#ffd23f" stroke="#121214" stroke-width="3.2"/>
      <path d="M40 9v9M40 62v9M9 40h9M62 40h9M18 18l6.5 6.5M55.5 55.5L62 62M62 18l-6.5 6.5M24.5 55.5L18 62" stroke="#ff5a14" stroke-width="3.2" stroke-linecap="round"/>
    </svg>
    <svg aria-hidden="true" focusable="false" width="92" height="58" viewBox="0 0 100 64" fill="none" class="cp-doodle cp-bob hidden end-4 top-6 lg:block" style="--rot:5deg;--bob-delay:1.2s">
      <path d="M26 50h46a14 14 0 0 0 2-27.8A18 18 0 0 0 39 16a15 15 0 0 0-13 34Z" fill="#bfe0ff" stroke="#121214" stroke-width="3.2" stroke-linejoin="round"/>
    </svg>
    <svg aria-hidden="true" focusable="false" width="60" height="60" viewBox="0 0 64 64" fill="none" class="cp-doodle cp-bob hidden start-10 top-64 xl:block" style="--rot:-10deg;--bob-delay:2.1s">
      <path d="M32 6l7.2 16.5L57 24.7 43.6 36.8 47.4 55 32 45.8 16.6 55l3.8-18.2L7 24.7l17.8-2.2Z" fill="#c9efa9" stroke="#121214" stroke-width="3.2" stroke-linejoin="round"/>
    </svg>
    <svg aria-hidden="true" focusable="false" width="58" height="54" viewBox="0 0 64 60" fill="none" class="cp-doodle cp-bob hidden end-10 top-64 xl:block" style="--rot:8deg;--bob-delay:0.8s">
      <path d="M32 52S8 37 8 20.5A12.5 12.5 0 0 1 32 15a12.5 12.5 0 0 1 24 5.5C56 37 32 52 32 52Z" fill="#ffb3a7" stroke="#121214" stroke-width="3.2" stroke-linejoin="round"/>
    </svg>

    <div class="relative z-10 mx-auto max-w-[1040px] text-center">
      <p class="badge mx-auto mb-4" data-rise style="--in:0">
        <svg aria-hidden="true" focusable="false" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" class="text-cp-orange"><circle cx="12" cy="12" r="7"/></svg>
        ফ্রি &middot; iPhone ও iPad &middot; Mac &middot; iOS 17+ ও macOS 26
      </p>
      <h1 class="h-display relative inline-block">
        iPhone ও Mac-এর জন্য সেরা বিনামূল্যের স্টোরেজ ক্লিনার।
        <svg aria-hidden="true" focusable="false" viewBox="0 0 380 18" fill="none" preserveAspectRatio="none" class="pointer-events-none mx-auto mt-2 h-3.5 w-64 max-w-full text-cp-orange">
          <path d="M4 12C95 4 230 3 376 11" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
        </svg>
      </h1>
      <p class="lede mx-auto mt-7 max-w-[640px] text-[17px] sm:text-[21px]">iPhone-এ ছবিগুলো সোয়াইপ করে মিনিটেই গিগাবাইট ফিরিয়ে নিন। Mac-এ ক্যাশ, ডেভেলপার ফাইল, ডুপ্লিকেট ও অ্যাপ অবশিষ্ট পরিষ্কার করুন। সবকিছু আপনার ডিভাইসেই চলে। বিজ্ঞাপন নেই, সাবস্ক্রিপশন নেই, অ্যাকাউন্ট নেই।</p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3.5 sm:flex-row" data-rise style="--in:2">
        <a href="https://apps.apple.com/app/id6775769763" class="btn-primary w-full max-w-[340px] px-7 py-3.5 text-[17px] sm:w-auto" target="_blank" rel="noopener">
          <svg aria-hidden="true" focusable="false" width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.46 2.23-1.21 3.05-.81.87-2.14 1.55-3.23 1.46-.14-1.1.4-2.25 1.16-3.04.85-.89 2.29-1.55 3.28-1.47Zm3.61 16.04c-.6 1.39-1.31 2.62-2.18 3.66-1.13 1.39-2.46 3.05-4.25 3.07-1.7.02-2.14-.99-4.46-.99-2.32 0-2.8 1.01-4.5.99-1.79-.02-3.15-1.6-4.28-2.99-2.6-3.2-4.59-9.05-1.92-12.99 1.32-1.95 3.69-3.18 6.25-3.22 1.78-.04 3.46 1.05 4.55 1.05 1.08 0 3.13-1.3 5.28-1.11.9.04 3.43.36 5.05 2.71-.13.08-3.02 1.76-2.99 5.25.04 4.17 3.66 5.55 3.45 5.57Z"/></svg>
          TidyByte ফ্রি ডাউনলোড করুন
        </a>
        <a href="/mac" class="btn-dark-cp w-full max-w-[340px] px-7 py-3.5 text-[17px] sm:w-auto">Mac-এর জন্য ডাউনলোড করুন</a>
      </div>

      <p class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm font-medium text-muted" data-rise style="--in:3">
        <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-success/15 text-success"><svg aria-hidden="true" focusable="false" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>বিজ্ঞাপন নেই</span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-success/15 text-success"><svg aria-hidden="true" focusable="false" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>অ্যাকাউন্ট লাগে না</span>
        <span class="inline-flex items-center gap-1.5"><span class="inline-flex h-4 w-4 items-center justify-center rounded-full bg-success/15 text-success"><svg aria-hidden="true" focusable="false" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>কোনো ছবিই TidyByte-এ পাঠানো হয় না</span>
      </p>
    </div>

    <!-- Hero showcase stage: crayon-bordered frame around the Mac + iPhone preview -->
    <div class="cr mx-auto mt-10 max-w-[960px] p-5 sm:p-8" style="--r:28px;--c:var(--cp-peach)" data-settle style="--in:1" role="img" aria-label="সোয়াইপের মাঝপথে iPhone-এ TidyByte, সামনে TidyByte for Mac-এর ওভারভিউ উইন্ডো।">
      <div class="fill" aria-hidden="true"></div>
      <div class="line" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-[740px] pb-6 pt-2">
        <!-- Mac window: top-start -->
        <div aria-hidden="true" class="me-auto ms-0 w-[86%] sm:w-[82%]">
          <div class="mac-home-window flex overflow-hidden rounded-2xl">
            <div class="flex w-[34%] shrink-0 flex-col border-e border-white/[0.08] bg-[#151517]/95">
              <div class="flex h-8 items-center justify-between px-3">
                <div class="flex items-center gap-1.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
                </div>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-white/55 rtl:-scale-x-100"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M9 4v16"/></svg>
              </div>
              <div class="px-2.5 pb-3">
                <div class="flex items-center gap-1.5 rounded-md bg-white/[0.12] px-2 py-1 text-[10px] font-semibold text-white">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#5cb0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 14h18"/><circle cx="17" cy="16.5" r="0.9" fill="#5cb0ff" stroke="none"/></svg>
                  <span class="truncate">ওভারভিউ</span>
                </div>
                <div class="mt-2 space-y-1 text-[10px] text-white/65">
                  <div class="flex items-center gap-1.5 px-2 py-0.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#ff453a" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13"/></svg><span class="truncate">সিস্টেম জাঙ্ক</span></div>
                  <div class="flex items-center justify-between gap-1 px-2 py-0.5"><span class="flex min-w-0 items-center gap-1.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#bf5af2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 12l-9.5 9.5a1.8 1.8 0 0 1-2.5-2.5L12.5 9.5"/><path d="M17.5 6.5l2.5 2.5-3.5 3.5-5-5 2-2a4.5 4.5 0 0 1 6-.5l-2 1.5z"/></svg><span class="truncate">ডেভেলপার</span></span><span dir="ltr" class="inline-flex shrink-0 items-baseline gap-0.5 text-[8px] tabular-nums text-white/55"><span>11.2</span> <span>GB</span></span></div>
                  <div class="flex items-center gap-1.5 px-2 py-0.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#5cb0ff" stroke-width="2"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg><span class="truncate">ডুপ্লিকেট</span></div>
                  <div class="flex items-center gap-1.5 px-2 py-0.5"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#30d158" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v9l6.5 3.5"/></svg><span class="truncate">স্পেস এক্সপ্লোরার</span></div>
                </div>
              </div>
            </div>
            <div class="flex min-w-0 flex-1 flex-col bg-[#1b1b1e]">
              <div class="flex h-8 items-center justify-between border-b border-white/[0.08] bg-[#242427] px-3">
                <span class="text-[11px] font-semibold tracking-tight text-white/85">TidyByte</span>
                <span class="rounded-full bg-white/[0.07] px-2 py-0.5 text-[9px] font-medium text-white/70">macOS 26</span>
              </div>
              <div class="flex-1 space-y-2.5 p-3">
                <div class="rounded-xl border border-white/[0.06] bg-[#262629] p-2.5">
                  <div class="flex items-center justify-between text-[10px] font-semibold text-white"><span>Macintosh HD</span><span dir="ltr" class="inline-flex items-baseline gap-0.5 font-normal tabular-nums text-white/70"><span>7.59</span> <span>GB</span></span></div>
                  <div class="mt-2 flex h-1.5 gap-[1.5px] overflow-hidden rounded-full bg-white/10">
                    <span class="h-full w-[42%] rounded-s-full bg-[#0a84ff]"></span>
                    <span class="h-full w-[18%] bg-[#bf5af2]"></span>
                    <span class="h-full w-[14%] bg-[#30d158]"></span>
                    <span class="h-full w-[11%] bg-[#ff9f0a]"></span>
                    <span class="h-full w-[8%] bg-[#636366]"></span>
                  </div>
                </div>
                <div class="rounded-xl border border-white/[0.06] bg-[#222225] p-3.5 text-start">
                  <div class="flex h-7 w-7 items-center justify-center rounded-full bg-[#0a84ff]/15">
                    <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5cb0ff" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35M11 8v6M8 11h6"/></svg>
                  </div>
                  <p class="mt-2 text-[11px] font-semibold text-white">কী পরিষ্কার করতে পারবেন খুঁজে নিন</p>
                  <p class="mt-1 w-3/4 text-[9px] leading-snug text-white/60">ক্যাশ, অবশিষ্ট, ডুপ্লিকেট, বড় ফাইল।</p>
                  <div class="mt-2.5 w-fit rounded-lg bg-[#0066cc] px-3 py-1 text-[10px] font-semibold text-white shadow-[0_4px_14px_rgba(0,102,204,0.35)]">আমার Mac স্ক্যান করুন</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Titanium iPhone foreground -->
        <div aria-hidden="true" class="absolute -bottom-2 -end-1 w-[36%] max-w-[200px] sm:-end-3">
          <div class="sim-iphone sim-iphone--hero">
            <div class="sim-iphone__screen">
              <div class="sim-iphone__sheen"></div>
              <div dir="ltr" class="flex items-center justify-between px-3 pt-2 text-[8.5px] font-semibold text-white/90">
                <span>12:05</span>
                <div class="sim-iphone__island"><span class="sim-iphone__lens"></span></div>
                <span class="flex items-center gap-1 text-white/90">
                  <svg width="10" height="8" viewBox="0 0 14 10" fill="currentColor"><rect x="0" y="6" width="2.2" height="4" rx=".6"/><rect x="3.5" y="4" width="2.2" height="6" rx=".6"/><rect x="7" y="2" width="2.2" height="8" rx=".6"/><rect x="10.5" y="0" width="2.2" height="10" rx=".6"/></svg>
                  <svg width="13" height="8" viewBox="0 0 20 11" fill="none"><rect x=".75" y="1" width="16" height="9" rx="2.2" stroke="currentColor" stroke-width="1.3"/><rect x="2.2" y="2.5" width="11.5" height="6" rx="1" fill="currentColor"/><path d="M18 3.8v3.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
              </div>
              <div class="flex items-center justify-between px-2.5 pt-1.5">
                <div class="flex items-center gap-1">
                  <span class="flex h-4 w-4 items-center justify-center rounded-full bg-[#242426] text-[8px] text-white/85 ring-1 ring-white/10 rtl:-scale-x-100">&#x2039;</span>
                  <span class="rounded-full border border-white/10 bg-[#242426] px-1.5 py-0.5 text-[7px] font-semibold text-[#ff6961]">শেষ করুন</span>
                </div>
                <span class="truncate px-1 text-[8px] font-semibold text-white">সোয়াইপ সেশন</span>
                <span class="flex h-4 w-4 items-center justify-center rounded-full bg-[#242426] text-white/60 ring-1 ring-white/10"><svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg></span>
              </div>
              <div class="mx-2.5 mt-2 aspect-[3/3.9] overflow-hidden rounded-xl shadow-[0_8px_20px_rgba(0,0,0,0.45)]">
                <svg viewBox="0 0 240 310" class="block h-full w-full" preserveAspectRatio="xMidYMid slice">
                  <defs>
                    <linearGradient id="hero-wf-sky" x1="0" y1="0" x2=".15" y2="1"><stop offset="0%" stop-color="#ded8eb"/><stop offset="50%" stop-color="#b4a7cb"/><stop offset="100%" stop-color="#766a90"/></linearGradient>
                    <linearGradient id="hero-wf-rock" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#605466"/><stop offset="100%" stop-color="#352d3c"/></linearGradient>
                    <linearGradient id="hero-wf-moss" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6c8248"/><stop offset="100%" stop-color="#3b5026"/></linearGradient>
                    <linearGradient id="hero-wf-water" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ffffff"/><stop offset="48%" stop-color="#ece8f8"/><stop offset="100%" stop-color="#c3b8dd" stop-opacity=".22"/></linearGradient>
                  </defs>
                  <rect width="240" height="310" fill="url(#hero-wf-sky)"/>
                  <path d="M0 68 C45 58 95 62 135 58 L240 50 L240 240 L0 240 Z" fill="url(#hero-wf-rock)"/>
                  <path d="M132 62 C168 56 205 52 240 48 L240 230 L152 230 C142 165 138 110 132 62 Z" fill="url(#hero-wf-moss)"/>
                  <path d="M124 62 C132 60 144 62 150 66 C160 118 168 176 176 238 L108 238 C114 172 118 114 124 62 Z" fill="url(#hero-wf-water)"/>
                  <path d="M0 226 C55 212 105 218 156 232 C192 216 218 192 240 184 L240 310 L0 310 Z" fill="#2b3d25"/>
                  <path d="M0 255 C72 240 150 258 240 242 L240 310 L0 310 Z" fill="#1d2b18"/>
                </svg>
              </div>
              <div dir="ltr" class="flex items-center justify-center gap-3 py-2.5">
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#ff453a] shadow-[0_0_12px_rgba(255,69,58,0.45)]"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span>
                <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#636366]/85"><svg width="8" height="8" viewBox="0 0 24 24" fill="#fff"><path d="M4 5v14l8-7zM13 5v14l8-7z"/></svg></span>
                <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#30d158] shadow-[0_0_12px_rgba(48,209,88,0.45)]"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-11"/></svg></span>
              </div>
              <div class="mx-2 mb-1.5 grid grid-cols-4 rounded-full border border-white/10 bg-[#222226]/90 p-0.5 text-[6px] font-medium text-[#c7c7cc]">
                <span class="flex flex-col items-center gap-[1px] rounded-full bg-white/[0.12] py-0.5 text-[#5cb0ff]"><span>সোয়াইপ</span></span>
                <span class="flex flex-col items-center gap-[1px] py-0.5"><span>পরিষ্কার</span></span>
                <span class="flex flex-col items-center gap-[1px] py-0.5"><span>স্টোরেজ</span></span>
                <span class="flex flex-col items-center gap-[1px] py-0.5"><span>সেটিংস</span></span>
              </div>
              <div class="mx-auto mb-1.5 h-[3px] w-12 rounded-full bg-white/35"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Shortcut hints under hero frame -->
    <div dir="ltr" class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-body">
      <span class="inline-flex items-center gap-1.5"><kbd class="cp-kbd">&larr;</kbd><kbd class="cp-kbd">&rarr;</kbd> <span>সোয়াইপ</span></span>
      <span class="inline-flex items-center gap-1.5"><kbd class="cp-kbd">&#x2318;</kbd><kbd class="cp-kbd">F</kbd> <span>AI ছবি সার্চ</span></span>
      <span class="inline-flex items-center gap-1.5"><kbd class="cp-kbd">&#x2318;</kbd><kbd class="cp-kbd">Z</kbd> <span>আনডু করুন</span></span>
    </div>
  </div>
</section>

<!-- Quick answer box -->
<section class="mt-10">
  <div class="cp-wrap max-w-4xl">
    <Fragment set:html={quickAnswer} />
  </div>
</section>

<!-- Capture & clutter sources 6-card strip -->
<section aria-label="সংখ্যায় TidyByte" class="home-sec">
  <div class="cp-wrap">
    <p class="eyebrow text-center">আপনার ডিভাইস ভরিয়ে রাখা সবকিছু</p>
    <ul role="list" class="cp-srcs mt-5">
      <li class="cp-src paper p-4 text-center">
        <p class="font-display text-3xl font-bold tabular-nums text-ink">12</p>
        <p class="mt-1 text-xs font-semibold text-body">ক্লিনআপ টুল</p>
      </li>
      <li class="cp-src paper p-4 text-center">
        <p class="font-display text-3xl font-bold tabular-nums text-ink">0</p>
