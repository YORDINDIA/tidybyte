---
// Sticky crayon-and-paper header: transparent at scroll=0, frosted #fffdf8f0
// with #cp-line sketchy bottom divider once scrolled.
import { ALL_LANGUAGES, type SiteLanguage } from "../../data/languages";
import { urlForRoute } from "../../lib/localized-page";
import { chrome, COMPACT_NAV } from "../../lib/chrome";

interface Props {
  home?: boolean;
  lang?: SiteLanguage;
}

const { home = false, lang = undefined } = Astro.props;
const anchor = (id: string) => (home ? `#${id}` : `/#${id}`);
const current = lang ?? undefined;
const t = (text: string) => chrome(lang?.code ?? "en", text);
const compactNav = COMPACT_NAV.has(lang?.code ?? "en");
---

<header class:list={["cp-header", compactNav && "header-compact"]} data-scrolled="false">
  <div class="cp-wrap flex h-full items-center justify-between gap-2 sm:gap-4">
    <a href={lang?.slug ? `/${lang.slug}` : "/"} class="group flex shrink-0 items-center gap-2 rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cp-orange sm:gap-2.5">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-[10px] bg-cp-orange text-white shadow-[0_0_0_2.5px_rgb(var(--c-ink)),2px_3px_0_rgb(var(--c-shadow))] transition group-hover:-translate-y-0.5 group-hover:-rotate-2 sm:h-10 sm:w-10 sm:rounded-[11px]">
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" class="sm:h-[22px] sm:w-[22px]">
          <rect x="4" y="5" width="13" height="15" rx="3" fill="white" fill-opacity="0.22" />
          <path d="M8 3h10a2 2 0 0 1 2 2v12" />
          <path d="m8.5 13 2.5 2.5 4.5-5" />
        </svg>
      </span>
      <span dir="ltr" class="font-display text-[22px] font-bold leading-none tracking-[-0.03em] text-ink sm:text-[28px]">TidyByte<span aria-hidden="true" class="text-cp-orange">.</span></span>
    </a>

    <nav aria-label={t("Primary")} class="primary-nav hidden items-center gap-1 xl:flex">
      <a href={anchor("features")} class="nav-link px-2.5">{t("Features")}</a>
      <a href="/photo-cleaner" class="nav-link px-2.5">{t("Tools")}</a>
      <a href="/mac" class="nav-link px-2.5">Mac</a>
      <a href={anchor("how-it-works")} class="nav-link px-2.5">{t("How it works")}</a>
      <a href="/blog" class="nav-link px-2.5">{t("Blog")}</a>
      <a href={anchor("faq")} class="nav-link px-2.5">{t("FAQ")}</a>
      <a href="/support" class="nav-link px-2.5">{t("Support")}</a>
      <a href="https://github.com/YORDINDIA/tidybyte" target="_blank" rel="noopener" class="nav-link px-2" aria-label={t("TidyByte on GitHub")}>
        <svg aria-hidden="true" focusable="false" width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.74 5.49.74 11.76c0 4.96 3.22 9.16 7.68 10.65.56.1.77-.24.77-.55v-1.93c-3.12.68-3.78-1.5-3.78-1.5-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.23.71-1.51-2.49-.28-5.12-1.25-5.12-5.55 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15.9-.25 1.86-.38 2.82-.39.96.01 1.92.14 2.82.39 2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.31-2.64 5.27-5.15 5.54.4.34.76 1.02.76 2.06v3.05c0 .31.2.66.78.55 4.46-1.49 7.67-5.69 7.67-10.65C23.26 5.49 18.27.5 12 .5Z"/></svg>
      </a>
    </nav>

    <div class="relative flex items-center gap-1.5 sm:gap-2">
      {current && (
        <details class="lang-menu">
          <summary class="icon-btn inline-flex h-9 items-center justify-center gap-1.5 rounded-full bg-surface-card px-2 text-ink shadow-[0_0_0_2px_rgb(var(--c-ink))] transition hover:-translate-y-px focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cp-orange sm:h-10 sm:px-2.5" aria-label={`${t("Language")} — ${current.endonym}`}>
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"/></svg>
            <span lang={current.htmlLang} class="hidden text-xs font-bold sm:inline">{current.endonym}</span>
            <svg aria-hidden="true" focusable="false" class="hidden sm:block" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="paper absolute end-0 top-12 z-50 max-h-[70vh] w-56 overflow-y-auto p-1.5">
            <p class="px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-cp-orange-deep">{t("Language")}</p>
            <ul>
              {ALL_LANGUAGES.map((l) => (
                <li>
                  <a
                    href={urlForRoute(l, "/")}
                    hreflang={l.htmlLang}
                    lang={l.htmlLang}
                    aria-current={l.code === current.code ? "true" : undefined}
                    class:list={[
                      "flex items-center gap-2 rounded-xl px-3 py-1.5 text-start text-sm transition hover:bg-surface-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cp-orange",
                      l.code === current.code ? "font-bold text-ink" : "font-medium text-body",
                    ]}
                  >
                    <span>{l.endonym}</span>
                    {l.code === current.code && (
                      <span aria-hidden="true" class="ms-auto h-2 w-2 rounded-full bg-cp-orange"></span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      )}

      <!-- Theme toggle: Light / Dark / System -->
      <div class="relative">
        <button type="button" data-theme-toggle aria-haspopup="menu" aria-expanded="false" aria-label={t("Change color theme")} class="icon-btn inline-flex h-9 w-9 items-center justify-center rounded-full bg-surface-card text-ink shadow-[0_0_0_2px_rgb(var(--c-ink))] transition hover:-translate-y-px focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cp-orange sm:h-10 sm:w-10">
          <svg data-theme-icon="sun" aria-hidden="true" focusable="false" class="block dark:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
          <svg data-theme-icon="moon" aria-hidden="true" focusable="false" class="hidden dark:block" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
        </button>
        <div data-theme-menu role="menu" aria-label={t("Color theme")} class="paper hidden absolute end-0 top-12 z-50 w-36 p-1.5">
          <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="light" class="flex w-full items-center gap-2 rounded-xl px-3 py-1.5 text-start text-sm font-medium text-ink transition hover:bg-surface-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cp-orange">
            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            {t("Light")}
            <span data-theme-dot aria-hidden="true" class="ms-auto h-2 w-2 rounded-full bg-cp-orange opacity-0"></span>
          </button>
          <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="dark" class="flex w-full items-center gap-2 rounded-xl px-3 py-1.5 text-start text-sm font-medium text-ink transition hover:bg-surface-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cp-orange">
            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/></svg>
            {t("Dark")}
            <span data-theme-dot aria-hidden="true" class="ms-auto h-2 w-2 rounded-full bg-cp-orange opacity-0"></span>
          </button>
          <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="system" class="flex w-full items-center gap-2 rounded-xl px-3 py-1.5 text-start text-sm font-medium text-ink transition hover:bg-surface-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cp-orange">
            <svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            {t("System")}
            <span data-theme-dot aria-hidden="true" class="ms-auto h-2 w-2 rounded-full bg-cp-orange opacity-0"></span>
          </button>
        </div>
      </div>

      <!-- Primary orange App Store CTA -->
      <a href="https://apps.apple.com/app/id6775769763" target="_blank" rel="noopener" class="btn-primary gap-1 px-2.5 py-1.5 text-xs sm:gap-2 sm:px-5 sm:py-2.5 sm:text-[15px]">
        <svg aria-hidden="true" focusable="false" class="shrink-0" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.46 2.23-1.21 3.05-.81.87-2.14 1.55-3.23 1.46-.14-1.1.4-2.25 1.16-3.04.85-.89 2.29-1.55 3.28-1.47Zm3.61 16.04c-.6 1.39-1.31 2.62-2.18 3.66-1.13 1.39-2.46 3.05-4.25 3.07-1.7.02-2.14-.99-4.46-.99-2.32 0-2.8 1.01-4.5.99-1.79-.02-3.15-1.6-4.28-2.99-2.6-3.2-4.59-9.05-1.92-12.99 1.32-1.95 3.69-3.18 6.25-3.22 1.78-.04 3.46 1.05 4.55 1.05 1.08 0 3.13-1.3 5.28-1.11.9.04 3.43.36 5.05 2.71-.13.08-3.02 1.76-2.99 5.25.04 4.17 3.66 5.55 3.45 5.57Z"/></svg>
        {t("Get the app")}
      </a>

      <!-- Mobile burger (40px-44px ink-outlined button) -->
      <button type="button" data-menu-toggle aria-controls="mobile-menu" aria-expanded="false" aria-label={t("Menu")} class="icon-btn inline-flex h-9 w-9 items-center justify-center rounded-full bg-surface-card text-ink shadow-[0_0_0_2px_rgb(var(--c-ink)),2px_2px_0_rgb(var(--c-shadow))] transition hover:-translate-y-px focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cp-orange sm:h-[44px] sm:w-[44px] xl:hidden">
        <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      </button>
    </div>
  </div>

  <!-- Sketchy bottom border revealed on scroll -->
  <div aria-hidden="true" class="cp-header-line"></div>
</header>

<!-- Mobile slide-in panel drawer (kept outside <header> so scrolled backdrop-filter never clips fixed positioning) -->
<div id="mobile-menu" data-mobile-menu role="dialog" aria-modal="true" aria-label={t("Mobile")} class="fixed inset-0 z-50 hidden xl:hidden">
  <div data-menu-scrim class="cp-drawer-scrim absolute inset-0"></div>
  <div data-drawer class="relative z-10 ms-auto h-full w-full max-w-[340px] p-3">
    <nav aria-label={t("Mobile")} class="cp-drawer-panel flex h-full flex-col gap-1 overflow-y-auto p-5 text-base">
      <div class="mb-3 flex items-center justify-between border-b border-hairline pb-3">
        <span dir="ltr" class="font-display text-2xl font-bold text-ink">TidyByte<span aria-hidden="true" class="text-cp-orange">.</span></span>
        <button type="button" data-menu-close aria-label={t("Close menu")} class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-surface-soft text-ink shadow-[0_0_0_2px_rgb(var(--c-ink))]">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      <a href={anchor("features")} class="nav-link py-2.5">{t("Features")}</a>
      <a href="/photo-cleaner" class="nav-link py-2.5">{t("Tools")}</a>
      <a href="/mac" class="nav-link py-2.5">{t("TidyByte for Mac")}</a>
      <a href={anchor("how-it-works")} class="nav-link py-2.5">{t("How it works")}</a>
      <a href="/blog" class="nav-link py-2.5">{t("Blog")}</a>
      <a href={anchor("faq")} class="nav-link py-2.5">{t("FAQ")}</a>
      <a href="/changelog" class="nav-link py-2.5">{t("Changelog")}</a>
      <a href="/support" class="nav-link py-2.5">{t("Support")}</a>
      <a href="https://github.com/YORDINDIA/tidybyte" target="_blank" rel="noopener" class="nav-link py-2.5">GitHub &rarr;</a>
      <div class="mt-auto pt-4">
        <a href="https://apps.apple.com/app/id6775769763" target="_blank" rel="noopener" class="btn-primary w-full justify-center">
          {t("Get the app")}
        </a>
      </div>
    </nav>
  </div>
</div>
