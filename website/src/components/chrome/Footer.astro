---
import { MAC_DOWNLOAD_URL } from "../../data/releases";
import type { SiteLanguage } from "../../data/languages";
import { chrome } from "../../lib/chrome";

interface Props {
  lang?: SiteLanguage;
}
const { lang = undefined } = Astro.props;
const t = (text: string) => chrome(lang?.code ?? "en", text);
const home = lang?.slug ? `/${lang.slug}` : "/";
const [madeByBefore, madeByAfter = ""] = t("Made by {name}").split("{name}");
---
<!-- Snaptitle-style deep navy footer (#1b1f45) with #cp-wax top edge -->
<footer class="cp-foot">
  <div class="cp-foot-bg" aria-hidden="true">
    <div class="cp-foot-edge"></div>
  </div>
  <div class="cp-wrap relative z-10 grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr_1fr_1.15fr] md:py-16">
    <div>
      <p class="font-display text-[30px] font-bold leading-none tracking-[-0.03em] text-white"><span dir="ltr" class="inline-block">TidyByte<span aria-hidden="true" class="text-cp-orange">.</span></span></p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-[#d9d6ff]">{t("Swipe to clean your photos. Free, on-device, no account.")}</p>
    </div>
    <div>
      <p class="cp-foot-head">{t("Product")}</p>
      <ul class="mt-3.5 space-y-2 text-[15px] font-medium">
        <li><a href={`${home}#features`}>{t("Features")}</a></li>
        <li><a href="/mac">{t("TidyByte for Mac")}</a></li>
        <li><a href="/activity-monitor-alternative">{t("Mac Activity Monitor alternative")}</a></li>
        <li><a href={`${home}#how-it-works`}>{t("How it works")}</a></li>
        <li><a href={`${home}#faq`}>{t("FAQ")}</a></li>
      </ul>
    </div>
    <div>
      <p class="cp-foot-head">{t("Tools")}</p>
      <ul class="mt-3.5 space-y-2 text-[15px] font-medium">
        <li><a href="/photo-cleaner">{t("All cleanup tools")}</a></li>
        <li><a href="/free-photo-cleaner-no-subscription">{t("Free, no subscription")}</a></li>
        <li><a href="/storage-cleaner">{t("Storage cleaner")}</a></li>
        <li><a href="/duplicate-photo-cleaner">{t("Duplicate photos")}</a></li>
        <li><a href="/screenshot-cleaner">{t("Screenshots")}</a></li>
        <li><a href="/chat-media-cleaner">{t("Chat media")}</a></li>
        <li><a href="/video-compression">{t("Video compression")}</a></li>
        <li><a href="/image-compression">{t("Image compression")}</a></li>
        <li><a href="/on-device-ai-photo-search">{t("AI photo search")}</a></li>
      </ul>
    </div>
    <div>
      <p class="cp-foot-head">{t("Resources")}</p>
      <ul class="mt-3.5 space-y-2 text-[15px] font-medium">
        <li><a href="/blog">{t("Blog")}</a></li>
        <li><a href="/changelog">{t("Changelog")}</a></li>
        <li><a href="/support">{t("Support")}</a></li>
      </ul>
    </div>
    <div>
      <p class="cp-foot-head">{t("Project")}</p>
      <ul class="mt-3.5 space-y-2 text-[15px] font-medium">
        <li><a href="https://github.com/YORDINDIA/tidybyte" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5"><svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.74 5.49.74 11.76c0 4.96 3.22 9.16 7.68 10.65.56.1.77-.24.77-.55v-1.93c-3.12.68-3.78-1.5-3.78-1.5-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.23.71-1.51-2.49-.28-5.12-1.25-5.12-5.55 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15.9-.25 1.86-.38 2.82-.39.96.01 1.92.14 2.82.39 2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.31-2.64 5.27-5.15 5.54.4.34.76 1.02.76 2.06v3.05c0 .31.2.66.78.55 4.46-1.49 7.67-5.69 7.67-10.65C23.26 5.49 18.27.5 12 .5Z"/></svg>GitHub</a></li>
        <li><a href={`${home}#open-source`}>{t("Open source")}</a></li>
        <li><a href="/privacy">{t("Privacy")}</a></li>
        <li><a href="/terms">{t("Terms")}</a></li>
      </ul>
    </div>
    <div>
      <p class="cp-foot-head">{t("App")}</p>
      <ul class="mt-3.5 space-y-2 text-[15px] font-medium">
        <li><a href="https://apps.apple.com/app/id6775769763" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5"><svg aria-hidden="true" focusable="false" class="shrink-0" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.46 2.23-1.21 3.05-.81.87-2.14 1.55-3.23 1.46-.14-1.1.4-2.25 1.16-3.04.85-.89 2.29-1.55 3.28-1.47Zm3.61 16.04c-.6 1.39-1.31 2.62-2.18 3.66-1.13 1.39-2.46 3.05-4.25 3.07-1.7.02-2.14-.99-4.46-.99-2.32 0-2.8 1.01-4.5.99-1.79-.02-3.15-1.6-4.28-2.99-2.6-3.2-4.59-9.05-1.92-12.99 1.32-1.95 3.69-3.18 6.25-3.22 1.78-.04 3.46 1.05 4.55 1.05 1.08 0 3.13-1.3 5.28-1.11.9.04 3.43.36 5.05 2.71-.13.08-3.02 1.76-2.99 5.25.04 4.17 3.66 5.55 3.45 5.57Z"/></svg>{t("Download on the App Store")}</a></li>
        <li><a href={MAC_DOWNLOAD_URL} class="inline-flex items-center gap-1.5"><svg aria-hidden="true" focusable="false" class="shrink-0" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M16.365 1.43c0 1.14-.46 2.23-1.21 3.05-.81.87-2.14 1.55-3.23 1.46-.14-1.1.4-2.25 1.16-3.04.85-.89 2.29-1.55 3.28-1.47Zm3.61 16.04c-.6 1.39-1.31 2.62-2.18 3.66-1.13 1.39-2.46 3.05-4.25 3.07-1.7.02-2.14-.99-4.46-.99-2.32 0-2.8 1.01-4.5.99-1.79-.02-3.15-1.6-4.28-2.99-2.6-3.2-4.59-9.05-1.92-12.99 1.32-1.95 3.69-3.18 6.25-3.22 1.78-.04 3.46 1.05 4.55 1.05 1.08 0 3.13-1.3 5.28-1.11.9.04 3.43.36 5.05 2.71-.13.08-3.02 1.76-2.99 5.25.04 4.17 3.66 5.55 3.45 5.57Z"/></svg>{t("Download for Mac")}</a></li>
      </ul>
    </div>
  </div>
  <div class="cp-wrap relative z-10">
    <div class="cp-foot-divider py-6 text-center text-xs text-[#b7b5e6]">
      &copy; 2026 TidyByte &middot; <a href="/LICENSE">{t("MIT licensed")}</a> &middot; {madeByBefore}<a href="https://sakshammittal.com/" target="_blank" rel="noopener">Saksham Mittal</a>{madeByAfter} &middot; {t("No account. No analytics. Nothing to cancel.")}
    </div>
  </div>
</footer>
